---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { estimateMaple, estimateVendor } from "../../lib/vendor-pricing";

const pageTitle = "New Relic Pricing 2026: Plans, Free Tier, Per-User and Per-GB Costs";
const pageDescription =
    "New Relic pricing explained: the free tier's 100 GB and one full user, Standard, Pro and Enterprise plans, user and data rates, Data Plus and a cost example.";
const published = "2026-10-19";
const updatedLabel = "October 19, 2026";
const verified = "2026-10-19";

const toc = [
    ["model", "The pricing model"],
    ["plans", "Plans"],
    ["users", "User types"],
    ["free-tier", "Free tier"],
    ["data", "Data ingest"],
    ["compute", "Compute pricing"],
    ["example", "Cost example"],
    ["reduce", "Reducing the bill"],
    ["dynatrace", "Dynatrace vs New Relic"],
] as const;
const tocHeadings = toc.map(([slug, text]) => ({ depth: 2, slug, text }));

// Rates the shared estimator does not model, from newrelic.com/pricing (verified 2026-10-19).
const CORE_USER = 49;
const DATA_PLUS_PER_GB = 0.6;
const PRO_MONTHLY_PER_USER = 418.8;

const usd = (amount: number) => {
    const cents = Math.round(amount * 100) / 100;
    return `$${cents.toLocaleString("en-US", { minimumFractionDigits: Number.isInteger(cents) ? 0 : 2, maximumFractionDigits: 2 })}`;
};

const dataGb = 800;
const allFull = estimateVendor("new-relic", { fullUsers: 12, dataVolume: dataGb });
const mixed = estimateVendor("new-relic", { fullUsers: 4, dataVolume: dataGb });
const [allFullUsers, allFullData] = allFull.breakdown;
const [mixedFullUsers, mixedData] = mixed.breakdown;
const coreCost = 8 * CORE_USER;
const mixedTotal = mixed.total + coreCost;
const dataPlusCost = (dataGb - 100) * DATA_PLUS_PER_GB;
const proMonthlyUsers = 12 * PRO_MONTHLY_PER_USER;
const maple = estimateMaple("new-relic", { fullUsers: 12, dataVolume: dataGb });

const ingestQuery = `FROM NrConsumption SELECT sum(GigabytesIngested)
WHERE productLine = 'DataPlatform'
SINCE 3 months ago FACET usageMetric TIMESERIES 1 day`;

const userQuery = `FROM NrMTDConsumption SELECT latest(FullPlatformUsersBillable),
  latest(CoreUsersBillable) SINCE 3 hours ago`;

const collectorConfig = `receivers:
  otlp:
    protocols:
      grpc:
      http:

processors:
  filter/drop-debug-logs:
    error_mode: ignore
    logs:
      log_record:
        - severity_number < SEVERITY_NUMBER_INFO
  batch:

exporters:
  otlphttp/newrelic:
    endpoint: https://otlp.nr-data.net      # EU: https://otlp.eu01.nr-data.net
    headers:
      api-key: \${env:NEW_RELIC_LICENSE_KEY}
  otlphttp/maple:
    endpoint: https://ingest.maple.dev      # EU: https://ingest.eu.maple.dev
    headers:
      Authorization: Bearer \${env:MAPLE_INGEST_KEY}

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/newrelic, otlphttp/maple]
    logs:
      receivers: [otlp]
      processors: [filter/drop-debug-logs, batch]
      exporters: [otlphttp/newrelic, otlphttp/maple]`;

const faqs = [
    {
        question: "Is New Relic free?",
        answer:
            "Yes, there is a permanent free tier with no credit card and no time limit. It includes 100 GB of data ingest a month, one full platform user, unlimited basic users, at least 8 days of default retention and 500 synthetic checks. Paid plans start once you need more data or more full platform or core users.",
    },
    {
        question: "How is a full platform user billed?",
        answer:
            "Per user per calendar month, at the highest user type the person held that month. On Standard the first full platform user is $10 and each additional one is $99, up to five. On Pro each is $349 a month on an annual commitment or $418.80 a month pay-as-you-go. Enterprise is quoted by sales. A user counts as billable once added, even before they log in.",
    },
    {
        question: "What happens past 100 GB on the New Relic free tier?",
        answer:
            "At 85% of the 100 GB you get an email and an in-app alert. Once a Free account passes 100 GB in a month, New Relic stops ingesting data and you lose access to the platform until you upgrade or the next month starts. On paid plans the first 100 GB is still free and every GB after it is billed at $0.40 (Original Data) or $0.60 (Data Plus).",
    },
    {
        question: "Is there a New Relic free trial?",
        answer:
            "New Relic does not advertise a time-limited trial of its paid plans. The free tier takes its place: it does not expire and includes one full platform user, so you can try the curated APM, infrastructure and browser views on 100 GB a month before paying.",
    },
    {
        question: "Is New Relic cheaper than Dynatrace?",
        answer:
            "It depends on the workload. New Relic charges per full platform user and per GB, with hosts free. Dynatrace charges per host or memory-GiB-hour and per GiB of logs and traces, with no per-user fee, under an annual commitment. A small team monitoring many hosts usually pays less on New Relic; a large team on few hosts often pays less on Dynatrace. Price your own host count, team size and data volume on both.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "New Relic pricing: plans, free tier and what a team pays",
    description: pageDescription,
    datePublished: published,
    dateModified: published,
    author: { "@type": "Organization", name: "Maple" },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/new-relic-pricing`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "New Relic pricing" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pb-16 pt-20 md:pb-24 md:pt-28 lg:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.75fr)] lg:items-center lg:gap-16">
                <div>
                    <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                        <span class="border border-primary/40 px-2 py-1 text-primary">Pricing</span>
                        <span>11 min read</span>
                    </div>
                    <h1 class="mt-6 max-w-[16ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                        New Relic pricing: plans, free tier and what a team pays
                    </h1>
                    <p class="mt-7 max-w-[62ch] text-[15px] leading-[1.75] text-fg-muted md:text-base">
                        New Relic bills two things: the users who need its full product, and every GB you send past the first 100 a month. Hosts, agents and containers are not counted. This guide covers the published rates, the free tier's limits, and what a 12-person team pays.
                    </p>
                    <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                        <span>By Maple</span>
                        <time datetime={published}>Updated {updatedLabel}</time>
                        <span>Prices last verified {verified}</span>
                    </div>
                </div>

                <div class="rounded-xl border border-border bg-bg-deep p-4 shadow-2xl shadow-black/20 md:p-5" aria-label="New Relic pricing at a glance">
                    <div class="flex items-center justify-between border-b border-border pb-3 font-mono text-[10px] text-fg-muted">
                        <span>new relic / list prices</span>
                        <span class="text-primary">USD / month</span>
                    </div>
                    <ol class="divide-y divide-border">
                        {[
                            ["01", "Free tier", "100 GB, 1 full platform user", "$0, no expiry"],
                            ["02", "Data", "$0.40/GB past 100 GB", "$0.60 with Data Plus"],
                            ["03", "Full platform user", "Standard $10 first, $99 after", "Pro $349 annual"],
                            ["04", "Core user", "$49 on any paid plan", "logs, errors, IDE"],
                            ["05", "Basic user", "Unlimited", "$0"],
                        ].map(([number, label, headline, detail]) => (
                            <li class="grid grid-cols-[2rem_1fr] gap-3 py-3.5">
                                <span class="font-mono text-[10px] text-primary">{number}</span>
                                <div>
                                    <div class="flex items-baseline justify-between gap-3">
                                        <span class="text-xs font-medium text-fg">{label}</span>
                                        <span class="font-mono text-[9px] text-fg-muted">{detail}</span>
                                    </div>
                                    <p class="mt-1 text-[11px] leading-relaxed text-fg-muted">{headline}</p>
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {toc.map(([id, label]) => (
                    <a href={`#${id}`} class="transition-colors hover:text-primary">{label}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={tocHeadings} class="sticky top-28" />
            </aside>

            <article class="nr-guide min-w-0">
                <section id="model" class="scroll-mt-24">
                    <p class="guide-eyebrow">01 · Pricing model</p>
                    <h2>The New Relic pricing model: users plus GB ingested</h2>

                    <div class="guide-answer">
                        <p>
                            A New Relic bill is <strong>billable users</strong> plus <strong>data ingested</strong> beyond a free <strong>100 GB per month</strong>. Full platform users cost $10 to $418.80 a month each depending on plan and term, core users $49, basic users nothing. Data costs <strong>$0.40 per GB</strong>, or $0.60 with Data Plus. Prices last verified {verified}.
                        </p>
                    </div>

                    <p>
                        The bill has four inputs. The <strong>edition</strong> (Free, Standard, Pro or Enterprise) sets the per-user price and the support level. <strong>Users</strong> are billed by type, and only core and full platform users cost money. <strong>GB ingested</strong> is the data New Relic stores after your trimming and transformation rules run, rounded up to the next whole GB each month. <strong>Add-ons</strong> cover extra retention, synthetic checks beyond the included amount ($0.005 per check), the EU data center and Advanced Compute features.
                    </p>
                    <p>
                        There is no per-host or per-CPU charge. Running 10 or 1,000 hosts costs the same in licenses; the difference shows up only in the GB they send. The model favors small teams running large fleets, and costs the most where many engineers need the APM views.
                    </p>
                    <p>
                        A second model, <strong>Data + Core Compute</strong>, replaces user licenses with a charge for the compute each query and page load consumes. It is covered in <a href="#compute">compute pricing</a> below.
                    </p>
                </section>

                <section id="plans" class="scroll-mt-24">
                    <p class="guide-eyebrow">02 · Editions</p>
                    <h2>New Relic plans: Free, Standard, Pro and Enterprise</h2>
                    <p>
                        All four editions include unlimited basic users and the same first 100 GB of free data each month. They differ in how many full platform users you can add, what each costs, and the support and compliance terms.
                    </p>

                    <div class="overflow-x-auto">
                        <table>
                            <thead>
                                <tr><th>Edition</th><th>Full platform user</th><th>Core user</th><th>Data past 100 GB</th><th>Limits and terms</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><strong>Free</strong></td><td>1 user, $0</td><td>Not available</td><td>Ingest stops at 100 GB</td><td>No credit card, no expiry, at least 8 days of retention, 500 synthetic checks</td></tr>
                                <tr><td><strong>Standard</strong></td><td>$10 for the first, $99 each after</td><td>$49</td><td>$0.40/GB, $0.60 Data Plus</td><td>Up to 5 full platform users, pay-as-you-go, ticket support with a 2 business day response</td></tr>
                                <tr><td><strong>Pro</strong></td><td>$349 annual, $418.80 monthly</td><td>$49</td><td>$0.40/GB, $0.60 Data Plus</td><td>Unlimited users, commitment discounts, 2 hour response for critical issues, optional compute pricing</td></tr>
                                <tr><td><strong>Enterprise</strong></td><td>Contact sales</td><td>$49</td><td>Contact sales</td><td>1 hour critical response, FedRAMP Moderate and HIPAA eligibility with Data Plus, custom pricing</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <p>
                        Standard's five-user ceiling decides most upgrades. A sixth engineer who needs APM moves the whole account to Pro, and the per-user price jumps from $99 to $349. Five Standard users cost $406 a month; six Pro users cost $2,094 on an annual term.
                    </p>
                    <p>
                        Pay-as-you-go on Standard and Pro is billed at the end of each calendar month with no commitment beyond it. Pro and Enterprise customers can sign a commitment contract for volume discounts, and New Relic says unused committed funds roll over for up to 12 months. New Relic also runs discount programs for startups and nonprofits.
                    </p>
                </section>

                <section id="users" class="scroll-mt-24">
                    <p class="guide-eyebrow">03 · Seats</p>
                    <h2>User types: basic, core and full platform</h2>
                    <p>
                        The user type controls what a person sees and what they cost. New Relic's docs describe it as a billing decision; roles still control permissions.
                    </p>

                    <div class="guide-signal-list">
                        <div><span>Basic</span><p><strong>Free, unlimited.</strong> Set up instrumentation, run NRQL queries, build custom dashboards, create basic alerts, and search and view logs. No access to the curated APM, browser, mobile or infrastructure UIs.</p></div>
                        <div><span>Core</span><p><strong>$49 a month on paid plans.</strong> Everything a basic user has, plus the full logs UI, errors inbox, the CodeStream IDE extension, apps from the app catalog, and account and billing administration. Still no curated APM views.</p></div>
                        <div><span>Full platform</span><p><strong>$10 to $418.80 a month depending on edition.</strong> Every feature, including the curated APM, infrastructure, Kubernetes, browser, mobile and synthetics experiences.</p></div>
                    </div>

                    <h3>How users are counted</h3>
                    <p>
                        Billing runs per calendar month in UTC, and each person is billed at the <strong>highest user type they held during that month</strong>. Promoting someone to full platform for one afternoon of incident work bills a full month. A user is billable as soon as they are added, whether or not they have logged in, and two accounts with the same email count once. On committed contracts, a user who goes through two downgrade and upgrade cycles in a contract year is billed as full platform for the rest of that year.
                    </p>
                </section>

                <section id="free-tier" class="scroll-mt-24">
                    <p class="guide-eyebrow">04 · Free tier</p>
                    <h2>The New Relic free tier and its limits</h2>
                    <p>
                        New Relic's free tier is permanent and needs no credit card. Each month it includes:
                    </p>

                    <div class="guide-checklist">
                        {[
                            ["100 GB of data ingest", "Logs, metrics, traces and events combined, measured after your drop and transformation rules."],
                            ["1 full platform user", "Access to every curated view, so one person can evaluate the full product."],
                            ["Unlimited basic users", "Dashboards, NRQL queries and basic alerts for the rest of the team."],
                            ["At least 8 days of retention", "The Original Data default. Some data types keep longer, for example logs at 30 days."],
                            ["500 synthetic checks", "Each synthetic monitor run counts as one check."],
                            ["Hosts and agents", "No limit on how many you instrument; only the data counts."],
                        ].map(([title, body], index) => (
                            <div><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{title}</h3><p>{body}</p></div></div>
                        ))}
                    </div>

                    <h3>Past 100 GB on the free tier</h3>
                    <p>
                        At 85% of the allowance New Relic sends an email and an in-app alert. Once a Free account passes 100 GB in a calendar month, <strong>ingest stops and you lose access to the platform</strong> until you upgrade or the first day of the next month. A spike in logs late in the month can leave you without telemetry for days, so set a usage alert well before 85% (the queries are in <a href="#reduce">reducing the bill</a>).
                    </p>

                    <h3>No separate free trial</h3>
                    <p>
                        New Relic does not advertise a time-limited trial of Standard or Pro. The free tier is the evaluation path: it includes one full platform user, so the curated views are available from day one.
                    </p>
                </section>

                <section id="data" class="scroll-mt-24">
                    <p class="guide-eyebrow">05 · Data</p>
                    <h2>Data ingest: Original Data vs Data Plus</h2>
                    <p>
                        Every account picks one data option. Both start billing after the same free 100 GB.
                    </p>

                    <div class="overflow-x-auto">
                        <table>
                            <thead>
                                <tr><th></th><th>Original Data</th><th>Data Plus</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Price per GB past 100 GB (Standard, Pro)</td><td>$0.40</td><td>$0.60</td></tr>
                                <tr><td>Retention</td><td>Default, at least 8 days</td><td>Up to 90 days more than the default</td></tr>
                                <tr><td>Compliance</td><td>Standard</td><td>FedRAMP Moderate and HIPAA eligibility on Enterprise</td></tr>
                                <tr><td>Extras</td><td>None</td><td>Advanced log obfuscation, enhanced streaming and historical data export</td></tr>
                                <tr><td>EU data center</td><td>+$0.05/GB</td><td>+$0.05/GB</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <p>
                        Data Plus raises every GB by 50%, so it pays off only when you need the longer retention or the compliance eligibility. Teams that only want longer retention can buy the extended retention add-on instead, and logs can go to Live Archives for up to seven years.
                    </p>
                    <p>
                        Some data does not count toward GB ingested, including aggregated infrastructure data, dimensional and golden metrics, synthetic check results and New Relic's own usage events. New Relic does not charge for data egress or rehydration.
                    </p>
                </section>

                <section id="compute" class="scroll-mt-24">
                    <p class="guide-eyebrow">06 · Compute</p>
                    <h2>Compute-based pricing (CCUs)</h2>
                    <p>
                        On Pro and Enterprise, New Relic offers a consumption model that drops user licenses entirely. You pay for data ingest as usual, plus <strong>compute capacity units (CCUs)</strong>: the capacity consumed by each successful customer-initiated action, such as loading a page or running a query. Every user gets full platform access. Failed requests caused by New Relic errors and queries that analyze your own usage are not charged.
                    </p>
                    <p>
                        New Relic does not publish a per-CCU price; it varies by edition and is quoted by sales. Its billing docs list Core Compute as in preview, available through an account executive. Budgets with threshold alerts are available to cap spend.
                    </p>
                    <p>
                        <strong>Advanced Compute</strong> is a separate add-on, billed in advanced CCUs, for the AI, automation and security features such as New Relic AI and workflow automation. It applies under either model, and even basic users can generate Advanced Compute charges.
                    </p>
                </section>

                <section id="example" class="scroll-mt-24">
                    <p class="guide-eyebrow">07 · Worked example</p>
                    <h2>New Relic cost: a worked monthly example</h2>
                    <p>
                        A team of 12 engineers sends {dataGb} GB of logs, traces and metrics a month to New Relic's US region on Original Data. Hosts are free, so only the users and the 700 billable GB matter. The user mix changes the bill more than anything else.
                    </p>

                    <div class="overflow-x-auto">
                        <table>
                            <thead>
                                <tr><th>Line item</th><th>A: all 12 on full platform (Pro, annual)</th><th>B: 4 full platform + 8 core (Standard)</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Full platform users</td><td>{allFullUsers.detail} = {usd(allFullUsers.value)}</td><td>{mixedFullUsers.detail} = {usd(mixedFullUsers.value)}</td></tr>
                                <tr><td>Core users</td><td>None</td><td>8 × ${CORE_USER} = {usd(coreCost)}</td></tr>
                                <tr><td>Data ingest</td><td>700 GB × $0.40 = {usd(allFullData.value)}</td><td>700 GB × $0.40 = {usd(mixedData.value)}</td></tr>
                                <tr><td><strong>Monthly total</strong></td><td><strong>{usd(allFull.total)}</strong></td><td><strong>{usd(mixedTotal)}</strong></td></tr>
                            </tbody>
                        </table>
                    </div>

                    <p>
                        Option B stays on Standard because its five-user limit applies to full platform users, and only four people hold one. It works when the eight core users can live without the curated APM and infrastructure views, which in practice means the people not on call.
                    </p>

                    <h3>How the total moves</h3>
                    <div class="guide-signal-list">
                        <div><span>Data Plus</span><p>700 GB × $0.60 = {usd(dataPlusCost)} instead of {usd(allFullData.value)}, adding {usd(dataPlusCost - allFullData.value)} to either option.</p></div>
                        <div><span>Pro monthly</span><p>Option A without an annual commitment: 12 × $418.80 = {usd(proMonthlyUsers)} for users, {usd(proMonthlyUsers - allFullUsers.value)} more a month.</p></div>
                        <div><span>A 13th user</span><p>On option A, another {usd(allFullUsers.value / 12)} a month. Doubling data to 1,600 GB adds {usd(800 * 0.4)}.</p></div>
                    </div>

                    <p>
                        For comparison, the same {dataGb} GB on Maple's Startup plan is estimated at {usd(maple.total)} a month, with no per-user fee: $39 including 100 GB per signal, then $0.30 per GB, assuming the volume splits evenly across logs, traces and metrics. The <a href="/compare/new-relic">Maple vs New Relic comparison</a> has a calculator for your own numbers, and <a href="/pricing">Maple pricing</a> lists the plan.
                    </p>
                </section>

                <section id="reduce" class="scroll-mt-24">
                    <p class="guide-eyebrow">08 · Cost control</p>
                    <h2>Ways to reduce a New Relic bill</h2>

                    <h3>Measure ingest and seats first</h3>
                    <p>
                        New Relic records its own usage in the <code>NrConsumption</code> and <code>NrMTDConsumption</code> event types, which do not count toward ingest. This query from New Relic's docs breaks daily GB down by source:
                    </p>
                    <pre><code>{ingestQuery}</code></pre>
                    <p>And this one returns the month-to-date billable user counts:</p>
                    <pre><code>{userQuery}</code></pre>
                    <p>
                        Put an alert on the first query at a daily GB rate that would cross your budget, or 85 GB for the month on the free tier.
                    </p>

                    <h3>Review who holds full platform seats</h3>
                    <p>
                        Seats usually outweigh data, as the worked example shows. Downgrade people who only read dashboards to basic, and people who mostly work in logs and errors to core. Because the highest type in a month is what gets billed, make the change at the start of a month, and on a committed contract keep each person's type stable to avoid the two-cycle rule.
                    </p>

                    <h3>Drop data before it is billed</h3>
                    <p>
                        Ingest is measured after New Relic's processing rules, so dropped data is never billed. NRQL drop rules reached end of life on June 30, 2026, and <strong>Pipeline Control</strong> replaces them: cloud rules drop data inside New Relic, and the gateway runs in your own Kubernetes cluster and filters data before it leaves your network. Dropped data cannot be recovered.
                    </p>
                    <p>
                        If you already send OpenTelemetry, the Collector can do the same filtering in your own infrastructure. This configuration drops logs below INFO and sends traces and logs to New Relic's OTLP endpoint. It also sends a copy to Maple, which lets you compare bills on identical data before deciding anything; remove the Maple exporter if you only want the filter.
                    </p>
                    <pre><code>{collectorConfig}</code></pre>
                    <p>
                        Other levers on the same pipeline: sample traces (see <a href="/docs/concepts/sampling-throughput">how Maple keeps throughput accurate under sampling</a>), drop high-cardinality attributes you never query, and stop shipping health check spans and debug logs from production.
                    </p>

                    <h3>Commit once usage is stable</h3>
                    <p>
                        Pro's annual price is 17% below its monthly price ($349 vs $418.80 per full platform user), and commitment contracts add volume discounts on top. Commit only after a few months of measured usage, since the commitment is owed whether you use it or not.
                    </p>
                </section>

                <section id="dynatrace" class="scroll-mt-24">
                    <p class="guide-eyebrow">09 · Comparison</p>
                    <h2>Dynatrace vs New Relic pricing</h2>
                    <p>
                        The two vendors bill on different units. New Relic counts people and GB and ignores hosts. Dynatrace counts hosts (by memory size for full-stack monitoring) and GiB of logs and traces, has no per-user fee, and sells through the Dynatrace Platform Subscription, an annual minimum commitment drawn down at rate-card prices.
                    </p>

                    <div class="overflow-x-auto">
                        <table>
                            <thead>
                                <tr><th></th><th>New Relic</th><th>Dynatrace</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Users</td><td>$10 to $418.80 per full platform user</td><td>No per-user charge</td></tr>
                                <tr><td>Hosts</td><td>Free</td><td>Full-Stack $58/mo per 8 GiB host ($0.01 per memory-GiB-hour); Infrastructure $29/mo per host</td></tr>
                                <tr><td>Logs</td><td>$0.40/GB past 100 GB free, queries included</td><td>$0.20/GiB to ingest, $0.0007/GiB-day to retain, $0.0035/GiB scanned to query</td></tr>
                                <tr><td>Traces</td><td>Same $0.40/GB pool</td><td>$0.20/GiB to ingest, plus retention and query</td></tr>
                                <tr><td>Free option</td><td>Permanent free tier</td><td>15-day free trial</td></tr>
                                <tr><td>Commitment</td><td>Optional (pay-as-you-go on Standard and Pro)</td><td>Annual minimum spend</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <p>
                        Before data, five full platform users on New Relic Standard cost $406 a month, while 100 Full-Stack hosts of 8 GiB on Dynatrace cost $5,800. Flip the team: 40 Pro users cost $13,960 a month, and 20 Dynatrace hosts cost $1,160. Small teams on large fleets tend to pay less on New Relic, and large teams on small fleets on Dynatrace. The <a href="/guides/dynatrace-pricing">Dynatrace pricing guide</a> breaks down the rate card and the platform subscription.
                    </p>
