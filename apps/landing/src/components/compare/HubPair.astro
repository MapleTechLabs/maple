---
/**
 * HubPair: ComparePair for the hub, as one row above the hero's product frame:
 * Maple's mark, then every vendor it is compared against, each linking to its
 * page. Marks only: the cards under the hero carry the names.
 */
import Icon from "../Icon.astro";
import BrandMarkIcon from "../BrandMarkIcon.astro";
import { comparePath, competitors } from "../../lib/competitors";

const locale = Astro.currentLocale ?? "en";
---

<div class="flex items-center gap-3 overflow-hidden rounded-xl border border-border bg-bg px-4 py-3">
	<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-elevated">
		<Icon name="MapleMark" size={20} class="text-primary" />
	</span>
	<span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted" aria-hidden="true">vs</span>
	<ul class="flex min-w-0 flex-1 flex-wrap items-center gap-1.5">
		{
			competitors.map((competitor) => (
				<li>
					<a
						href={comparePath(locale, competitor.slug)}
						class="flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-bg-elevated transition-colors hover:border-fg-muted"
						aria-label={competitor.navLabel()}
						title={competitor.name}
					>
						<BrandMarkIcon id={competitor.mark} class="h-[18px] w-[18px]" />
					</a>
				</li>
			))
		}
	</ul>
</div>
