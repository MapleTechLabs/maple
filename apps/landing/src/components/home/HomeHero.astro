---
/**
 * THESIS: Open observability at Roman architectural scale; a poster opening makes the
 * product's connected systems tangible before the working interface appears.
 * OWN-WORLD: Maple amber, charcoal, bone, heavy grotesk type, shared rounded buttons and dithered stone.
 * STORY: Understand the offer, see the real product, start a trial or hand setup to a coding agent.
 * FIRST VIEWPORT: Three-line headline above left-side copy/actions; a monumental
 * generated structure on the right, and the product plate rising over its base.
 * The hero stops short of the viewport so the plate below starts inside it.
 * FORM: Dither Monumentalism with the shared Maple palette, as requested.
 */
import { buttonVariants } from "@maple/views/ui/button.styles";
import * as m from "../../paraglide/messages.js";
import HeroCta from "../HeroCta.astro";
import AgentPromptButton from "../AgentPromptButton.astro";

// The changelog is English only, so the link is the same in every locale.
const announceHref = m.hero_announce_href();
---

<section class="monument-hero" aria-labelledby="home-title">
    <div class="monument-hero__field shell">
        <a
            href={announceHref}
            class="monument-announce"
            data-track="cta_click"
            data-track-location="hero_announce"
            data-track-label={m.hero_announce_text()}
            data-track-destination={announceHref}
        >
            <span class="monument-announce__badge">{m.hero_announce_badge()}</span>
            <span class="monument-announce__text">{m.hero_announce_text()}</span>
            <span class="monument-announce__arrow" aria-hidden="true">→</span>
        </a>
        <h1 id="home-title">
            <span>{m.hero_title()}</span>
            <span>{m.hero_title_sub()}</span>
            <span class="monument-hero__headline-accent">{m.hero_title_accent()}</span>
        </h1>
        <div class="monument-hero__copy">
            <p class="monument-hero__description">{m.hero_subtitle()}</p>
            <div class="monument-actions">
                <HeroCta class={buttonVariants({ size: "xl" })} />
                <AgentPromptButton />
            </div>
        </div>
    </div>
    <picture>
        <source media="(min-width: 1800px)" srcset="/art/maple-rome-ultrawide.webp" />
        <img class="monument-hero__art" src="/art/maple-rome-balanced.webp" width="1536" height="1024" alt="" fetchpriority="high" decoding="async" />
    </picture>
</section>
