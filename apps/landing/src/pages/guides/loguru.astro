const rules = [
    {
        title: "No enqueue=True on this sink",
        body: "<code>LoggingHandler</code> reads the active span of the thread that runs it. From Loguru's queue thread it finds none, and every record exports with an all-zero trace ID. The SDK's batch processor already exports in the background.",
    },
    {
        title: "Filter out opentelemetry records",
        body: "When an export fails, the exporter logs an error through <code>logging</code>. The InterceptHandler routes it into Loguru, and without the <code>filter</code> it would be queued for the next export, which fails and logs again.",
    },
    {
        title: "propagate = False on loguru.otel",
        body: "Without it, the rebuilt record also travels up to the root logger, where the InterceptHandler hands it back to Loguru. Loguru detects the re-entry and prints a logging error instead of the line.",
    },
    {
        title: "Bound keys must not clash",
        body: "Every <code>bind()</code> value becomes a log attribute. <code>makeRecord</code> rejects keys that already exist on a <code>LogRecord</code>, such as <code>name</code>, <code>module</code> or <code>message</code>, so pick names like <code>user_name</code>.",
    },
];

