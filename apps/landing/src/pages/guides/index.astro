---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SeoHead from "../../components/SeoHead.astro";
import type { BlogPost } from "../../lib/blog";
import { allGuides, guideCategories } from "../../lib/guides";

const pageTitle = "Guides to APM, Observability & OpenTelemetry | Maple";
const pageDescription =
    "Practical guides to application performance monitoring, observability, OpenTelemetry, latency, and choosing an open-source observability stack.";

const fieldNotes = (await getCollection("blog") as BlogPost[])
    .filter((post) => (!post.data.draft || import.meta.env.DEV) && post.data.category === "guides")
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const itemListJsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Maple observability guides",
    itemListElement: allGuides.map((guide, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: guide.title,
        url: `${siteUrl}${guide.href}`,
    })),
};
---

<Layout title={pageTitle} description={pageDescription} alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <Nav />
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Guides" }]} />

    <main class="mx-auto max-w-6xl px-6 pb-20 pt-16 md:pb-28 md:pt-20">
        <h1 class="font-display text-4xl font-medium tracking-[-0.03em] text-fg md:text-5xl">Guides</h1>
        <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-fg-muted">
            Practical guides to APM, observability, OpenTelemetry, and debugging production software.
        </p>

        <div class="mt-14 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {guideCategories.map((category) => (
                <section id={category.id} class="scroll-mt-24" aria-labelledby={`${category.id}-title`}>
                    <h2 id={`${category.id}-title`} class="border-b border-border pb-3 font-display text-lg font-medium text-fg">
                        {category.title}
                    </h2>
                    <ul class="mt-4 space-y-3">
                        {category.guides.map((guide) => (
                            <li>
                                <a href={guide.href} class="text-[14px] leading-snug text-fg-muted transition-colors hover:text-primary">
                                    {guide.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}

            {fieldNotes.length > 0 && (
                <section aria-labelledby="field-notes">
                    <h2 id="field-notes" class="border-b border-border pb-3 font-display text-lg font-medium text-fg">From the blog</h2>
                    <ul class="mt-4 space-y-3">
                        {fieldNotes.map((post) => (
                            <li>
                                <a href={`/blog/${post.id}`} class="text-[14px] leading-snug text-fg-muted transition-colors hover:text-primary">
                                    {post.data.title}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}
        </div>
    </main>

    <BottomCTA />
    <Footer />
</Layout>
