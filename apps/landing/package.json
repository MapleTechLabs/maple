{
	"name": "@maple/landing",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate:og": "node scripts/generate-og.mjs",
		"dev": "bun run --silent sync:cli && exec env -u CLAUDECODE astro dev --port ${PORT:-3391} --host ${HOST:-127.0.0.1}",
		"sync:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && astro sync",
		"sync:cli": "mkdir -p public/cli && cp ../../scripts/install.sh public/cli/install && cp ../../scripts/uninstall.sh public/cli/uninstall",
		"test": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && vitest run",
		"build": "bun run sync:cli && astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/markdown-satteri": "^0.4.2",
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/react": "^7.0.0",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@clerk/clerk-react": "^5.61.3",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@maple-dev/browser": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/infra": "workspace:*",
		"@maple/ui": "workspace:*",
		"@shikijs/themes": "^4.4.3",
		"@shikijs/transformers": "^4.4.3",
		"@tailwindcss/vite": "catalog:tailwind",
		"@tanstack/charts": "catalog:charts",
		"@types/react": "catalog:react",
		"@types/react-dom": "catalog:react",
		"astro": "^7.3.5",
		"autumn-js": "^1.3.25",
		"d3-scale": "^4.0.2",
		"effect": "catalog:effect",
		"fuse.js": "^7.5.0",
		"motion": "^13.4.4",
		"ogl": "^1.0.11",
		"react": "catalog:react",
		"react-dom": "catalog:react",
		"tailwindcss": "catalog:tailwind",
		"tw-animate-css": "catalog:tailwind"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.25.4",
		"@types/d3-scale": "^4.0.9",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
