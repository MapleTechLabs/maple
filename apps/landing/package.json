{
	"name": "@maple/landing",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate:og": "node scripts/generate-og.mjs",
		"screenshots": "bun scripts/screenshots/capture.ts",
		"screenshots:thread": "bun scripts/screenshots/capture.ts --set thread",
		"screenshots:status-pages": "bun scripts/screenshots/status-pages.ts",
		"screenshots:product-analytics": "bun scripts/screenshots/product-analytics-guides.ts",
		"check:lightbox": "bun scripts/lightbox-check.ts",
		"dev": "bun run --silent sync:cli && exec env -u CLAUDECODE astro dev --port ${PORT:-3391} --host ${HOST:-127.0.0.1}",
		"sync:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && astro sync",
		"sync:cli": "mkdir -p public/cli && cp ../../scripts/install.sh public/cli/install && cp ../../scripts/uninstall.sh public/cli/uninstall",
		"test": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && vitest run",
		"build": "bun run sync:cli && astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:alchemy",
		"@astrojs/markdown-satteri": "^0.4.10",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@maple-dev/browser": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/infra": "workspace:*",
		"@maple/primitives": "workspace:*",
		"@maple/status-page": "workspace:*",
		"@maple/strings": "workspace:*",
		"@maple/ui": "workspace:*",
		"@maple/views": "workspace:*",
		"@shikijs/themes": "^4.6.0",
		"@shikijs/transformers": "^4.6.0",
		"@tailwindcss/vite": "catalog:tailwind",
		"@takumi-rs/helpers": "2.22.1",
		"@takumi-rs/wasm": "2.22.1",
		"astro": "^7.4.13",
		"effect": "catalog:effect",
		"foldkit": "0.171.0",
		"tailwindcss": "catalog:tailwind",
		"tw-animate-css": "catalog:tailwind"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@foldkit/vite-plugin": "0.29.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@vitest/browser-playwright": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:tooling",
		"vitest": "catalog:",
		"woff2-encoder": "^2.0.0",
		"yaml": "2.9.1"
	}
}
