---
/**
 * Full-size viewer for product screenshots: people click a shot to read it. One island serves
 * every `[data-zoomable]` on the page, so the static frames stay legible if it never starts.
 * Behaviour is in `lightbox/` (a port of ramka, MIT: see lightbox/LICENSE-ramka); this is its look.
 */
import { Lightbox } from "./lightbox/Lightbox";
---

<Lightbox client:idle />

<style is:global>
	img[data-zoomable] {
		cursor: zoom-in;
	}

	img[data-zoomable]:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* The morph. The plate holds the shared name until the viewer renders, then the
	   open slide does; that render runs in a View Transition, so the browser
	   carries the image between the two. */
	html:not(:has([data-lightbox-content])) [data-lightbox-origin],
	[data-lightbox-media][data-active] {
		view-transition-name: lightbox-media;
	}

	/* The plate is in the viewer while it is open; left in the page as well, it
	   would show through the backdrop. */
	html:has([data-lightbox-content]) [data-lightbox-origin] {
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		html:has([data-lightbox-origin])::view-transition-old(root),
		html:has([data-lightbox-origin])::view-transition-new(root) {
			animation-duration: 360ms;
			animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
		}

		html:has([data-lightbox-origin])::view-transition-group(lightbox-media) {
			overflow: hidden;
			border-radius: 8px;
			animation-duration: 360ms;
			animation-timing-function: cubic-bezier(0.44, 0.58, 0, 1);
		}

		/* No crossfade between the two bitmaps: only the viewer's shot is drawn,
		   stretched between the boxes. It is the incoming image on the way in and
		   the outgoing one on the way out, which is the default below. */
		html:has([data-lightbox-origin])::view-transition-old(lightbox-media),
		html:has([data-lightbox-origin])::view-transition-new(lightbox-media) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			animation: none;
			mix-blend-mode: normal;
		}

		html:has([data-lightbox-origin])::view-transition-new(lightbox-media) {
			opacity: 0;
		}

		html:has([data-lightbox-content])::view-transition-new(lightbox-media) {
			opacity: 1;
		}
	}

	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		color: var(--foreground);
		/* Room for the bar above and a margin of backdrop all round, so the shot
		   reads as lifted off the page rather than pinned to its edges. */
		--lightbox-inset-top: calc(3.75rem + env(safe-area-inset-top, 0px));
		--lightbox-inset-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
		--lightbox-inset-inline: 0.75rem;
	}

	.lightbox:has([data-captioned]) {
		--lightbox-inset-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
	}

	@media (min-width: 768px) {
		.lightbox {
			--lightbox-inset-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
			--lightbox-inset-inline: 2.5rem;
		}

		.lightbox:has([data-captioned]) {
			--lightbox-inset-bottom: calc(5rem + env(safe-area-inset-bottom, 0px));
		}

		/* A gallery keeps its side margins clear for the step buttons. */
		.lightbox:has([data-gallery]) {
			--lightbox-inset-inline: 4.75rem;
		}
	}

	/* Where the browser cannot animate the open (reduced motion, no View
	   Transitions), the viewer still arrives rather than appearing. */
	@keyframes lightbox-arrive {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lightbox {
			animation: lightbox-arrive 160ms ease-out;
		}
	}

	@supports not (view-transition-name: none) {
		.lightbox {
			animation: lightbox-arrive 200ms ease-out;
		}
	}

	/* A real element, not ::backdrop: a pull has to thin it frame by frame while
	   the shot is dragged away, then bring it back on the snap's own clock. */
	.lightbox__backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in oklch, black 82%, transparent);
		backdrop-filter: blur(6px);
		opacity: calc(1 - var(--lightbox-pull-progress, 0) * 0.6);
		transition: opacity var(--lightbox-pull-snap-duration, 0s) var(--lightbox-pull-snap-easing, linear);
	}

	.lightbox[data-pulling] .lightbox__backdrop {
		transition: none;
	}

	@media (prefers-reduced-transparency: reduce) {
		.lightbox__backdrop {
			background: black;
			backdrop-filter: none;
		}
	}

	.lightbox__content {
		position: absolute;
		inset: 0;
		overflow: hidden;
		outline: none;
		overscroll-behavior: contain;
		user-select: none;
		-webkit-user-select: none;
		touch-action: pan-x;
	}

	/* The carousel is a native scroller: swiping, momentum and snapping are the
	   browser's. Vertical touches are left to the viewer, which reads them as a
	   pull. */
	.lightbox__slides {
		position: relative;
		display: flex;
		width: 100%;
		height: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-behavior: auto;
		scrollbar-width: none;
		overflow-anchor: none;
		touch-action: pan-x;
	}

	.lightbox__slides::-webkit-scrollbar {
		display: none;
	}

	.lightbox__slide {
		position: relative;
		box-sizing: border-box;
		flex: 0 0 100%;
		min-width: 100%;
		height: 100%;
		padding: var(--lightbox-inset-top) var(--lightbox-inset-inline) var(--lightbox-inset-bottom);
		scroll-snap-align: center;
		scroll-snap-stop: always;
	}

	.lightbox__zoom {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		transform-origin: center center;
		touch-action: pan-x;
	}

	.lightbox__slide[data-active] .lightbox__zoom {
		will-change: transform;
	}

	.lightbox__media {
		display: block;
		min-width: 0;
		min-height: 0;
		width: auto;
		max-width: min(100%, 1600px);
		height: auto;
		max-height: 100%;
		object-fit: contain;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--bg-elevated, var(--background));
		cursor: zoom-in;
		-webkit-user-drag: none;
	}

	.lightbox__content[data-zoomed] .lightbox__media {
		cursor: grab;
	}

	.lightbox__content[data-zoomed] .lightbox__media:active {
		cursor: grabbing;
	}

	/* Everything that is not the shot steps back while it is pulled away, and
	   the parts a zoomed shot would run under step back while it is zoomed. */
	.lightbox__chrome {
		transition:
			opacity 200ms ease,
			visibility 0s linear 0s;
	}

	.lightbox:is([data-pulling], [data-pull-dismissing]) .lightbox__chrome,
	.lightbox__content[data-zoomed] :is(.lightbox__caption, .lightbox__step) {
		visibility: hidden;
		opacity: 0;
		transition:
			opacity 200ms ease,
			visibility 0s linear 200ms;
	}

	.lightbox__bar {
		position: absolute;
		top: calc(0.75rem + env(safe-area-inset-top, 0px));
		inset-inline: 0.75rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		pointer-events: none;
	}

	.lightbox__counter {
		padding-inline-start: 0.375rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		color: var(--muted-foreground);
	}

	.lightbox__controls {
		display: flex;
		gap: 0.5rem;
		pointer-events: auto;
	}

	.lightbox__control {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 9999px;
		/* Opaque enough to stay legible over any screenshot underneath. */
		background: color-mix(in oklch, var(--bg-elevated, black) 82%, transparent);
		backdrop-filter: blur(4px);
		color: var(--muted-foreground);
		cursor: pointer;
		touch-action: manipulation;
		transition:
			color 150ms ease,
			scale 150ms ease;
	}

	.lightbox__control:hover {
		color: var(--foreground);
	}

	.lightbox__control:active {
		scale: 0.96;
	}

	.lightbox__control:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	.lightbox__control[data-disabled] {
		color: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
		cursor: default;
		scale: 1;
	}

	.lightbox__step {
		position: absolute;
		top: 50%;
		translate: 0 -50%;
	}

	.lightbox__step--previous {
		inset-inline-start: 1.25rem;
	}

	.lightbox__step--next {
		inset-inline-end: 1.25rem;
	}

	/* A finger swipes; the step buttons are for a pointer. */
	@media (hover: none), (max-width: 767px) {
		.lightbox__step {
			display: none;
		}
	}

	.lightbox__caption {
		position: absolute;
		inset-inline: 0;
		bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
		display: -webkit-box;
		max-width: 72ch;
		margin: 0 auto;
		padding-inline: 1rem;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		font-size: 0.8125rem;
		line-height: 1.45;
		text-align: center;
		text-wrap: balance;
		color: var(--foreground);
		pointer-events: none;
	}

	.lightbox__caption:empty {
		display: none;
	}
</style>
