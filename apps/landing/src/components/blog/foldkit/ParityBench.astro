---
/**
 * ParityBench: the parity harness as a comparator bench. Geometry is generated by
 * scripts/figures/parity-bench.mjs; parity-bench.live.mjs moves it from the model.
 */
import "./iso/iso.css"
import "./parity-bench.css"
import { plateHtml } from "./iso/iso-kit.mjs"
import { BENCH_SVG } from "./parity-bench.data.mjs"

const html = plateHtml({
	fig: "Fig 1",
	title: "Parity bench",
	hint: "Click to skip to the next run",
	readout: "",
	keys: [],
	caption: "",
	body: `<div class="iso-stage pb-stage" tabindex="0" role="button" aria-label="Parity bench: press Enter to run the next comparison">${BENCH_SVG}</div>`,
})
---

<div class="iso pb-root" data-theme="dark">
	<Fragment set:html={html} />
</div>

<script>
	import { mountParityBench } from "./parity-bench.live.mjs"

	document.querySelectorAll<HTMLElement>(".pb-root").forEach((root) => {
		const stage = root.querySelector<HTMLElement>(".pb-stage")
		if (stage) mountParityBench(stage, root.querySelector("[data-readout]"))
	})
</script>
