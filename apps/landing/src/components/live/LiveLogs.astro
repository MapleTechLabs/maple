---
/**
 * The /logs page from the dashboard's own Foldkit components on example data: the severity
 * histogram (which draws its own frame) over the stream. Without the histogram the stream sits in
 * a `.live-frame` of its own.
 *
 * Each island keeps its own static import here, since Astro builds the hydration script from it.
 */
import { LiveLogsStream } from "./LiveLogsStream";
import { LiveLogsVolumeChart } from "./LiveLogsVolumeChart";

interface Props {
	/** Draw the histogram above the stream (the page's full layout). */
	volume?: boolean;
	/** The stream's height, or `fill` to take the rest of a sized parent. Rows past it scroll. */
	streamHeight?: string;
	class?: string;
}

const { volume = true, streamHeight = "22rem", class: className = "" } = Astro.props;
const fill = streamHeight === "fill";
---

{
	volume ? (
		<div class={`flex flex-col gap-3 ${fill ? "h-full" : ""} ${className}`}>
			<LiveLogsVolumeChart client:visible />
			<div class={`flex flex-col ${fill ? "min-h-0 flex-1" : ""}`} style={fill ? undefined : `height: ${streamHeight};`}>
				<LiveLogsStream client:visible />
			</div>
		</div>
	) : (
		<div class={`live-frame ${fill ? "live-logs--plate flex h-full flex-col overflow-hidden" : ""} ${className}`}>
			<div class="live-frame__head">
				<span>/logs</span>
				<span>production</span>
			</div>
			<div class={`flex flex-col p-3 ${fill ? "min-h-0 flex-1" : ""}`} style={fill ? undefined : `height: ${streamHeight};`}>
				<LiveLogsStream client:visible />
			</div>
		</div>
	)
}
