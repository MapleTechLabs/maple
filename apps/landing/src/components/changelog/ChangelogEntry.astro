---
/**
 * One changelog entry: the date sits in the timeline gutter beside a dot on
 * the rail, and the full note renders in the reading column. The timeline and
 * the permalink page share it, so an entry reads the same in both places.
 */
import { render } from "astro:content";
import type { Release } from "../../lib/changelog";
import { dayLabel } from "../../lib/changelog";
import { CATEGORY_LABELS, CONTRIBUTORS } from "../../lib/changelog-meta";
import { isoDate } from "../../lib/blog";

interface Props {
    release: Release;
    /** Permalink page: the title is the page's h1 and links nowhere. */
    standalone?: boolean;
    /** The newest entry gets the one amber dot on the rail. */
    latest?: boolean;
}

const { release, standalone = false, latest = false } = Astro.props;
const { title, description, date, category, authors, cover, coverAlt, breaking } = release.data;
const { Content } = await render(release);

const href = `/changelog/${release.id}`;
const permalink = Astro.site ? new URL(href, Astro.site).toString() : href;
const contributors = authors.map((id) => CONTRIBUTORS[id]);
const Heading = standalone ? "h1" : "h2";

const tag = "border px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em]";
---

<article
    id={release.id}
    class="changelog-entry relative scroll-mt-28 py-10 lg:grid lg:grid-cols-[var(--cl-gutter)_minmax(0,1fr)]"
>
    {/* ── Gutter: date + rail dot ── */}
    <div class="hidden lg:block" aria-hidden="true">
        <div class="sticky top-28 flex h-7 items-center justify-end pr-8">
            <span class="font-mono text-xs tabular-nums text-fg-muted">{dayLabel(date)}</span>
            <span
                class:list={[
                    "absolute right-0 flex h-3 w-3 translate-x-1/2 items-center justify-center rounded-full border bg-bg",
                    latest ? "border-primary/50" : "border-border",
                ]}
            >
                <span class:list={["h-1 w-1 rounded-full", latest ? "bg-primary" : "bg-fg-muted/50"]}></span>
            </span>
        </div>
    </div>

    {/* ── Reading column ── */}
    <div class="min-w-0 max-w-[680px] font-display lg:pl-12">
        <div class="flex h-7 flex-wrap items-center gap-2.5">
            <span class:list={[tag, "border-border text-foreground"]}>{CATEGORY_LABELS[category]}</span>
            {breaking && <span class:list={[tag, "border-primary/40 text-primary"]}>breaking</span>}
            <time
                datetime={isoDate(date)}
                class:list={["font-mono text-xs tabular-nums text-fg-muted", !standalone && "lg:sr-only"]}
            >
                {dayLabel(date)}, {date.getUTCFullYear()}
            </time>
        </div>

        <Heading
            class:list={[
                "mt-4 font-display font-semibold text-balance text-foreground",
                standalone
                    ? "text-[clamp(30px,5vw,44px)] leading-[1.05] tracking-[-0.03em]"
                    : "text-2xl leading-[1.15] tracking-[-0.02em] md:text-[28px]",
            ]}
        >
            {standalone ? title : (
                <a href={href} class="transition-colors hover:text-primary">{title}</a>
            )}
        </Heading>

        <p class="mt-3 text-[15px] leading-[1.7] text-pretty text-fg-muted">{description}</p>

        {cover && (
            <img
                src={cover}
                alt={coverAlt ?? ""}
                width="1280"
                height="660"
                loading={latest || standalone ? "eager" : "lazy"}
                decoding="async"
                data-zoomable
                class="mt-8 aspect-[1280/660] w-full rounded-xl border border-border bg-bg-deep object-cover"
            />
        )}

        <div class="docs-content docs-prose changelog-body mt-8">
            <Content />
        </div>

        <footer class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-4">
            {contributors.length > 0 ? (
                <div class="flex items-center gap-3">
                    <span class="flex">
                        {contributors.map((c) => (
                            <img
                                src={c.avatar}
                                alt=""
                                width="24"
                                height="24"
                                loading="lazy"
                                class="-ml-1.5 h-6 w-6 rounded-full ring-2 ring-bg first:ml-0"
                            />
                        ))}
                    </span>
                    <span class="text-[13px] text-fg-muted">
                        {contributors.map((c, i) => (
                            <>
                                {i > 0 && ", "}
                                <a
                                    href={`https://github.com/${c.github}`}
                                    rel="noopener"
                                    class="transition-colors hover:text-foreground"
                                >
                                    {c.name}
                                </a>
                            </>
                        ))}
                    </span>
                </div>
            ) : (
                <span></span>
            )}
            <span data-copy={permalink} class="changelog-copy">
                <button
                    type="button"
                    class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-muted transition-colors hover:text-foreground [&.is-done]:text-primary"
                >
                    copy link
                </button>
            </span>
        </footer>
    </div>
</article>

<script>
    import { bindCopyButtons } from "../../lib/copy-to-clipboard";
    bindCopyButtons({
        hostSelector: ".changelog-copy[data-copy]",
        buttonSelector: "button",
        track: { event: "changelog_link_copied", key: "url" },
    });
</script>

<style is:global>
    /* Trim the prose's outer margins so the footer rule sits evenly. */
    .changelog-body > :first-child {
        margin-top: 0;
    }
    .changelog-body > :last-child {
        margin-bottom: 0;
    }
</style>
