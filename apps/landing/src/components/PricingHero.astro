---
/**
 * The pricing page's hero.
 *
 * Uses the shared palette and type in a compact pricing introduction, with three things the generic
 * hero can't: the claims a buyer scans for before anything else ("no per-seat",
 * "no per-host", "no per-series"), a second CTA that jumps straight to the
 * estimator, and the rate card — every signal's rate and retention on one
 * line, above the fold, before the offer card asks for a decision.
 *
 * Every number comes from `getOffer()`; nothing here is typed by hand.
 */
import { buttonVariants } from "@maple/views/ui/button.styles";
import * as m from "../paraglide/messages.js";
import HeroCta from "./HeroCta.astro";
import PixelIcon from "./icons/PixelIcon.astro";
import RegionChip from "./RegionChip.astro";
import ProductFrame from "./marketing/ProductFrame.astro";
import {
	getOffer,
	money,
	otherAllotments,
	rateBlock,
	rateLabel,
	telemetryGroups,
	volume,
} from "../lib/pricing-offer";

const offer = await getOffer();

// The hero quotes one included volume and one per-GB rate; the three GB
// signals share both, so any of them is the source. Fall back to the first
// allotment so a config drift renders a number rather than "undefined".
const gbSignal = offer.allotments.find((a) => a.unit === "gb") ?? offer.allotments[0];
const includedGB = gbSignal?.included ?? 0;
const gbRate = gbSignal?.rate ?? 0;

// The strip's cells follow the offer table's grouping: logs and traces share one, metrics has
// its own, then each other meter. A cell is a name, the price with its unit, and one or two
// plain lines: what is included, and for telemetry how long it is kept free.
interface RateCell {
	key: string
	label: string
	price: string
	unit: string
	lines: ReadonlyArray<string>
}

const rateCells: ReadonlyArray<RateCell> = [
	...telemetryGroups(offer).map((g) => ({
		key: g.key,
		label: g.label,
		price: g.ingestion === undefined ? "" : rateLabel(g.ingestion),
		unit: "/ GB",
		lines: [
			g.size > 1 ? m.pricing_includes_each({ amount: g.included }) : m.pricing_rate_included({ amount: g.included }),
			...(g.retention === undefined
				? []
				: [m.pricing_kept_free_then({ days: String(g.days), rate: rateLabel(g.retention) })]),
		],
	})),
	...otherAllotments(offer).map((a) => ({
		key: a.featureId,
		label: a.label,
		price: a.unlimited ? m.pricing_unlimited() : a.rate === undefined ? "" : rateLabel(a.rate),
		unit: a.unlimited ? "" : a.unit === "sessions" ? "/ session" : `/ ${rateBlock(a)} events`,
		lines: [a.unlimited ? m.pricing_free_beta() : m.pricing_rate_included({ amount: volume(a, a.included) })],
	})),
];

const claims = [m.pricing_no_seat(), m.pricing_no_host(), m.pricing_no_series()];
---

<section class="pricing-hero relative overflow-hidden">
	<div class="pricing-hero__inner shell">
		{/* Inside the shell so the artwork tracks the content column on wide screens
		    instead of drifting to the viewport edge. */}
		<img class="pricing-hero__illustration" src="/art/maple-pricing-trade-route.webp" width="1536" height="1024" alt="Engraving of a merchant road winding past fields toward a Roman aqueduct" decoding="async" />
		{/* Copy beside the product from lg. Under lg the rates follow the buttons: the price comes first here. */}
		<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-center lg:gap-14">
		<div class="min-w-0">
		<div class="mb-4">
			<span
				class="pricing-hero__label"
			>
				{m.page_pricing_label()}
			</span>
		</div>

		<h1
			class="max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-fg sm:text-4xl md:text-5xl"
		>
			{m.pricing_hero_title().replace("usage-based", "usage‑based")}
		</h1>

		<p class="pricing-hero__lede">
			{
				m.pricing_hero_lede({
					price: money(offer.price),
					included: String(includedGB),
					rate: rateLabel(gbRate),
					storage: rateLabel(gbSignal?.retention?.rate ?? gbRate),
				})
			}
		</p>

		{/* The three claims a buyer scans for. Plain rows, one check each. */}
		<ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-fg">
			{
				claims.map((claim) => (
					<li class="inline-flex items-center gap-2">
						<svg
							class="h-3.5 w-3.5 shrink-0 text-primary"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="square"
						>
							<path d="M20 6L9 17l-5-5" />
						</svg>
						{claim}
					</li>
				))
			}
			{/* Residency is the fourth thing EU buyers scan for; /eu is English-only, so a bare href. */}
			<li>
				<a href="/eu" class="group inline-flex items-center gap-2">
					<PixelIcon name="earth" class="h-3.5 w-3.5 shrink-0 text-primary" />
					{/* Underline the text only: a decoration on the link would run under the chips too. */}
					<span class="underline decoration-border underline-offset-4 transition-colors group-hover:decoration-primary">
						{m.pricing_region_claim()}
					</span>
					<span class="inline-flex gap-1">
						<RegionChip region="us" />
						<RegionChip region="eu" />
					</span>
				</a>
			</li>
		</ul>

		<div class="mt-8 flex flex-wrap items-center gap-3">
			<HeroCta class={buttonVariants({ size: "lg" })} />
			<a href="#calculator" class={buttonVariants({ variant: "outline", size: "lg" })}>
				{m.pricing_hero_estimate()}
			</a>
		</div>
		</div>
		{/* The overview's totals row: the three volumes the rate card meters. */}
		<ProductFrame surface="usage" label={m.pricing_hero_shot()} loading="eager" class="pricing-hero__product hidden lg:block" />
		</div>

		{/* The rate card. One cell per metered signal: label, rate, then what's
		    included. This is the whole price list; the offer card below repeats
		    it only to attach the plan and the button. */}
		<div class="pricing-rates">
			<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">
				{m.pricing_rates_eyebrow()}
			</p>
			<div
				class="pricing-rates__grid"
			>
				{
					rateCells.map((c) => (
						<div class="pricing-rates__cell">
							<div class="text-[12.5px] text-fg">{c.label}</div>
							<div class="pricing-rates__amount">
								<span class="font-mono text-2xl tabular-nums tracking-[-0.02em] text-fg">{c.price}</span>
								<span class="font-mono text-[11px] text-fg-muted">{c.unit}</span>
							</div>
							<div class="mt-3 space-y-1 text-[12px] leading-relaxed text-fg-muted">
								{c.lines.map((line) => (
									<p>{line}</p>
								))}
							</div>
						</div>
					))
				}
			</div>
			<p class="mt-4 max-w-[80ch] text-[12px] leading-relaxed text-fg-muted">
				{m.pricing_rates_retention()}
			</p>
		</div>
	</div>
</section>

<style>
	/* The pricing page's panels are sharp; the capture's frame follows them. */
	:global(.pricing-hero__product .live-frame) {
		border-radius: 0;
	}
</style>
