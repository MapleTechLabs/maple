---
/**
 * The trace explorer artifact: the dashboard's Foldkit trace flow and flamegraph on a fixture
 * trace. The server renders its frame, tabs and flow pane at full size; `client:visible` starts
 * it once the section scrolls into view.
 *
 * A thin Astro wrapper rather than the island straight in the artifact map: Astro generates the
 * hydration script from the *static import* at the call site, so a component pulled out of a
 * `Record` can't take a `client:*` directive.
 */
import { TraceVisualization } from "../../TraceVisualization";
---

<TraceVisualization client:visible />
