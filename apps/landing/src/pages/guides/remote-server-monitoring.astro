---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { highlight } from "../../lib/guide-highlight";
import LanguageTabs from "../../components/docs/LanguageTabs.astro";
import LanguageTab from "../../components/docs/LanguageTab.astro";

const pageTitle = "Remote server monitoring: agents, checks, alerts | Maple";
const pageDescription =
    "Remote server monitoring with OpenTelemetry: agent vs agentless collection, the ports each needs, what to watch, and alerts for servers that go quiet.";
const published = "2026-10-19";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "definition", text: "Definition" },
    { depth: 2, slug: "methods", text: "Agent vs agentless" },
    { depth: 3, slug: "agent", text: "Agent: the server pushes" },
    { depth: 3, slug: "agentless", text: "Agentless: a poller pulls" },
    { depth: 3, slug: "tools", text: "Tools" },
    { depth: 3, slug: "security", text: "Security" },
    { depth: 2, slug: "signals", text: "Signals to watch" },
    { depth: 3, slug: "ssh", text: "Checks over SSH" },
    { depth: 2, slug: "setup", text: "Collector setup" },
    { depth: 3, slug: "agent-config", text: "Agent config" },
    { depth: 3, slug: "checker", text: "Checks from outside" },
    { depth: 3, slug: "fleet", text: "Many servers" },
    { depth: 2, slug: "maple", text: "Hosts in Maple" },
    { depth: 2, slug: "alerts", text: "Alerts" },
    { depth: 3, slug: "heartbeat", text: "Heartbeat per server" },
    { depth: 3, slug: "fleet-heartbeat", text: "One rule for the fleet" },
    { depth: 3, slug: "thresholds", text: "Disk, memory, CPU" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per way of collecting, reused by the diagram, badges, tables and configs.
const kinds = {
    agent: { label: "Agent", color: "var(--chart-3)" },
    poller: { label: "Poller", color: "var(--chart-2)" },
    probe: { label: "Outside check", color: "var(--chart-5)" },
} as const;
type Kind = keyof typeof kinds;

const silence: { cause: string; agent: string; probe: string }[] = [
    { cause: "The server crashed or hung", agent: "Stops", probe: "Fails" },
    { cause: "The agent stopped, the server is fine", agent: "Stops", probe: "Passes" },
    { cause: "The web server died, the host is fine", agent: "Keeps arriving", probe: "Fails" },
];

const methods: { method: string; kind: Kind; opens: string; port: string; fits: string }[] = [
    { method: "OpenTelemetry Collector, or another agent", kind: "agent", opens: "The server, outbound", port: "Nothing", fits: "Linux and Windows servers you run" },
    { method: "SSH polling", kind: "poller", opens: "The poller", port: "22, plus an account", fits: "A few servers, one-off checks" },
    { method: "SNMP", kind: "poller", opens: "The poller", port: "UDP 161", fits: "Switches, firewalls, UPS units" },
    { method: "WMI or WinRM", kind: "poller", opens: "The poller", port: "135 and dynamic RPC, or 5985/5986", fits: "Windows servers in a domain" },
    { method: "Prometheus scrape of node_exporter", kind: "poller", opens: "The scraper", port: "9100", fits: "Fleets already on Prometheus" },
    { method: "HTTP or ping check", kind: "probe", opens: "A checker", port: "The service's own port", fits: "Reachability, TLS certificates" },
];

const signals: { signal: string; kind: Kind; metric: string; alert: string }[] = [
    { signal: "Heartbeat", kind: "agent", metric: "system.memory.utilization", alert: "No new points from the host for 5 minutes" },
    { signal: "Reachability", kind: "probe", metric: "httpcheck.status", alert: "No 2xx for 2 minutes" },
    { signal: "CPU", kind: "agent", metric: "system.cpu.utilization, system.cpu.load_average.15m", alert: "Above 90% for 15 minutes, or load above the core count" },
    { signal: "Memory", kind: "agent", metric: "system.memory.utilization", alert: "Above 90% used, or OOM kills in the logs" },
    { signal: "Disk space", kind: "agent", metric: "system.filesystem.utilization", alert: "Any writable mount above 90%" },
    { signal: "Network", kind: "agent", metric: "system.network.errors, system.network.dropped", alert: "Errors or drops climbing" },
    { signal: "Processes", kind: "agent", metric: "system.processes.count", alert: "Blocked processes piling up" },
    { signal: "Logs", kind: "agent", metric: "file_log", alert: "Disk I/O errors, OOM kills, SSH auth failures" },
    { signal: "Certificate", kind: "probe", metric: "httpcheck.tls.cert_remaining", alert: "Fewer than 14 days left" },
];

const sshTabs: { id: string; label: string; code: string; read: string }[] = [
    {
        id: "cpu",
        label: "CPU",
        code: `uptime              # load average over 1, 5 and 15 minutes
top -o %CPU         # live, busiest process first (htop if installed)
vmstat 5 5          # five samples, 5 seconds apart`,
        read: "Load above the number of cores means work is queueing. In <code>vmstat</code>, a high <code>r</code> column is the same queue, and a high <code>wa</code> means the CPU is waiting on disk rather than busy.",
    },
    {
        id: "memory",
        label: "Memory",
        code: `free -h                           # used, available, swap
ps aux --sort=-%mem | head -5     # the biggest processes
vmstat 5 5                        # si and so: swapping in and out`,
        read: "Read <code>available</code>, not <code>free</code>: the kernel fills spare memory with cache and hands it back on demand. Non-zero <code>si</code> and <code>so</code> in <code>vmstat</code> mean the server is swapping.",
    },
    {
        id: "disk",
        label: "Disk",
        code: `df -h                                        # space per mount
df -i                                        # inodes per mount
du -xh /var --max-depth=1 | sort -h | tail   # what filled /var
iostat -xz 5 3                               # per-device load (sysstat package)`,
        read: "A device near 100 in <code>%util</code> with rising <code>r_await</code> or <code>w_await</code> is saturated. <code>iostat</code> comes with the <code>sysstat</code> package.",
    },
    {
        id: "network",
        label: "Network",
        code: `ss -tulpn          # listening ports and the process behind each
ss -s              # connection counts by state
ip -s link         # bytes, errors and drops per interface`,
        read: "Thousands of connections in <code>timewait</code> point at a client opening a new connection per request. Errors or drops that keep rising in <code>ip -s link</code> point at the link or the driver.",
    },
    {
        id: "logs",
        label: "Logs",
        code: `journalctl -p err -b                      # errors since the last boot
journalctl -k -p err --since today        # kernel errors: disks, OOM kills
journalctl -u nginx --since "1 hour ago"  # one service`,
        read: "Most distributions log through the journal. On systems with <code>rsyslog</code>, the same lines are in <code>/var/log/syslog</code> or <code>/var/log/messages</code>.",
    },
];

const sshLoop = `for h in web-01 web-02 db-01; do
  ssh "$h" 'echo "== $(hostname)"; uptime; df -h / | tail -1'
done`;

const installCommands = `# Debian and Ubuntu
curl -LO https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v0.163.1/otelcol-contrib_0.163.1_linux_amd64.deb
sudo dpkg -i otelcol-contrib_0.163.1_linux_amd64.deb

# RHEL, Rocky, Alma, Fedora
curl -LO https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v0.163.1/otelcol-contrib_0.163.1_linux_amd64.rpm
sudo rpm -ivh otelcol-contrib_0.163.1_linux_amd64.rpm`;

const agentConfig = `receivers:
    host_metrics:
        collection_interval: 30s
        scrapers:
            cpu:
                metrics:
                    system.cpu.utilization:
                        enabled: true
            load: {}
            memory:
                metrics:
                    system.memory.utilization:
                        enabled: true
            filesystem:
                metrics:
                    system.filesystem.utilization:
                        enabled: true
            network: {}
            processes: {}
    file_log:
        include:
            - /var/log/syslog
            - /var/log/auth.log
        start_at: end

processors:
    resource_detection:
        detectors: [env, system]
    resource/logs:
        attributes:
            - key: service.name
              value: system-logs
              action: upsert
    batch: {}

exporters:
    otlp_http/maple:
        endpoint: https://ingest.maple.dev
        compression: gzip
        headers:
            x-maple-ingest-key: \${env:MAPLE_INGEST_KEY}

service:
    pipelines:
        metrics:
            receivers: [host_metrics]
            processors: [resource_detection, batch]
            exporters: [otlp_http/maple]
        logs:
            receivers: [file_log]
            processors: [resource_detection, resource/logs, batch]
            exporters: [otlp_http/maple]`;

const envFile = `OTELCOL_OPTIONS="--config=/etc/otelcol-contrib/config.yaml"
MAPLE_INGEST_KEY=maple_sk_...
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production`;

const serviceCommands = `sudo chmod 600 /etc/otelcol-contrib/otelcol-contrib.conf
sudo usermod -aG adm otelcol-contrib     # read access to /var/log
sudo systemctl enable otelcol-contrib
sudo systemctl restart otelcol-contrib
journalctl -u otelcol-contrib -f`;

const checkerConfig = `receivers:
    http_check:
        collection_interval: 60s
        metrics:
            httpcheck.tls.cert_remaining:
                enabled: true
        targets:
            - method: GET
              endpoints:
                  - https://web-01.example.com/health
                  - https://web-02.example.com/health
    ssh_check/db-01:
        endpoint: db-01.example.com:22
        username: monitor
        key_file: /etc/otelcol-contrib/monitor_ed25519
        known_hosts: /etc/otelcol-contrib/known_hosts
        collection_interval: 60s
        resource_attributes:
            ssh.endpoint:
                enabled: true

processors:
    resource/checks:
        attributes:
            - key: service.name
              value: uptime-checks
              action: upsert
    batch: {}

exporters:
    otlp_http/maple:
        endpoint: https://ingest.maple.dev
        compression: gzip
        headers:
            x-maple-ingest-key: \${env:MAPLE_INGEST_KEY}

service:
    pipelines:
        metrics/checks:
            receivers: [http_check, ssh_check/db-01]
            processors: [resource/checks, batch]
            exporters: [otlp_http/maple]`;

const knownHosts = `ssh-keyscan db-01.example.com | sudo tee /etc/otelcol-contrib/known_hosts`;

const envTemplate = `OTELCOL_OPTIONS="--config=/etc/otelcol-contrib/config.yaml"
MAPLE_INGEST_KEY={{ maple_ingest_key }}
OTEL_RESOURCE_ATTRIBUTES=host.name={{ inventory_hostname }},deployment.environment.name={{ env_name }}`;

const heartbeatSql = `SELECT $__timeGroup(TimeUnix) AS bucket, count() AS value
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.memory.utilization'
  AND ResourceAttributes['host.name'] = 'web-01'
GROUP BY bucket`;

const fleetSql = `SELECT $__timeGroup(TimeUnix) AS bucket,
       uniqExact(ResourceAttributes['host.name']) AS value
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.memory.utilization'
GROUP BY bucket`;

const thresholdRules: { id: string; label: string; sql: string; settings: string }[] = [
    {
        id: "rule-disk",
        label: "Disk",
        sql: `SELECT $__timeGroup(TimeUnix) AS bucket,
       ResourceAttributes['host.name'] AS group,
       max(Value) AS value
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.filesystem.utilization'
  AND Attributes['mode'] = 'rw'
GROUP BY bucket, group`,
        settings: "<strong>Window</strong> 5 min, <strong>Alert when the value</strong> is above, <strong>Threshold</strong> <code>0.9</code>. The fullest writable mount on each host. <code>mode = 'rw'</code> drops read-only mounts such as snap images, which always read 100%.",
    },
    {
        id: "rule-memory",
        label: "Memory",
        sql: `SELECT $__timeGroup(TimeUnix) AS bucket,
       ResourceAttributes['host.name'] AS group,
       max(Value) AS value
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.memory.utilization'
  AND Attributes['state'] = 'used'
GROUP BY bucket, group`,
        settings: "<strong>Window</strong> 5 min, <strong>Alert when the value</strong> is above, <strong>Threshold</strong> <code>0.9</code>. The metric has one point per state (used, free, cached, buffered and slab), so filter to <code>used</code>.",
    },
    {
        id: "rule-cpu",
        label: "CPU",
        sql: `SELECT $__timeGroup(TimeUnix) AS bucket,
       ResourceAttributes['host.name'] AS group,
       1 - avg(Value) AS value
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.cpu.utilization'
  AND Attributes['state'] = 'idle'
GROUP BY bucket, group`,
        settings: "<strong>Window</strong> 15 min, <strong>Alert when the value</strong> is above, <strong>Threshold</strong> <code>0.9</code>. Busy time is one minus idle time. The longer window keeps short spikes, such as a nightly backup, from paging.",
    },
];

const faqs = [
    {
        question: "What is remote server monitoring?",
        answer:
            "Remote server monitoring is collecting health data from servers you cannot physically reach, such as cloud VMs, machines in a colocation rack or a server in a branch office, and alerting when something goes wrong. It covers availability, CPU, memory, disk, network, processes and logs, collected by an agent on each server or by a central system that polls or probes them.",
    },
    {
        question: "What is the difference between agent-based and agentless monitoring?",
        answer:
            "An agent is a program on each server that reads local metrics and logs and sends them out over an outbound connection. Agentless monitoring has a central poller connect in over SSH, SNMP, WMI or a Prometheus scrape, or probe the server from outside with HTTP or ping. Agents see more, including logs and per-mount disk usage, and need no inbound port. Agentless methods suit devices that cannot run an agent, but every target needs an open port and the poller needs credentials for each one.",
    },
    {
        question: "How can I monitor a remote Linux server for free?",
        answer:
            "Install the OpenTelemetry Collector Contrib, which is open source under the Apache 2.0 license, as a systemd service with the host_metrics and file_log receivers, and send the data to any OTLP backend. Prometheus with node_exporter and Grafana is a self-hosted alternative. For a one-off look, SSH in and run uptime, vmstat, free -h, df -h and journalctl.",
    },
    {
        question: "How do I get alerted when a remote server goes down?",
        answer:
            "Use two alerts. A heartbeat alert fires when the server's agent has sent nothing for a few minutes, which catches a crashed host, a broken network path and a stopped agent. An HTTP check from another machine fires when the service on the server stops answering. Run the check outside the server it watches, or it goes down with it.",
    },
    {
        question: "Which remote server monitoring tools are there?",
        answer:
            "Agents include the OpenTelemetry Collector, Prometheus node_exporter, and the agents of Zabbix, Datadog and New Relic. Agentless tools poll over SNMP, SSH or WMI, as Zabbix, Nagios-based systems and PRTG can. Uptime services probe from outside. Many teams combine an agent on every server with an outside check.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Remote server monitoring with OpenTelemetry",
    description: pageDescription,
    datePublished: published,
    dateModified: "2026-10-20",
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/remote-server-monitoring`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Remote server monitoring" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Infrastructure</span>
                    <span>10 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Remote server monitoring with OpenTelemetry
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    Collect metrics and logs from servers you can't walk up to, and get alerted when one goes quiet.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt="" width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime="2026-10-20">Updated {updatedLabel}</time>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {sectionNav.map((h) => (
                    <a href={`#${h.slug}`} class="transition-colors hover:text-primary">{h.text}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={toc} class="sticky top-28" />
            </aside>

            <article class="rsm-guide min-w-0">
                <section id="definition" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Definition</p>
                    <h2>Remote server monitoring, defined</h2>

                    <p>
                        A server under your desk tells you it is struggling: the fan spins up and the shell lags. A VM in another region tells you nothing, so you learn it died from a customer asking why the site is down. <strong>Remote server monitoring</strong> is software that collects health numbers and logs from servers you can't physically reach, such as a cloud VM or a machine in a branch office, and alerts you when a number crosses a limit or stops arriving. Without it, a full disk or a crashed VM stays broken until someone outside notices, and your users see every minute of that downtime first. This guide compares agent and agentless collection and the tools for each, lists the signals worth watching, sets up the OpenTelemetry Collector on each server, and ends with alerts that fire when a server goes quiet.
                    </p>

                    <div class="guide-callout guide-takeaways">
                        <p class="guide-kicker">Key takeaways</p>
                        <ul>
                            <li>An agent pushes data out over HTTPS on port 443 and needs no inbound port. A poller needs SSH, SNMP, WinRM or port 9100 open to it.</li>
                            <li>Run an agent on servers you own, add an outside HTTP check for what users reach, and poll only devices that can't run an agent.</li>
                            <li>A dead server sends nothing, so one alert has to treat missing data as a breach.</li>
                            <li>Full disks take servers down while CPU and memory look normal: alert on every writable mount above 90%.</li>
                        </ul>
                    </div>
                    <p>
                        Distance adds one problem a local machine doesn't have: silence. When a remote server stops reporting, you can't see why from your desk. Two signals from different places tell the common causes apart:
                    </p>

                    <div class="guide-table">
                        <table class="silence">
                            <thead>
                                <tr>
                                    <th>What happened</th>
                                    <th><span class="kind-badge" style={`--kind: ${kinds.agent.color}`}>Agent data</span></th>
                                    <th><span class="kind-badge" style={`--kind: ${kinds.probe.color}`}>Outside check</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {silence.map((row) => (
                                    <tr>
                                        <td class="guide-table__key">{row.cause}</td>
                                        <td data-result={row.agent === "Stops" ? "bad" : "ok"}>{row.agent}</td>
                                        <td data-result={row.probe === "Fails" ? "bad" : "ok"}>{row.probe}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p>
                        The agent reports what the server sees from the inside. The outside check reports what a client sees.
                    </p>
                </section>

                <section id="methods" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · Collection</p>
                    <h2>Agent-based vs agentless remote server monitoring</h2>
                    <p>
                        The two approaches differ in who opens the network connection, and that decides which ports have to be open on the server.
                    </p>

                    <figure class="flow" aria-label="Three ways to collect from a remote server. Agent: the server opens an outbound HTTPS connection on port 443 to Maple ingest and needs no inbound port. Poller: a central poller connects in to the server on port 22, 161, 5985 or 9100, which must be open to it. Outside check: a checker on another network sends GET /health to the server's public port 443 every 60 seconds and records status, latency and the certificate.">
                        <svg viewBox="0 0 760 330" aria-hidden="true">
                            <defs>
                                {(["agent", "poller", "probe"] as const).map((k) => (
                                    <marker id={`flow-${k}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                        <path d="M0,0 L8,4 L0,8 z" style={`fill: ${kinds[k].color}`} />
                                    </marker>
                                ))}
                            </defs>

                            <line x1="380" y1="20" x2="380" y2="326" class="flow__edge" />
                            <text x="386" y="14" class="flow__mono">firewall / NAT</text>
                            <text x="0" y="14" class="flow__mono">your side</text>
                            <text x="760" y="14" text-anchor="end" class="flow__mono">remote site</text>

                            <text x="0" y="36" class="flow__kind" style={`fill: ${kinds.agent.color}`}>AGENT · PUSH</text>
                            <rect x="0" y="44" width="170" height="60" rx="8" class="flow__box" />
                            <text x="85" y="70" text-anchor="middle" class="flow__title">Maple ingest</text>
                            <text x="85" y="90" text-anchor="middle" class="flow__mono">ingest.maple.dev</text>
                            <rect x="590" y="44" width="170" height="60" rx="8" class="flow__box" style={`stroke: ${kinds.agent.color}`} />
                            <text x="675" y="70" text-anchor="middle" class="flow__title">Server</text>
                            <text x="675" y="90" text-anchor="middle" class="flow__mono">Collector agent</text>
                            <line x1="584" y1="74" x2="176" y2="74" marker-end="url(#flow-agent)" class="flow__line" style={`stroke: ${kinds.agent.color}`} />
                            <text x="278" y="66" text-anchor="middle" class="flow__mono" style={`fill: ${kinds.agent.color}`}>HTTPS to port 443</text>
                            <text x="482" y="66" text-anchor="middle" class="flow__mono">opened by the server</text>
                            <text x="675" y="120" text-anchor="middle" class="flow__mono" style={`fill: ${kinds.agent.color}`}>inbound: none</text>

                            <text x="0" y="146" class="flow__kind" style={`fill: ${kinds.poller.color}`}>POLLER · PULL</text>
