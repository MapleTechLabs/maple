{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		// The template compile writes checked-in modules under src/generated/
		// rather than a dist/ directory, so the root task's outputs don't apply.
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["templates/**", "scripts/build.ts", "scripts/inline-tailwind.ts", "package.json"],
			"outputs": ["src/generated/**"]
		}
	}
}
