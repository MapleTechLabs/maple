logger.info("Payment captured")`;

const serializeOutput = String.raw`{"text": "2026-10-22 20:40:30.469 | INFO     | __main__:<module>:6 - Payment captured\n",
 "record": {"elapsed": {...}, "exception": null, "extra": {}, "file": {...},
            "function": "<module>", "level": {"icon": "ℹ️", "name": "INFO", "no": 20},
            "line": 6, "message": "Payment captured", "module": "app", "name": "__main__",
            "process": {...}, "thread": {...}, "time": {...}}}`;

const contextCode = String.raw`import sys
from loguru import logger

logger.remove()
logger.add(sys.stderr, format="{level: <7} | {message} | {extra}")

log = logger.bind(user="ada")
log.info("Signed in")


def charge_card():
    logger.info("Charging card")


with logger.contextualize(request_id="req_9f2c"):
    logger.info("Request started")
    charge_card()

logger.info("Request finished")`;

const contextOutput = String.raw`INFO    | Signed in | {'user': 'ada'}
INFO    | Request started | {'request_id': 'req_9f2c'}
INFO    | Charging card | {'request_id': 'req_9f2c'}
INFO    | Request finished | {}`;

const catchCode = String.raw`from loguru import logger


@logger.catch
def main():
    order = {"id": "ord_123", "total": 40, "quantity": 0}
    print(order["total"] / order["quantity"])


main()`;

const catchOutput = String.raw`2026-10-22 18:38:39.486 | ERROR    | __main__:<module>:10 - An error has been caught in function '<module>', process 'MainProcess' (14), thread 'MainThread' (281473511032000):
Traceback (most recent call last):

> File "/srv/app/main.py", line 10, in <module>
    main()
    └ <function main at 0xffffa7f73110>

  File "/srv/app/main.py", line 7, in main
    print(order["total"] / order["quantity"])
          │                └ {'id': 'ord_123', 'total': 40, 'quantity': 0}
          └ {'id': 'ord_123', 'total': 40, 'quantity': 0}

ZeroDivisionError: division by zero`;

const interceptCode = String.raw`# intercept.py
import inspect
import logging

from loguru import logger


class InterceptHandler(logging.Handler):
    def emit(self, record: logging.LogRecord) -> None:
        try:
            level = logger.level(record.levelname).name
        except ValueError:
            level = record.levelno

        # Report the line that called logging, not a line inside the logging module.
        frame, depth = inspect.currentframe(), 0
        while frame is not None and (depth == 0 or frame.f_code.co_filename == logging.__file__):
            frame = frame.f_back
            depth += 1

        logger.opt(depth=depth, exception=record.exc_info).log(level, record.getMessage())


logging.basicConfig(handlers=[InterceptHandler()], level=0, force=True)`;

const interceptUsageCode = String.raw`# main.py
import logging

import intercept  # noqa: F401
from loguru import logger

logger.info("From Loguru")
logging.getLogger("payments.client").warning("Retrying %s", "ord_123")`;

const interceptUsageOutput = String.raw`2026-10-22 20:42:11.692 | INFO     | __main__:<module>:7 - From Loguru
2026-10-22 20:42:11.692 | WARNING  | __main__:<module>:8 - Retrying ord_123`;

const otelInstall = String.raw`pip install loguru \
    opentelemetry-sdk \
    opentelemetry-exporter-otlp-proto-http \
    opentelemetry-instrumentation-logging`;

const bridgeCode = String.raw`# telemetry.py, after the logger_provider setup
from loguru import logger
from opentelemetry.instrumentation.logging.handler import LoggingHandler

otel_logger = logging.getLogger("loguru.otel")
otel_logger.setLevel(logging.DEBUG)
otel_logger.propagate = False  # keep these records away from the root logger
otel_logger.addHandler(LoggingHandler(logger_provider=logger_provider, log_code_attributes=True))


def otel_sink(message):
    record = message.record
    log_record = otel_logger.makeRecord(
        record["name"],
        record["level"].no,
        record["file"].path,
        record["line"],
        record["message"],
        (),
        record["exception"],
        func=record["function"],
        extra=record["extra"],
    )
    log_record.levelname = record["level"].name
    otel_logger.handle(log_record)


logger.add(
    otel_sink,
    level="INFO",
    # Skip the SDK's own logs: a failed export would otherwise log itself again.
    filter=lambda record: not record["name"].startswith("opentelemetry"),
)`;

const requestCode = String.raw`# checkout.py
import intercept  # noqa: F401
import telemetry  # noqa: F401
from loguru import logger
from opentelemetry import trace

tracer = trace.get_tracer("checkout")

with tracer.start_as_current_span("POST /checkout"):
    logger.bind(order_id="ord_123").info("Charging card")`;

const comparison = [
    ["First log line", "<code>from loguru import logger</code>", "<code>basicConfig()</code>, then <code>getLogger(__name__)</code>"],
    ["Rotating log files", "<code>rotation</code> and <code>retention</code> on <code>add()</code>", "<code>RotatingFileHandler</code>"],
    ["JSON output", "<code>serialize=True</code>", "A custom <code>Formatter</code> or a third-party package"],
    ["Context fields", "<code>bind()</code>, <code>contextualize()</code>", "<code>extra=</code> on each call, or a <code>LoggerAdapter</code>"],
    ["Used by libraries", "Rarely", "Nearly all of them"],
];

const faqs = [
    {
        question: "What is Loguru in Python?",
        answer:
            "Loguru is a logging library for Python that works as soon as you import it. You call from loguru import logger and start logging, and it prints readable, colored lines to your terminal. Files, JSON output and other destinations are added with logger.add().",
    },
    {
        question: "Is Loguru free?",
        answer: "Yes. Loguru is open source under the MIT license and installs from PyPI with pip install loguru.",
    },
    {
        question: "How do I set the log level in Loguru?",
        answer:
            "Remove the default sink and add it back with a level: logger.remove(), then logger.add(sys.stderr, level=\"INFO\"). To change it without editing code, set the environment variable LOGURU_LEVEL=INFO before starting the app.",
    },
    {
        question: "What are the Loguru levels?",
        answer:
            "TRACE (5), DEBUG (10), INFO (20), SUCCESS (25), WARNING (30), ERROR (40) and CRITICAL (50). They match the standard logging module's numbers, plus TRACE and SUCCESS. logger.level(\"NAME\", no=35) adds your own.",
    },
    {
        question: "Should I use Loguru or the standard logging module?",
        answer:
            "Loguru takes less setup in an application: files, JSON and context are one argument each. Libraries should log with the standard logging module so the application decides where the lines go. An application on Loguru can forward those library logs with an InterceptHandler.",
    },
    {
        question: "How do I send Loguru logs to OpenTelemetry?",
        answer:
            "The OpenTelemetry Python SDK collects logs from the standard logging module. Add a Loguru sink that turns each line into a logging record and hands it to a logger with OpenTelemetry's LoggingHandler attached. Lines logged during a request then carry its trace ID.",
    },
    {
        question: "Why do I get ModuleNotFoundError: No module named 'loguru'?",
        answer:
            "Loguru is installed for a different Python than the one running your code, usually another virtual environment. Install it with the same interpreter that runs the app: python -m pip install loguru.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Loguru for Python",
    description: pageDescription,
    datePublished: published,
    dateModified: "2026-10-22",
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/loguru`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Loguru for Python" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Logging</span>
                    <span>7 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Loguru for Python
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    Start logging with Loguru in two lines, then send its logs to OpenTelemetry so each line links to the request that wrote it.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt="" width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime="2026-10-22">Updated {updatedLabel}</time>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {sectionNav.map((h) => (
                    <a href={`#${h.slug}`} class="transition-colors hover:text-primary">{h.text}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={toc} class="sticky top-28" />
            </aside>

            <article class="loguru-guide min-w-0">
                <section id="get-started" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Basics</p>
                    <h2>Get started with Loguru</h2>

                    <div class="guide-answer">
                        <p><strong>Loguru</strong> is a Python logging library that works the moment you import it. There is one ready-made <code>logger</code>, nothing to configure, and the output is easy to read from the first line.</p>
                    </div>

                    <p>
                        With the standard <code>logging</code> module, you set up a handler and a format before your logs look useful. Loguru skips that step. When you want more, such as a log file that rotates or JSON output, you add it with one call to <code>logger.add()</code>. Loguru is free and open source under the MIT license.
                    </p>

                    <h3 id="install" class="scroll-mt-24">pip install loguru</h3>
                    <pre><code>{installCommand}</code></pre>
                    <p>In a uv project, run <code>uv add loguru</code> instead.</p>

                    <h3 id="first-line" class="scroll-mt-24">from loguru import logger</h3>
                    <p>Import <code>logger</code> and start logging. Loguru prints colored lines to your terminal out of the box:</p>
                    <pre><code set:html={highlight(quickstartCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(quickstartOutput, "loguru-output")} /></pre>

                    <div class="anatomy" role="img" aria-label="The parts of a Loguru line: the time, the level INFO, the place in your code __main__:<module>:4, and your message.">
                        <div class="anatomy__line" aria-hidden="true">
                            {anatomy.map(([text, field, body], index) => (
                                <>
                                    {index > 0 && <span class="anatomy__sep">{index === 3 ? "-" : "|"}</span>}
                                    <div class="anatomy__col">
                                        <span class="anatomy__part">{text}</span>
                                        <div class="anatomy__key"><code>{field}</code><span>{body}</span></div>
                                    </div>
                                </>
                            ))}
                        </div>
                    </div>
                    <p>
                        Placeholders work like <code>str.format()</code>: <code>{"{}"}</code> takes the next argument and <code>{"{percent}"}</code> takes the keyword argument of that name.
                    </p>
                </section>

                <section id="configure" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · Configure</p>
                    <h2>Levels, files and formats</h2>
                    <p>
                        Loguru calls each place it writes logs to a <strong>sink</strong>. A fresh <code>logger</code> has one sink, your terminal. <code>logger.add()</code> adds a sink and <code>logger.remove()</code> takes sinks away.
                    </p>

                    <h3 id="set-level" class="scroll-mt-24">Set the log level</h3>
                    <p>The terminal sink shows every level from <code>DEBUG</code> up. To show less, remove it and add it back with the level you want:</p>
                    <pre><code set:html={highlight(setLevelCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(setLevelOutput, "loguru-output")} /></pre>
                    <p>
                        <code>logger.remove()</code> with no arguments removes every sink. To change the level without touching code, start the app with the environment variable <code>LOGURU_LEVEL=INFO</code>.
                    </p>

                    <h3 id="levels" class="scroll-mt-24">Loguru levels</h3>
                    <p>
                        Loguru uses the standard library's level numbers and adds <code>TRACE</code> and <code>SUCCESS</code>. A sink set to a level shows that level and everything above it.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Level</th><th>No.</th><th>Method</th></tr>
                            </thead>
                            <tbody>
                                {levels.map((l) => (
                                    <tr>
                                        <td><span class={`level level--${l.name.toLowerCase()}`}>{l.name}</span></td>
                                        <td>{l.no}</td>
                                        <td><code>{l.method}</code></td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p>To add your own level, give it a name and a number. The number decides where it sorts:</p>
                    <pre><code set:html={highlight(customLevelCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(customLevelOutput, "loguru-output")} /></pre>

                    <h3 id="files" class="scroll-mt-24">Write logs to a file</h3>
                    <p>Pass a file path to <code>logger.add()</code>. Loguru can also start a new file when the current one gets big, delete old files and compress them:</p>
                    <pre><code set:html={highlight(fileCode, "python-logging")} /></pre>
                    <p>
                        <code>rotation</code> also takes a time of day, such as <code>"00:00"</code> for a new file every midnight, or an interval such as <code>"1 week"</code>.
                    </p>

                    <h3 id="format" class="scroll-mt-24">Change the format</h3>
                    <p>
                        The <code>format</code> argument sets what each line shows. Names in braces are filled in for every line, and tags like <code>&lt;green&gt;</code> add color. Loguru leaves the colors out when it writes to a file.
                    </p>
                    <pre><code set:html={highlight(formatCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(formatOutput, "loguru-output")} /></pre>
                </section>

                <section id="structured" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>03</span> · Structure</p>
                    <h2>JSON logs and context</h2>

                    <h3 id="json" class="scroll-mt-24">JSON output with serialize=True</h3>
                    <p>Add a sink with <code>serialize=True</code> and each line comes out as a JSON object holding everything Loguru knows about the call (trimmed here):</p>
                    <pre><code set:html={highlight(serializeCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(serializeOutput, "json")} /></pre>
                    <p>
                        To ship logs to a backend as structured data, the <a href="#opentelemetry">OpenTelemetry setup</a> below sends each line with its fields and the trace ID of its request.
                    </p>

                    <h3 id="context" class="scroll-mt-24">Add context with bind() and contextualize()</h3>
                    <p>
                        Context is extra data that travels with a log line, such as a user name or a request ID. Loguru keeps it in a dict called <code>extra</code> and gives you two ways to fill it:
                    </p>
                    <ul class="guide-list">
                        <li><code>logger.bind()</code> returns a copy of the logger with fixed values. Lines logged through the copy carry them, and the global <code>logger</code> stays as it was.</li>
                        <li><code>logger.contextualize()</code> adds values to every line logged inside a <code>with</code> block, including lines from the functions it calls.</li>
                    </ul>
                    <pre><code set:html={highlight(contextCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(contextOutput, "loguru-output")} /></pre>
                    <p>
                        Each thread and each asyncio task sees its own <code>contextualize()</code> values, so a web app can set the request ID once per request in middleware.
                    </p>
                </section>

                <section id="exceptions" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>04</span> · Errors</p>
                    <h2>Log exceptions with their variables</h2>
                    <p>
                        <code>@logger.catch</code> logs any exception the function raises, with its traceback, and lets the program carry on. Loguru's tracebacks also show the value of each variable in them:
                    </p>
                    <pre><code set:html={highlight(catchCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(catchOutput, "loguru-output")} /></pre>
                    <p>
                        Inside an <code>except</code> block, <code>logger.exception("Charge failed")</code> does the same for the exception you caught.
                    </p>
                    <div class="guide-callout">
                        <p class="guide-kicker">Hide variable values in production</p>
                        <p>
                            They can contain passwords, tokens and customer data. Add production sinks with <code>diagnose=False</code>, or start the app with <code>LOGURU_DIAGNOSE=NO</code> for the default terminal sink.
                        </p>
                    </div>
                </section>

                <section id="stdlib" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>05</span> · Standard library</p>
                    <h2>Loguru and the logging module</h2>

                    <h3 id="intercept" class="scroll-mt-24"><span class="sys-dot" style={`--sys: ${systems.stdlib.color}`}></span>Send library logs through Loguru</h3>
                    <p>
                        Libraries like requests, SQLAlchemy and uvicorn log with the standard <code>logging</code> module, so their lines skip your Loguru sinks. The Loguru docs include a small handler that forwards them. Save it as <code>intercept.py</code>:
                    </p>
                    <pre><code set:html={highlight(interceptCode, "python-logging")} /></pre>
                    <p>Import it once, first thing at startup, and lines from both come out of the same sinks:</p>
                    <pre><code set:html={highlight(interceptUsageCode, "python-logging")} /></pre>
                    <pre class="pre-output"><code set:html={highlight(interceptUsageOutput, "loguru-output")} /></pre>

                    <h3 id="comparison" class="scroll-mt-24">Loguru vs the logging module</h3>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Task</th>
                                    <th><span class="sys-badge" style={`--sys: ${systems.loguru.color}`}>Loguru</span></th>
                                    <th><span class="sys-badge" style={`--sys: ${systems.stdlib.color}`}>logging</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {comparison.map(([task, loguru, stdlib]) => (
                                    <tr><td>{task}</td><td set:html={loguru} /><td set:html={stdlib} /></tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Loguru suits applications. If you write a library, log with <code>logging</code> so the application that uses it decides where the lines go.
                    </p>
                </section>

                <section id="opentelemetry" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>06</span> · OpenTelemetry</p>
                    <h2>Send Loguru logs to OpenTelemetry</h2>
                    <p>
                        OpenTelemetry is the open standard for collecting traces, metrics and logs. A <strong>trace</strong> records one request as it moves through your code. A log line sent through OpenTelemetry during a request carries that request's trace ID, so a backend such as Maple can show the line next to the request that wrote it.
                    </p>
                    <p>
                        The OpenTelemetry Python SDK collects logs from the standard <code>logging</code> module only. Loguru needs one extra sink, a bridge that hands each line over:
                    </p>

                    <figure class="flow" aria-label="The path of a log line. Your code calls the Loguru logger. Library logs go to the root logger, where the InterceptHandler passes them to Loguru. Loguru writes to the terminal and files, and to otel_sink, the bridge. otel_sink hands the line to the loguru.otel logger, whose LoggingHandler adds the trace and span IDs and passes it to the LoggerProvider, which exports it to Maple.">
                        <svg viewBox="0 0 760 372" aria-hidden="true">
                            <defs>
                                {["loguru", "stdlib", "otel", "primary"].map((k) => (
                                    <marker id={`flow-head-${k}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                        <path d="M0,0 L8,4 L0,8 z" class={`flow__head flow__head--${k}`} />
                                    </marker>
                                ))}
                            </defs>

                            <rect x="0" y="24" width="150" height="64" rx="8" class="flow__box flow__box--loguru" />
                            <text x="75" y="51" text-anchor="middle" class="flow__title">Your code</text>
                            <text x="75" y="71" text-anchor="middle" class="flow__mono flow__mono--loguru">logger.info()</text>

                            <rect x="0" y="150" width="150" height="64" rx="8" class="flow__box flow__box--stdlib" />
                            <text x="75" y="177" text-anchor="middle" class="flow__title">Libraries</text>
                            <text x="75" y="197" text-anchor="middle" class="flow__mono flow__mono--stdlib">logging</text>

                            <rect x="205" y="150" width="160" height="64" rx="8" class="flow__box flow__box--stdlib" />
                            <text x="285" y="177" text-anchor="middle" class="flow__title">Root logger</text>
                            <text x="285" y="197" text-anchor="middle" class="flow__mono flow__mono--stdlib">InterceptHandler</text>

                            <rect x="420" y="24" width="150" height="64" rx="8" class="flow__box flow__box--loguru flow__box--strong" />
                            <text x="495" y="51" text-anchor="middle" class="flow__title">Loguru logger</text>
                            <text x="495" y="71" text-anchor="middle" class="flow__mono flow__mono--loguru">every sink</text>

                            <rect x="610" y="24" width="150" height="64" rx="8" class="flow__box flow__box--loguru" />
                            <text x="685" y="51" text-anchor="middle" class="flow__title">Terminal, files</text>
                            <text x="685" y="71" text-anchor="middle" class="flow__mono">your other sinks</text>

                            <rect x="610" y="150" width="150" height="64" rx="8" class="flow__box flow__box--loguru" />
                            <text x="685" y="177" text-anchor="middle" class="flow__title">otel_sink</text>
                            <text x="685" y="197" text-anchor="middle" class="flow__mono flow__mono--loguru">the bridge</text>

                            <rect x="610" y="290" width="150" height="64" rx="8" class="flow__box flow__box--stdlib" />
                            <text x="685" y="317" text-anchor="middle" class="flow__title">loguru.otel</text>
                            <text x="685" y="337" text-anchor="middle" class="flow__mono flow__mono--stdlib">a logging logger</text>

                            <rect x="420" y="290" width="150" height="64" rx="8" class="flow__box flow__box--otel" />
                            <text x="495" y="317" text-anchor="middle" class="flow__title">LoggingHandler</text>
                            <text x="495" y="337" text-anchor="middle" class="flow__mono flow__mono--otel">+ trace ID</text>

                            <rect x="205" y="290" width="160" height="64" rx="8" class="flow__box flow__box--otel" />
                            <text x="285" y="317" text-anchor="middle" class="flow__title">LoggerProvider</text>
                            <text x="285" y="337" text-anchor="middle" class="flow__mono flow__mono--otel">exports in batches</text>

                            <rect x="0" y="290" width="150" height="64" rx="8" class="flow__box flow__box--primary" />
                            <text x="75" y="317" text-anchor="middle" class="flow__title">Maple</text>
                            <text x="75" y="337" text-anchor="middle" class="flow__mono">Logs page</text>

                            <line x1="150" y1="56" x2="414" y2="56" marker-end="url(#flow-head-loguru)" class="flow__line flow__line--loguru" />
                            <line x1="150" y1="182" x2="199" y2="182" marker-end="url(#flow-head-stdlib)" class="flow__line flow__line--stdlib" />
                            <line x1="365" y1="160" x2="452" y2="94" marker-end="url(#flow-head-loguru)" class="flow__line flow__line--loguru" />
                            <text x="420" y="140" class="flow__mono flow__mono--loguru">forwarded</text>
                            <line x1="570" y1="56" x2="604" y2="56" marker-end="url(#flow-head-loguru)" class="flow__line flow__line--loguru" />
