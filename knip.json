{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreWorkspaces": ["apps/ingest", "apps/ios", "examples/*"],
	"ignore": ["**/*.type-test.ts"],
	"ignoreExportsUsedInFile": true,
	"workspaces": {
		".": {
			"entry": ["alchemy.run.ts", "scripts/**/*.ts", "scripts/oxlint-plugins/*.mjs"],
			"ignoreBinaries": ["tb", "pscale", "infisical"],
			// alchemy's optional peer, dynamic-imported when the deploy applies migrations.
			"ignoreDependencies": ["pg"]
		},
		"apps/landing": {
			// scripts/figures/*.mjs generate blog figures and covers, run by hand with node.
			// iso/ is a vendored drawing kit; only part of its API is used.
			"entry": ["src/worker.ts", "tools/**/*.ts", "tools/**/*.js", "scripts/figures/*.mjs"],
			"ignore": ["src/components/blog/foldkit/iso/**"],
			"ignoreDependencies": ["@paper-design/shaders"]
		},
		"apps/api": {
			// src/worker.ts was auto-detected from wrangler.jsonc's `main` until the
			// wrangler configs were deleted; the Worker entries are now named here.
			// bench-suites/*.ts are loaded by path from scripts/bench-queries.ts (a dynamic
			// import off the CLI's --suite argument), so knip cannot see the edge.
			"entry": [
				"src/worker.ts",
				"autumn.config.ts",
				"scripts/cold-path/*.{ts,mjs}",
				"scripts/bench-suites/*.ts"
			]
		},
		// Single-module Workers: the root alchemy.run.ts imports src/worker.ts, and
		// alchemy bundles it, so it is the app's one entry.
		// The tool playground config is run by path from scripts/tool-playground.sh.
		"apps/ai": {
			"entry": ["src/worker.ts", "vitest.playground.config.ts", "src/evals/playground/*.playground.ts"]
		},
		"apps/alerting": {
			"entry": ["src/worker.ts"]
		},
		"apps/chat-bot": {
			"entry": ["src/worker.ts"]
		},
		"apps/electric-sync": {
			"entry": ["src/worker.ts"]
		},
		// The sandbox Worker's entry is its own plain module (that is the point: a
		// generated entry would drop the container-backed class export), and the
		// alchemy declaration beside it is what the root stack yields.
		"apps/sandbox": {
			"entry": ["src/worker.ts", "alchemy.run.ts"],
			"ignoreDependencies": ["cloudflare"]
		},
		// Run by path: the browser e2e suite (`e2e run`, `test:e2e`).
		"apps/web": {
			// `src/worker-entry.ts` is named by string in `src/worker.ts`.
			"entry": ["src/worker-entry.ts", "e2e/e2e.config.ts", "e2e/tests/**/*.e2e.ts"]
		},
		// local-ui renders apps/web's source modules (ui, charts, lib/sugar-high), so their runtime
		// packages must resolve from this app too.
		// `src/worker-entry.ts` is named by string in `src/worker.ts`.
		"apps/local-ui": {
			"entry": ["src/worker.ts", "src/worker-entry.ts"],
			"ignoreDependencies": [
				"@floating-ui/dom",
				"@tanstack/charts",
				"@tanstack/charts-scales",
				"sugar-high"
			]
		},
		"apps/cli": {
			"entry": [
				"test/probes/*.ts",
				"test/archive-probe-helpers.ts",
				"test/merge-injection-probe.ts",
				"test/native-local-store-migration-fixture.ts",
				"test/native-service-map-ingest-bridge-probe.ts"
			],
			"ignoreBinaries": ["duckdb"]
		},
		"packages/db": {
			"entry": ["scripts/**/*.ts", "effect-orm.config.ts"]
		},
		"packages/security-audit": {
			// The vendored skill's own validator tests run under `node --test`.
			"entry": ["scripts/**/*.ts", "skill/*.test.cjs"]
		},
		"packages/email": {
			"entry": ["scripts/**/*.ts"],
			"ignore": ["src/generated/**"],
			"ignoreDependencies": ["tailwindcss"]
		},
		"lib/ai-model-catalog": {
			"entry": ["scripts/**/*.ts"]
		},
		"lib/semconv": {
			"entry": ["scripts/**/*.ts"]
		},
		"lib/alchemy-portless": {
			// The dev-sidecar entry alchemy loads by URL, not by import.
			"entry": ["src/Local.ts"]
		},
		"packages/query-engine": {
			"entry": ["src/drain/index.ts"]
		},
		"packages/browser": {
			// Imported by the private packages it bundles (browser-session, sdk-core); listed here so the build keeps them external.
			"ignoreDependencies": ["rrweb", "web-vitals"]
		}
	},
	"rules": {
		"files": "error",
		"dependencies": "error",
		"devDependencies": "error",
		"unlisted": "error",
		"binaries": "error",
		"unresolved": "error",
		"exports": "warn",
		"types": "warn",
		"nsExports": "warn",
		"nsTypes": "warn",
		"enumMembers": "warn",
		"namespaceMembers": "warn",
		"duplicates": "warn",
		"cycles": "error"
	}
}
