{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		// Public API fixtures and the export/docs checks read this package's dist/,
		// so both tasks need "build", not just the root's "^build".
		"typecheck": {
			"dependsOn": ["build", "^build"]
		},
		"test": {
			"dependsOn": ["build", "^build"],
			"outputs": []
		}
	}
}
