const choosing = [
    ["All six resources", "CPU, memory with commit charge, disk latency, network, service states and event logs."],
    ["History you can compare", "Enough retention to set this week next to last month, so a slow leak shows up as a trend."],
    ["Alerts per server", "One incident for the server that is in trouble, not an average across the fleet that never crosses the line."],
    ["Fits what you already run", "Windows servers alerting through the same rules and on-call rotation as your Linux hosts and applications."],
    ["Deployment", "An MSI you can push with Group Policy or your configuration tool, running as a service with a known footprint."],
    ["Pricing unit", "Per host, per sensor, per counter or per GB ingested. The unit decides what a hundred more servers cost."],
];

const receivers: { name: string; reads: string; body: string; covers: ResourceId[] }[] = [
    { name: "hostmetrics", reads: "System APIs", body: "CPU, memory, disk, filesystem, network, page file and load, with the same metric names as on Linux. Load is computed from the processor queue length.", covers: ["cpu", "memory", "disk", "network"] },
    { name: "windows_perf_counters", reads: "Performance counters", body: "Any Performance Monitor counter you list, under a metric name you choose. Here: commit charge, disk latency and the queue lengths.", covers: ["cpu", "memory", "disk"] },
    { name: "windows_service", reads: "Service Control Manager", body: "<code>windows.service.status</code> per listed service: 4 is Running, 1 is Stopped. Alpha stability.", covers: ["services"] },
    { name: "windows_event_log", reads: "Event log", body: "One channel or an XML query; each event becomes a log record with its level mapped to a severity.", covers: ["events"] },
];

const installExample = `$v = '0.163.1'
$msi = "$env:TEMP\\otelcol-contrib.msi"
Invoke-WebRequest -OutFile $msi -Uri "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$v/otelcol-contrib_\${v}_windows_x64.msi"
Start-Process msiexec.exe -ArgumentList "/i \`"$msi\`" /qn" -Wait
Get-Service otelcol-contrib`;

const collectorConfig = `extensions:
  file_storage:
    directory: C:\\ProgramData\\OpenTelemetry Collector\\storage
    create_directory: true

receivers:
  hostmetrics:
    collection_interval: 30s
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      filesystem:
        metrics:
          system.filesystem.utilization:
            enabled: true
      load: {}
      disk: {}
      network: {}
      paging: {}

  windows_perf_counters:
    collection_interval: 30s
    metrics:
      windows.memory.committed_percent:
        description: Memory\\% Committed Bytes In Use
        unit: "%"
        gauge:
      windows.memory.pages_per_sec:
        description: Memory\\Pages/sec
        unit: "{page}/s"
        gauge:
      windows.disk.latency:
        description: PhysicalDisk\\Avg. Disk sec/Read and sec/Write
        unit: s
        gauge:
      windows.disk.queue_length:
        description: PhysicalDisk\\Current Disk Queue Length
        unit: "{request}"
        gauge:
      windows.system.processor_queue_length:
        description: System\\Processor Queue Length
        unit: "{thread}"
        gauge:
    perfcounters:
      - object: Memory
        counters:
          - name: "% Committed Bytes In Use"
            metric: windows.memory.committed_percent
          - name: Pages/sec
            metric: windows.memory.pages_per_sec
      - object: PhysicalDisk
        instances: "*"
        counters:
          - name: Avg. Disk sec/Read
            metric: windows.disk.latency
            attributes:
              direction: read
          - name: Avg. Disk sec/Write
            metric: windows.disk.latency
            attributes:
              direction: write
          - name: Current Disk Queue Length
            metric: windows.disk.queue_length
      - object: System
        counters:
          - name: Processor Queue Length
            metric: windows.system.processor_queue_length

  windows_service:
    collection_interval: 1m
    include_services: [W3SVC, WinRM] # the services this server must keep running

  windows_event_log/system:
    channel: system
    storage: file_storage
    resource:
      service.name: windows-eventlog

  windows_event_log/application:
    channel: application
    storage: file_storage
    exclude_providers: [otelcol-contrib]
    resource:
      service.name: windows-eventlog

  windows_event_log/security:
    storage: file_storage
    query: |
      <QueryList>
        <Query Id="0">
          <Select Path="Security">*[System[(EventID=4625 or EventID=4740 or EventID=1102)]]</Select>
        </Query>
      </QueryList>
    resource:
      service.name: windows-eventlog

processors:
  resourcedetection:
    detectors: [env, system]
  batch: {}

exporters:
  otlphttp/maple:
    endpoint: https://ingest.maple.dev # EU organizations: https://ingest.eu.maple.dev
    compression: gzip
    headers:
      x-maple-ingest-key: \${env:MAPLE_INGEST_KEY}

service:
  extensions: [file_storage]
  pipelines:
    metrics:
      receivers: [hostmetrics, windows_perf_counters, windows_service]
      processors: [resourcedetection, batch]
      exporters: [otlphttp/maple]
    logs:
      receivers: [windows_event_log/system, windows_event_log/application, windows_event_log/security]
      processors: [resourcedetection, batch]
      exporters: [otlphttp/maple]`;

const serviceEnvExample = `$dir = 'C:\\Program Files\\OpenTelemetry Collector'
$svc = 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\otelcol-contrib'
New-ItemProperty -Path $svc -Name Environment -PropertyType MultiString -Value 'MAPLE_INGEST_KEY=maple_sk_your_key' -Force

# Check the file before restarting the service
$env:MAPLE_INGEST_KEY = 'maple_sk_your_key'
& "$dir\\otelcol-contrib.exe" validate --config "$dir\\config.yaml"
Restart-Service otelcol-contrib`;

const perHostCpuSql = `SELECT $__timeGroup(TimeUnix) AS bucket,
       ResourceAttributes['host.name'] AS group,
       avg(Value) AS value,
       count() AS samples
FROM metrics_gauge
WHERE $__orgFilter AND $__timeFilter(TimeUnix)
  AND MetricName = 'system.cpu.utilization'
  AND Attributes['state'] = 'idle'
GROUP BY bucket, group
ORDER BY bucket`;

const faqs = [
    {
        question: "What are the best Windows server monitoring tools?",
        answer:
            "It depends on what the rest of your monitoring runs on. For one server, the built-in Performance Monitor, Resource Monitor and Event Viewer are enough to diagnose a problem. For a fleet, pick an agent that sends counters, service states and event logs to the backend you already use for other systems, so Windows servers alert through the same rules. Estates standardized on Microsoft often use Azure Monitor or System Center Operations Manager; commercial suites add ready-made templates for Windows roles.",
    },
    {
        question: "Are there free or open-source Windows server monitoring tools?",
        answer:
            "Windows includes Task Manager, Resource Monitor, Performance Monitor, Event Viewer and PowerShell's Get-Counter, and Windows Admin Center is a free download. Open-source agents include the OpenTelemetry Collector, the Prometheus windows_exporter, Telegraf, the Zabbix agent and NSClient++. The agents need a backend that stores the data and runs the alerts.",
    },
    {
        question: "How do I monitor a Windows server?",
        answer:
            "Pick the signals first: CPU and processor queue, available memory and commit charge, disk latency and free space, network errors, the services the server must keep running, and the System and Application event logs. Check them by hand with Performance Monitor and Event Viewer. For history and alerts, run an agent such as the OpenTelemetry Collector as a Windows service and send the data to a monitoring backend.",
    },
    {
        question: "Which Performance Monitor counters matter most on Windows Server?",
        answer:
            "Processor(_Total)\\% Processor Time and System\\Processor Queue Length for CPU, Memory\\Available MBytes and Memory\\% Committed Bytes In Use for memory, PhysicalDisk\\Avg. Disk sec/Read and sec/Write for disk latency, LogicalDisk\\% Free Space, and Network Interface\\Bytes Total/sec. Add role counters such as Web Service\\Current Connections on IIS.",
    },
    {
        question: "How do I monitor Windows services?",
        answer:
            "Get-Service shows the state of every service on one machine. To alert on it, collect the state on a schedule: the OpenTelemetry Collector's windows_service receiver reports windows.service.status for each listed service, where 4 means Running. Alert when the value for a service drops below 4, and watch the System log for events 7031 and 7034, which record a service crashing.",
    },
    {
        question: "Does the OpenTelemetry Collector run on Windows Server?",
        answer:
            "Yes. The opentelemetry-collector-releases project publishes MSI installers for the Contrib distribution. The installer registers a Windows service named otelcol-contrib that runs as LocalSystem and reads config.yaml from C:\\Program Files\\OpenTelemetry Collector.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
