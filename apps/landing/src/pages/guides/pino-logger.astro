const sectionNav = toc.filter((h) => h.depth === 2);

// One color per place a log line passes through, used by the diagram, badges and code.
const stages = {
    main: { name: "Main thread", color: "var(--chart-1)" },
    worker: { name: "Worker thread", color: "var(--chart-2)" },
    destination: { name: "Destination", color: "var(--chart-3)" },
    otel: { name: "OpenTelemetry", color: "var(--chart-5)" },
} as const;

const levels = [
    { name: "fatal", value: "60", use: "The process is about to exit.", tone: "var(--destructive)" },
    { name: "error", value: "50", use: "A request or job failed and someone may need to act.", tone: "var(--destructive)" },
    { name: "warn", value: "40", use: "Something went wrong and the code recovered: a retry, a fallback.", tone: "var(--warning)" },
    { name: "info", value: "30", use: "The default. Lifecycle events and one line per unit of work.", tone: "var(--foreground)" },
    { name: "debug", value: "20", use: "Detail you turn on while investigating.", tone: "var(--muted-foreground)" },
    { name: "trace", value: "10", use: "Very verbose output, usually only on your machine.", tone: "var(--muted-foreground)" },
];

const firstLogBody = `logger.info("server started")
logger.info({ port: 3000 }, "listening")
logger.info("user %s signed in after %d ms", "ada", 42)
logger.error(new Error("connection refused"), "payment provider unreachable")`;

const firstLogTabs = [
    {
        id: "typescript",
        label: "TypeScript",
        run: "node app.ts   # Node 22.18+, in a package with \"type\": \"module\"",
        code: `// app.ts\nimport pino, { type Logger } from "pino"\n\nconst logger: Logger = pino()\n\n${firstLogBody}`,
    },
    { id: "esm", label: "ES modules", run: "node app.mjs", code: `// app.mjs\nimport pino from "pino"\n\nconst logger = pino()\n\n${firstLogBody}` },
    { id: "commonjs", label: "CommonJS", run: "node app.cjs", code: `// app.cjs\nconst pino = require("pino")\n\nconst logger = pino()\n\n${firstLogBody}` },
];

const firstLogOutput = `{"level":30,"time":1792513464618,"pid":4812,"hostname":"api-1","msg":"server started"}
{"level":30,"time":1792513464619,"pid":4812,"hostname":"api-1","port":3000,"msg":"listening"}
{"level":30,"time":1792513464619,"pid":4812,"hostname":"api-1","msg":"user ada signed in after 42 ms"}
{"level":50,"time":1792513464619,"pid":4812,"hostname":"api-1","err":{"type":"Error","message":"connection refused","stack":"Error: connection refused\\n    at file:///srv/app.ts:8:14 ..."},"msg":"payment provider unreachable"}`;

const levelSnippet = `const logger = pino({ level: process.env.LOG_LEVEL ?? "info" })

logger.debug("dropped: debug is below info")

logger.level = "debug" // change it at runtime, for example from an admin endpoint
logger.debug("written now")

if (logger.isLevelEnabled("trace")) {
  logger.trace({ memory: process.memoryUsage() }, "memory snapshot")
}`;

const childSnippet = `const logger = pino()

const billing = logger.child({ module: "billing" })
const log = billing.child({ requestId: "req_8f2c" })

log.warn({ invoiceId: "inv_1042" }, "invoice overdue")

const db = logger.child({ module: "db" }, { level: "warn" })
db.info("not written: this child only logs warn and above")`;

const childOutput = `{"level":40,"time":1792513481449,"pid":4812,"hostname":"api-1","module":"billing","requestId":"req_8f2c","invoiceId":"inv_1042","msg":"invoice overdue"}`;

const redactSnippet = `const logger = pino({
  redact: {
    paths: ["password", "req.headers.authorization", 'req.headers["x-api-key"]', "cards[*].number"],
    censor: "[REDACTED]",
  },
  serializers: {
    user: (user) => ({ id: user.id, plan: user.plan }),
