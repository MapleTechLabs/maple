---
/**
 * FeaturePage — the single template behind all `/features/*` routes, in
 * all three locales.
 *
 * The spine, and its tonal cadence:
 *
 *   00  PageHero            bg-bg       copy + the product, over the engraving
 *   01  SurfacePanel        bg-bg       border-t            tone flat → hairline
 *   02  ArtifactSection     bg-bg       border-t            only when the hero holds a capture
 *   03  ScreenGallery       bg-bg       border-t            more of the surface
 *   04  [extra sections]    per section                     kubernetes only
 *   05  CapabilityLedger    bg-bg-deep  no border           tone steps → tone is the rule
 *   06  PlanFacts           bg-bg-deep  border-t            price, retention, proof, docs
 *   07  CrossLinks          bg-bg-deep  border-t            tone flat → hairline
 *   08  PageCta             amber                           the one peak
 *
 * The tonal rule is tighter here than on the homepage because these pages carry
 * more frames: `.live-frame` is itself `--bg-deep`, so any section holding one
 * must sit on `bg-bg` or the frame dissolves into its own floor. That, not
 * taste, is why 01 and 02 are both quiet.
 *
 * A feature page gets ONE live artifact. Several carry an amber
 * `.live-frame__live` pulse and `--severity-warn` fills, which share the
 * primary hue; two of them plus the closing CTA reads speckled rather than rare.
 *
 * The hero shows the product, never a second copy of it: an artifact lifted into
 * the hero keeps its title and lede as the frame's caption and gets no section.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import * as m from "../../paraglide/messages.js";
import { planRows } from "../../lib/feature-plan";
import { featureBySlug } from "../../lib/features";
import { getOffer } from "../../lib/pricing-offer";
import { SCALE_PROOF_STORY_PATH } from "../../lib/scale-proof";
import { featurePath, GALLERY_SHOT_SIZE, useCasePath } from "../../lib/page-registry";
import { useCaseBySlug } from "../../lib/use-cases";
import Layout from "../../layouts/Layout.astro";
import FAQ from "../FAQ.astro";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";
import SeoHead from "../SeoHead.astro";
import ArtifactSection from "./ArtifactSection.astro";
import CapabilityLedger from "./CapabilityLedger.astro";
import CrossLinks from "./CrossLinks.astro";
import PageCta from "./PageCta.astro";
import PageHero from "./PageHero.astro";
import PlanFacts from "./PlanFacts.astro";
import ScreenGallery from "./ScreenGallery.astro";
import Shot from "./Shot.astro";
import SurfacePanel from "./SurfacePanel.astro";
import { ARTIFACTS, EXTRA_SECTIONS, HERO_ARTIFACTS, HERO_ASIDES } from "./slots";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const feature = featureBySlug(slug);
if (!feature) throw new Error(`FeaturePage: unknown feature slug "${slug}"`);

const locale = Astro.currentLocale ?? "en";

// Messages are called HERE, during render, never at module scope and never in
// getStaticPaths — Paraglide resolves the locale per call.
const title = feature.seoTitle();
const description = feature.seoDescription();

const plan = planRows(feature.plan, await getOffer());

const Artifact = feature.artifact ? ARTIFACTS[feature.artifact.id] : null;
const HeroAside = feature.heroAside ? HERO_ASIDES[feature.heroAside] : null;
const heroShot = feature.heroShot;
// The artifact moves into the hero unless the page gave the hero something else.
const lifted = !HeroAside && !heroShot && feature.artifact ? feature.artifact : null;
const HeroArtifact = lifted ? HERO_ARTIFACTS[lifted.id] : null;
const hasHeroProduct = Boolean(HeroAside ?? heroShot ?? HeroArtifact);

const hero = {
	title: feature.heroTitle(),
	lede: feature.heroLede(),
	illustration: feature.illustration,
	illustrationAlt: feature.illustrationAlt,
	breadcrumb: [
		{ label: m.breadcrumb_home(), href: "/" },
		{ label: m.breadcrumb_features(), href: "/features" },
		{ label: feature.navLabel() },
	],
};

// Resolved here rather than inside the template: Astro's compiler can't parse a
// block-bodied arrow that returns a component from an expression container.
const extraSections = feature.extraSections.map((id) => EXTRA_SECTIONS[id]);

const faq = (feature.faq ?? []).map((item) => ({ question: item.question(), answer: item.answer() }));

const crossLinks = [
	...feature.related.flatMap((related) => {
		const entry = featureBySlug(related);
		return entry ? [{ href: featurePath(locale, entry.slug), name: entry.navLabel(), desc: entry.navDesc() }] : [];
	}),
	...feature.relatedUseCases.flatMap((related) => {
		const entry = useCaseBySlug(related);
		return entry ? [{ href: useCasePath(locale, entry.slug), name: entry.navLabel(), desc: entry.navDesc() }] : [];
	}),
];
---

<Layout
	title={title}
	description={description}
	ogType="article"
	alternates={feature.locales}
	mdHref={locale === "en" ? `/features/${feature.slug}.md` : undefined}
>
	<SeoHead title={title} description={description} />
	<Nav />

	<!-- Two branches, not a conditional slot: a slot that renders nothing still counts as filled,
	     and PageHero would lay out an empty second column. The `bg-bg` floor keeps the engraving
	     from showing through an artifact made of two frames. -->
	{
		hasHeroProduct ? (
			<PageHero {...hero}>
				<figure slot="product">
					<div class="rounded-xl bg-bg">
						{HeroAside && <HeroAside />}
						{heroShot && (
							<Shot
								src={`/screenshots/${heroShot.id}.webp`}
								alt={heroShot.alt}
								width={GALLERY_SHOT_SIZE.width}
								height={GALLERY_SHOT_SIZE.height}
								crop={heroShot.crop}
								route={heroShot.route}
								title={heroShot.title}
								loading="eager"
							/>
						)}
						{HeroArtifact && <HeroArtifact />}
					</div>
					{lifted && (
						<figcaption class="mt-4 max-w-[68ch]">
							<h2 class="text-sm font-medium text-fg">{lifted.title()}</h2>
							<p class="mt-1 text-[13px] leading-relaxed text-fg-muted">{lifted.lede()}</p>
						</figcaption>
					)}
				</figure>
			</PageHero>
		) : (
			<PageHero {...hero} />
		)
	}

	{
		feature.panel && (
			<SurfacePanel
				class="border-t border-border"
				route={feature.panel.route}
				constant={feature.panel.constant}
				shot={feature.panel.plate.alt}
				src={feature.panel.plate.src}
				caption={feature.panel.plate.caption}
				width={feature.panel.plate.width}
				height={feature.panel.plate.height}
				crop={feature.panel.plate.crop}
				facts={feature.panel.facts}
				eyebrow={m.page_panel_eyebrow()}
				title={feature.panel.title()}
				lede={feature.panel.lede()}
			/>
		)
	}

	<!-- Always hairlined: whatever precedes it — the hero or the panel — is also
	     bg-bg, so the tone never steps here and cannot be the separator. -->
	{
		feature.artifact && Artifact && !lifted && (
			<ArtifactSection
				class="border-t border-border"
				eyebrow={m.page_artifact_eyebrow()}
				title={feature.artifact.title()}
				lede={feature.artifact.lede()}
				wide={feature.artifact.wide}
			>
				<Artifact />
			</ArtifactSection>
		)
	}

	{
		feature.gallery.length > 0 && (
			<ScreenGallery
				class="border-t border-border"
				eyebrow={m.page_gallery_eyebrow()}
				title={m.page_gallery_title({ feature: feature.navLabel() })}
				shots={feature.gallery}
			/>
		)
	}

	{extraSections.map((Section) => <Section />)}

	<CapabilityLedger
		eyebrow={m.page_cap_eyebrow()}
		title={feature.capTitle()}
		items={feature.capabilities.map((capability) => ({
			op: capability.op,
			title: capability.title(),
			body: capability.body(),
		}))}
	/>

	<PlanFacts
		class="border-t border-border"
		rows={plan}
		docsHref={feature.plan.docs}
		pricingHref={getRelativeLocaleUrl(locale, "pricing")}
		proofHref={SCALE_PROOF_STORY_PATH}
	/>

	<!-- On the ledger's deep floor, like the sections around it: FAQ sets no background of its own. -->
	{
		faq.length > 0 && (
			<div class="bg-bg-deep">
				<FAQ items={faq} shell />
			</div>
		)
	}

	<CrossLinks
		class="border-t border-border"
		eyebrow={m.page_cross_eyebrow()}
		title={m.page_cross_features_title()}
		links={crossLinks}
	/>

	<PageCta
		title={feature.cta ? feature.cta.title() : m.page_cta_title()}
		lede={feature.cta ? feature.cta.lede() : m.page_cta_lede()}
	/>
	<Footer />
</Layout>
