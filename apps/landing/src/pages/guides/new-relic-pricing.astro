---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { highlight } from "../../lib/guide-highlight";
import { estimateMaple, estimateVendor } from "../../lib/vendor-pricing";

const pageTitle = "New Relic pricing: plans, free tier and costs | Maple";
const pageDescription =
    "New Relic pricing explained: the free tier's 100 GB, Standard, Pro and Enterprise plans, per-user and per-GB rates, and a worked monthly bill.";
const published = "2026-10-19";
const updated = "2026-10-20";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "model", text: "The pricing model" },
    { depth: 3, slug: "user-types", text: "User types" },
    { depth: 2, slug: "plans", text: "Plans" },
    { depth: 3, slug: "standard-ceiling", text: "Standard's five-user limit" },
    { depth: 3, slug: "terms", text: "Pay-as-you-go or commit" },
    { depth: 2, slug: "free-tier", text: "Free tier" },
    { depth: 3, slug: "past-100-gb", text: "Past 100 GB" },
    { depth: 3, slug: "free-trial", text: "Free trial" },
    { depth: 2, slug: "rates", text: "User types and data rates" },
    { depth: 3, slug: "counting", text: "How users are counted" },
    { depth: 3, slug: "data-options", text: "Original Data or Data Plus" },
    { depth: 3, slug: "compute", text: "Compute pricing" },
    { depth: 2, slug: "example", text: "Cost example" },
    { depth: 3, slug: "dynatrace", text: "Dynatrace vs New Relic" },
    { depth: 2, slug: "reduce", text: "Lowering the bill" },
    { depth: 3, slug: "collector", text: "Filter in a Collector" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per billing meter, used by the formula, the meter chart, the
// user-type badges and the cost bars.
const meters = {
    full: { name: "Full platform user", color: "var(--chart-p99)" },
    core: { name: "Core user", color: "var(--chart-5)" },
    data: { name: "Data past 100 GB", color: "var(--chart-2)" },
    free: { name: "Free", color: "var(--chart-3)" },
};

// Rates the shared estimator does not model, from newrelic.com/pricing.
const CORE_USER = 49;
const DATA_PLUS_PER_GB = 0.6;
const PRO_MONTHLY_PER_USER = 418.8;

const usd = (amount: number) =>
    `$${amount.toLocaleString("en-US", { minimumFractionDigits: Number.isInteger(amount) ? 0 : 2, maximumFractionDigits: 2 })}`;

const dataGb = 800;
const billableGb = dataGb - 100;
const allFull = estimateVendor("new-relic", { fullUsers: 12, dataVolume: dataGb });
const mixed = estimateVendor("new-relic", { fullUsers: 4, dataVolume: dataGb });
const [allFullUsers, allFullData] = allFull.breakdown;
const [mixedFullUsers, mixedData] = mixed.breakdown;
const coreCost = 8 * CORE_USER;
const mixedTotal = mixed.total + coreCost;
const dataPlusCost = billableGb * DATA_PLUS_PER_GB;
const proMonthlyUsers = 12 * PRO_MONTHLY_PER_USER;
const maple = estimateMaple("new-relic", { fullUsers: 12, dataVolume: dataGb });

const scenarios = [
    {
        label: "A",
        title: "12 full platform users, Pro with a 1-year commitment",
        total: allFull.total,
        parts: [
            { meter: meters.full, value: allFullUsers.value, detail: allFullUsers.detail },
            { meter: meters.data, value: allFullData.value, detail: `${billableGb} GB × $0.40` },
        ],
    },
    {
        label: "B",
        title: "4 full platform + 8 core users, Standard",
        total: mixedTotal,
        parts: [
            { meter: meters.full, value: mixedFullUsers.value, detail: mixedFullUsers.detail },
            { meter: meters.core, value: coreCost, detail: `8 × $${CORE_USER}` },
            { meter: meters.data, value: mixedData.value, detail: `${billableGb} GB × $0.40` },
        ],
    },
];
const maxTotal = Math.max(...scenarios.map((s) => s.total));
const seatShareA = Math.round((allFullUsers.value / allFull.total) * 100);

// The free-tier meter: 4 px per GB from x = 110.
const gbX = (gb: number) => 110 + gb * 4;

const ingestQuery = `FROM NrConsumption SELECT sum(GigabytesIngested)
WHERE productLine = 'DataPlatform'
SINCE 3 months ago FACET usageMetric TIMESERIES 1 day`;

const userQuery = `FROM NrMTDConsumption SELECT latest(FullPlatformUsersBillable),
  latest(CoreUsersBillable) SINCE 3 hours ago`;

const alertQuery = `FROM NrMTDConsumption SELECT latest(GigabytesIngested)
WHERE productLine = 'DataPlatform'`;

const collectorConfig = `receivers:
  otlp:
    protocols:
      grpc:
      http:

processors:
  filter/drop-debug-logs:
    error_mode: ignore
    logs:
      log_record:
        - severity_number != SEVERITY_NUMBER_UNSPECIFIED and severity_number < SEVERITY_NUMBER_INFO
  batch:

exporters:
  otlphttp/newrelic:
    endpoint: https://otlp.nr-data.net      # EU: https://otlp.eu01.nr-data.net
    headers:
      api-key: \${env:NEW_RELIC_LICENSE_KEY}
  otlphttp/maple:
    endpoint: https://ingest.maple.dev      # EU: https://ingest.eu.maple.dev
    headers:
      Authorization: Bearer \${env:MAPLE_INGEST_KEY}

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/newrelic, otlphttp/maple]
    logs:
      receivers: [otlp]
      processors: [filter/drop-debug-logs, batch]
      exporters: [otlphttp/newrelic, otlphttp/maple]`;

const faqs = [
    {
        question: "Is New Relic free?",
        answer:
            "Yes. The free tier has no time limit and needs no credit card. Each month it includes 100 GB of data ingest, one full platform user, unlimited basic users, at least 8 days of retention and 500 synthetic check runs. You pay once you need more data or more full platform or core users.",
    },
    {
        question: "How much does New Relic cost per month?",
        answer:
            "Users plus data. On Standard, the first full platform user is $10 a month and each additional one $99 a month, up to five. On Pro each full platform user is $349 a month with a 1-year commitment, or $418.80 a month without one. Core users are $49 a month on any paid plan, and every GB past the first 100 is $0.40. A 12-person team sending 800 GB pays about $979 a month with 4 full platform and 8 core users on Standard, or $4,468 with all 12 on Pro.",
    },
    {
        question: "Why is New Relic expensive?",
        answer:
            "Mostly because of full platform users. Anyone who needs the APM, infrastructure or browser views, including whoever is on call, needs one: $99 a month on Standard and $349 on Pro with a 1-year commitment. Twelve full platform users on Pro cost $4,188 a month before any data.",
    },
    {
        question: "Are there hidden costs in New Relic pricing?",
        answer:
            "Not hidden, but some sit outside the headline rates. Data Plus raises data from $0.40 to $0.60 per GB, storing data in the EU region adds $0.05 per GB, synthetic checks past your edition's allowance cost $0.005 each, and extended retention and Advanced Compute are paid add-ons.",
    },
    {
        question: "What happens past 100 GB on the New Relic free tier?",
        answer:
            "New Relic sends an email and an in-app alert at 85% of the 100 GB. Once a Free account passes 100 GB in a calendar month, data ingest stops and you lose access to the platform until you upgrade or the first day of the next month. On a paid plan the first 100 GB stays free and every GB after it is billed.",
    },
    {
        question: "Is there a New Relic free trial?",
        answer:
            "New Relic does not advertise a time-limited trial of Standard or Pro. The free tier does not expire and includes one full platform user, so one person can use the APM, infrastructure and browser views on up to 100 GB a month before paying.",
    },
    {
        question: "Does New Relic charge per host?",
        answer:
            "No. Hosts, agents and containers are not counted. A host costs only the data it sends, so 10 hosts and 1,000 hosts pay the same user fees.",
    },
    {
        question: "Is New Relic cheaper than Dynatrace?",
        answer:
            "It depends on team size and host count. New Relic bills per full platform user and per GB, with hosts free. Dynatrace bills per host (by memory for full-stack monitoring) and per GiB of logs and traces, with no user fee, under an annual commitment. A small team on many hosts usually pays less on New Relic; a large team on few hosts often pays less on Dynatrace.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "New Relic pricing, explained",
    description: pageDescription,
    datePublished: published,
    dateModified: updated,
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/new-relic-pricing`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "New Relic pricing" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Pricing</span>
                    <span>9 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    New Relic pricing, explained
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    How users and gigabytes add up to a monthly bill, what the free tier covers, and what a 12-person team pays.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt="" width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime={updated}>Updated {updatedLabel}</time>
                    <span>Prices verified on newrelic.com/pricing, {updatedLabel}</span>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {sectionNav.map((h) => (
                    <a href={`#${h.slug}`} class="transition-colors hover:text-primary">{h.text}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={toc} class="sticky top-28" />
            </aside>

            <article class="nr-guide min-w-0">
                <section class="guide-lead">
                    <p>
                        <strong>New Relic</strong> is an observability platform for application performance monitoring, infrastructure, logs and more. Its pricing has two parts: users, billed by user type, and data ingest, where the first 100 GB each month is free and each GB after that costs $0.40.
                    </p>
                    <p>
                        This guide covers the four editions, the free tier, user types and data rates, a worked monthly bill for a 12-person team, and ways to lower a New Relic bill.
                    </p>
                    <div class="guide-takeaways">
                        <p class="guide-kicker">Key takeaways</p>
                        <ul>
                            <li>The free tier includes 100 GB of data a month, one full platform user and unlimited basic users, with no time limit.</li>
                            <li>Data past 100 GB costs $0.40 per GB ($0.60 with Data Plus); hosts, agents and containers are free.</li>
                            <li>Full platform users cost $10 for the first and $99 for each after on Standard (5 at most), $349 on Pro with a 1-year commitment.</li>
                            <li>Core users cost $49 a month and get logs and errors, but not the APM or infrastructure screens.</li>
                            <li>On the free tier, passing 100 GB stops ingest and platform access until the next month.</li>
                        </ul>
                    </div>
                </section>

                <section id="model" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Pricing model</p>
                    <h2>The New Relic pricing model</h2>

                    <p>
                        People are billed by <strong>user type</strong>, and only two of the three types cost money. The plan, called an <strong>edition</strong> (Free, Standard, Pro or Enterprise), sets the price of a full platform user, how many you can add and the support level.
                    </p>

                    <h3 id="user-types" class="scroll-mt-24">The three user types</h3>
                    <p>
                        Every person in the account has one <strong>user type</strong>. It decides which screens they can open and what they cost; roles still decide what they may change.
                    </p>
                    <div class="user-types">
                        <div class="user-types__row" style="--meter: var(--muted-foreground)">
                            <div class="user-types__head"><span class="meter-badge">Basic</span><strong>$0</strong><small>unlimited, every edition</small></div>
                            <p>Query any data with NRQL, build custom dashboards and basic alerts, set up instrumentation. No curated APM, infrastructure, browser or mobile screens.</p>
                        </div>
                        <div class="user-types__row" style={`--meter: ${meters.core.color}`}>
                            <div class="user-types__head"><span class="meter-badge">Core</span><strong>$49</strong><small>per user, a month</small></div>
                            <p>Basic plus the logs UI, the errors inbox, the CodeStream IDE extension, and user and billing management. Still no curated APM or infrastructure screens. Paid editions only.</p>
                        </div>
                        <div class="user-types__row" style={`--meter: ${meters.full.color}`}>
                            <div class="user-types__head"><span class="meter-badge">Full platform</span><strong>$10 to $418.80</strong><small>per user, a month</small></div>
                            <p>Everything, including APM, infrastructure, Kubernetes, browser, mobile and synthetics. Whoever is on call needs this type. The monthly price depends on the edition and on whether you commit for a year (see <a href="#plans">plans</a>).</p>
                        </div>
                    </div>

                    <figure class="formula" aria-label="The monthly bill is full platform users times $10 to $418.80 each, plus core users times $49, plus every GB past the first 100 times $0.40. Basic users, hosts, agents, containers and the first 100 GB cost nothing.">
                        <div class="formula__row" aria-hidden="true">
                            <div class="formula__term" style={`--meter: ${meters.full.color}`}>
                                <span class="formula__label">Full platform users</span>
                                <strong>× $10 to $418.80</strong>
                                <span class="formula__note">a month, by edition and term</span>
                            </div>
                            <span class="formula__op">+</span>
                            <div class="formula__term" style={`--meter: ${meters.core.color}`}>
                                <span class="formula__label">Core users</span>
                                <strong>× $49</strong>
                                <span class="formula__note">a month, paid editions only</span>
                            </div>
                            <span class="formula__op">+</span>
                            <div class="formula__term" style={`--meter: ${meters.data.color}`}>
                                <span class="formula__label">GB past the first 100</span>
                                <strong>× $0.40</strong>
                                <span class="formula__note">$0.60 with Data Plus</span>
                            </div>
                            <span class="formula__op">=</span>
                            <div class="formula__term formula__term--total">
                                <span class="formula__label">Monthly bill</span>
                                <strong>USD</strong>
                                <span class="formula__note">plus add-ons</span>
                            </div>
                        </div>
                        <p class="formula__free" aria-hidden="true" style={`--meter: ${meters.free.color}`}><span>$0</span> Basic users, hosts, agents, containers and the first 100 GB</p>
                    </figure>

                    <p>
                        Hosts are not counted at all. A fleet of 10 hosts and a fleet of 1,000 pay the same user fees and differ only in the GB they send. GB ingested is measured after your drop rules run and is rounded up to the next whole GB each month.
                    </p>
                    <p>
                        Smaller charges sit on top: synthetic checks past your edition's monthly allowance cost $0.005 each, storing data in the EU region adds $0.05 per GB, and extended retention and Advanced Compute are add-ons. Pro and Enterprise accounts can also swap user fees for compute pricing, covered under <a href="#compute">compute pricing</a>.
                    </p>
                </section>

                <section id="plans" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · Editions</p>
                    <h2>New Relic plans: Free, Standard, Pro and Enterprise</h2>
                    <p>
                        Every edition includes unlimited basic users and the same free 100 GB a month. They differ in the price and number of full platform users, the synthetic checks included, and support: Standard gets ticket support, Enterprise adds FedRAMP and HIPAA eligibility and custom terms. Prices below are what you pay each month.
                    </p>

                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Edition</th><th>Full platform user, a month</th><th>Core user, a month</th><th>Data past 100 GB</th><th>Synthetic checks a month</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><strong>Free</strong></td><td>1 user, $0</td><td>Not offered</td><td>Ingest stops</td><td>500</td></tr>
                                <tr><td><strong>Standard</strong></td><td>$10 for the first, $99 for each after, 5 max</td><td>$49</td><td>$0.40/GB</td><td>10,000</td></tr>
                                <tr><td><strong>Pro</strong></td><td>$349 with a 1-year commitment, $418.80 month to month, no user limit</td><td>$49</td><td>$0.40/GB</td><td>1 million</td></tr>
                                <tr><td><strong>Enterprise</strong></td><td>Contact sales</td><td>$49</td><td>Contact sales</td><td>10 million</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <h3 id="standard-ceiling" class="scroll-mt-24">Standard's five-user limit</h3>
                    <p>
                        Standard allows five full platform users. A sixth person who needs the APM views moves the account to Pro, where every full platform user costs $349 a month (with a 1-year commitment) instead of $99 a month. Five Standard users cost $406 a month; six Pro users cost $2,094 a month with the commitment, or $2,513 a month without.
                    </p>
                    <p>
                        The limit counts full platform users only. Core and basic users are unlimited on Standard, which is why the cheaper option in the <a href="#example">cost example</a> stays on Standard with 12 people.
                    </p>

                    <h3 id="terms" class="scroll-mt-24">Pay-as-you-go or a commitment</h3>
                    <p>
                        Standard and Pro can run pay-as-you-go: New Relic bills at the end of each calendar month, with no commitment past it. On Pro, committing for a year lowers the full platform price from $418.80 to $349 a month, 17% less; you still pay monthly. Pro and Enterprise customers can also sign a commitment contract for volume discounts. New Relic runs programs for startups and nonprofits and does not publish their discounts.
                    </p>
                </section>

                <section id="free-tier" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>03</span> · Free tier</p>
                    <h2>The New Relic free tier</h2>
                    <p>
                        The free tier is permanent and needs no credit card. Each month it includes:
                    </p>

                    <div class="guide-checklist">
                        {[
                            ["100 GB of data ingest", "Logs, metrics, traces and events combined, counted after your drop rules."],
                            ["1 full platform user", "One person gets every curated view, including APM, infrastructure and browser monitoring."],
                            ["Unlimited basic users", "Everyone else can query data, build dashboards and set basic alerts."],
                            ["At least 8 days of retention", "The default for most data types. Some keep data longer."],
                            ["500 synthetic checks", "A monthly budget of runs, not of monitors: each run from one location is one check. One monitor every 15 minutes from one location uses about 2,900 a month. Ping monitors don't count."],
                            ["Any number of hosts", "Instrument as many as you like; only their data counts."],
                        ].map(([title, body], index) => (
                            <div><span>{String(index + 1).padStart(2, "0")}</span><div><h4>{title}</h4><p>{body}</p></div></div>
                        ))}
                    </div>

                    <h3 id="past-100-gb" class="scroll-mt-24">Past 100 GB</h3>
                    <p>
                        The same 100 GB allowance behaves differently on the free tier and on a paid plan once a month's data runs past it:
                    </p>

                    <figure class="meter" aria-label="Data ingested during a month, from 0 to 140 GB. At 85 GB New Relic sends an email and an in-app alert. On the free tier, ingest and platform access stop at 100 GB. On a paid plan, data past 100 GB keeps flowing and is billed at $0.40 per GB.">
                        <svg viewBox="0 0 700 172" aria-hidden="true">
                            <text x="0" y="66" class="meter__lane">Free</text>
                            <rect x={gbX(0)} y="48" width={gbX(100) - gbX(0)} height="26" rx="4" class="meter__free" />
                            <text x={(gbX(0) + gbX(100)) / 2} y="66" text-anchor="middle" class="meter__inbar">100 GB included</text>
                            <rect x={gbX(100)} y="44" width="4" height="34" rx="1" class="meter__stop" />
                            <text x={gbX(100) + 14} y="66" class="meter__mono meter__mono--stop">ingest and access stop</text>

                            <text x="0" y="114" class="meter__lane">Paid plans</text>
                            <rect x={gbX(0)} y="96" width={gbX(100) - gbX(0)} height="26" rx="4" class="meter__free" />
                            <text x={(gbX(0) + gbX(100)) / 2} y="114" text-anchor="middle" class="meter__inbar">100 GB included</text>
                            <rect x={gbX(100) + 2} y="96" width={gbX(140) - gbX(100) - 2} height="26" rx="4" class="meter__billed" />
                            <text x={(gbX(100) + gbX(140)) / 2 + 1} y="114" text-anchor="middle" class="meter__inbar">$0.40 per GB</text>

                            <line x1={gbX(85)} y1="30" x2={gbX(85)} y2="132" class="meter__alert" />
                            <text x={gbX(85)} y="20" text-anchor="middle" class="meter__mono meter__mono--alert">85 GB: email and in-app alert</text>

                            <line x1={gbX(0)} y1="140" x2={gbX(140)} y2="140" class="meter__axis" />
                            {[0, 85, 100, 140].map((gb) => (
                                <g>
                                    <line x1={gbX(gb)} y1="140" x2={gbX(gb)} y2="145" class="meter__axis" />
                                    <text x={gbX(gb)} y="160" text-anchor="middle" class="meter__mono">{gb} GB</text>
                                </g>
                            ))}
                        </svg>
                    </figure>
                    <p class="guide-caption">One calendar month of ingest. The allowance resets on the first day of each month.</p>

                    <p>
                        On the free tier, passing 100 GB stops ingest <strong>and</strong> locks you out of the platform until you upgrade or the month ends. A burst of debug logs in the third week can leave you without data or dashboards for the rest of the month. Alert on your own usage well before New Relic's 85% email; the query is under <a href="#measure">measure ingest and seats</a>.
                    </p>

                    <h3 id="free-trial" class="scroll-mt-24">Is there a free trial?</h3>
                    <p>
                        New Relic does not advertise a time-limited trial of Standard or Pro. The free tier takes its place: its one full platform user sees the same curated views a paid user does, on up to 100 GB a month, with no end date.
                    </p>
                </section>

                <section id="rates" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>04</span> · Rates</p>
                    <h2>User types and data rates</h2>

                    <h3 id="counting" class="scroll-mt-24">How users are counted</h3>
                    <div class="guide-callout">
                        <p class="guide-kicker">How New Relic counts users</p>
                        <p>
                            Billing runs per calendar month in UTC, and each person pays for the <strong>highest type they held that month</strong>. Promoting someone to full platform for one afternoon of incident work bills them for the whole month. A user is billable from the moment they are added, before their first login, and accounts with the same email count once. On a commitment contract, a full platform user downgraded and upgraded again twice in a contract year stays billed as full platform for the rest of that year.
                        </p>
                    </div>

                    <h3 id="data-options" class="scroll-mt-24">Original Data or Data Plus</h3>
                    <p>
                        Each account picks one data option, and both bill from the 101st GB.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th></th><th>Original Data</th><th>Data Plus</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Per GB past 100 GB</td><td>$0.40</td><td>$0.60</td></tr>
                                <tr><td>Retention</td><td>At least 8 days by default</td><td>Up to 90 days more</td></tr>
                                <tr><td>Compliance</td><td>Standard</td><td>FedRAMP Moderate and HIPAA eligibility on Enterprise</td></tr>
                                <tr><td>Extras</td><td>None</td><td>Log obfuscation, streaming and historical data export</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Data Plus costs 50% more per GB, so it pays off when you need the retention or the compliance eligibility. Some data never counts toward GB ingested: basic alerting data, aggregated infrastructure data and dimensional metrics, golden metrics, synthetic check results, and New Relic's own usage and audit events.
                    </p>

                    <h3 id="compute" class="scroll-mt-24">Compute pricing (CCUs)</h3>
                    <p>
                        Pro and Enterprise can replace user fees with <strong>Core Compute</strong>. You still pay for data, plus <strong>compute capacity units (CCUs)</strong>: the capacity each successful action you run consumes, such as loading a page or running a query. Every user gets full platform access. Requests that fail on New Relic's side and queries that analyze your own usage are free. New Relic does not publish a per-CCU price, and its billing docs list Core Compute as a public preview arranged through an account executive.
                    </p>
                    <p>
                        <strong>Advanced Compute</strong> is a separate add-on, billed in advanced CCUs, for New Relic's AI, automation and security features. It applies on either model, and basic users can run up charges with it too.
                    </p>
                </section>

                <section id="example" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>05</span> · Worked example</p>
                    <h2>New Relic cost: a worked monthly example</h2>
                    <p>
                        A team of 12 engineers sends {dataGb} GB of logs, traces and metrics a month to the US region on Original Data. Hosts cost nothing, so the bill comes from the users and the {billableGb} GB past the free 100. Two ways to staff the same team:
                    </p>

                    <figure class="bars" aria-label={`Monthly cost of two options. Option A, 12 full platform users on Pro with a 1-year commitment: ${usd(allFull.total)}, of which ${usd(allFullUsers.value)} is users and ${usd(allFullData.value)} is data. Option B, 4 full platform users and 8 core users on Standard: ${usd(mixedTotal)}, of which ${usd(mixedFullUsers.value)} is full platform users, ${usd(coreCost)} core users and ${usd(mixedData.value)} data.`}>
                        <div class="bars__legend" aria-hidden="true">
                            {[meters.full, meters.core, meters.data].map((m) => (
                                <span style={`--meter: ${m.color}`}><i></i>{m.name}</span>
                            ))}
                        </div>
                        <div class="bars__rows" aria-hidden="true">
                            {scenarios.map((s) => (
                                <div class="bars__row">
                                    <div class="bars__head">
                                        <span><strong>{s.label}</strong> {s.title}</span>
                                        <strong class="bars__total">{usd(s.total)}<small> a month</small></strong>
                                    </div>
                                    <div class="bars__track">
                                        {s.parts.map((p) => (
                                            <span class="bars__seg" style={`--meter: ${p.meter.color}; width: ${(p.value / maxTotal) * 100}%`}></span>
                                        ))}
                                    </div>
                                    <div class="bars__parts">
                                        {s.parts.map((p) => (
                                            <span style={`--meter: ${p.meter.color}`}><i></i>{p.detail} = {usd(p.value)}</span>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                        <figcaption>Both bars on one scale. The data cost is the same {usd(allFullData.value)} in both; in option A, users are {seatShareA}% of the bill.</figcaption>
                    </figure>

                    <p>
                        Option B stays on Standard because the five-user limit counts only full platform users. It works if the eight core users can do without the curated APM and infrastructure views, which usually means the people who are not on call.
                    </p>

                    <h3>How the total moves</h3>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Change</th><th>Effect</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Switch to Data Plus</td><td>{billableGb} GB × $0.60 = {usd(dataPlusCost)}, {usd(dataPlusCost - allFullData.value)} a month more on either option</td></tr>
                                <tr><td>Option A month to month</td><td>12 × $418.80 = {usd(proMonthlyUsers)} for users, {usd(proMonthlyUsers - allFullUsers.value)} a month more</td></tr>
                                <tr><td>A 13th full platform user on A</td><td>$349 a month more</td></tr>
                                <tr><td>Double the data to 1,600 GB</td><td>{usd(800 * 0.4)} a month more</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        For comparison, the same {dataGb} GB on Maple's Startup plan comes to about {usd(maple.total)} a month with no per-user fee: $39 including 100 GB per signal, then $0.30 per GB, assuming the volume splits evenly across logs, traces and metrics. The <a href="/compare/new-relic">Maple vs New Relic comparison</a> has a calculator for your own numbers.
                    </p>

                    <h3 id="dynatrace" class="scroll-mt-24">Dynatrace vs New Relic pricing</h3>
                    <p>
                        The two vendors bill different things. New Relic counts people and GB and ignores hosts. Dynatrace counts hosts and GiB of logs and traces, charges nothing per user, and sells through an annual minimum commitment.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th></th><th>New Relic</th><th>Dynatrace</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Users</td><td>$10 to $418.80 per full platform user a month</td><td>No per-user fee</td></tr>
                                <tr><td>Hosts</td><td>Free</td><td>$58/mo per 8 GiB full-stack host, $29/mo infrastructure-only</td></tr>
                                <tr><td>Logs and traces</td><td>$0.40/GB past 100 GB, queries included</td><td>$0.20/GiB to ingest, plus retention and query fees for logs</td></tr>
                                <tr><td>Free option</td><td>Permanent free tier</td><td>15-day trial</td></tr>
                                <tr><td>Commitment</td><td>Optional</td><td>Annual minimum spend</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Before data, five Standard users on New Relic cost $406 a month, while 100 full-stack hosts of 8 GiB on Dynatrace cost $5,800. Swap the sizes and the order flips: 40 Pro users cost $13,960, and 20 Dynatrace hosts cost $1,160. The <a href="/guides/dynatrace-pricing">Dynatrace pricing guide</a> covers its rate card in detail.
                    </p>
                </section>

                <section id="reduce" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>06</span> · Cost control</p>
                    <h2>Lowering a New Relic bill</h2>
                    <p>
                        Seats move the bill more than data does, so start with who holds which user type, then cut data you never query.
                    </p>

                    <ol class="guide-steps">
                        <li>
                            <span>01</span>
                            <div>
                                <h4 id="measure" class="scroll-mt-24">Measure ingest and seats</h4>
                                <p>New Relic records its own usage in the <code>NrConsumption</code> and <code>NrMTDConsumption</code> event types, which do not count toward ingest. Run these in the New Relic query builder. Daily GB by source over three months:</p>
                                <pre><code set:html={highlight(ingestQuery, "nrql")} /></pre>
                                <p>Billable users so far this month:</p>
                                <pre><code set:html={highlight(userQuery, "nrql")} /></pre>
                                <p>GB ingested so far this month. Put an alert condition on it at your budget, or at 70 GB on the free tier:</p>
                                <pre><code set:html={highlight(alertQuery, "nrql")} /></pre>
                            </div>
                        </li>
                        <li>
                            <span>02</span>
                            <div>
                                <h4>Move people to cheaper user types</h4>
                                <p>Downgrade people who only read dashboards to basic, and people who mostly work in logs and errors to core. Because a month bills at the highest type held, make changes on the first of the month, and on a commitment contract avoid the second downgrade-upgrade cycle.</p>
                            </div>
                        </li>
                        <li>
                            <span>03</span>
                            <div>
                                <h4>Drop data before it is billed</h4>
                                <p>Ingest is measured after New Relic's processing, so dropped data is never billed. Since August 31, 2026, <strong>Pipeline Control</strong> cloud rules have replaced NRQL drop rules for this inside New Relic, and its gateway can filter in your own Kubernetes cluster. Dropped data cannot be recovered.</p>
                            </div>
                        </li>
                        <li>
                            <span>04</span>
                            <div>
                                <h4>Commit once usage is stable</h4>
                                <p>A 1-year Pro commitment saves $69.80 per full platform user a month, and commitment contracts add volume discounts. The commitment is owed whether you use it or not, so sign after a few months of measured usage.</p>
                            </div>
                        </li>
                    </ol>

                    <h3 id="collector" class="scroll-mt-24">Filter in an OpenTelemetry Collector</h3>
                    <p>
                        If your services already export OpenTelemetry, an <a href="https://opentelemetry.io/docs/collector/" target="_blank" rel="noopener noreferrer">OpenTelemetry Collector</a> running in your infrastructure can drop data before it reaches any vendor. This configuration receives OTLP from your services on the Collector's default ports (4317 for gRPC, 4318 for HTTP), drops DEBUG and TRACE logs (logs with no severity set pass through), and exports traces and logs to New Relic's OTLP endpoint with your license key:
                    </p>
                    <div class="code-file">
                        <p class="code-file__name">otel-collector.yaml</p>
                        <pre><code set:html={highlight(collectorConfig, "yaml")} /></pre>
                    </div>
                    <p>
                        The <code>otlphttp/maple</code> exporter sends a copy of the same data to Maple, so you can compare what each vendor would bill for identical traffic. Delete it, and its name in both <code>exporters</code> lists, if you only want the filter. Sampling traces and dropping attributes nobody queries cut ingest the same way; <a href="/docs/concepts/sampling-throughput">sampling and throughput</a> covers how Maple keeps request rates accurate under sampling.
                    </p>
                    <p>
                        After a few days of dual export, compare the GB each signal sent to Maple with the <code>NrConsumption</code> numbers from the first query.
                    </p>

                    <div class="guide-maple">
                        <p class="guide-kicker">Send to Maple</p>
                        <h3>Point an OTLP exporter at Maple</h3>
                        <p>Ingest keys, regions and the endpoint are in the docs; pricing is per GB with no seat fees.</p>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <a href="/docs/getting-started/quickstart" class="guide-button guide-button--primary">Quickstart</a>
                            <a href="/docs/reference/ingest" class="guide-button">Ingest API</a>
                            <a href="/pricing" class="guide-button">Maple pricing</a>
                        </div>
                    </div>
                </section>

                <section class="guide-sources">
                    <p class="guide-eyebrow">Sources, last verified {updatedLabel}</p>
                    <ul>
                        <li><a href="https://newrelic.com/pricing" target="_blank" rel="noopener noreferrer">New Relic: pricing</a></li>
                        <li><a href="https://newrelic.com/pricing/compute" target="_blank" rel="noopener noreferrer">New Relic: compute pricing</a></li>
                        <li><a href="https://docs.newrelic.com/docs/accounts/accounts-billing/new-relic-one-pricing-billing/new-relic-one-pricing-billing/" target="_blank" rel="noopener noreferrer">New Relic docs: pricing and billing</a></li>
                        <li><a href="https://docs.newrelic.com/docs/accounts/accounts-billing/new-relic-one-user-management/user-type/" target="_blank" rel="noopener noreferrer">New Relic docs: user types</a></li>
                        <li><a href="https://docs.newrelic.com/docs/accounts/accounts-billing/new-relic-one-pricing-billing/usage-queries-alerts/" target="_blank" rel="noopener noreferrer">New Relic docs: usage queries and alerts</a></li>
                        <li><a href="https://docs.newrelic.com/eol/2025/05/drop-rule-filter/" target="_blank" rel="noopener noreferrer">New Relic docs: NRQL drop rules end of life</a></li>
                        <li><a href="https://docs.newrelic.com/docs/opentelemetry/best-practices/opentelemetry-otlp/" target="_blank" rel="noopener noreferrer">New Relic docs: OTLP endpoint</a></li>
                        <li><a href="https://www.dynatrace.com/pricing/" target="_blank" rel="noopener noreferrer">Dynatrace: pricing</a></li>
                        <li><a href="/docs/reference/ingest">Maple docs: Ingest API</a></li>
                    </ul>
                </section>
            </article>
