---
/**
 * CustomerLogos — the "trusted by" band.
 *
 * Two shapes. `section` (default) is the standalone band: an infinite,
 * edge-faded marquee in its own bordered section. `rail` is the right half of
 * the hero's proof rail — no shell, no border, an eyebrow and a static row of
 * lockups, because a five-logo marquee visibly repeats every five items and
 * announces "we have five" louder than simply showing five does.
 *
 * Companies come from the `logos` content collection; each entry's id maps to a
 * brand logo component in the LOGOS registry below. The marquee is pure CSS
 * (logo-marquee keyframe): one copy of the row is duplicated and the belt
 * translates -50% for a seamless loop. No JS island. `href` is optional:
 * present → external link, absent → static lockup.
 */
import { getCollection } from "astro:content";
import * as m from "../paraglide/messages.js";
import { LOGOS } from "../lib/customer-logos";
import { getSortedStories, getStoryCustomer } from "../lib/customers";

interface Props {
	variant?: "section" | "rail";
}

const { variant = "section" } = Astro.props;

const entries = (await getCollection("logos"))
	.filter((e) => LOGOS[e.id])
	.sort((a, b) => a.data.order - b.data.order);

const base = entries.map((e) => ({ id: e.id, name: e.data.name, href: e.data.href }));

// The rail points at the featured (else newest) customer story, when one is
// published. English-only, like /blog: a bare href, not l().
const stories = await getSortedStories();
const story = stories.find((s) => s.data.featured) ?? stories[0];
const storyCustomer = story ? await getStoryCustomer(story) : undefined;
const StoryLogo = storyCustomer ? LOGOS[storyCustomer.id] : undefined;
const storyStat = story?.data.highlights[0];

// The customer set is small, so repeat it until one "copy" is wide enough to
// fill a large viewport, then duplicate that copy so the -50% translate loops
// seamlessly. Only the first real pass is announced to assistive tech.
const repeats = Math.max(2, Math.ceil(12 / Math.max(base.length, 1)));
const oneCopy = Array.from({ length: repeats }, () => base).flat();
const belt = [...oneCopy, ...oneCopy];
---

{
	variant === "rail" ? (
		<div class="flex flex-col gap-3">
		<div class="flex flex-wrap items-center gap-x-7 gap-y-3">
			<p class="w-full text-[10px] uppercase tracking-[0.2em] text-fg-muted sm:w-auto sm:mr-1">
				{m.customers_eyebrow()}
			</p>
			{base.map((logo) => {
				const Logo = LOGOS[logo.id];
				// Same lockup as the marquee — mark plus wordmark. The mark
				// alone is ambiguous at this size for the single-letter brands.
				const inner = (
					<>
						<Logo class="logo-cell__mark h-6 w-auto" />
						<span class="font-display text-sm font-semibold tracking-[-0.01em]">{logo.name}</span>
					</>
				);
				return logo.href ? (
					<a
						href={logo.href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={logo.name}
						class="inline-flex items-center gap-3 text-fg-muted transition-colors hover:text-fg"
					>
						{inner}
					</a>
				) : (
					<span class="inline-flex items-center gap-3 text-fg-muted">{inner}</span>
				);
			})}
		</div>
		{story && storyCustomer && (
			<a
				href={`/customers/${story.id}`}
				class="monument-story"
				aria-label={`${storyCustomer.data.name}: ${storyStat ? `${storyStat.value} ${storyStat.label}. ` : ""}${m.customers_story_cta()}`}
				data-track="cta_click"
				data-track-location="hero_customer_story"
				data-track-destination={`/customers/${story.id}`}
			>
				{StoryLogo && <StoryLogo class="monument-story__mark" />}
				<span class="monument-story__name">{storyCustomer.data.name}</span>
				{storyStat && (
					<span class="monument-story__stat">
						<strong>{storyStat.value}</strong> {storyStat.label}
					</span>
				)}
				<span class="monument-story__cta">
					{m.customers_story_cta()}
					<span class="monument-story__arrow" aria-hidden="true">→</span>
				</span>
			</a>
		)}
		</div>
	) : (
		<Fragment>
<section class="border-y border-border bg-bg">
	<div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
		<p class="text-center text-[11px] uppercase tracking-[0.2em] text-fg-muted mb-10">
			{m.customers_eyebrow()}
		</p>
		<div class="logo-marquee">
			<div class="logo-marquee__belt">
				{
					belt.map((logo, i) => {
						const Logo = LOGOS[logo.id];
						const decorative = i >= base.length;
						const inner = (
							<>
								<Logo class="logo-cell__mark h-8 w-auto" />
								<span class="logo-cell__name">{logo.name}</span>
							</>
						);
						return logo.href ? (
							<a
								href={logo.href}
								target="_blank"
								rel="noopener noreferrer"
								class="logo-cell"
								aria-label={logo.name}
								aria-hidden={decorative ? "true" : undefined}
								tabindex={decorative ? -1 : undefined}
							>
								{inner}
							</a>
						) : (
							<span class="logo-cell" aria-hidden={decorative ? "true" : undefined}>
								{inner}
							</span>
						);
					})
				}
			</div>
		</div>
	</div>
</section>
		</Fragment>
	)
}
