---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";

const pageTitle = "Pino Logger for Node.js: Levels, pino-pretty, Transports and Trace IDs";
const pageDescription =
    "Use the Pino logger in Node.js: log levels, child loggers, redaction, pino-pretty, transports, Express, Fastify, Pino vs Winston and trace IDs in logs.";
const published = "2026-10-19";
const updatedLabel = "October 19, 2026";

const toc = [
    ["what-is-pino", "Pino in brief"],
    ["install", "Install and first log"],
    ["log-levels", "Log levels"],
    ["child-loggers", "Child loggers"],
    ["redaction", "Redaction"],
    ["serializers", "Serializers"],
    ["pino-pretty", "pino-pretty"],
    ["transports", "Transports"],
    ["destinations", "Async and sync"],
    ["express-fastify", "Express and Fastify"],
    ["pino-vs-winston", "Pino vs Winston"],
    ["opentelemetry", "Trace IDs with OpenTelemetry"],
] as const;
const tocHeadings = toc.map(([slug, text]) => ({ depth: 2, slug, text }));

const faqs = [
    {
        question: "What is Pino?",
        answer:
            "Pino is an open-source (MIT) logger for Node.js that writes each log record as one line of JSON. It keeps work on the main thread small: records are serialized quickly and written through a fast stream, while formatting and shipping logs to other systems run in transports on worker threads. Fastify uses Pino as its built-in logger.",
    },
    {
        question: "Pino vs Winston: which should I use?",
        answer:
            "Pick Pino when you want JSON logs with low overhead and plan to process them elsewhere, which is the usual setup for services in containers. Pick Winston when you want flexible formatting and many output targets configured inside the process, and per-call overhead matters less. Both have OpenTelemetry instrumentations that add trace IDs to records.",
    },
    {
        question: "How do I pretty print Pino logs?",
        answer:
            "Install pino-pretty as a dev dependency. Either pipe the output through it (node app.js | npx pino-pretty) or set transport: { target: \"pino-pretty\" } in the logger options only when NODE_ENV is development. Keep production output as plain JSON so log tooling can parse it.",
    },
    {
        question: "How do I set the Pino log level?",
        answer:
            "Pass level in the options, for example pino({ level: process.env.LOG_LEVEL ?? \"info\" }). The default is info. You can change it at runtime with logger.level = \"debug\", and give a child logger its own level with logger.child(bindings, { level: \"warn\" }).",
    },
    {
        question: "How do I add trace IDs to Pino logs?",
        answer:
            "Run your app with the OpenTelemetry Node.js SDK and its auto-instrumentations. The pino instrumentation adds trace_id, span_id and trace_flags to every record written inside an active span, and also sends the record to the OpenTelemetry log SDK, so a configured OTLP log exporter ships it with the trace context attached. No change to your logging calls is needed.",
    },
    {
        question: "Is Pino synchronous or asynchronous?",
        answer:
            "The default destination writes to stdout without blocking. Records are not buffered, so each call is written right away, and Pino flushes what is pending when the process exits normally. pino.destination({ minLength: 4096 }) adds buffering for more throughput; sync: true makes every write blocking, which is the recommended setting on AWS Lambda.",
    },
];

const installSnippet = `npm install pino
npm install --save-dev pino-pretty`;

const firstLogSnippet = `// app.mjs
import pino from "pino"

const logger = pino()

logger.info("server started")
logger.info({ port: 3000 }, "listening")
logger.info("user %s signed in after %d ms", "ada", 42)
logger.error(new Error("connection refused"), "payment provider unreachable")`;

const firstLogOutput = `{"level":30,"time":1792429189089,"pid":4812,"hostname":"api-1","msg":"server started"}
{"level":30,"time":1792429189089,"pid":4812,"hostname":"api-1","port":3000,"msg":"listening"}
{"level":30,"time":1792429189089,"pid":4812,"hostname":"api-1","msg":"user ada signed in after 42 ms"}
{"level":50,"time":1792429189089,"pid":4812,"hostname":"api-1","err":{"type":"Error","message":"connection refused","stack":"Error: connection refused\\n    at file:///srv/app.mjs:9:14 ..."},"msg":"payment provider unreachable"}`;

const levelSnippet = `const logger = pino({ level: process.env.LOG_LEVEL ?? "info" })

logger.debug("dropped, because debug is below info")

logger.level = "debug" // change it at runtime, for example from an admin endpoint
logger.debug("written now")

if (logger.isLevelEnabled("trace")) {
  logger.trace({ memory: process.memoryUsage() }, "memory snapshot")
}`;

const childSnippet = `const logger = pino()

const billing = logger.child({ module: "billing" })
const log = billing.child({ requestId: "req_8f2c" })

log.warn({ invoiceId: "inv_1042" }, "invoice overdue")
// {"level":40,...,"module":"billing","requestId":"req_8f2c","invoiceId":"inv_1042","msg":"invoice overdue"}

const db = logger.child({ module: "db" }, { level: "warn" })
db.info("not written: this child only logs warn and above")`;

const redactSnippet = `const logger = pino({
  redact: {
    paths: ["password", "req.headers.authorization", 'req.headers["x-api-key"]', "cards[*].number"],
    censor: "[REDACTED]",
  },
})

logger.info({ password: "hunter2", cards: [{ number: "4242424242424242", brand: "visa" }] }, "signup")
// {"level":30,...,"password":"[REDACTED]","cards":[{"number":"[REDACTED]","brand":"visa"}],"msg":"signup"}`;

const serializerSnippet = `const logger = pino({
  serializers: {
    err: pino.stdSerializers.err,
    user: (user) => ({ id: user.id, plan: user.plan }),
  },
})

logger.info({ user: { id: "u_1", plan: "pro", email: "ada@example.com" } }, "loaded user")
// {"level":30,...,"user":{"id":"u_1","plan":"pro"},"msg":"loaded user"}`;

const prettySnippet = `const logger = pino({
  level: process.env.LOG_LEVEL ?? "info",
  transport:
    process.env.NODE_ENV === "development"
      ? {
          target: "pino-pretty",
          options: { colorize: true, translateTime: "SYS:HH:MM:ss", ignore: "pid,hostname" },
        }
      : undefined,
})`;

const prettyCliSnippet = `node app.mjs | npx pino-pretty -c -t "SYS:HH:MM:ss" -i pid,hostname`;

const prettyOutput = `[19:03:29] INFO: listening
    port: 3000`;

const transportSnippet = `const transport = pino.transport({
  targets: [
    { target: "pino-pretty", level: "info", options: { colorize: true } },
    { target: "pino/file", level: "debug", options: { destination: "./logs/app.log", mkdir: true } },
  ],
})

const logger = pino({ level: "debug" }, transport)

logger.debug("only in the file")
logger.info({ orderId: "ord_77" }, "in the terminal and in the file")`;

const destinationSnippet = `// Buffer 4 KiB before each write: more throughput, and a crash can lose the last buffer.
const logger = pino(pino.destination({ dest: "./logs/app.log", minLength: 4096, mkdir: true }))

// Block on every write: nothing is pending when the function returns.
const lambdaLogger = pino(pino.destination({ sync: true }))`;

const expressInstallSnippet = `npm install express pino pino-http`;

const expressSnippet = `// server.mjs
import express from "express"
import pino from "pino"
import { pinoHttp } from "pino-http"

const logger = pino({
  level: process.env.LOG_LEVEL ?? "info",
  redact: ["req.headers.authorization", "req.headers.cookie"],
})
const app = express()

app.use(
  pinoHttp({
    logger,
    customLogLevel: (req, res, err) =>
      err || res.statusCode >= 500 ? "error" : res.statusCode >= 400 ? "warn" : "info",
  }),
)

app.get("/orders/:id", (req, res) => {
  req.log.info({ orderId: req.params.id }, "loading order")
  res.json({ id: req.params.id })
})

app.listen(3000, () => logger.info({ port: 3000 }, "listening"))`;

const fastifySnippet = `// server.mjs
import Fastify from "fastify"

const app = Fastify({
  logger: { level: process.env.LOG_LEVEL ?? "info" },
})

app.get("/orders/:id", async (request) => {
  request.log.info({ orderId: request.params.id }, "loading order")
  return { id: request.params.id }
})

await app.listen({ port: 3000 })`;

const otelInstallSnippet = `npm install @opentelemetry/api \\
  @opentelemetry/sdk-node \\
  @opentelemetry/auto-instrumentations-node \\
  @opentelemetry/instrumentation \\
  @opentelemetry/resources \\
  @opentelemetry/sdk-logs \\
  @opentelemetry/sdk-metrics \\
  @opentelemetry/exporter-trace-otlp-proto \\
  @opentelemetry/exporter-logs-otlp-proto \\
  @opentelemetry/exporter-metrics-otlp-proto`;

const tracingSnippet = `// tracing.mjs
import { register } from "node:module"
import { NodeSDK } from "@opentelemetry/sdk-node"
import { getNodeAutoInstrumentations } from "@opentelemetry/auto-instrumentations-node"
import { resourceFromAttributes } from "@opentelemetry/resources"
import { BatchLogRecordProcessor } from "@opentelemetry/sdk-logs"
import { PeriodicExportingMetricReader } from "@opentelemetry/sdk-metrics"
import { OTLPTraceExporter } from "@opentelemetry/exporter-trace-otlp-proto"
import { OTLPLogExporter } from "@opentelemetry/exporter-logs-otlp-proto"
import { OTLPMetricExporter } from "@opentelemetry/exporter-metrics-otlp-proto"

// Lets the instrumentations patch ES modules. CommonJS apps can drop this line.
register("@opentelemetry/instrumentation/hook.mjs", import.meta.url)

const MAPLE_ENDPOINT = "https://ingest.maple.dev" // EU: https://ingest.eu.maple.dev
const MAPLE_KEY = "YOUR_INGEST_KEY"
const headers = { authorization: \`Bearer \${MAPLE_KEY}\` }

const sdk = new NodeSDK({
  resource: resourceFromAttributes({ "service.name": "orders-api" }),
  traceExporter: new OTLPTraceExporter({ url: \`\${MAPLE_ENDPOINT}/v1/traces\`, headers }),
  logRecordProcessors: [
    new BatchLogRecordProcessor({
      exporter: new OTLPLogExporter({ url: \`\${MAPLE_ENDPOINT}/v1/logs\`, headers }),
    }),
  ],
  metricReaders: [
    new PeriodicExportingMetricReader({
      exporter: new OTLPMetricExporter({ url: \`\${MAPLE_ENDPOINT}/v1/metrics\`, headers }),
    }),
  ],
  instrumentations: [getNodeAutoInstrumentations()],
})

sdk.start()

process.on("SIGTERM", () => {
  sdk.shutdown().finally(() => process.exit(0))
})`;

const runSnippet = `node --import ./tracing.mjs server.mjs`;

const correlatedOutput = `{"level":30,"time":1792429242653,"pid":4812,"hostname":"api-1","req":{"id":1,"method":"GET","url":"/orders/42",...},"trace_id":"e08d88aa5e99a090233a81b18df248dc","span_id":"5dc79b621fed8db5","trace_flags":"01","orderId":"42","msg":"loading order"}`;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Pino logger for Node.js: setup, levels, transports and trace IDs",
    description: pageDescription,
    datePublished: published,
    dateModified: published,
    author: { "@type": "Organization", name: "Maple" },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/pino-logger`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Pino logger for Node.js" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pb-16 pt-20 md:pb-24 md:pt-28 lg:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.75fr)] lg:items-center lg:gap-16">
                <div>
                    <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                        <span class="border border-primary/40 px-2 py-1 text-primary">Node.js logging</span>
                        <span>13 min read</span>
                    </div>
                    <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                        Pino logger for Node.js: setup, levels, transports and trace IDs
                    </h1>
                    <p class="mt-7 max-w-[62ch] text-[15px] leading-[1.75] text-fg-muted md:text-base">
                        A working Pino 10 setup: levels, child loggers, redaction, pino-pretty, transports, Express and Fastify, and the OpenTelemetry instrumentation that stamps each log line with the trace it belongs to.
                    </p>
                    <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                        <span>By Maple</span>
                        <time datetime={published}>Updated {updatedLabel}</time>
                    </div>
                </div>

                <div class="rounded-xl border border-border bg-bg-deep p-4 shadow-2xl shadow-black/20 md:p-5" aria-label="Pino at a glance">
                    <div class="flex items-center justify-between border-b border-border pb-3 font-mono text-[10px] text-fg-muted">
                        <span>pino / at a glance</span>
                        <span class="text-primary">v10</span>
                    </div>
                    <ol class="divide-y divide-border">
                        {[
                            ["01", "Output", "One JSON object per line", "NDJSON on stdout"],
                            ["02", "Levels", "trace 10 to fatal 60", "default info"],
                            ["03", "Context", "logger.child({ requestId })", "bindings on every line"],
                            ["04", "Secrets", "redact: [\"req.headers.authorization\"]", "built in"],
                            ["05", "Shipping", "pino.transport() in a worker", "off the main thread"],
                            ["06", "Trace IDs", "OpenTelemetry pino instrumentation", "trace_id, span_id"],
                        ].map(([number, label, headline, detail]) => (
                            <li class="grid grid-cols-[2rem_1fr] gap-3 py-3.5">
                                <span class="font-mono text-[10px] text-primary">{number}</span>
                                <div>
                                    <div class="flex items-baseline justify-between gap-3">
                                        <span class="text-xs font-medium text-fg">{label}</span>
                                        <span class="font-mono text-[9px] text-fg-muted">{detail}</span>
                                    </div>
                                    <p class="mt-1 font-mono text-[11px] leading-relaxed text-fg-muted">{headline}</p>
                                </div>
                            </li>
                        ))}
                    </ol>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {toc.map(([id, label]) => (
                    <a href={`#${id}`} class="transition-colors hover:text-primary">{label}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={tocHeadings} class="sticky top-28" />
            </aside>

            <article class="pino-guide min-w-0">
                <section id="what-is-pino" class="scroll-mt-24">
                    <p class="guide-eyebrow">01 · Definition</p>
                    <h2>Pino, the JSON logger for Node.js</h2>

                    <div class="guide-answer">
                        <p>
                            <strong>Pino</strong> is an MIT-licensed logger for Node.js that writes every record as a single line of JSON. It does as little as possible on the thread that serves requests: it serializes the record, writes it to a fast stream, and leaves pretty printing, file rotation and shipping to <strong>transports</strong> that run on worker threads.
                        </p>
                    </div>

                    <p>
                        That design suits services that run in containers or on platforms that collect stdout. The application emits structured JSON, and something outside the hot path decides how to format or forward it. Fastify ships Pino as its built-in logger, and <code>pino-http</code> adds request logging to Express, Koa and plain <code>http</code> servers.
                    </p>
                    <p>
                        Pino ships its own TypeScript definitions, so <code>import pino, &#123; type Logger &#125; from "pino"</code> works without an <code>@types</code> package.
                    </p>
                </section>

                <section id="install" class="scroll-mt-24">
                    <p class="guide-eyebrow">02 · Setup</p>
                    <h2>Install Pino and write the first log line</h2>
                    <pre><code>{installSnippet}</code></pre>
                    <p>
                        <code>pino-pretty</code> is only for reading logs in a terminal, so it goes in dev dependencies. The logger itself needs no configuration to start:
                    </p>
                    <pre><code>{firstLogSnippet}</code></pre>
                    <pre><code>{firstLogOutput}</code></pre>
                    <p>
                        Each logging method takes an optional object first and a message second. The object's keys are merged into the top level of the record, which is what makes the output searchable by field later. Strings after the message fill <code>%s</code>, <code>%d</code> and <code>%o</code> placeholders. An <code>Error</code> passed first is serialized under <code>err</code> with its type, message and stack.
                    </p>
                    <p>
                        Put the data in the object rather than in the message. <code>logger.info(&#123; orderId &#125;, "order created")</code> gives you a field to filter on; <code>logger.info(`order $&#123;orderId&#125; created`)</code> gives you a string you have to parse back.
                    </p>
                </section>

                <section id="log-levels" class="scroll-mt-24">
                    <p class="guide-eyebrow">03 · Levels</p>
                    <h2>Pino log levels and how to set the level</h2>
                    <p>
                        Pino writes the level as a number. A logger drops every call below its configured level before doing any serialization work, so a disabled <code>debug</code> call costs almost nothing.
                    </p>

                    <div class="guide-table-wrap">
                        <table>
                            <thead>
                                <tr><th>Level</th><th>Value</th><th>Use it for</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><code>fatal</code></td><td>60</td><td>The process is about to exit.</td></tr>
                                <tr><td><code>error</code></td><td>50</td><td>A request or job failed and someone may need to act.</td></tr>
                                <tr><td><code>warn</code></td><td>40</td><td>Something unexpected that the code recovered from: a retry, a fallback, a slow dependency.</td></tr>
                                <tr><td><code>info</code></td><td>30</td><td>The default. Lifecycle events and one line per unit of work.</td></tr>
                                <tr><td><code>debug</code></td><td>20</td><td>Detail you turn on while investigating.</td></tr>
                                <tr><td><code>trace</code></td><td>10</td><td>Very verbose output, usually only in local development.</td></tr>
                                <tr><td><code>silent</code></td><td>Infinity</td><td>Disables logging entirely, for example in tests.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <pre><code>{levelSnippet}</code></pre>
                    <p>
                        Read the level from an environment variable so you can raise it for one deploy without a code change. Guard expensive arguments with <code>isLevelEnabled()</code>: the call is skipped when the level is off, but its arguments are still evaluated. If you need different names, <code>customLevels</code> adds levels with your own numbers.
                    </p>
                </section>

                <section id="child-loggers" class="scroll-mt-24">
                    <p class="guide-eyebrow">04 · Context</p>
                    <h2>Child loggers and bindings</h2>
                    <p>
                        <code>logger.child(bindings)</code> returns a logger that adds the same fields to every record it writes. Pino serializes the bindings once, when the child is created, so per-request children are cheap.
                    </p>
                    <pre><code>{childSnippet}</code></pre>
                    <p>
                        The usual pattern is one child per request or per job, carrying a request ID, tenant or job name, passed down to whatever code handles that unit of work. <code>pino-http</code> and Fastify create that child for you as <code>req.log</code> and <code>request.log</code>. The second argument to <code>child()</code> can override <code>level</code>, <code>redact</code>, <code>serializers</code> and <code>msgPrefix</code> for that child only.
                    </p>
                </section>

                <section id="redaction" class="scroll-mt-24">
                    <p class="guide-eyebrow">05 · Secrets</p>
                    <h2>Redact passwords, tokens and card numbers</h2>
                    <p>
                        The <code>redact</code> option replaces values at the paths you list before the line is written. Paths use JavaScript dot and bracket notation, <code>[*]</code> matches every array element or key, and keys with hyphens need brackets.
                    </p>
                    <pre><code>{redactSnippet}</code></pre>
                    <p>
                        The default censor is <code>"[Redacted]"</code>. Set <code>remove: true</code> to drop the key instead, or pass a function as <code>censor</code> to mask part of a value. Pino's documentation warns never to build redaction paths from user input. Redaction only covers the paths you list, so a token logged under a new key name goes out in clear text; keeping whole request bodies out of logs is the safer default.
                    </p>
                </section>

                <section id="serializers" class="scroll-mt-24">
                    <p class="guide-eyebrow">06 · Serializers</p>
                    <h2>Serializers decide how objects are written</h2>
                    <p>
                        A serializer is a function keyed by a top-level property name. Whenever a record has that key, Pino writes the function's return value instead of the original object. It is the place to turn a large domain object into the handful of fields you want to search on.
                    </p>
                    <pre><code>{serializerSnippet}</code></pre>
                    <p>
                        <code>pino.stdSerializers</code> provides <code>err</code>, <code>req</code> and <code>res</code>. <code>err</code> is on by default and also runs when you pass an <code>Error</code> as the first argument. Serializers must return something JSON-serializable and must not throw. They only match top-level keys, and for child bindings they run once at creation time, not on every call.
                    </p>
                </section>

                <section id="pino-pretty" class="scroll-mt-24">
                    <p class="guide-eyebrow">07 · Development</p>
                    <h2>Pretty print Pino logs with pino-pretty</h2>
                    <p>
                        Raw NDJSON is hard to scan in a terminal. <code>pino-pretty</code> turns it into colored, indented lines. Load it as a transport only when <code>NODE_ENV</code> is <code>development</code>, so a production install without dev dependencies never asks for it:
                    </p>
                    <pre><code>{prettySnippet}</code></pre>
                    <pre><code>{prettyOutput}</code></pre>
                    <p>
                        Or leave the code alone and pipe the output through the CLI, which takes the same options as flags:
                    </p>
                    <pre><code>{prettyCliSnippet}</code></pre>
                    <p>
                        The pino-pretty README recommends against using it in production. Production output should stay JSON, so whatever collects it can parse fields instead of matching text. <code>logger.flush()</code> also does not flush pino-pretty's own buffer, which matters if you rely on the last lines before a crash.
                    </p>
                </section>

                <section id="transports" class="scroll-mt-24">
                    <p class="guide-eyebrow">08 · Transports</p>
                    <h2>Pino transports and worker threads</h2>
                    <p>
                        A transport is a module that receives Pino's JSON lines and writes them somewhere. <code>pino.transport()</code> starts it in a worker thread, so formatting and network I/O do not compete with request handling. With <code>targets</code>, one logger fans out to several transports, each with its own minimum level.
                    </p>
                    <pre><code>{transportSnippet}</code></pre>
                    <ul>
                        <li><code>target</code> is a package name (<code>pino-pretty</code>, <code>pino/file</code>, which ships with Pino) or an absolute path to your own module.</li>
                        <li>A target without a <code>level</code> defaults to <code>info</code>. The logger's own level still applies first, so set it to the lowest level any target needs.</li>
                        <li><code>options</code> is copied to the worker with the structured clone algorithm, so it cannot contain functions.</li>
                        <li>Pass a transport either as the <code>transport</code> option or as the second argument to <code>pino()</code>. Passing both a <code>transport</code> option and a destination throws.</li>
                        <li>Pino flushes the worker on a normal exit. An <code>'error'</code> event from a transport is fatal, according to the Pino docs, and the process should be terminated.</li>
                    </ul>
                    <p>
                        <code>pino-opentelemetry-transport</code> is one of these transports: it converts lines to OpenTelemetry log records inside the worker. The instrumentation route in the <a href="#opentelemetry">OpenTelemetry section</a> covers most apps with less setup, because it also adds the trace context.
                    </p>
                </section>

                <section id="destinations" class="scroll-mt-24">
                    <p class="guide-eyebrow">09 · Performance</p>
                    <h2>Asynchronous and synchronous destinations</h2>
                    <p>
                        Without a transport, Pino writes to a destination built on <code>sonic-boom</code>. The default one writes to stdout without blocking and without buffering: each call is handed to the file descriptor right away, and Pino flushes anything pending when the process exits normally. <code>pino.destination()</code> lets you change both.
                    </p>
                    <pre><code>{destinationSnippet}</code></pre>
                    <div class="guide-table-wrap">
                        <table>
                            <thead>
                                <tr><th>Setting</th><th>Behaviour</th><th>Use it when</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Default (<code>sync: false</code>, <code>minLength: 0</code>)</td><td>Non-blocking, written immediately</td><td>Most services</td></tr>
                                <tr><td><code>minLength: 4096</code></td><td>Collects 4 KiB before each write</td><td>Very high log volume, where losing the last buffer on a crash is acceptable</td></tr>
                                <tr><td><code>sync: true</code></td><td>Blocks until each write completes</td><td>AWS Lambda and other runtimes that freeze the process after a response</td></tr>
                                <tr><td><code>pino.transport()</code></td><td>Worker thread does formatting and I/O</td><td>Pretty printing, files with several levels, sending to a network service</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Pino's documentation notes that buffered asynchronous logging in Lambda tends to delay or lose messages, because the runtime freezes before the buffer is written.
                    </p>
                </section>

                <section id="express-fastify" class="scroll-mt-24">
                    <p class="guide-eyebrow">10 · HTTP servers</p>
                    <h2>Pino with Express (pino-http) and Fastify</h2>
                    <h3>Express with pino-http</h3>
                    <pre><code>{expressInstallSnippet}</code></pre>
                    <pre><code>{expressSnippet}</code></pre>
                    <p>
                        <code>pino-http</code> writes one <code>request completed</code> line per request with the method, URL, status code and <code>responseTime</code> in milliseconds. It also attaches a child logger as <code>req.log</code> carrying a request <code>id</code>, so every line a handler writes can be tied to the request. <code>customLogLevel</code> logs 4xx responses as <code>warn</code> and 5xx as <code>error</code>; without it every response is <code>info</code>. The older <code>express-pino-logger</code> package is deprecated in favour of <code>pino-http</code>.
                    </p>
                    <p>
                        The default request serializer includes every request header, which is why the logger above redacts <code>authorization</code> and <code>cookie</code>. Add any other header that carries a credential, such as an API key header.
                    </p>

                    <h3>Fastify</h3>
                    <pre><code>{fastifySnippet}</code></pre>
                    <p>
                        Fastify creates the Pino logger itself from the <code>logger</code> option, which accepts <code>true</code> or any Pino options, including <code>redact</code> and <code>transport</code>. It logs <code>incoming request</code> and <code>request completed</code> with a <code>reqId</code>, and <code>request.log</code> is the per-request child. To pass a Pino instance you created yourself, Fastify 5 uses the separate <code>loggerInstance</code> option.
                    </p>
                </section>

                <section id="pino-vs-winston" class="scroll-mt-24">
                    <p class="guide-eyebrow">11 · Comparison</p>
                    <h2>Pino vs Winston</h2>
                    <p>
                        Winston is the other widely used Node.js logger. Both are MIT-licensed and both work with OpenTelemetry. They differ mostly in where the formatting and shipping work happens.
                    </p>
                    <div class="guide-table-wrap">
                        <table>
                            <thead>
                                <tr><th></th><th>Pino</th><th>Winston</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Default output</td><td>NDJSON, one object per line</td><td>Set by <code>format</code>; JSON is one of many formats</td></tr>
                                <tr><td>Levels</td><td>trace 10, debug 20, info 30, warn 40, error 50, fatal 60</td><td>npm levels: error 0, warn 1, info 2, http 3, verbose 4, debug 5, silly 6</td></tr>
                                <tr><td>Formatting</td><td>Outside the app: pino-pretty, or your log tooling</td><td>In-process with composable <code>format.combine()</code></td></tr>
                                <tr><td>Transports</td><td>Worker threads via <code>pino.transport()</code></td><td>Run in the main thread (Console, File, Http, Stream, community)</td></tr>
                                <tr><td>Child loggers</td><td><code>logger.child()</code>, bindings serialized once</td><td><code>logger.child()</code> merges default metadata</td></tr>
                                <tr><td>Redaction</td><td>Built-in <code>redact</code> option</td><td>Write a custom format</td></tr>
                                <tr><td>HTTP request logging</td><td>Fastify's built-in logger; <code>pino-http</code> for Express</td><td>Middleware such as <code>express-winston</code></td></tr>
                                <tr><td>OpenTelemetry</td><td>Instrumentation adds trace context and sends records to the log SDK</td><td>Instrumentation adds trace context; sending needs <code>@opentelemetry/winston-transport</code></td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Choose Pino when logs are JSON headed for a collector and you want the smallest per-call cost; Pino publishes its own benchmarks against other loggers. Choose Winston when the process itself must write several formats to several destinations, or an existing codebase already depends on its format pipeline. Moving between them is mostly mechanical, because both take a metadata object and a message, though Pino puts the object first.
                    </p>
                </section>

                <section id="opentelemetry" class="scroll-mt-24">
                    <p class="guide-eyebrow">12 · Correlation</p>
                    <h2>Add trace IDs to Pino logs with OpenTelemetry</h2>
                    <p>
                        A log line that says <code>payment provider unreachable</code> is more useful when you can open the request it came from. The OpenTelemetry pino instrumentation handles both sides without changes to your logging calls:
                    </p>
                    <ul>
                        <li>Log correlation: records written inside an active span get <code>trace_id</code>, <code>span_id</code> and <code>trace_flags</code> fields in the JSON line.</li>
                        <li>Log sending: each record also goes to the OpenTelemetry log SDK, which exports it over OTLP with the trace context, level and fields attached. This needs Pino 7 or later.</li>
                    </ul>
                    <p>
                        The instrumentation is part of <code>@opentelemetry/auto-instrumentations-node</code>, so the standard Node.js SDK setup turns it on. Install the SDK packages:
                    </p>
                    <pre><code>{otelInstallSnippet}</code></pre>
                    <p>
                        Create <code>tracing.mjs</code>. It starts the SDK before your application code loads Pino, which is what lets the instrumentation patch it:
                    </p>
                    <pre><code>{tracingSnippet}</code></pre>
                    <p>
                        An ingest key can only write telemetry to your organization; it cannot read data. To keep it out of source anyway, the SDK can take its whole configuration from the standard <code>OTEL_*</code> variables, as shown in <a href="/docs/guides/instrumentation-nodejs#environment-variables">the Node.js guide's environment variables section</a>.
                    </p>
                    <div class="guide-callout">
                        <p class="guide-kicker">Check the BatchLogRecordProcessor signature</p>
                        <p>
                            Current <code>@opentelemetry/sdk-logs</code> releases take an options object, <code>new BatchLogRecordProcessor(&#123; exporter &#125;)</code>. Older releases took the exporter as the first argument. Passing an exporter to a release that expects the object raises no error and no log record leaves the process, so check the installed <code>.d.ts</code> if logs never arrive.
                        </p>
                    </div>
                    <p>
                        Load it ahead of the app. The Express server from the previous section needs no other change:
                    </p>
                    <pre><code>{runSnippet}</code></pre>
                    <pre><code>{correlatedOutput}</code></pre>
                    <p>
                        Stdout now carries the trace ID, and the same record is exported to <code>/v1/logs</code> with Pino's level label as severity text and the matching OpenTelemetry severity number. Your own fields, such as <code>orderId</code>, become log attributes. The exported record drops the <code>trace_id</code>, <code>span_id</code>, <code>pid</code> and <code>hostname</code> fields from its attributes, because the trace context and resource carry them. Records written outside a span, such as the startup <code>listening</code> line, are still exported, just without a trace ID.
                    </p>
                    <p>
                        Log sending forwards everything the logger writes after its own level filter, independent of any per-target levels in a <code>pino.transport()</code>. To keep only correlation and ship logs another way, configure the instrumentation with <code>disableLogSending: true</code> in <code>getNodeAutoInstrumentations(&#123; "@opentelemetry/instrumentation-pino": &#123; disableLogSending: true &#125; &#125;)</code>.
                    </p>

                    <div class="guide-maple">
                        <p class="guide-kicker">Pino logs in Maple</p>
                        <h3>Send them to Maple and jump from a log line to its trace</h3>
                        <ol class="guide-steps">
                            <li>
                                <span>01</span>
                                <div><h3>Create an ingest key</h3><p>In Maple, open <strong>Settings &gt; Ingestion</strong> and copy the private key (<code>maple_sk_...</code>). Use it as <code>MAPLE_KEY</code> in <code>tracing.mjs</code>, and switch <code>MAPLE_ENDPOINT</code> to the EU host if your organization is in the EU region.</p></div>
                            </li>
                            <li>
                                <span>02</span>
                                <div><h3>Start the app with the SDK</h3><p>Run <code>node --import ./tracing.mjs server.mjs</code> and send it a few requests. The pino instrumentation sends each record through the log exporter, and the trace exporter sends the spans.</p></div>
                            </li>
                            <li>
                                <span>03</span>
                                <div><h3>Open the Logs page</h3><p>Records appear in <strong>Logs</strong> with a <strong>Severity</strong> filter built from Pino's levels and a <strong>Service</strong> filter from <code>service.name</code>. Paste a trace ID into the search box to see every line from one request.</p></div>
                            </li>
                            <li>
                                <span>04</span>
                                <div><h3>Move to the trace</h3><p>Open a record and click its <code>trace:</code> link to see the request's spans at the log's timestamp. From a trace, <strong>View Logs</strong> goes the other way.</p></div>
                            </li>
                        </ol>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <a href="/docs/guides/instrumentation-nodejs#log-correlation" class="guide-button guide-button--primary">Node.js instrumentation guide</a>
                            <a href="/docs/explore/logs" class="guide-button">Logs in Maple</a>
                        </div>
                    </div>
                </section>

