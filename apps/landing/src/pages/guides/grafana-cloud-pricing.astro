---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import "../../styles/pricing-guide.css";
import GuideBody from "../../components/guides/GuideBody.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { getOffer, money, rateLabel } from "../../lib/pricing-offer";

const pageTitle = "Grafana Cloud Pricing: Free Tier, Pro Rates and Worked Bills | Maple";
const pageDescription =
    "Grafana Cloud pricing explained: the free tier, Pro rates for metrics series, logs, traces and users, how DPM multiplies a metrics bill, and three worked monthly bills.";
const published = "2026-11-21";
const updated = "2026-11-21";
const updatedLabel = "November 21, 2026";
const verified = "2026-11-21";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const offer = await getOffer();
const gb = offer.allotments.find((a) => a.unit === "gb");

const toc = [
    { depth: 2, slug: "plans", text: "Plans and prices" },
    { depth: 3, slug: "free-tier", text: "The free tier" },
    { depth: 2, slug: "meters", text: "How each meter bills" },
    { depth: 3, slug: "metrics", text: "Metrics: series and DPM" },
    { depth: 3, slug: "logs-traces", text: "Logs and traces" },
    { depth: 3, slug: "users", text: "Users" },
    { depth: 3, slug: "volume", text: "Volume discounts" },
    { depth: 2, slug: "surprises", text: "What surprises teams" },
    { depth: 2, slug: "examples", text: "What a month costs" },
    { depth: 3, slug: "small-team", text: "Small team" },
    { depth: 3, slug: "mid-team", text: "Mid-sized team" },
    { depth: 3, slug: "scrape", text: "Same team, 30-second scrape" },
    { depth: 2, slug: "reduce", text: "Cutting the bill" },
    { depth: 2, slug: "maple", text: "Maple pricing" },
];

// One color per billed category, reused by the badges, the bill bars and the tables.
const cats = {
    base: { label: "Platform fee", color: "var(--muted-foreground)" },
    metrics: { label: "Metrics", color: "var(--chart-4)" },
    logs: { label: "Logs", color: "var(--chart-3)" },
    traces: { label: "Traces", color: "var(--chart-2)" },
    users: { label: "Users", color: "var(--chart-1)" },
    app: { label: "Application Observability", color: "var(--chart-5)" },
} as const;
type Cat = keyof typeof cats;

// Grafana Cloud Pro list prices in their first volume tier, verified on the date above.
const pro = {
    fee: 19,
    seriesPer1k: 6.5,
    gbProcess: 0.05,
    gbWrite: 0.4,
    gbRetain: 0.1,
    user: 8,
    appHostHour: 0.025,
};
// The free allotment offsets written GB only; processing is charged on everything received.
// Retain is charged only for 30-day increments beyond the 30 days Pro includes.
const signalCost = (gb: number, freeGb: number) => gb * pro.gbProcess + Math.max(0, gb - freeGb) * pro.gbWrite;
const signalCalc = (gb: number, freeGb: number) =>
    `${num(gb)} GB × $${pro.gbProcess.toFixed(2)} process + max(0, ${num(gb)} − ${freeGb} included) = ${num(Math.max(0, gb - freeGb))} GB × $${pro.gbWrite.toFixed(2)} write`;
const free = { seriesK: 10, logsGb: 50, tracesGb: 50, users: 3 };
const HOURS = 720; // a 30-day month, as Grafana's "$18/host" uses

const cents = (n: number) => Math.round(n * 100 + 1e-6) / 100;
const usd = (n: number) => `$${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const num = (n: number) => n.toLocaleString("en-US");

interface Usage { users: number; seriesK: number; dpm: number; logsGb: number; tracesGb: number; appHosts: number }
const bill = (u: Usage) => {
    const billableK = Math.max(u.seriesK, u.seriesK * u.dpm);
    const appHours = u.appHosts * HOURS;
    const lines: { cat: Cat; label: string; calc: string; cost: number }[] = [
        { cat: "base", label: "Pro platform fee", calc: "Monthly", cost: pro.fee },
        { cat: "users", label: "Active users", calc: `${u.users} − ${free.users} included = ${u.users - free.users} × $${pro.user}`, cost: Math.max(0, u.users - free.users) * pro.user },
        { cat: "metrics", label: "Metrics", calc: `${u.dpm > 1 ? `${num(u.seriesK)}k series × ${u.dpm} DPM = ` : ""}${num(billableK)}k − ${free.seriesK}k included = ${num(billableK - free.seriesK)}k × $${pro.seriesPer1k.toFixed(2)}`, cost: Math.max(0, billableK - free.seriesK) * pro.seriesPer1k },
        { cat: "logs", label: "Logs", calc: signalCalc(u.logsGb, free.logsGb), cost: signalCost(u.logsGb, free.logsGb) },
        { cat: "traces", label: "Traces", calc: signalCalc(u.tracesGb, free.tracesGb), cost: signalCost(u.tracesGb, free.tracesGb) },
        { cat: "app", label: "Application Observability", calc: `${u.appHosts} hosts × ${HOURS} h = ${num(appHours)} host-hours × $${pro.appHostHour}`, cost: appHours * pro.appHostHour },
    ]
        .map((l) => ({ ...l, cost: cents(l.cost) }))
        .filter((l) => l.cost > 0);
    const total = cents(lines.reduce((sum, l) => sum + l.cost, 0));
    const byCat = (Object.keys(cats) as Cat[])
        .map((cat) => ({ cat, cost: cents(lines.filter((l) => l.cat === cat).reduce((sum, l) => sum + l.cost, 0)) }))
        .filter((c) => c.cost > 0);
    return { lines, total, byCat };
};

const smallUsage: Usage = { users: 3, seriesK: 8, dpm: 1, logsGb: 30, tracesGb: 20, appHosts: 0 };
const midUsage: Usage = { users: 12, seriesK: 40, dpm: 1, logsGb: 400, tracesGb: 300, appHosts: 10 };
const small = bill(smallUsage);
const mid = bill(midUsage);
const midScrape = bill({ ...midUsage, dpm: 2 });
const billBars = [
    { label: "Small team on Pro", bill: small },
    { label: "Mid-sized team, 60-second scrape", bill: mid },
    { label: "Mid-sized team, 30-second scrape", bill: midScrape },
];
// Keeping logs and traces 60 days instead of 30: one retain increment on the written GB.
const retainShare = cents((midUsage.logsGb + midUsage.tracesGb) * pro.gbRetain);

// The mid-sized workload on Maple: metrics estimated at 0.1 KB per data point.
const mapleRate = gb?.rate ?? 0.3;
const mapleIncluded = gb?.included ?? 100;
const metricGb = (seriesK: number, dpm: number) => Math.round(seriesK * 1_000 * dpm * 60 * 24 * 30 * 0.1) / 1_000_000;
const mapleBill = (dpm: number) => {
    const lines = [
        { label: "Plan", calc: "Monthly price", cost: offer.price },
        { label: "Logs", calc: `${midUsage.logsGb} GB − ${mapleIncluded} included = ${midUsage.logsGb - mapleIncluded} GB × ${rateLabel(mapleRate)}`, cost: Math.max(0, midUsage.logsGb - mapleIncluded) * mapleRate },
        { label: "Traces", calc: `${midUsage.tracesGb} GB − ${mapleIncluded} included = ${midUsage.tracesGb - mapleIncluded} GB × ${rateLabel(mapleRate)}`, cost: Math.max(0, midUsage.tracesGb - mapleIncluded) * mapleRate },
        { label: "Metrics", calc: `${num(metricGb(midUsage.seriesK, dpm))} GB − ${mapleIncluded} included = ${num(cents(metricGb(midUsage.seriesK, dpm) - mapleIncluded))} GB × ${rateLabel(mapleRate)}`, cost: Math.max(0, metricGb(midUsage.seriesK, dpm) - mapleIncluded) * mapleRate },
    ].map((l) => ({ ...l, cost: cents(l.cost) }));
    return { lines, total: cents(lines.reduce((sum, l) => sum + l.cost, 0)) };
};
const maple = mapleBill(1);
// Sensitivity: the same metrics at three times the bytes per data point.
const mapleHigh = cents(maple.total + (Math.max(0, metricGb(midUsage.seriesK, 1) * 3 - mapleIncluded) - Math.max(0, metricGb(midUsage.seriesK, 1) - mapleIncluded)) * mapleRate);
const mapleScrape = mapleBill(2);

const faqs = [
    {
        question: "Is Grafana Cloud free?",
        answer:
            "Yes. The free tier costs $0 with no credit card and includes 10,000 active metric series, 50 GB each of logs, traces and profiles, 3 active users, 50,000 frontend sessions and 14 days of retention every month. Usage is capped at those limits; Pro turns them into an allowance and bills what goes past it.",
    },
    {
        question: "How much does Grafana Cloud Pro cost?",
        answer:
            `Pro is a $19 monthly platform fee plus usage above the free allowance: $6.50 per 1,000 active metric series, $0.05 per GB processed and $0.40 per GB written for logs or traces (the 50 GB allowance offsets writes only), $0.10 per GB for each 30 days kept beyond the included 30, and $8 per active user. A 12-person team with 40,000 series, 700 GB of logs and traces and Application Observability on 10 hosts pays about ${usd(mid.total)} a month at the default retention (prices verified ${verified}).`,
    },
    {
        question: "What is DPM in Grafana Cloud?",
        answer:
            "DPM is data points per minute per active series. Pro includes 1 DPM, which is a 60-second scrape interval. At a 15-second scrape a series sends 4 DPM, and Grafana bills whichever is higher: your active series or your total DPM divided by the included 1. Halving the scrape interval doubles billable usage for the same series.",
    },
    {
        question: "What counts as an active user in Grafana Cloud?",
        answer:
            "Any user that logs into Grafana during the billing month. The first 3 are included on Free and Pro; each one after that is $8 a month, or $55 with Enterprise plugins.",
    },
    {
        question: "What does Grafana Cloud Enterprise cost?",
        answer:
            "Enterprise starts at a $25,000 a year spend commitment, with custom retention and volume pricing negotiated with sales. Metrics can go as low as $3 per 1,000 series on Enterprise.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Grafana Cloud pricing, explained",
    description: pageDescription,
    datePublished: published,
    dateModified: updated,
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/grafana-cloud-pricing`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        class="shell pt-4"
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Grafana Cloud pricing" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="shell relative pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Pricing</span>
                    <span>9 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Grafana Cloud pricing, explained
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    What the free tier includes, what Pro charges for series, gigabytes and users, and three monthly bills worked out.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt={author.name} width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime={updated}>Updated {updatedLabel}</time>
                    <span>Prices verified {verified}</span>
                </div>
            </div>
        </header>

        <GuideBody headings={toc} class="pricing-guide">
                <section class="guide-lead">
                    <p>
                        <strong>Grafana Cloud</strong> is Grafana Labs' hosted observability stack: Grafana dashboards over managed metrics, logs, traces and profiles, plus add-ons for frontend monitoring, synthetics, load testing and incident response. It has a free tier, a pay-as-you-go Pro plan and an Enterprise contract.
                    </p>
                    <p>
                        This guide covers the plans, how each meter bills, the charges that surprise teams, three worked monthly bills and how to cut one.
                    </p>
                    <p class="guide-disclosure">
                        Maple publishes this guide and competes with Grafana Cloud. Section 06 compares the two; every Grafana Cloud figure comes from Grafana Cloud's own pages, linked at the end.
                    </p>
                    <div class="guide-takeaways">
                        <p class="guide-kicker">Key takeaways</p>
                        <ul>
                            <li>Free includes 10,000 metric series, 50 GB each of logs and traces, 3 users and 14 days of retention.</li>
                            <li>Pro is $19 a month plus usage above the same allowance, with 30 days for logs and traces and 13 months for metrics.</li>
                            <li>Metrics are $6.50 per 1,000 active series. Scraping faster than once a minute multiplies that.</li>
                            <li>Logs and traces are $0.05 per GB to process and $0.40 per GB to write. Keeping them past 30 days adds $0.10 per GB per 30 days.</li>
                            <li>Every user who logs in during a month counts. Past 3, each is $8.</li>
                        </ul>
                    </div>
                </section>

                <section id="plans" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Plans</p>
                    <h2>Grafana Cloud plans and prices</h2>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Per month</th><th>Free</th><th>Pro</th><th>Enterprise</th></tr>
                            </thead>
                            <tbody>
                                <tr class="row-price"><td>Price</td><td>$0</td><td>$19 + usage</td><td>From $25,000 a year</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Metrics</span></td><td>10k series</td><td>10k, then $6.50 per 1k</td><td>From $3 per 1k</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Logs</span></td><td>50 GB</td><td>$0.05 per GB processed, 50 GB written, then $0.40 per GB</td><td>Custom</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.traces.color}`}>Traces</span></td><td>50 GB</td><td>$0.05 per GB processed, 50 GB written, then $0.40 per GB</td><td>Custom</td></tr>
                                <tr><td>Profiles</td><td>50 GB</td><td>$0.05 per GB processed, 50 GB written, then $0.40 per GB</td><td>Custom</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.users.color}`}>Active users</span></td><td>3</td><td>3, then $8 each</td><td>Custom</td></tr>
                                <tr><td>Frontend Observability</td><td>50k sessions</td><td>50k, then $0.75 per 1k</td><td>Custom</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.app.color}`}>Application Observability</span></td><td>2,232 host-hours</td><td>$0.025 per host-hour, none included</td><td>Custom</td></tr>
                                <tr><td>Kubernetes Monitoring</td><td>2,232 host-hours, 37,944 container-hours</td><td>Then $0.01 per host-hour, $0.0007 per container-hour</td><td>Custom</td></tr>
                                <tr><td>Synthetics</td><td>100k API, 10k browser runs</td><td>Then $5 per 10k API, $50 per 10k browser</td><td>Custom</td></tr>
                                <tr><td>IRM</td><td>3 active users</td><td>Then $20 each</td><td>Custom</td></tr>
                                <tr><td>Retention</td><td>14 days</td><td>13 months metrics, 30 days logs and traces</td><td>Custom</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="table-note">
                        Pro includes the free allowance every month and bills what goes past it. Application Observability is $18 per host at a full month of hours; Kubernetes Monitoring is $7.20 per host and $0.50 per container.
                    </p>

                    <h3 id="free-tier" class="scroll-mt-24">The free tier</h3>
                    <p>
                        The free tier costs nothing with no credit card and no end date. It runs the same services as Pro within usage limits, with 14 days of retention and community support. Pro adds the longer retention and email support, and turns the limits into an allowance with usage billed past it. Enterprise starts at a <strong>$25,000 a year spend commitment</strong> with custom retention.
                    </p>
                    <p class="guide-verified">
                        Verified {verified} against <a href="https://grafana.com/pricing/" target="_blank" rel="noopener noreferrer">grafana.com/pricing</a> and Grafana's invoice docs for <a href="https://grafana.com/docs/grafana-cloud/cost-management-and-billing/understand-your-invoice/metrics-invoice/" target="_blank" rel="noopener noreferrer">metrics</a> and <a href="https://grafana.com/docs/grafana-cloud/cost-management-and-billing/understand-your-invoice/logs-invoice/" target="_blank" rel="noopener noreferrer">logs</a>.
                    </p>
                </section>

                <section id="meters" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · Meters</p>
                    <h2>How each Grafana Cloud meter bills</h2>

                    <h3 id="metrics" class="scroll-mt-24">Metrics: active series and DPM</h3>
                    <p>
                        An <strong>active series</strong> is a time series that received a data point in the last 20 minutes. Grafana measures active series through the month and bills the <strong>95th percentile</strong>, which forgives the busiest 5% of the month, about 36 hours. A stack that normally runs 6,000 series and spikes to 30,000 for a day is still billed for 6,000.
                    </p>
                    <p>
                        <strong>DPM</strong> is data points per minute per series. Pro includes 1 DPM, a 60-second scrape. The invoice docs give the rule as <code>usage = max(active_series, total_dpm / included_dpm)</code>. At a 30-second scrape, 50,000 series send 100,000 data points a minute and bill as 100,000 series. A 15-second scrape, common in Prometheus configs, is 4 DPM.
                    </p>

                    <h3 id="logs-traces" class="scroll-mt-24">Logs and traces: process, write, retain</h3>
                    <p>
                        Logs, traces and profiles bill per GB in three parts on Pro: <strong>$0.05 to process</strong>, <strong>$0.40 to write</strong> and <strong>$0.10 to retain</strong>. The 50 GB allowance offsets the write charge only, so processing is billed from the first GB. Process is measured on everything Grafana receives. Write is measured on what is kept after Adaptive Telemetry features such as Adaptive Logs drop data, so dropping cuts the write charge but not the process charge.
                    </p>
                    <div class="guide-callout">
                        <p class="guide-kicker">When retain applies</p>
                        <p>
                            The pricing page lists retain as a third per-GB rate on Pro. The logs invoice docs bill it "for each additional retention increment beyond the minimum": paid accounts keep 30 days at no retain charge, and each further 30 days costs $0.10 per GB. The worked bills below use the default 30 days, so they carry no retain charge.
                        </p>
                    </div>
                    <p>
                        Queries are included up to a fair-use ratio: 100 times your monthly written log volume, then $0.003 per GB scanned. Metrics queries are included up to 20 billion query units per 1,000 billable series.
                    </p>

                    <h3 id="users" class="scroll-mt-24">Users</h3>
                    <p>
                        Grafana defines an active user as anyone who logs into Grafana during the billing month. Three are included; each one after that is <strong>$8 a month</strong>, or <strong>$55</strong> with Enterprise plugins, a paid add-on. Incident response (IRM) counts its own users at $20 each past 3.
                    </p>

                    <h3 id="volume" class="scroll-mt-24">Volume discounts</h3>
                    <p>
                        Pro rates step down automatically as volume grows. These are the published bands:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Meter</th><th>First band</th><th>Second band</th><th>Third band</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Series, per 1k</span></td><td>$6.50 to 100k</td><td>$5.90 to 200k</td><td>$5.50 above</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Process, per GB</span></td><td>$0.05 to 10,000 GB</td><td>$0.046 to 25,000 GB</td><td>$0.044 above</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Write, per GB</span></td><td>$0.40 to 1,000 GB</td><td>$0.37 to 2,500 GB</td><td>$0.35 above</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Retain, per GB</span></td><td>$0.10 to 5,000 GB</td><td>$0.092 to 12,500 GB</td><td>$0.088 above</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.users.color}`}>Active users</span></td><td>$8 to 25</td><td>$7.25 to 50</td><td>$6.80 above</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="table-note">
                        The worked examples below stay inside the first band, so the band rules do not change their totals.
                    </p>
                </section>

                <section id="surprises" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>03</span> · Surprises</p>
                    <h2>What surprises teams on Grafana Cloud</h2>
                    <ul class="guide-list">
                        <li><strong>The scrape interval is a price multiplier.</strong> Moving from 60 to 15 seconds bills four times the series, with no new metric added.</li>
                        <li><strong>Labels create series.</strong> Every unique label combination is a series. A <code>user_id</code> or <code>pod</code> label on a busy metric can add tens of thousands.</li>
                        <li><strong>Anyone who logs in is a user.</strong> A product manager who opens one dashboard in a month costs $8 like an engineer on call.</li>
                        <li><strong>Curated apps add host-hours.</strong> Application Observability bills $0.025 per host-hour on top of the traces it reads, and Kubernetes Monitoring bills hosts and containers. Grafana's FAQ says you can opt out of the curated experience and pay only for the telemetry.</li>
                        <li><strong>Dropped logs still pay to process.</strong> Adaptive Logs lowers the $0.40 write charge, not the $0.05 process charge.</li>
                        <li><strong>Free retention is 14 days.</strong> Teams that start free and need a month of logs move to Pro.</li>
                    </ul>
                </section>

                <section id="examples" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>04</span> · Examples</p>
                    <h2>What a month of Grafana Cloud costs</h2>
                    <p>
                        Three bills on Pro at the prices checked {verified}, in a 30-day month. Each bar splits one bill by category:
                    </p>

                    <figure class="bills" aria-label={`Where each bill goes. ${billBars.map(({ label, bill: b }) => `${label}, ${usd(b.total)}: ${b.byCat.map((c) => `${cats[c.cat].label} ${usd(c.cost)}`).join(", ")}.`).join(" ")}`}>
                        <div aria-hidden="true">
                            {billBars.map(({ label, bill: b }) => (
                                <div class="bills__row">
                                    <p class="bills__head"><span>{label}</span><strong>{usd(b.total)}</strong></p>
                                    <div class="bills__bar">
                                        {b.byCat.map((c) => {
                                            const share = (c.cost / b.total) * 100;
                                            return <span style={`--cat: ${cats[c.cat].color}; width: ${share}%`}>{share >= 9 ? `${Math.round(share)}%` : ""}</span>;
                                        })}
                                    </div>
                                </div>
                            ))}
                            <div class="bills__legend">
                                {(Object.keys(cats) as Cat[]).map((cat) => (
                                    <span><i style={`--cat: ${cats[cat].color}`}></i>{cats[cat].label}</span>
                                ))}
                            </div>
                        </div>
                    </figure>

                    <h3 id="small-team" class="scroll-mt-24">Small team: {usd(small.total)} a month</h3>
                    <p>
                        Three engineers, 8,000 active series at a 60-second scrape, 30 GB of logs and 20 GB of traces. Every write fits the free allowance, so on Pro they pay the {usd(pro.fee)} platform fee plus processing on all 50 GB, {usd(small.total)} in total, for 30 days of logs and traces instead of 14. On the free tier the same team pays nothing.
                    </p>

                    <h3 id="mid-team" class="scroll-mt-24">Mid-sized team: {usd(mid.total)} a month</h3>
                    <p>
                        Twelve people log in during the month. They run 40,000 active series at a 60-second scrape, send 400 GB of logs and 300 GB of traces, and use Application Observability on 10 hosts all month.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation</th><th>Per month</th></tr>
                            </thead>
                            <tbody>
                                {mid.lines.map((l) => (
                                    <tr><td><span class="cat-badge" style={`--cat: ${cats[l.cat].color}`}>{l.label}</span></td><td>{l.calc}</td><td class="num">{usd(l.cost)}</td></tr>
                                ))}
                                <tr class="row-total"><td>Total</td><td></td><td class="num">{usd(mid.total)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Logs and traces are the largest share. Keeping them 60 days instead of 30 adds one retain increment, about {usd(retainShare)}, for a total of {usd(cents(mid.total + retainShare))}.
                    </p>

                    <h3 id="scrape" class="scroll-mt-24">Same team, 30-second scrape: {usd(midScrape.total)} a month</h3>
                    <p>
                        The team halves the scrape interval to see shorter spikes. The 40,000 series now send 2 data points a minute each, so they bill as 80,000:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation</th><th>Per month</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Metrics, 60 s</span></td><td>{mid.lines.find((l) => l.cat === "metrics")?.calc}</td><td class="num">{usd(mid.lines.find((l) => l.cat === "metrics")?.cost ?? 0)}</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Metrics, 30 s</span></td><td>{midScrape.lines.find((l) => l.cat === "metrics")?.calc}</td><td class="num">{usd(midScrape.lines.find((l) => l.cat === "metrics")?.cost ?? 0)}</td></tr>
                                <tr class="row-total"><td>Bill change</td><td></td><td class="num">+{usd(cents(midScrape.total - mid.total))}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        No series, label or dashboard changed. A 15-second scrape would bill the same 40,000 series as 160,000, which crosses into the second volume band.
                    </p>
                </section>

                <section id="reduce" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>05</span> · Cutting the bill</p>
                    <h2>How to cut a Grafana Cloud bill</h2>
                    <ol class="guide-steps">
                        <li>
                            <span>01</span>
                            <div><h4>Read the cost dashboards</h4><p>Grafana Cloud's Cost Management dashboards show month-to-date usage, refreshed hourly. Start with the meter that grew most since last month.</p></div>
                        </li>
                        <li>
                            <span>02</span>
                            <div><h4>Scrape once a minute</h4><p>Pro includes 1 DPM. Keep a 60-second interval unless a dashboard needs finer resolution, and set it per job rather than globally.</p></div>
                        </li>
                        <li>
                            <span>03</span>
                            <div><h4>Turn on Adaptive Metrics</h4><p>It identifies unused series and recommends aggregating them. Grafana says it can cut metrics by up to 80%; your number depends on how many unused labels you send.</p></div>
                        </li>
                        <li>
                            <span>04</span>
                            <div><h4>Drop log patterns nobody reads</h4><p>Adaptive Logs recommends patterns to drop, which saves the $0.40 write charge on each GB. Dropping in your Collector or agent before sending saves the $0.05 process charge too.</p></div>
                        </li>
                        <li>
                            <span>05</span>
                            <div><h4>Audit who logs in</h4><p>Each person who logs in during a month counts. Remove accounts nobody uses and keep Enterprise plugins to the people who need them, since those users cost $55 instead of $8.</p></div>
                        </li>
                        <li>
                            <span>06</span>
                            <div><h4>Check the host-hour products</h4><p>Application Observability and Kubernetes Monitoring bill per host-hour for the curated views. If the team only uses the raw metrics and traces, opt out and pay for the telemetry alone.</p></div>
                        </li>
                    </ol>
                </section>

                <section id="maple" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>06</span> · Maple</p>
                    <h2>Maple pricing for the same workload</h2>
                    <p>
                        Maple is an OpenTelemetry observability platform. It has one plan at <strong>{money(offer.price)}{offer.interval}</strong> with {mapleIncluded} GB each of logs, traces and metrics included, then {rateLabel(mapleRate)} per GB for each signal. There is no per-user, per-series or per-host charge. Logs and traces are kept 30 days and metrics 90.
                    </p>
                    <p>
                        The mid-sized team on Maple, which meters uncompressed OTLP bytes, with metrics estimated at 0.1 KB per data point. At 1 DPM, 40,000 series send {num(40_000 * 60 * 24 * 30)} data points a month:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation</th><th>Per month</th></tr>
                            </thead>
                            <tbody>
                                {maple.lines.map((l) => (
                                    <tr><td>{l.label}</td><td>{l.calc}</td><td class="num">{usd(l.cost)}</td></tr>
                                ))}
                                <tr class="row-total"><td>Total</td><td></td><td class="num">{usd(maple.total)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        If metric points average 0.3 KB instead of 0.1, the total is {usd(mapleHigh)}. At a 30-second scrape Maple meters twice the metric bytes and the 0.1 KB total is {usd(mapleScrape.total)}. Scrape interval moves both bills; on Maple it moves the bytes, on Grafana Cloud the billed series.
                    </p>
                    <p>
                        Grafana Cloud is the better fit in several cases. Its free tier covers a small team at $0, and Maple has no free cloud plan. Pro keeps metrics for 13 months against Maple's 90 days. Grafana dashboards can read from many data sources outside Grafana Cloud, and the Grafana stack can be self-hosted from open-source components. Maple fits teams that send OpenTelemetry and want one store for all three signals, no per-user charge, and source code they can run themselves.
                    </p>

                    <div class="guide-maple">
                        <p class="guide-kicker">Maple</p>
                        <h3>Price your own month</h3>
                        <p>The calculator prices Grafana Cloud and Maple on the same sliders, and the compare page goes feature by feature.</p>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <a href="/pricing" class="guide-button guide-button--primary">See Maple pricing</a>
                            <a href="/compare/grafana" class="guide-button">Maple vs Grafana</a>
                        </div>
                    </div>
                </section>

                <section class="guide-sources">
                    <p class="guide-eyebrow">Sources and further reading</p>
                    <ul>
                        <li><a href="https://grafana.com/pricing/" target="_blank" rel="noopener noreferrer">Grafana Labs: Pricing (verified {verified})</a></li>
                        <li><a href="https://grafana.com/docs/grafana-cloud/cost-management-and-billing/understand-your-invoice/metrics-invoice/" target="_blank" rel="noopener noreferrer">Grafana Cloud docs: Metrics invoice (verified {verified})</a></li>
                        <li><a href="https://grafana.com/docs/grafana-cloud/cost-management-and-billing/understand-your-invoice/logs-invoice/" target="_blank" rel="noopener noreferrer">Grafana Cloud docs: Logs invoice (verified {verified})</a></li>
                        <li><a href="/compare/grafana">Maple vs Grafana</a></li>
                        <li><a href="/pricing">Maple pricing</a></li>
                    </ul>
                </section>
        </GuideBody>
    </main>

