---
/**
 * The proof rail: GitHub stars, ingest volume and the customer logos.
 *
 * It used to close the hero. It sits under the product plate now, so the first
 * viewport can hold the product instead.
 */
import * as m from "../../paraglide/messages.js";
import PixelStar from "../icons/PixelStar.astro";
import CustomerLogos from "../CustomerLogos.astro";
import { DATA_POINTS_INGESTED, formatDataPoints } from "../../lib/ingest-stats";
import { getGitHubStars, formatStars } from "../../lib/github-stars";

const stars = await getGitHubStars();
---

<div class="monument-proof">
	<div class="monument-proof__inner">
		<dl class="monument-proof__stats">
			{
				stars !== null && (
					<div>
						<dt>{m.stat_github()}</dt>
						<dd>
							<a class="monument-proof__github" href="https://github.com/MapleTechLabs/maple">
								<PixelStar class="size-5 text-primary" />
								{formatStars(stars)}
							</a>
						</dd>
					</div>
				)
			}
			<div>
				<dt>{m.ingest_stats_label()}</dt>
				<dd>{formatDataPoints(DATA_POINTS_INGESTED)}+</dd>
			</div>
		</dl>
		<CustomerLogos variant="rail" />
	</div>
</div>
