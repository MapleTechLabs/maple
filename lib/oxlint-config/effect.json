		"effecttsgo/overridden-schema-constructor": "error",
		"effecttsgo/prefer-effect-array": "error",
		"effecttsgo/prefer-effect-record": "error",
		"effecttsgo/prefer-effect-string": "error",
		"effecttsgo/prefer-succeed-some-or-none": "error",
		"effecttsgo/prefer-typed-schema-decoder": "error",
		"effecttsgo/prefer-unsafe-constructor": "error",
		"effecttsgo/process-env": "error",
		"effecttsgo/process-env-in-effect": "error",
		"effecttsgo/promise-in-effect-success": "error",
		"effecttsgo/provide-layer-succeed-to-provide-service": "error",
		"effecttsgo/race-first-with-sleep-to-timeout": "error",
		"effecttsgo/redundant-map-error": "error",
		"effecttsgo/redundant-or-die": "error",
		"effecttsgo/redundant-schema-tag-identifier": "error",
		"effecttsgo/result-match-to-from-result": "error",
		"effecttsgo/return-effect-in-gen": "error",
		"effecttsgo/run-effect-inside-effect": "error",
		"effecttsgo/run-of-exit-to-run-exit": "error",
		"effecttsgo/schema-class-object-literal": "error",
		"effecttsgo/schema-literal-non-finite": "error",
		"effecttsgo/schema-opaque-instance-member": "error",
		"effecttsgo/schema-struct-with-tag": "error",
		"effecttsgo/schema-sync-in-effect": "error",
		"effecttsgo/scope-in-layer-effect": "error",
		"effecttsgo/suspend-fail-to-fail-sync": "error",
		"effecttsgo/sync-to-succeed": "error",
		"effecttsgo/timeout-catch-tag-to-timeout-or-else": "error",
		"effecttsgo/try-catch-in-effect-gen": "error",
		"effecttsgo/unknown-in-effect-catch": "error",
		"effecttsgo/unnecessary-effect-gen": "error",
		"effecttsgo/unnecessary-fail-yieldable-error": "error",
		"effecttsgo/unnecessary-pipe": "error",
		"effecttsgo/unnecessary-pipe-chain": "error",
		"effecttsgo/unnecessary-typeof-type": "error",

		// --- Where we differ from upstream.
		// Error context is schema-backed; `unknown` causes go in `Schema.Defect()`.
		"effecttsgo/any-unknown-in-error-context": "error",
		"effecttsgo/nested-effect-gen-yield": "error",
		"effecttsgo/effect-do-notation": "error",
		"effecttsgo/effect-try-without-catch": "error",
		"effecttsgo/map-map-error-to-map-both": "error",
		"effecttsgo/provide-merge-all-to-array": "error",
		"effecttsgo/service-not-as-class": "error",
		"effecttsgo/strict-effect-provide": "error",
		"effecttsgo/type-union-to-schema-union": "error",
		"effecttsgo/yield-in-call-argument": "error",
		// `effect/unstable/*` (HttpApi, HttpClient, RPC) is the normal surface in Effect 4; version bumps are where breakage shows.
		"effecttsgo/unstable-api-usage": "off",
		// JSON can't carry NaN/Infinity, and a blanket `Schema.Finite` turns a computed NaN into a decode failure.
		"effecttsgo/schema-number": "off",
		// Schema classes are told apart by fields and `_tag`; a brand on every class is noise.
		"effecttsgo/schema-class-missing-brand": "off",
		// `new Date(ts)` to parse or format is pure; `global-date-in-effect` covers clock reads in Effect code.
		"effecttsgo/global-date": "off",
		// Worker handlers, Durable Object methods and Promise-based library hooks have to be async.
		"effecttsgo/async-function": "off",
		// node:crypto, node:fs and node:path are often the intended APIs on servers and Workers.
		"effecttsgo/node-builtin-import": "off",
		// Flags every sync decode, mostly at non-Effect boundaries; `schema-sync-in-effect` covers the case that matters.
		"effecttsgo/schema-sync": "off",

		// --- Type-aware TypeScript bug rules.
		// Fires on `new X({ ...x })`, which is how Schema classes are copied.
		"typescript/no-misused-spread": "off",
		// 0 and NaN are falsy, so `if (count)` or `ts || fallback` on a number hides real values; an object in a condition is always truthy.
		"typescript/strict-boolean-expressions": [
			"error",
			{
				"allowString": true,
				"allowNumber": false,
				"allowNullableObject": true,
				"allowNullableBoolean": true,
				"allowNullableString": true,
				"allowNullableNumber": false,
				"allowNullableEnum": false,
				"allowAny": true
			}
		],
		"typescript/await-thenable": "error",
		"typescript/no-floating-promises": "error",
		"typescript/restrict-template-expressions": "error",
		"typescript/require-array-sort-compare": "error",
		"typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unnecessary-type-arguments": "error",
		"typescript/no-deprecated": "error",
		"typescript/use-unknown-in-catch-callback-variable": "error",
		"typescript/return-await": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-unsafe-enum-comparison": "error",
		"typescript/only-throw-error": "error",
		"typescript/no-base-to-string": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/no-useless-default-assignment": "error",
		"typescript/no-implied-eval": "error",
		"typescript/no-for-in-array": "error",
		"typescript/no-array-delete": "error",
		"typescript/no-mixed-enums": "error",
		"typescript/no-meaningless-void-operator": "error",
		"typescript/no-duplicate-type-constituents": "error",
		"typescript/no-unsafe-unary-minus": "error",
		"typescript/prefer-reduce-type-parameter": "error",
		// `any` is typed at its source (decodes, guards, typed env), so it never flows on silently.
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",

		// --- effect-strict plugin.
		// Syntax halves of the Effect error convention (plugins/effect-strict.mjs).
		"effect-strict/no-try-catch": "error",
		"effect-strict/no-effect-die": "error",
		"effect-strict/no-date-parse": "error",
		"effect-strict/no-record-string-any": "error"
	},
	"overrides": [
		// Tests may use host globals, inline fixtures and intentionally partial layers; production code may not.
		{
			"files": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/test/**",
				"**/tests/**",
				"**/__tests__/**"
			],
			"rules": {
				"effecttsgo/crypto-random-uuid": "off",
				"effecttsgo/global-console": "off",
				"effecttsgo/global-fetch": "off",
				"effecttsgo/global-random": "off",
				"effecttsgo/global-timers": "off",
				"effecttsgo/new-promise": "off",
				"effecttsgo/process-env": "off",
				"effecttsgo/any-unknown-in-error-context": "off",
				"effecttsgo/global-date-in-effect": "off",
				"effecttsgo/global-json": "off",
				"effecttsgo/global-json-in-effect": "off",
				"effecttsgo/schema-sync-in-effect": "off",
				"effecttsgo/unsafe-effect-type-assertion": "off",
				"effecttsgo/strict-effect-provide": "off",
				"effecttsgo/yield-in-call-argument": "off",
				"typescript/require-array-sort-compare": "off",
				"typescript/restrict-template-expressions": "off",
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off"
			}
		},
		// Ops scripts, benches and build configs run as plain async Node/Bun, not Effect programs.
		{
			"files": ["scripts/**", "**/scripts/**", "**/bench/**", "**/*.config.ts", "**/*.config.mts"],
			"rules": {
				"effecttsgo/crypto-random-uuid": "off",
				"effecttsgo/global-console": "off",
				"effecttsgo/global-fetch": "off",
				"effecttsgo/global-random": "off",
				"effecttsgo/global-timers": "off",
				"effecttsgo/new-promise": "off",
				"effecttsgo/process-env": "off",
				"effecttsgo/prefer-effect-array": "off",
				"effecttsgo/prefer-effect-record": "off",
				"effecttsgo/prefer-effect-string": "off",
				"effect-strict/no-try-catch": "off"
			}
		},
		// Untyped JavaScript: every import is `any` to the type-aware lint.
		{
			"files": ["**/*.js", "**/*.mjs", "**/*.cjs"],
			"rules": {
				"typescript/no-unsafe-argument": "off",
				"typescript/no-unsafe-assignment": "off",
				"typescript/no-unsafe-call": "off",
				"typescript/no-unsafe-member-access": "off",
				"typescript/no-unsafe-return": "off"
			}
		}
	]
