---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { highlight } from "../../lib/guide-highlight";

const pageTitle = "Incident response steps and lifecycle | Maple";
const pageDescription =
    "The incident response lifecycle from NIST and SANS, the incident response steps on-call teams follow, severity levels, MTTR and a postmortem template.";
const published = "2026-10-19";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "lifecycle", text: "The lifecycle" },
    { depth: 3, slug: "nist", text: "NIST: four phases" },
    { depth: 3, slug: "sans", text: "SANS: six steps" },
    { depth: 2, slug: "steps", text: "Incident response steps" },
    { depth: 2, slug: "severity", text: "Severity and roles" },
    { depth: 3, slug: "severity-levels", text: "Severity levels" },
    { depth: 3, slug: "roles", text: "Incident roles" },
    { depth: 2, slug: "example", text: "A worked example" },
    { depth: 3, slug: "timeline", text: "The timeline" },
    { depth: 3, slug: "metrics", text: "MTTD, MTTA and MTTR" },
    { depth: 2, slug: "postmortem", text: "The postmortem" },
    { depth: 2, slug: "maple", text: "In Maple" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per NIST phase, used by the lifecycle diagram, the step badges and the timeline.
// Severity uses the warm colors, so the phases keep to the cool ones.
const phases = {
    prep: { name: "Preparation", color: "var(--chart-5)" },
    detect: { name: "Detection and Analysis", short: "Detection", color: "var(--chart-2)" },
    contain: { name: "Containment, Eradication and Recovery", short: "Containment", color: "var(--chart-4)" },
    post: { name: "Post-Incident Activity", short: "Post-incident", color: "var(--chart-3)" },
} as const;
type PhaseKey = keyof typeof phases;

const lifecycle: { key: PhaseKey; title: string[]; sans: string[] }[] = [
    { key: "prep", title: ["Preparation"], sans: ["Preparation"] },
    { key: "detect", title: ["Detection and", "Analysis"], sans: ["Identification"] },
    { key: "contain", title: ["Containment,", "Eradication and", "Recovery"], sans: ["Containment", "Eradication", "Recovery"] },
    { key: "post", title: ["Post-Incident", "Activity"], sans: ["Lessons Learned"] },
];

const steps: { slug: string; title: string; phase: PhaseKey | null; label?: string; body: string }[] = [
    { slug: "detect", title: "Detect", phase: "detect", body: "An alert fires on something users feel: error rate, latency, a drop in traffic. A customer report counts too, and an incident customers reported first should end with a new alert among the postmortem's action items." },
    { slug: "declare", title: "Triage and declare", phase: "detect", body: "Acknowledge the page and check how far the problem reaches: one service or all, one region or all, which customers. If it is an incident, declare it with a severity level, name an incident commander and open a channel for it. Declaring early and downgrading later costs less than declaring late." },
    { slug: "mitigate", title: "Mitigate", phase: "contain", body: "Stop the user impact before you know the cause. Roll back the last deploy, turn off the feature flag, fail over to another region, scale up or shed load. A deploy in the last hour is the first suspect." },
    { slug: "communicate", title: "Communicate", phase: null, label: "Throughout", body: "Post to the status page and to internal stakeholders at a fixed interval, even when nothing has changed. Each update says what is affected, what is being done and when the next update comes." },
    { slug: "resolve", title: "Resolve", phase: "contain", body: "Confirm recovery on the same signal that detected the problem, then check for side effects: queued jobs, duplicate writes, retries still running. Close the incident and post a final update. The root-cause fix can ship later as an action item." },
    { slug: "review", title: "Review", phase: "post", body: "Write the postmortem within five working days, review it with the people involved, and track each action item until it is done." },
];

// Warm colors, darkest for the worst. Reused by the badges in the table and nowhere else.
const severities = [
    { level: "SEV1", name: "Critical", color: "var(--severity-fatal)", impact: "A core user journey is down, or data is at risk, for most users. Security breaches start here.", example: "Checkout fails for every user", response: "Page now, commander assigned, updates every 30 min, postmortem required" },
    { level: "SEV2", name: "Major", color: "var(--severity-error)", impact: "A key feature is down for some users, or badly degraded for all of them.", example: "p99 latency at 8 s in one region", response: "Page now, updates every hour, postmortem required" },
    { level: "SEV3", name: "Minor", color: "var(--severity-warn)", impact: "A non-critical feature is broken and a workaround exists.", example: "CSV export fails for large accounts", response: "Ticket, fixed in working hours" },
    { level: "SEV4", name: "Low", color: "var(--severity-trace)", impact: "Cosmetic issues, or internal tools with no user impact.", example: "Wrong label on an admin page", response: "Backlog" },
];

const roles = [
    ["Commander", "Owns the incident: sets priorities, assigns work, makes the rollback call and decides when it is over. The commander does not debug; to start debugging, they hand command to someone else first."],
    ["Ops", "The engineers changing production. One person runs commands at a time and announces each change in the channel before making it."],
    ["Comms", "Writes the status page and stakeholder updates at the interval the severity sets, and keeps support and account managers from interrupting the responders."],
    ["Scribe", "Keeps a timestamped log of findings, decisions and changes. The postmortem timeline comes from this log."],
];

// Minutes after 14:00 UTC. The clock chart below uses the same minutes.
const timeline: { at: number; label: string; phase: PhaseKey | null; body: string }[] = [
    { at: 2, label: "Deploy", phase: null, body: "checkout v2.41.0 ships. It runs one database query per item when it loads a cart." },
    { at: 6, label: "Impact starts", phase: null, body: "Large carts hold database connections longer, the connection pool runs dry and checkout requests fail with 503." },
    { at: 8, label: "Alert fires", phase: "detect", body: "The checkout error rate has been above 5% on two checks in a row. The alert rule opens an incident and PagerDuty pages the on-call engineer." },
    { at: 11, label: "Acknowledged", phase: "detect", body: "The on-call engineer acknowledges the page. The error rate is 23% on checkout and normal everywhere else." },
    { at: 13, label: "Declared", phase: "detect", body: "SEV1. The on-call engineer takes command, opens #inc-checkout and asks for a comms lead and a scribe." },
    { at: 16, label: "Diagnosis", phase: "detect", body: "Failing traces wait 4 to 5 seconds for a database connection before they time out. The failures started four minutes after the deploy." },
    { at: 18, label: "Decision", phase: "contain", body: "Roll back to v2.40.3 instead of raising the pool size. Comms posts the first status page update." },
    { at: 24, label: "Mitigated", phase: "contain", body: "The rollback finishes. The error rate is under 1% within two minutes." },
    { at: 31, label: "Alert resolves", phase: "contain", body: "Once the 5-minute window no longer holds the failures, two healthy checks in a row resolve the alert's incident. The resolve notification closes the PagerDuty incident." },
    { at: 45, label: "Resolved", phase: "contain", body: "The order queue is drained and the payment provider confirms no duplicate charges. The commander closes the incident and books the postmortem." },
];
const clock = (minutes: number) => `14:${String(minutes).padStart(2, "0")}`;

const axisMinutes = 50; // 14:00 to 14:50 on the clock chart
const clocks = [
    { name: "MTTD", full: "time to detect", from: 6, to: 8, by: "Alerts on user-facing symptoms, shorter evaluation windows" },
    { name: "MTTA", full: "time to acknowledge", from: 8, to: 11, by: "Paging escalation, fewer noisy alerts" },
    { name: "MTTM", full: "time to mitigate", from: 6, to: 24, by: "Rollbacks that take one command, feature flags, runbooks" },
    { name: "MTTR", full: "time to resolve", from: 6, to: 45, by: "All of the above, plus written exit criteria" },
];
const pct = (minutes: number) => `${(minutes / axisMinutes) * 100}%`;

const postmortemTemplate = `# Postmortem: checkout failures after v2.41.0 (SEV1, 2026-10-19)

Status: draft | Owner: <name> | Review date: <date>

## Summary
Two or three sentences: what broke, for whom, for how long, how it was fixed.

## Impact
- User impact: 14:06 to 14:24 UTC (18 minutes)
- Users affected: 23% of checkout attempts failed (<number> orders)
- Revenue, SLO budget or data impact: <numbers>

## Timeline (UTC)
From the scribe's log. Include when each person learned what.

## Root cause
The chain of events in the system. Describe systems and decisions, not people.

## Detection
How we found out, and how long after impact started. Would a different
threshold or window have caught it sooner?

## Response
What went well, what slowed us down, where we got lucky.

## Action items
| Action                                       | Type     | Owner  | Due    |
| -------------------------------------------- | -------- | ------ | ------ |
| Load test checkout with large carts          | Prevent  | <name> | <date> |
| Alert on connection pool wait time           | Detect   | <name> | <date> |
| Put the rollback command in the runbook      | Mitigate | <name> | <date> |`;

const faqs = [
    {
        question: "What are the incident response steps?",
        answer:
            "For an on-call software team: detect the problem, triage it and declare an incident with a severity level, mitigate the user impact, communicate at a fixed interval throughout, resolve the incident once the service is healthy, and review it in a blameless postmortem with tracked action items. Preparation (runbooks, alert rules, an on-call rotation) happens before any of them.",
    },
    {
        question: "What are the phases of the incident response lifecycle?",
        answer:
            "NIST SP 800-61 Rev. 2 defines four phases: Preparation; Detection and Analysis; Containment, Eradication and Recovery; and Post-Incident Activity. The SANS Incident Handler's Handbook splits the same work into six steps: Preparation, Identification, Containment, Eradication, Recovery and Lessons Learned. Rev. 3, published in April 2025, organizes the guidance around the six functions of the NIST Cybersecurity Framework 2.0 instead.",
    },
    {
        question: "What is the difference between the NIST and SANS incident response frameworks?",
        answer:
            "They cover the same work at different levels of detail. NIST groups containment, eradication and recovery into one phase because they overlap and repeat. SANS lists them as separate steps, which reads more like a checklist. Either one works for a software team; pick one set of names and use it in your runbooks and postmortems.",
    },
    {
        question: "What is a SEV1 incident?",
        answer:
            "SEV1 is the highest severity level in most incident response plans: a core user journey is down, data is at risk, or most users are affected. It pages people immediately, gets a dedicated incident commander and regular status updates, and always gets a postmortem. Each company writes its own definitions, so publish yours where on-call engineers can find them.",
    },
    {
        question: "What goes in a postmortem?",
        answer:
            "A summary, the user impact in numbers, a timestamped timeline, the root cause, how the incident was detected, what helped and what slowed the response, and action items with an owner and a due date each. A blameless postmortem describes systems and decisions, not who made a mistake.",
    },
    {
        question: "What is the difference between MTTA and MTTR?",
        answer:
            "MTTA (mean time to acknowledge) runs from the alert firing to a person acknowledging it, and measures paging and on-call. MTTR runs from the start of the incident to its resolution, and measures the whole response. MTTR also stands for repair, recover and respond, so write down which clock your team means.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Incident response, step by step",
    description: pageDescription,
    datePublished: published,
    dateModified: "2026-10-20",
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/incident-response`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Incident response" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">On-call</span>
                    <span>9 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Incident response, step by step
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    The lifecycle NIST and SANS describe, and the steps an on-call team follows when production breaks.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt="" width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime="2026-10-20">Updated {updatedLabel}</time>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {sectionNav.map((h) => (
                    <a href={`#${h.slug}`} class="transition-colors hover:text-primary">{h.text}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={toc} class="sticky top-28" />
            </aside>

            <article class="ir-guide min-w-0">
                <section id="lifecycle" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Definition</p>
                    <h2>The incident response lifecycle</h2>

                    <div class="guide-answer">
                        <p><strong>Incident response</strong> is what a team does from the moment something breaks until it works again and the lessons are written down. The <strong>incident response lifecycle</strong> draws that work as a loop, because each review changes how the team prepares for the next incident.</p>
                    </div>

                    <p>
                        An incident is an unplanned event that hurts users or puts data at risk: an outage, a slow checkout, a leaked credential. One failed request is noise; a fifth of checkouts failing for ten minutes is an incident.
                    </p>
                    <p>
                        The two published models come from security teams: NIST Special Publication 800-61 and the SANS Incident Handler's Handbook. They describe the same loop at different levels of detail, and both fit a production outage with a few changes of vocabulary.
                    </p>

                    <figure class="cycle" aria-label="The incident response lifecycle. Preparation leads to Detection and Analysis, which leads to Containment, Eradication and Recovery, which leads to Post-Incident Activity. Containment loops back to analysis when it turns up new evidence, and Post-Incident Activity loops back to Preparation. Inside each NIST phase are the SANS steps it covers: Preparation; Identification; Containment, Eradication and Recovery; Lessons Learned.">
                        <svg viewBox="0 0 760 280" aria-hidden="true">
                            <defs>
                                {Object.entries(phases).map(([key, p]) => (
                                    <marker id={`cycle-arrow-${key}`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                        <path d="M0,0 L8,4 L0,8 z" style={`fill: ${p.color}`} />
                                    </marker>
                                ))}
                            </defs>

                            <path d="M 470 60 C 470 22, 290 22, 290 58" class="cycle__loop" style={`stroke: ${phases.contain.color}`} marker-end="url(#cycle-arrow-contain)" />
                            <text x="380" y="20" text-anchor="middle" class="cycle__note">new evidence: analyse again</text>

                            {lifecycle.map((phase, i) => {
                                const x = i * 203;
                                const color = phases[phase.key].color;
                                return (
                                    <g style={`--phase: ${color}`}>
                                        <rect x={x} y="60" width="150" height="150" rx="8" class="cycle__box" />
                                        {phase.title.map((line, l) => (
                                            <text x={x + 14} y={88 + l * 19} class="cycle__title">{line}</text>
                                        ))}
                                        <line x1={x + 14} y1="142" x2={x + 136} y2="142" class="cycle__rule" />
                                        <text x={x + 14} y="160" class="cycle__kicker">SANS</text>
                                        {phase.sans.map((line, l) => (
                                            <text x={x + 14} y={176 + l * 14} class="cycle__sans">{line}</text>
                                        ))}
                                        {i < lifecycle.length - 1 && (
                                            <line x1={x + 152} y1="110" x2={x + 199} y2="110" class="cycle__line" style={`stroke: ${color}`} marker-end={`url(#cycle-arrow-${phase.key})`} />
                                        )}
                                    </g>
                                );
                            })}

                            <path d="M 684 212 L 684 242 L 75 242 L 75 216" class="cycle__loop" style={`stroke: ${phases.post.color}`} marker-end="url(#cycle-arrow-post)" />
                            <text x="380" y="264" text-anchor="middle" class="cycle__note">lessons learned change the next round of preparation</text>
                        </svg>
                    </figure>
                    <p class="guide-caption">NIST's four phases, with the SANS steps each one covers. Each arrow takes the color of the phase it leaves.</p>

                    <h3 id="nist" class="scroll-mt-24">NIST SP 800-61: four phases</h3>
                    <p>
                        <a href="https://csrc.nist.gov/pubs/sp/800/61/r2/final" target="_blank" rel="noopener noreferrer">NIST SP 800-61 Rev. 2</a> (2012) defines the four phases in the diagram. The third is one box because its parts overlap: rolling back one service can show that a second one is broken too, which sends the team back to analysis.
                    </p>
                    <p>
                        <a href="https://csrc.nist.gov/pubs/sp/800/61/r3/final" target="_blank" rel="noopener noreferrer">Rev. 3</a>, published in April 2025, supersedes Rev. 2. It drops the four-phase cycle and files incident response under the six functions of the NIST Cybersecurity Framework 2.0: Govern, Identify, Protect, Detect, Respond and Recover. Most runbooks and training material still use the four phases, and so does this guide.
                    </p>

                    <h3 id="sans" class="scroll-mt-24">SANS: six steps</h3>
                    <p>
                        The <a href="https://www.sans.org/white-papers/33901" target="_blank" rel="noopener noreferrer">SANS Incident Handler's Handbook</a> (Patrick Kral, 2012) splits NIST's third phase into its parts. That gives six steps, often shortened to PICERL: Preparation, Identification, Containment, Eradication, Recovery and Lessons Learned.
                    </p>
                    <p>
                        On a security incident, containment isolates a compromised host and eradication removes the attacker. On an outage, containment is mitigation: a rollback, a feature flag or a failover that stops the user impact. Eradication is the permanent fix, which can wait for working hours if the mitigation holds.
                    </p>
                </section>

                <section id="steps" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · On call</p>
                    <h2>Incident response steps</h2>
                    <p>
                        These steps put the phases in the order an on-call engineer works through them once an alert goes off. Each badge names the NIST phase the step belongs to. <span class="phase-badge" style={`--phase: ${phases.prep.color}`}>Preparation</span> comes first and happens on a quiet day: runbooks, alert rules, a paging rotation, and production access for whoever is on call.
                    </p>

                    <ol class="guide-steps">
                        {steps.map((s, i) => (
                            <li>
                                <span>{String(i + 1).padStart(2, "0")}</span>
                                <div>
                                    <div class="guide-steps__head">
                                        <h3 id={s.slug} class="scroll-mt-24">{s.title}</h3>
                                        {s.phase === null
                                            ? <span class="phase-badge phase-badge--neutral">{s.label}</span>
                                            : <span class="phase-badge" style={`--phase: ${phases[s.phase].color}`}>{phases[s.phase].short}</span>}
                                    </div>
                                    <p>{s.body}</p>
                                </div>
                            </li>
                        ))}
                    </ol>
                </section>

                <section id="severity" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>03</span> · Classification</p>
                    <h2>Severity levels and roles</h2>

                    <h3 id="severity-levels" class="scroll-mt-24">Incident severity levels</h3>
                    <p>
                        A severity level decides who gets woken up, how often stakeholders hear from you, and whether a postmortem is required. Define the levels by user impact rather than by which component broke, so the on-call engineer can pick one in under a minute. A common starting set:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Level</th><th>Impact</th><th>Example</th><th>Response</th></tr>
                            </thead>
                            <tbody>
                                {severities.map((s) => (
                                    <tr>
                                        <td><span class="sev-badge" style={`--sev: ${s.color}`}>{s.level}</span><span class="sev-name">{s.name}</span></td>
                                        <td>{s.impact}</td>
                                        <td>{s.example}</td>
                                        <td>{s.response}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Severity can change mid-incident. A SEV3 that turns out to hit every enterprise customer becomes a SEV1, and the change is announced in the incident channel.
                    </p>

                    <h3 id="roles" class="scroll-mt-24">Incident roles</h3>
                    <p>
                        One person can run a small incident. Once more than two people are involved, split the work so nobody debugs and writes status updates at the same time. The <a href="https://sre.google/sre-book/managing-incidents/" target="_blank" rel="noopener noreferrer">Google SRE book's chapter on managing incidents</a> describes the same split.
                    </p>
                    <div class="role-list">
                        {roles.map(([role, body]) => (
                            <div><span>{role}</span><p>{body}</p></div>
                        ))}
                    </div>
                    <p>
                        At 3 a.m. the on-call engineer holds every role until help arrives. The roles matter most at handover: "I'm handing command to Priya, she has the channel" is one line in the incident log.
                    </p>
                </section>

                <section id="example" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>04</span> · Worked example</p>
                    <h2>An incident, minute by minute</h2>
                    <p>
                        A deploy at 14:02 UTC makes checkout run one database query per item in a cart. At normal traffic nobody notices. At the afternoon peak, large carts hold database connections longer, the connection pool runs dry, and checkout starts failing.
                    </p>

                    <h3 id="timeline" class="scroll-mt-24">The timeline</h3>
                    <ol class="ir-timeline">
                        {timeline.map((e) => (
                            <li style={e.phase === null ? undefined : `--phase: ${phases[e.phase].color}`} class={e.phase === null ? "ir-timeline__before" : undefined}>
                                <time>{clock(e.at)}</time>
                                <div><h4>{e.label}</h4><p>{e.body}</p></div>
                            </li>
                        ))}
                    </ol>
                    <p>
                        The dot on each entry takes the color of its phase: <span class="phase-badge" style={`--phase: ${phases.detect.color}`}>Detection</span> until the decision to roll back, <span class="phase-badge" style={`--phase: ${phases.contain.color}`}>Containment</span> from then on. The rollback went out before anyone had confirmed the cause, which is the intended order. The diff was read against the slow traces after the incident closed.
                    </p>

                    <h3 id="metrics" class="scroll-mt-24">MTTD, MTTA, MTTM and MTTR</h3>
                    <p>
                        Each incident metric is a clock that starts and stops at a different event. Measured on this incident:
                    </p>
                    <figure class="clocks" aria-label="Four clocks on a 14:00 to 14:50 axis. MTTD runs from 14:06 to 14:08, 2 minutes. MTTA from 14:08 to 14:11, 3 minutes. MTTM from 14:06 to 14:24, 18 minutes. MTTR from 14:06 to 14:45, 39 minutes.">
                        <div class="clocks__rows" aria-hidden="true">
                            <div class="clocks__row clocks__row--phases">
                                <span class="clocks__label"></span>
                                <span class="clocks__track">
                                    <span class="clocks__phase" style={`left: ${pct(6)}; width: ${pct(18 - 6)}; --phase: ${phases.detect.color}`}>Detection</span>
                                    <span class="clocks__phase" style={`left: ${pct(18)}; width: ${pct(45 - 18)}; --phase: ${phases.contain.color}`}>Containment and recovery</span>
                                </span>
                                <span></span>
                            </div>
                            {clocks.map((c) => (
                                <div class="clocks__row">
                                    <span class="clocks__label"><strong>{c.name}</strong>{c.full}</span>
                                    <span class="clocks__track"><span class="clocks__bar" style={`left: ${pct(c.from)}; width: ${pct(c.to - c.from)}`}></span></span>
                                    <span class="clocks__value">{c.to - c.from} min</span>
                                </div>
                            ))}
                            <div class="clocks__row clocks__row--axis">
                                <span class="clocks__label"></span>
                                <span class="clocks__track">
                                    {[0, 10, 20, 30, 40, 50].map((m) => (
                                        <span class="clocks__tick" style={`left: ${pct(m)}`}>{clock(m)}</span>
                                    ))}
                                </span>
                                <span></span>
                            </div>
                        </div>
                        <figcaption>Three of the four clocks start when users are first affected, at 14:06. MTTA starts at the alert, so it measures paging, not the alerts themselves.</figcaption>
                    </figure>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Metric</th><th>Starts</th><th>Stops</th><th>Shortened by</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><strong>MTTD</strong></td><td>User impact begins</td><td>An alert fires or someone reports it</td><td>{clocks[0].by}</td></tr>
                                <tr><td><strong>MTTA</strong></td><td>The alert fires</td><td>A person acknowledges it</td><td>{clocks[1].by}</td></tr>
                                <tr><td><strong>MTTM</strong></td><td>User impact begins</td><td>User impact ends</td><td>{clocks[2].by}</td></tr>
                                <tr><td><strong>MTTR</strong></td><td>User impact begins</td><td>The incident is closed</td><td>{clocks[3].by}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        MTTR also stands for repair, recover and respond, so teams end up comparing different clocks. Write down which one yours means. With a handful of incidents a quarter, one long outage moves the mean a lot: report the median next to it.
                    </p>
                </section>

                <section id="postmortem" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>05</span> · <span class="eyebrow-phase" style={`--phase: ${phases.post.color}`}>Post-incident</span></p>
                    <h2>The blameless postmortem</h2>
                    <p>
                        A blameless postmortem assumes everyone acted reasonably with what they knew at the time, and asks which parts of the system let a reasonable action cause an outage. "Checkout has no load test with large carts" leads to a fix. "Alex shipped a bad query" teaches people to hide their mistakes next time. The <a href="https://sre.google/sre-book/postmortem-culture/" target="_blank" rel="noopener noreferrer">Google SRE book's postmortem chapter</a> covers the practice in depth.
                    </p>
                    <p>
                        The template carries the checkout incident's numbers as an example. Copy it into your docs tool and replace each <code>&lt;placeholder&gt;</code> from the incident channel and the scribe's log:
                    </p>
                    <div class="code-file">
                        <p class="code-file__name">postmortem.md</p>
                        <pre><code set:html={highlight(postmortemTemplate, "markdown")} /></pre>
                    </div>
                    <div class="guide-callout">
                        <p class="guide-kicker">The action items decide whether it worked</p>
                        <p>
                            Give each one an owner, a due date and a ticket in the same tracker as feature work, and review the open ones in a recurring meeting. An item that only exists in the postmortem document does not get done.
                        </p>
                    </div>
                </section>

                <section id="maple" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>06</span> · In practice</p>
                    <h2>Incident response in Maple</h2>
                    <p>
                        Maple covers detection and notification, from the OpenTelemetry traces, logs and metrics your services send, and keeps a history of every alert incident. Declaring severity, assigning roles, acknowledging pages and the status page stay with your team and your paging tool.
                    </p>

                    <ol class="guide-steps">
                        <li>
                            <span>01</span>
                            <div>
                                <h4>Alert on what users feel</h4>
                                <p>On the <strong>Alerts</strong> page, click <strong>New rule</strong> and start from a template such as <strong>High error rate</strong> (above 5% over a 5-minute window) or <strong>Slow P95 latency</strong>. Set <strong>Severity</strong> to <strong>Critical</strong> or <strong>Warning</strong>; Maple shows it on the incident and in every notification. Pick a past range and click <strong>Dry run</strong> to replay the rule: the chart shades where it would have held an incident open, so you can check it would have caught your last outage.</p>
                                <figure class="guide-figure"><img src="/screenshots/guides/incident-response-01-rule.webp" data-zoomable alt="A new alert rule from the High error rate template: error rate above 5% over a 5 minute window, severity Critical, with the Dry run preview over the last hour shading the span where the rule would have fired for checkout." width="2316" height="2016" loading="lazy" /></figure>
                            </div>
                        </li>
                        <li>
                            <span>02</span>
                            <div>
                                <h4>Route pages by severity</h4>
                                <p>Each rule sends to the <a href="/docs/alerting/notification-destinations">notification destinations</a> attached to it. Attach PagerDuty to the <strong>Critical</strong> rules and a Slack channel to the <strong>Warning</strong> ones. PagerDuty receives a stable <code>dedup_key</code>, so the trigger and the resolve land on the same PagerDuty incident.</p>
                            </div>
                        </li>
                        <li>
                            <span>03</span>
                            <div>
                                <h4>Open the incident from the notification</h4>
                                <p>Maple checks each rule once a minute and opens an <a href="/docs/alerting/incidents">incident</a> after <strong>Breaches to fire</strong> breaching checks in a row (2 by default). The notification shows the value, the threshold and the window, and links to the alert in Maple and to Maple AI. Open incidents are listed under <strong>Open</strong> on the <strong>Alerts</strong> inbox, with the current value against the threshold and how long each has been open. If the service stops sending telemetry, the incident shows <strong>Waiting on data</strong> and stays open instead of resolving on an empty window.</p>
                                <figure class="guide-figure"><img src="/screenshots/guides/incident-response-02-active-incident.webp" data-zoomable alt="The Alerts inbox with one firing incident under Open: severity Critical, rule High error rate, group checkout, its current value against the 0.05 threshold and how long it has been open." width="2330" height="324" loading="lazy" /></figure>
                            </div>
                        </li>
                        <li>
                            <span>04</span>
                            <div>
                                <h4>Use the history in the postmortem</h4>
                                <p>The incident resolves after <strong>Healthy to resolve</strong> healthy checks in a row and sends a resolve notification. The rule's <strong>History</strong> tab lists its past incidents with <strong>Total triggered</strong> and <strong>Avg resolution</strong>. On the <a href="/docs/reference/mcp">MCP server</a>, <code>list_alert_incidents</code> and <code>get_incident_timeline</code> return the same data to an AI assistant drafting the postmortem.</p>
                                <figure class="guide-figure"><img src="/screenshots/guides/incident-response-03-history.webp" data-zoomable alt="The History tab of the High error rate rule: Total triggered 3 and Avg resolution 6.5m, then each incident for checkout with its state, values, trigger time and duration." width="2330" height="1230" loading="lazy" /></figure>
                            </div>
                        </li>
                    </ol>

                    <div class="guide-maple">
                        <p class="guide-kicker">Set it up in Maple</p>
                        <h3>Your first alert rule</h3>
                        <p>Every rule setting, when incidents open and resolve, and what each notification contains.</p>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <a href="/docs/alerting/alert-rules" class="guide-button guide-button--primary">Alert rules docs</a>
                            <a href="/docs/alerting/incidents" class="guide-button">Incidents docs</a>
                        </div>
                    </div>
                </section>

