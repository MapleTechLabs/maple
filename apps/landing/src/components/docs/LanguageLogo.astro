---
// Maps a `LogoId` to its brand logo. The only place the logo components
// are wired to language ids — everything else passes the id around.
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { LogoId } from "../../lib/docs-languages";
import EffectLogomark from "../icons/EffectLogomark.astro";
import NodeJsLogo from "../icons/NodeJsLogo.astro";
import NextjsLogo from "../icons/NextjsLogo.astro";
import PythonLogo from "../icons/PythonLogo.astro";
import GoLogo from "../icons/GoLogo.astro";
import RustLogo from "../icons/RustLogo.astro";
import OpenJdkLogo from "../icons/OpenJdkLogo.astro";
import CsharpLogo from "../icons/CsharpLogo.astro";
import KotlinLogo from "../icons/KotlinLogo.astro";
import LaravelLogo from "../icons/LaravelLogo.astro";
import TypeScriptLogo from "../icons/TypeScriptLogo.astro";

interface Props {
    id: LogoId;
    class?: string;
}

const LOGOS = {
    effect: EffectLogomark,
    node: NodeJsLogo,
    nextjs: NextjsLogo,
    python: PythonLogo,
    go: GoLogo,
    rust: RustLogo,
    java: OpenJdkLogo,
    kotlin: KotlinLogo,
    csharp: CsharpLogo,
    laravel: LaravelLogo,
    typescript: TypeScriptLogo,
} satisfies Record<LogoId, AstroComponentFactory>;

const { id, class: className = "h-4 w-4" } = Astro.props;
const Logo = LOGOS[id];
---

<Logo class={className} />
