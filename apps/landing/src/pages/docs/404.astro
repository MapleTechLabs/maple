---
// Not-found page for /docs/* paths: keeps the reader inside the docs chrome
// (tabs, sidebar, search) instead of the marketing 404.
import DocsLayout from "../../layouts/DocsLayout.astro";
import { INSTRUMENTATION_SLUG } from "../../lib/docs-nav";

const LINKS = [
    { label: "Quickstart", href: "/docs/getting-started/quickstart", hint: "Send your first trace." },
    { label: "Instrumentation", href: `/docs/${INSTRUMENTATION_SLUG}`, hint: "Guides for every language and framework." },
    { label: "Reference", href: "/docs/reference/authentication", hint: "API, CLI, ingest, SQL and limits." },
    { label: "All docs", href: "/docs", hint: "The documentation home." },
];
---

<DocsLayout
    title="Page not found"
    description="There is no docs page at this address."
    headings={[]}
    currentSlug=""
    wide
    noindex
>
    <div class="max-w-2xl">
        <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">404</p>
        <h1 class="mt-3 text-[30px] font-semibold leading-[1.15] tracking-[-0.025em] text-fg md:text-[34px]">Page not found</h1>
        <p class="mt-3 text-[16px] leading-[1.6] text-pretty text-fg-muted">
            There is no docs page at this address. It may have moved. Search the docs from the header, or start from one of these.
        </p>
        <ul class="mt-8 divide-y divide-border rounded-xl border border-border">
            {LINKS.map((link) => (
                <li>
                    <a href={link.href} class="group flex items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-bg-elevated">
                        <span class="min-w-0">
                            <span class="block text-[14px] font-medium text-fg">{link.label}</span>
                            <span class="mt-0.5 block text-[13px] text-fg-muted">{link.hint}</span>
                        </span>
                        <svg class="h-3.5 w-3.5 shrink-0 text-fg-muted/60 transition-colors group-hover:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                            <path d="M16.99 12H17" /><path d="M14.99 10H15" /><path d="M14.99 14H15" /><path d="M12.99 16H13" /><path d="M12.99 8H13" /><path d="M10.99 6H11" /><path d="M10.99 18H11" /><path d="M8.99 20H9" /><path d="M8.99 4H9" />
                        </svg>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</DocsLayout>
