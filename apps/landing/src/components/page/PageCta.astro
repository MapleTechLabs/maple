---
/**
 * Closing CTA. Comparison pages continue the hero landscape below the copy;
 * pages without artwork retain the amber treatment.
 */
import * as m from "../../paraglide/messages.js";
import { APP_SIGN_UP_URL } from "../../lib/app-urls";

interface Props {
	title: string;
	lede: string;
	artwork?: string;
}

const { title, lede, artwork } = Astro.props;
---

<section class:list={["relative overflow-hidden drenched-amber", { "illustrated-cta": artwork }]}>
	{artwork && <img class="cta-art" src={artwork} alt="" width="2172" height="724" loading="lazy" decoding="async" />}
	<div class="relative shell py-24 text-center md:py-32 cta-content">
		<h2
			class="mx-auto max-w-[24ch] font-display text-4xl font-medium leading-[1.04] tracking-[-0.02em] sm:text-5xl"
		>
			{title}
		</h2>
		<p class="mx-auto mt-5 max-w-[52ch] text-base leading-relaxed opacity-85">{lede}</p>
		<div class="mt-10 flex flex-wrap items-center justify-center gap-3">
			<a
				href={APP_SIGN_UP_URL}
				class:list={["inline-flex h-11 items-center justify-center rounded-lg px-5 text-sm font-medium transition-colors", artwork ? "ink-button" : "bg-foreground text-background hover:bg-foreground/90"]}
			>
				{m.cta_bookend_primary()}
			</a>
			<a
				href="https://github.com/MapleTechLabs/maple"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-11 items-center justify-center rounded-lg border border-current/40 px-5 text-sm font-medium transition-colors hover:bg-current/10"
			>
				{m.cta_github()}
			</a>
		</div>
	</div>
</section>

<style>
	.illustrated-cta::before { display: none; }
	.cta-art {
		position: absolute;
		inset: auto 0 0;
		width: 100%;
		max-width: none;
		height: auto;
		mask-image: linear-gradient(to bottom, transparent, black 50%);
		pointer-events: none;
	}
	.illustrated-cta .cta-content {
		padding-top: 3.5rem;
		padding-bottom: clamp(11rem, 17vw, 18rem);
	}
	.illustrated-cta .cta-content > div { margin-top: 1.75rem; }
	@media (max-width: 767px) {
		.illustrated-cta .cta-content { padding-top: 3rem; padding-bottom: 10rem; }
		.cta-art {
			width: max(100%, 900px);
			left: 50%;
			transform: translateX(-50%);
		}
	}
</style>
