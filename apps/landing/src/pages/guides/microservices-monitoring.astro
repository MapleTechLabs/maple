const tracer = trace.getTracer("orders");
const attributes = {
  "messaging.system": "rabbitmq",
  "messaging.destination.name": "orders",
};

export function publish(queue: Queue, body: string) {
  const options = { kind: SpanKind.PRODUCER, attributes };
  tracer.startActiveSpan("send orders", options, (span) => {
    const headers: Record<string, string> = {};
    propagation.inject(context.active(), headers); // writes traceparent
    queue.send(body, headers);
    span.end();
  });
}

export function onMessage(message: Message) {
  // Reads traceparent back from the message headers.
  const parent = propagation.extract(context.active(), message.headers);
  const options = { kind: SpanKind.CONSUMER, attributes };
  tracer.startActiveSpan("process orders", options, parent, (span) => {
    handleOrder(message.body);
    span.end();
  });
}` },
    { id: "go", label: "Go", lang: "go", install: "go get go.opentelemetry.io/otel", code: `package orders

import (
	"context"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/propagation"
	"go.opentelemetry.io/otel/trace"
)

var (
	tracer = otel.Tracer("orders")
	attrs  = trace.WithAttributes(
		attribute.String("messaging.system", "rabbitmq"),
		attribute.String("messaging.destination.name", "orders"),
	)
)

func Publish(ctx context.Context, q Queue, body []byte) error {
	ctx, span := tracer.Start(ctx, "send orders",
		trace.WithSpanKind(trace.SpanKindProducer), attrs)
	defer span.End()

	// Writes traceparent for the span into the headers.
	headers := propagation.MapCarrier{}
	otel.GetTextMapPropagator().Inject(ctx, headers)
	return q.Send(ctx, body, headers)
}

func OnMessage(msg Message) {
	// Reads traceparent back from the message headers.
	ctx := otel.GetTextMapPropagator().Extract(context.Background(),
		propagation.MapCarrier(msg.Headers))
	ctx, span := tracer.Start(ctx, "process orders",
		trace.WithSpanKind(trace.SpanKindConsumer), attrs)
	defer span.End()

	handleOrder(ctx, msg.Body)
}` },
    { id: "rust", label: "Rust", lang: "rust", install: "cargo add opentelemetry@0.31 tracing tracing-opentelemetry@0.32", code: `use std::collections::HashMap;

use opentelemetry::global;
use tracing::info_span;
use tracing_opentelemetry::OpenTelemetrySpanExt;

pub fn publish(queue: &Queue, body: &[u8]) {
    let span = info_span!("send orders", otel.kind = "producer",
        messaging.system = "rabbitmq", messaging.destination.name = "orders");
    let _entered = span.enter();

    // Writes traceparent for the span into the headers.
    let mut headers = HashMap::new();
    global::get_text_map_propagator(|p| p.inject_context(&span.context(), &mut headers));
    queue.send(body, headers);
}

pub fn on_message(message: &Message) {
    // Reads traceparent back from the message headers.
    let parent = global::get_text_map_propagator(|p| p.extract(&message.headers));
    let span = info_span!("process orders", otel.kind = "consumer",
        messaging.system = "rabbitmq", messaging.destination.name = "orders");
    let _ = span.set_parent(parent);
    let _entered = span.enter();

    handle_order(&message.body);
}` },
    { id: "java", label: "Java", lang: "java", install: "io.opentelemetry:opentelemetry-api", code: `import io.opentelemetry.api.GlobalOpenTelemetry;
import io.opentelemetry.api.trace.Span;
import io.opentelemetry.api.trace.SpanKind;
import io.opentelemetry.api.trace.Tracer;
import io.opentelemetry.context.Context;
import io.opentelemetry.context.Scope;
import io.opentelemetry.context.propagation.TextMapGetter;
import io.opentelemetry.context.propagation.TextMapPropagator;
import java.util.HashMap;
import java.util.Map;

public class Orders {
    static final Tracer tracer = GlobalOpenTelemetry.getTracer("orders");

    static final TextMapGetter<Map<String, String>> getter = new TextMapGetter<>() {
        public Iterable<String> keys(Map<String, String> headers) {
            return headers.keySet();
        }

        public String get(Map<String, String> headers, String key) {
            return headers.get(key);
        }
    };

    static TextMapPropagator propagator() {
        return GlobalOpenTelemetry.getPropagators().getTextMapPropagator();
    }

    static void publish(Queue queue, byte[] body) {
        Span span = tracer.spanBuilder("send orders").setSpanKind(SpanKind.PRODUCER)
                .setAttribute("messaging.system", "rabbitmq")
                .setAttribute("messaging.destination.name", "orders").startSpan();
        try (Scope scope = span.makeCurrent()) {
            // Writes traceparent for the span into the headers.
            Map<String, String> headers = new HashMap<>();
            propagator().inject(Context.current(), headers, Map::put);
            queue.send(body, headers);
        } finally {
            span.end();
        }
    }

    static void onMessage(Message message) {
        // Reads traceparent back from the message headers.
        Context parent = propagator().extract(Context.root(), message.headers(), getter);
        Span span = tracer.spanBuilder("process orders")
                .setParent(parent).setSpanKind(SpanKind.CONSUMER)
                .setAttribute("messaging.system", "rabbitmq")
                .setAttribute("messaging.destination.name", "orders").startSpan();
        try (Scope scope = span.makeCurrent()) {
            handleOrder(message.body());
        } finally {
            span.end();
        }
    }
}` },
    { id: "csharp", label: "C#", lang: "csharp", install: "dotnet add package OpenTelemetry", code: `using System.Diagnostics;
using OpenTelemetry;
using OpenTelemetry.Context.Propagation;

static class Orders
{
    // Register the source in your tracer setup with .AddSource("orders").
    static readonly ActivitySource Source = new("orders");

    public static void Publish(IQueue queue, byte[] body)
    {
        using var activity = Source.StartActivity("send orders", ActivityKind.Producer);
        activity?.SetTag("messaging.system", "rabbitmq");
        activity?.SetTag("messaging.destination.name", "orders");

        // Writes traceparent for the activity into the headers.
        var headers = new Dictionary<string, string>();
        Propagators.DefaultTextMapPropagator.Inject(
            new PropagationContext(activity?.Context ?? default, Baggage.Current),
            headers, (h, key, value) => h[key] = value);
        queue.Send(body, headers);
    }

    public static void OnMessage(Message message)
    {
        // Reads traceparent back from the message headers.
        var parent = Propagators.DefaultTextMapPropagator.Extract(default, message.Headers,
            (h, key) => h.TryGetValue(key, out var value) ? [value] : []);
        using var activity = Source.StartActivity(
            "process orders", ActivityKind.Consumer, parent.ActivityContext);
        activity?.SetTag("messaging.system", "rabbitmq");
        activity?.SetTag("messaging.destination.name", "orders");

        HandleOrder(message.Body);
    }
}` },
];

