---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import "../../styles/pricing-guide.css";
import GuideBody from "../../components/guides/GuideBody.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { getOffer, money, rateLabel } from "../../lib/pricing-offer";

const pageTitle = "Datadog Pricing: Per-Host Costs, Logs and Custom Metrics | Maple";
const pageDescription =
    "Datadog pricing explained: per-host infrastructure and APM prices, log ingest and indexing, custom metric billing, and three worked monthly bills at list price.";
const published = "2026-11-21";
const updated = "2026-11-21";
const updatedLabel = "November 21, 2026";
const verified = "2026-11-21";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const offer = await getOffer();
const gb = offer.allotments.find((a) => a.unit === "gb");
const sessions = offer.allotments.find((a) => a.unit === "sessions");

const toc = [
    { depth: 2, slug: "how-it-works", text: "How Datadog pricing works" },
    { depth: 3, slug: "free-tier", text: "The free tier" },
    { depth: 3, slug: "commitments", text: "Annual, monthly, on-demand" },
    { depth: 3, slug: "counting", text: "How hosts are counted" },
    { depth: 2, slug: "price-list", text: "The price list" },
    { depth: 3, slug: "logs", text: "Logs: ingest and index" },
    { depth: 3, slug: "apm", text: "APM and spans" },
    { depth: 2, slug: "surprises", text: "What surprises teams" },
    { depth: 2, slug: "examples", text: "What a month costs" },
    { depth: 3, slug: "small-team", text: "Small team" },
    { depth: 3, slug: "mid-team", text: "Mid-sized team" },
    { depth: 3, slug: "custom-metric", text: "One custom metric" },
    { depth: 2, slug: "reduce", text: "Cutting the bill" },
    { depth: 2, slug: "maple", text: "Maple pricing" },
];

// One color per billed category, reused by the badges, the bill bars and the tables.
const cats = {
    hosts: { label: "Hosts", color: "var(--chart-1)" },
    apm: { label: "APM and spans", color: "var(--chart-2)" },
    logs: { label: "Logs", color: "var(--chart-3)" },
    metrics: { label: "Custom metrics", color: "var(--chart-4)" },
    frontEnd: { label: "RUM and synthetics", color: "var(--chart-5)" },
} as const;
type Cat = keyof typeof cats;

// Datadog's US list prices, verified on the date above. [annual, on-demand]
const price = {
    infraPro: [15, 18],
    apm: [31, 36],
    logIngestGb: [0.1, 0.1],
    logIndex15dPerM: [1.7, 2.55],
    customMetricsPer100: [5, 5],
    indexedSpans15dPerM: [1.7, 2.55],
    rumMeasurePer1k: [0.15, 0.22],
    rumInvestigatePer1k: [3, 4.5],
    replayPer1k: [2.5, 3.6],
    apiTestsPer10k: [5, 7.2],
};
type Billing = 0 | 1;
const included = { customMetricsPerHost: 100, indexedSpansPerApmHostM: 1, ingestedSpansPerApmHostGb: 150 };

const cents = (n: number) => Math.round(n * 100 + 1e-6) / 100;
const usd = (n: number) => `$${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const rate = (n: number) => `$${n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 3 })}`;
const num = (n: number) => n.toLocaleString("en-US");

interface Usage {
    hosts: number;
    apmHosts: number;
    logGb: number;
    indexedLogsM: number;
    customMetrics: number;
    indexedSpansM: number;
    rumSessionsK: number;
    replaysK: number;
    apiRuns: number;
}
const bill = (u: Usage, b: Billing) => {
    const metricsOver = Math.max(0, u.customMetrics - u.hosts * included.customMetricsPerHost);
    // On-demand allotments accrue per host-hour: 1M a month over the year's 730-hour average month, for a 720-hour month here.
    const spansIncluded = b === 0 ? u.apmHosts * included.indexedSpansPerApmHostM : Math.round(u.apmHosts * included.indexedSpansPerApmHostM * (720 / 730) * 100) / 100;
    const spansOver = Math.max(0, cents(u.indexedSpansM - spansIncluded));
    const lines: { cat: Cat; label: string; calc: string; cost: number }[] = [
        { cat: "hosts", label: "Infrastructure Pro", calc: `${u.hosts} hosts × ${rate(price.infraPro[b])}`, cost: u.hosts * price.infraPro[b] },
        { cat: "apm", label: "APM", calc: `${u.apmHosts} APM hosts × ${rate(price.apm[b])}`, cost: u.apmHosts * price.apm[b] },
        { cat: "logs", label: "Log ingest", calc: `${num(u.logGb)} GB × ${rate(price.logIngestGb[b])}`, cost: u.logGb * price.logIngestGb[b] },
        { cat: "logs", label: "Log indexing, 15 days", calc: `${num(u.indexedLogsM)}M events × ${rate(price.logIndex15dPerM[b])}`, cost: u.indexedLogsM * price.logIndex15dPerM[b] },
        { cat: "metrics", label: "Custom metrics", calc: `${num(u.customMetrics)} − ${num(u.hosts * included.customMetricsPerHost)} included = ${num(metricsOver)}, × ${rate(price.customMetricsPer100[b])} per 100`, cost: (metricsOver / 100) * price.customMetricsPer100[b] },
        { cat: "apm", label: "Indexed spans", calc: `${u.indexedSpansM}M − ${spansIncluded}M included = ${spansOver}M × ${rate(price.indexedSpans15dPerM[b])}`, cost: spansOver * price.indexedSpans15dPerM[b] },
        { cat: "frontEnd", label: "RUM Measure", calc: `${num(u.rumSessionsK)}k sessions × ${rate(price.rumMeasurePer1k[b])} per 1,000`, cost: u.rumSessionsK * price.rumMeasurePer1k[b] },
        { cat: "frontEnd", label: "RUM Investigate", calc: `${num(u.replaysK)}k replayed sessions retained × ${rate(price.rumInvestigatePer1k[b])} per 1,000`, cost: u.replaysK * price.rumInvestigatePer1k[b] },
        { cat: "frontEnd", label: "Session Replay", calc: `${num(u.replaysK)}k sessions × ${rate(price.replayPer1k[b])} per 1,000`, cost: u.replaysK * price.replayPer1k[b] },
        { cat: "frontEnd", label: "Synthetic API tests", calc: `${num(u.apiRuns)} runs × ${rate(price.apiTestsPer10k[b])} per 10,000`, cost: (u.apiRuns / 10_000) * price.apiTestsPer10k[b] },
    ]
        .map((l) => ({ ...l, cost: cents(l.cost) }))
        .filter((l) => l.cost > 0);
    const total = cents(lines.reduce((sum, l) => sum + l.cost, 0));
    const byCat = (Object.keys(cats) as Cat[])
        .map((cat) => ({ cat, cost: cents(lines.filter((l) => l.cat === cat).reduce((sum, l) => sum + l.cost, 0)) }))
        .filter((c) => c.cost > 0);
    return { lines, total, byCat };
};

const smallUsage: Usage = { hosts: 5, apmHosts: 3, logGb: 50, indexedLogsM: 10, customMetrics: 800, indexedSpansM: 5, rumSessionsK: 0, replaysK: 0, apiRuns: 0 };
// Ten API checks, every minute, from two locations, over a 30-day month.
const apiRuns = 10 * 2 * 60 * 24 * 30;
const midUsage: Usage = { hosts: 40, apmHosts: 25, logGb: 1_000, indexedLogsM: 200, customMetrics: 12_000, indexedSpansM: 60, rumSessionsK: 500, replaysK: 50, apiRuns };
const small = bill(smallUsage, 0);
const mid = bill(midUsage, 0);
const midOnDemand = bill(midUsage, 1);
const billBars = [
    { label: "Small team, annual prices", bill: small },
    { label: "Mid-sized team, annual prices", bill: mid },
    { label: "Mid-sized team, on-demand", bill: midOnDemand },
];

// One distribution metric: every tag combination is a custom metric, times five aggregations.
const metric = { endpoints: 20, statuses: 5, hosts: 40, aggregations: 5 };
const combos = metric.endpoints * metric.statuses * metric.hosts;
const distributionCount = combos * metric.aggregations;
const withPercentiles = distributionCount * 2;
const percentileCost = cents((withPercentiles / 100) * price.customMetricsPer100[0]);
const noHostCount = metric.endpoints * metric.statuses * metric.aggregations * 2;
const noHostCost = cents((noHostCount / 100) * price.customMetricsPer100[0]);

// The mid-sized workload on Maple: spans and logs in GB; metrics estimated at 0.1 KB per data point.
const mapleRate = gb?.rate ?? 0.3;
const mapleIncluded = gb?.included ?? 100;
const sessionRate = sessions?.rate ?? 0.002;
const sessionsIncluded = sessions?.included ?? 5_000;
const traceGb = 600;
// Host metrics come with Datadog's host price; on Maple they are metric bytes too.
const hostSeries = midUsage.hosts * 200;
const metricGb = Math.round((((midUsage.customMetrics + hostSeries) * 60 * 24 * 30 * 0.1) / 1_000_000) * 100) / 100;
const mapleLines = [
    { label: "Plan", calc: "Monthly price", cost: offer.price },
    { label: "Logs", calc: `${num(midUsage.logGb)} GB − ${mapleIncluded} included = ${num(midUsage.logGb - mapleIncluded)} GB × ${rateLabel(mapleRate)}`, cost: cents(Math.max(0, midUsage.logGb - mapleIncluded) * mapleRate) },
    { label: "Traces", calc: `${traceGb} GB − ${mapleIncluded} included = ${traceGb - mapleIncluded} GB × ${rateLabel(mapleRate)}`, cost: cents(Math.max(0, traceGb - mapleIncluded) * mapleRate) },
    { label: "Metrics", calc: `about ${metricGb} GB, inside the ${mapleIncluded} GB included`, cost: cents(Math.max(0, metricGb - mapleIncluded) * mapleRate) },
    { label: "Session replays", calc: `${num(midUsage.replaysK * 1000)} − ${num(sessionsIncluded)} included = ${num(midUsage.replaysK * 1000 - sessionsIncluded)} × ${rateLabel(sessionRate)}`, cost: cents(Math.max(0, midUsage.replaysK * 1000 - sessionsIncluded) * sessionRate) },
];
const likeForLike = cents(mid.total - mid.lines.filter((l) => l.label === "RUM Measure" || l.label === "Synthetic API tests").reduce((sum, l) => sum + l.cost, 0));
const mapleTotal = cents(mapleLines.reduce((sum, l) => sum + l.cost, 0));
// Sensitivity: the same metrics at three times the bytes per data point.
const metricGbHigh = Math.round(metricGb * 3 * 100) / 100;
const mapleTotalHigh = cents(mapleTotal + Math.max(0, metricGbHigh - mapleIncluded) * mapleRate);
const allSessionsOnMaple = cents((midUsage.rumSessionsK * 1000 - sessionsIncluded) * sessionRate);

const faqs = [
    {
        question: "How much does Datadog cost per host?",
        answer:
            `Infrastructure Pro is $15 per host per month billed annually or $18 on-demand. Enterprise is $23 or $27. APM adds $31 per APM host billed annually or $36 on-demand, so a host with both costs $46 a month on an annual plan. Logs, custom metrics above the included 100 per host, RUM and synthetics are billed on top (prices verified ${verified}).`,
    },
    {
        question: "Is Datadog free?",
        answer:
            "Datadog has a free tier for up to five hosts with one day of metric retention. It does not include APM, log management or the other paid products, which are billed per host or per unit from the first one.",
    },
    {
        question: "How does Datadog bill custom metrics?",
        answer:
            "A custom metric is a metric name plus one unique combination of tag values, including the host tag. Datadog counts the distinct combinations each hour and averages them over the month. Infrastructure Pro includes 100 per host and Enterprise 200, pooled across the account. The list price above that is $5 per 100 custom metrics per month.",
    },
    {
        question: "What is the difference between ingested and indexed logs in Datadog?",
        answer:
            "Ingest is $0.10 per GB for every log Datadog receives. Indexing is a second charge per million log events you keep searchable, priced by retention: $1.06 for 3 days, $1.27 for 7, $1.70 for 15 and $2.50 for 30 days on annual billing. Logs you exclude from indexes still pay the ingest charge.",
    },
    {
        question: "What is the difference between annual and on-demand Datadog pricing?",
        answer:
            "Annual prices need a commitment. On-demand pays for usage with no commitment, at a higher rate: Infrastructure Pro is $18 instead of $15 per host, APM $36 instead of $31, and 15-day log indexing $2.55 instead of $1.70 per million events. For logs, Datadog says volume above a monthly commitment pays 50% over the annual price.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Datadog pricing, explained",
    description: pageDescription,
    datePublished: published,
    dateModified: updated,
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/datadog-pricing`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        class="shell pt-4"
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Datadog pricing" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="shell relative pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Pricing</span>
                    <span>10 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Datadog pricing, explained
                </h1>
                <p class="mt-7 max-w-[54ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    What a host, a gigabyte of logs and a custom metric cost, and three monthly bills worked out line by line.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt={author.name} width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime={updated}>Updated {updatedLabel}</time>
                    <span>Prices verified {verified}</span>
                </div>
            </div>
        </header>

        <GuideBody headings={toc} class="pricing-guide">
                <section class="guide-lead">
                    <p>
                        <strong>Datadog</strong> is a monitoring platform sold as separate products: infrastructure, APM, log management, real user monitoring, synthetics and dozens more. Each product has its own unit, so a bill adds up hosts, gigabytes, million-event blocks, sessions and test runs.
                    </p>
                    <p>
                        This guide covers how the products are billed, the list prices for the ones most teams use, the charges that surprise people, three worked monthly bills, and how to bring a Datadog bill down.
                    </p>
                    <p class="guide-disclosure">
                        Maple publishes this guide and competes with Datadog. Section 06 compares the two; every Datadog figure comes from Datadog's own pages, linked at the end.
                    </p>
                    <div class="guide-takeaways">
                        <p class="guide-kicker">Key takeaways</p>
                        <ul>
                            <li>Infrastructure Pro is $15 per host per month on an annual plan, $18 on-demand.</li>
                            <li>APM is another $31 per APM host on an annual plan, $36 on-demand.</li>
                            <li>Logs bill twice: $0.10 per GB ingested, then $1.70 per million events indexed for 15 days.</li>
                            <li>Each tag combination on a metric is a separate custom metric. Pro includes 100 per host.</li>
                            <li>Hosts are counted hourly, and the bill uses the highest count after dropping the top 1% of hours.</li>
                        </ul>
                    </div>
                </section>

                <section id="how-it-works" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · The model</p>
                    <h2>How Datadog pricing works</h2>
                    <p>
                        Datadog has no single plan. You turn on products, and each one meters its own unit. The ones in this guide bill in five ways:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Category</th><th>Unit</th><th>Examples</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.hosts.color}`}>Hosts</span></td><td>Per host per month</td><td>Infrastructure, Database Monitoring</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.apm.color}`}>APM and spans</span></td><td>Per APM host, plus spans per GB and per million</td><td>APM, indexed spans</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Logs</span></td><td>Per GB ingested, plus per million events indexed</td><td>Log Management, Flex Logs</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Custom metrics</span></td><td>Per 100 metrics above the host allotment</td><td>Metrics from your code or OpenTelemetry</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>RUM and synthetics</span></td><td>Per 1,000 sessions, per test run</td><td>RUM, Session Replay, API and browser tests</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <h3 id="free-tier" class="scroll-mt-24">The free tier</h3>
                    <p>
                        Datadog's free tier covers <strong>up to five hosts with one day of metric retention</strong>. It is enough to try the agent and the dashboards. APM, logs and the other paid products are not part of it.
                    </p>

                    <h3 id="commitments" class="scroll-mt-24">Annual, monthly and on-demand</h3>
                    <p>
                        Every product has three prices: annual, month-to-month and on-demand. Annual is the lowest and needs a commitment to a volume for the year. On-demand needs no commitment and costs more. For hosts the gap is 20%: Infrastructure Pro is $15 annual and $18 on-demand. For 15-day log indexing it is 50%: $1.70 against $2.55 per million events. For logs, the pricing page says a month above your committed volume pays 50% over the annual price, only on the volume past the commitment. A commitment sized below real usage pays that premium on the rest.
                    </p>

                    <h3 id="counting" class="scroll-mt-24">How hosts are counted</h3>
                    <p>
                        Datadog's billing docs say hosts are metered every hour. At the end of the month it drops the top 1% of hours and bills the <strong>highest remaining count</strong>, the high-water mark of the lower 99%. A fleet that runs 20 hosts most of the month and scales to 60 for two days pays for 60, because two days is more than 1% of a month. A container running its own agent counts as a host; the docs recommend one agent per host for that reason.
                    </p>
                    <p class="guide-verified">
                        Verified {verified} against <a href="https://www.datadoghq.com/pricing/" target="_blank" rel="noopener noreferrer">datadoghq.com/pricing</a>, the <a href="https://www.datadoghq.com/pricing/list/" target="_blank" rel="noopener noreferrer">full price list</a> and <a href="https://docs.datadoghq.com/account_management/billing/" target="_blank" rel="noopener noreferrer">Datadog's billing docs</a>.
                    </p>
                </section>

                <section id="price-list" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · List prices</p>
                    <h2>The Datadog price list</h2>
                    <p>
                        These are the US list prices for the products most teams start with. The full list has more than a hundred lines.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Product</th><th>Unit</th><th>Annual</th><th>On-demand</th></tr>
                            </thead>
                            <tbody>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.hosts.color}`}>Infrastructure Pro</span></td><td>Per host per month</td><td>$15</td><td>$18</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.hosts.color}`}>Infrastructure Enterprise</span></td><td>Per host per month</td><td>$23</td><td>$27</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.apm.color}`}>APM</span></td><td>Per APM host per month</td><td>$31</td><td>$36</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.apm.color}`}>APM Enterprise</span></td><td>Per APM host, adds the profiler</td><td>$40</td><td>$48</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Log ingest</span></td><td>Per GB</td><td>$0.10</td><td>$0.10</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.logs.color}`}>Log indexing, 15 days</span></td><td>Per million events</td><td>$1.70</td><td>$2.55</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.metrics.color}`}>Custom metrics</span></td><td>Per 100, above the allotment</td><td>$5</td><td>$5</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>RUM Measure</span></td><td>Per 1,000 sessions</td><td>$0.15</td><td>$0.22</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>RUM Investigate</span></td><td>Per 1,000 retained sessions</td><td>$3</td><td>$4.50</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>Session Replay</span></td><td>Per 1,000 sessions</td><td>$2.50</td><td>$3.60</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>Synthetic API tests</span></td><td>Per 10,000 runs</td><td>$5</td><td>$7.20</td></tr>
                                <tr><td><span class="cat-badge" style={`--cat: ${cats.frontEnd.color}`}>Synthetic browser tests</span></td><td>Per 1,000 runs</td><td>$12</td><td>$18</td></tr>
                                <tr><td>Database Monitoring</td><td>Per database host per month</td><td>$70</td><td>$84</td></tr>
                                <tr><td>Error Tracking</td><td>Flat price for the first 50,000 errors a month</td><td>$25</td><td>$36</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="table-note">
                        Month-to-month prices sit between the two columns for most products and match on-demand for hosts. Existing customers may have different allotments in their contract.
                    </p>
                    <p>
                        Each Infrastructure Pro host includes <strong>100 custom metrics</strong> and 5 containers; Enterprise includes 200 and 10. Extra containers cost $1 a month each prepaid or $0.002 per container-hour on-demand. Allotments are pooled across the account, so one busy host can use the allotment of a quiet one.
                    </p>

                    <h3 id="logs" class="scroll-mt-24">Logs: ingest, then index</h3>
                    <p>
                        Every log Datadog receives pays <strong>$0.10 per GB</strong> to ingest. Logs you want to search and alert on go into an index, which bills per million events at the retention you choose:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Index retention</th><th>Annual, per million events</th><th>On-demand</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>3 days</td><td>$1.06</td><td>$1.59</td></tr>
                                <tr><td>7 days</td><td>$1.27</td><td>$1.91</td></tr>
                                <tr><td>15 days</td><td>$1.70</td><td>$2.55</td></tr>
                                <tr><td>30 days</td><td>$2.50</td><td>$3.75</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Indexing is priced per event, not per byte. At 1 KB per log line, a GB holds about a million events, so indexing it for 15 days costs 17 times what ingesting it did. Flex Logs is a cheaper storage tier for logs you search rarely, at $0.05 per million events stored per month on an annual plan.
                    </p>

                    <h3 id="apm" class="scroll-mt-24">APM and spans</h3>
                    <p>
                        Each APM host includes <strong>150 GB of ingested spans</strong> and <strong>1 million indexed spans</strong> a month, both pooled across the account. Ingested spans above the allotment are $0.10 per GB. Indexed spans, the ones kept for search and analytics, are $1.70 per million for 15 days on an annual plan or $2.55 on-demand. On on-demand billing, the pricing page says span allotments are metered each hour rather than pooled over the month, so a traffic spike can cross the allotment even when the monthly total would not.
                    </p>
                </section>

                <section id="surprises" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>03</span> · Surprises</p>
                    <h2>What surprises teams on a Datadog bill</h2>
                    <ul class="guide-list">
                        <li><strong>Custom metrics multiply with tags.</strong> Datadog counts every distinct combination of metric name and tag values, including <code>host</code>, as one custom metric. A distribution metric counts five per combination, and turning on percentiles doubles that. The worked example below prices one such metric.</li>
                        <li><strong>Indexed logs cost more than ingested ones.</strong> Teams budget for $0.10 per GB and then index most of what they send.</li>
                        <li><strong>Short spikes set the host count.</strong> Anything above 1% of the month, about 7 hours, counts toward the high-water mark. Autoscaling for a weekly batch job can set the bill.</li>
                        <li><strong>Containers past the allotment.</strong> A Kubernetes node packed with small pods passes 5 containers per host quickly, and each extra one bills by the hour.</li>
                        <li><strong>Each product is its own line.</strong> RUM, Session Replay, synthetics, Database Monitoring, error tracking and security products each add a meter. A dashboard that pulls from five products is billed by five.</li>
                        <li><strong>Growth past the commitment costs more per unit.</strong> On-demand prices run about 16% to 50% above annual ones, and log volume above a commitment pays 50% over the annual price.</li>
                    </ul>
                </section>

                <section id="examples" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>04</span> · Examples</p>
                    <h2>What a month of Datadog costs</h2>
                    <p>
                        Three bills at list price, from rates checked {verified}. Volumes are monthly and a month is 30 days. Each bar splits one bill by category:
                    </p>

                    <figure class="bills" aria-label={`Where each bill goes. ${billBars.map(({ label, bill: b }) => `${label}, ${usd(b.total)}: ${b.byCat.map((c) => `${cats[c.cat].label} ${usd(c.cost)}`).join(", ")}.`).join(" ")}`}>
                        <div aria-hidden="true">
                            {billBars.map(({ label, bill: b }) => (
                                <div class="bills__row">
                                    <p class="bills__head"><span>{label}</span><strong>{usd(b.total)}</strong></p>
                                    <div class="bills__bar">
                                        {b.byCat.map((c) => {
                                            const share = (c.cost / b.total) * 100;
                                            return <span style={`--cat: ${cats[c.cat].color}; width: ${share}%`}>{share >= 9 ? `${Math.round(share)}%` : ""}</span>;
                                        })}
                                    </div>
                                </div>
                            ))}
                            <div class="bills__legend">
                                {(Object.keys(cats) as Cat[]).map((cat) => (
                                    <span><i style={`--cat: ${cats[cat].color}`}></i>{cats[cat].label}</span>
                                ))}
                            </div>
                        </div>
                    </figure>

                    <h3 id="small-team" class="scroll-mt-24">Small team: about {usd(small.total)} a month</h3>
                    <p>
                        Five hosts on Infrastructure Pro, three of them running APM. They send 50 GB of logs, about 50 million events, and index 10 million of them for 15 days. Their services emit 800 custom metrics and they index 5 million spans. Annual prices:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation</th><th>Per month</th></tr>
                            </thead>
                            <tbody>
                                {small.lines.map((l) => (
                                    <tr><td><span class="cat-badge" style={`--cat: ${cats[l.cat].color}`}>{l.label}</span></td><td>{l.calc}</td><td class="num">{usd(l.cost)}</td></tr>
                                ))}
                                <tr class="row-total"><td>Total</td><td></td><td class="num">{usd(small.total)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Hosts and APM are {Math.round(((small.lines[0].cost + small.lines[1].cost) / small.total) * 100)}% of this bill. The 50 GB of logs cost {usd(small.lines[2].cost + small.lines[3].cost)} in total, less than APM for one host.
                    </p>

                    <h3 id="mid-team" class="scroll-mt-24">Mid-sized team: about {usd(mid.total)} a month</h3>
                    <p>
                        Forty hosts on Infrastructure Pro, 25 of them running APM. They ingest 1,000 GB of logs and index 200 million events for 15 days. Services send 600 GB of spans, emit 12,000 custom metrics and index 60 million spans. The web app has 500,000 sessions a month on RUM Measure, with Session Replay on 50,000 of them, which are retained on RUM Investigate so they can be replayed. Ten API checks run every minute from two locations, {num(apiRuns)} runs.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation, annual</th><th>Annual</th><th>On-demand</th></tr>
                            </thead>
                            <tbody>
                                {mid.lines.map((l, i) => (
                                    <tr><td><span class="cat-badge" style={`--cat: ${cats[l.cat].color}`}>{l.label}</span></td><td>{l.calc}</td><td class="num">{usd(l.cost)}</td><td class="num">{usd(midOnDemand.lines[i].cost)}</td></tr>
                                ))}
                                <tr class="row-total"><td>Total</td><td></td><td class="num">{usd(mid.total)}</td><td class="num">{usd(midOnDemand.total)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        The same month on-demand costs {usd(cents(midOnDemand.total - mid.total))} more. The on-demand span line assumes traffic is even across hours; since on-demand span allotments are metered hourly, uneven traffic costs more. The 864,000 synthetic runs cost almost as much as ingesting and indexing all the logs, because every location multiplies every check. The 600 GB of spans stays inside the 3,750 GB that 25 APM hosts include, so span ingest adds nothing here.
                    </p>

                    <h3 id="custom-metric" class="scroll-mt-24">One custom metric: {usd(percentileCost)} a month</h3>
                    <p>
                        The mid-sized team adds one distribution metric, <code>checkout.latency</code>, tagged with <code>endpoint</code> (20 values), <code>status</code> (5) and <code>host</code> (40). If every combination reports in every hour of the month, the worst case:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Step</th><th>Calculation</th><th>Custom metrics</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Tag combinations</td><td>20 × 5 × 40</td><td class="num">{num(combos)}</td></tr>
                                <tr><td>Distribution aggregations</td><td>{num(combos)} × 5 (count, sum, min, max, avg)</td><td class="num">{num(distributionCount)}</td></tr>
                                <tr><td>With percentiles turned on</td><td>{num(distributionCount)} × 2</td><td class="num">{num(withPercentiles)}</td></tr>
                                <tr class="row-total"><td>Monthly cost</td><td>{num(withPercentiles)} ÷ 100 × $5</td><td class="num">{usd(percentileCost)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        The team's 4,000 included metrics are already used, so all of it is billed. Dropping the <code>host</code> tag leaves 100 combinations, {num(noHostCount)} custom metrics and {usd(noHostCost)} a month. This is the arithmetic from Datadog's own custom metrics billing docs, which use the same five-per-combination rule.
                    </p>
                </section>

                <section id="reduce" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>05</span> · Cutting the bill</p>
                    <h2>How to cut a Datadog bill</h2>
                    <ol class="guide-steps">
                        <li>
                            <span>01</span>
                            <div><h4>Find the top line first</h4><p>The <strong>Plan &amp; Usage</strong> page breaks the bill down by product. In the mid-sized example, hosts and APM are about half; in a log-heavy setup, indexing is. Work on the biggest line.</p></div>
                        </li>
                        <li>
                            <span>02</span>
                            <div><h4>Index less, or index for less time</h4><p>Exclusion filters on an index stop events from being indexed; they still pay $0.10 per GB to ingest. Moving debug and access logs from a 15-day index to a 3-day one cuts their indexing price from $1.70 to $1.06 per million. Flex Logs suits logs you only search during an audit.</p></div>
                        </li>
                        <li>
                            <span>03</span>
                            <div><h4>Drop high-cardinality tags from metrics</h4><p>The <strong>Metrics Summary</strong> page lists custom metrics by count. Remove <code>host</code>, user IDs and request IDs from metric tags, and turn off percentiles you never chart. Metrics without Limits lets you choose which tags stay queryable.</p></div>
                        </li>
                        <li>
                            <span>04</span>
                            <div><h4>Keep APM on the hosts that need it</h4><p>APM is priced per host, so a utility host running the tracer costs $31 a month for traces nobody reads. Retention filters decide which ingested spans get indexed.</p></div>
                        </li>
                        <li>
                            <span>05</span>
                            <div><h4>Run one agent per node</h4><p>An agent inside each container makes every container a billable host. One containerized agent per Kubernetes node counts the node once and its containers against the allotment.</p></div>
                        </li>
                        <li>
                            <span>06</span>
                            <div><h4>Commit to the steady baseline</h4><p>Commit annually to the volume you always use and leave peaks on-demand. Size the commitment from a few months of the usage page, not from a host count at signing.</p></div>
                        </li>
                    </ol>
                    <p>
                        Synthetics can be a quick saving. A check that runs every 5 minutes instead of every minute is 80% fewer runs, at the cost of noticing an outage up to 4 minutes later.
                    </p>
                </section>

                <section id="maple" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>06</span> · Maple</p>
                    <h2>Maple pricing for the same workload</h2>
                    <p>
                        Maple is an OpenTelemetry observability platform. It has one plan at <strong>{money(offer.price)}{offer.interval}</strong> with {mapleIncluded} GB each of logs, traces and metrics included, then {rateLabel(mapleRate)} per GB for each signal. There is no host, seat or index charge. Browser sessions with replay are {num(sessionsIncluded)} a month included, then {rateLabel(sessionRate)} each. Logs and traces are kept 30 days and metrics 90.
                    </p>
                    <p>
                        The mid-sized team's month on Maple. Maple meters uncompressed OTLP bytes. Metrics are estimated at 0.1 KB per data point, one point a minute, for the 12,000 custom metrics plus about 200 system series per host ({num(hostSeries)} in all), which Datadog's host price covers:
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th>Line</th><th>Calculation</th><th>Per month</th></tr>
                            </thead>
                            <tbody>
                                {mapleLines.map((l) => (
                                    <tr><td>{l.label}</td><td>{l.calc}</td><td class="num">{usd(l.cost)}</td></tr>
                                ))}
                                <tr class="row-total"><td>Total</td><td></td><td class="num">{usd(mapleTotal)}</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        If metric points average 0.3 KB instead, metrics are {metricGbHigh} GB and the total is {usd(mapleTotalHigh)}. That compares with {usd(mid.total)} on Datadog's annual prices, or {usd(likeForLike)} without the RUM Measure and synthetics lines that Maple does not price the same way. Maple records replays only for the sessions you sample. It has no cheap tier for counting every session the way RUM Measure does: recording all 500,000 sessions would cost {usd(allSessionsOnMaple)}, more than Datadog's $75. Maple includes 10 uptime monitors, which this guide does not compare check for check with the 864,000 API runs, and it has no browser tests. It does not offer database monitoring, security products or Datadog's catalog of integrations, and it keeps logs 30 days.
                    </p>
                    <p>
                        Datadog is the better fit when you rely on those products, or on its agent's integrations for hosts and managed services. Maple fits teams that already send OpenTelemetry and want a bill that moves with gigabytes rather than hosts and tags.
                    </p>

                    <div class="guide-maple">
                        <p class="guide-kicker">Maple</p>
                        <h3>Price your own month</h3>
                        <p>The calculator prices Datadog and Maple on the same sliders, and the compare page goes product by product.</p>
                        <div class="mt-6 flex flex-wrap gap-3">
