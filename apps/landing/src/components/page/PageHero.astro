---
/**
 * PageHero — the hero for feature and use-case pages.
 *
 * The old FeatureHero is still in the tree serving /pricing, /observability,
 * /opentelemetry, /roadmap, /best-… and /integrations/*, so this is an
 * addition rather than an edit. What changes on the pages that adopt it:
 * a 60px line grid becomes the system's own 16×16 dot grid (the /infra
 * texture); `max-w-6xl` becomes `.shell`, so the hero finally lines up with
 * the nav and footer above and below it; the `rounded-full` amber pill becomes
 * the 0.18em eyebrow every homepage section uses; `font-bold` becomes
 * `font-semibold`.
 *
 * Feature pages pair the copy with a decorative Roman engraving. Other pages
 * retain the dot-grid veil and their existing aside layout.
 *
 * The breadcrumb renders inside this component so it sits on the same axis as
 * everything else. It keeps its own BreadcrumbList JSON-LD.
 */
import { buttonVariants } from "@maple/ui/components/ui/button";
import * as m from "../../paraglide/messages.js";
import Breadcrumb from "../Breadcrumb.astro";
import { HeroCta } from "../HeroCta";

interface Props {
	eyebrow: string;
	title: string;
	lede: string;
	illustration?: string;
	breadcrumb: { label: string; href?: string }[];
	/**
	 * Use-case pages only: the literal signal that opens the story, e.g.
	 * "checkout p99 380 ms · threshold 200 ms". Never translated — it is
	 * product data, and the pages below it show it verbatim.
	 */
	signal?: string;
}

const { eyebrow, title, lede, breadcrumb, signal, illustration } = Astro.props;

// An optional right-hand column (the /compare logo pairing). Without it the
// hero keeps its single-column measure; with it, the copy and the aside sit
// on one row from lg up, centred on each other.
const hasAside = Astro.slots.has("aside");
---

<section class:list={["relative overflow-hidden bg-bg", illustration && "page-hero--illustrated"]}>
	{illustration ? (
		<div class="page-hero__art" aria-hidden="true">
			<img src={illustration} width="1536" height="1024" alt="" loading="eager" decoding="async" />
		</div>
	) : <div class="dot-grid-veil" aria-hidden="true"></div>}

	<div class="relative">
		<Breadcrumb items={breadcrumb} class="shell pt-24 md:pt-28" />

		<div
			class:list={[
				"shell pb-16 pt-8 md:pb-24 md:pt-10",
				hasAside && "grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-center lg:gap-16",
			]}
		>
		<div class:list={["min-w-0", illustration && "page-hero__copy"]}>
			<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{eyebrow}</p>

			<h1
				class="mt-5 max-w-[20ch] font-display text-[2.375rem] font-semibold leading-[1.03] tracking-[-0.025em] text-fg sm:text-5xl lg:text-6xl"
			>
				{title}
			</h1>

			<p class="mt-6 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-base">{lede}</p>

			{
				signal && (
					<p class="mt-7 inline-flex items-center gap-2.5 rounded-lg border border-border bg-bg-elevated px-3.5 py-2 font-mono text-[12.5px] text-fg">
						<span class="op-key">signal</span>
						{signal}
					</p>
				)
			}

			<div class="mt-10 flex flex-wrap items-center gap-3">
				<HeroCta client:load className={buttonVariants({ size: "xl" })} />
				<a
					href="https://github.com/MapleTechLabs/maple"
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ variant: "outline", size: "xl" })}
				>
					{m.cta_github()}
				</a>
			</div>
		</div>
		{hasAside && <div class="min-w-0"><slot name="aside" /></div>}
		</div>
	</div>
</section>

<style>
	.page-hero__art {
		position: absolute;
		inset: 0;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, transparent, black 18%, black 85%, transparent);
	}

	.page-hero__art img {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 72%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.75;
		mask-image: linear-gradient(to right, transparent, black 55%);
	}

	@media (min-width: 1024px) {
		.page-hero__copy {
			max-width: 58%;
		}
	}

	@media (max-width: 1023px) {
		.page-hero__art img {
			width: 100%;
			opacity: 0.2;
			object-position: 65% center;
		}
	}
</style>
