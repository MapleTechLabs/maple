{
	"name": "@maple-dev/alchemy",
	"version": "0.2.5",
	"description": "Alchemy provider for Maple resources — declare API keys, ingest keys, dashboards, alert destinations, and alert rules in your alchemy.run.ts",
	"keywords": [
		"alchemy",
		"effect",
		"infrastructure-as-code",
		"maple",
		"observability",
		"opentelemetry"
	],
	"homepage": "https://maple.dev",
	"bugs": "https://github.com/MapleTechLabs/maple/issues",
	"license": "MIT",
	"author": "Makisuo, Inc.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MapleTechLabs/maple.git",
		"directory": "packages/alchemy-maple"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./telemetry": {
			"types": "./dist/telemetry.d.mts",
			"import": "./dist/telemetry.mjs"
		},
		"./local": {
			"types": "./dist/local.d.mts",
			"import": "./dist/local.mjs"
		},
		"./local-sidecar": {
			"types": "./dist/local-sidecar.d.mts",
			"import": "./dist/local-sidecar.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsrs --noEmit",
		"test": "vitest run",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@maple-dev/effect-sdk": "workspace:*"
	},
	"devDependencies": {
		"@effect/platform-bun": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@maple/domain": "workspace:*",
		"@maple/local-server": "workspace:*",
		"@types/bun": "^1.4.4",
		"@types/node": "catalog:tooling",
		"alchemy": "catalog:alchemy",
		"effect": "catalog:effect",
		"tsdown": "^0.23.0",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-bun": "^4.0.0",
		"alchemy": ">=2.0.0-beta.80 <3",
		"effect": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@effect/platform-bun": {
			"optional": true
		}
	}
}
