<script>
    import { bindCopyButtons } from "../../lib/copy-to-clipboard";

    // A copy button on every code block, as on the docs pages. Output blocks get none.
    const article = document.querySelector(".loguru-guide");
    if (article) {
        for (const pre of article.querySelectorAll<HTMLPreElement>("pre:not(.pre-output)")) {
            pre.dataset.copy = pre.textContent ?? "";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "code-copy";
            button.textContent = "copy";
            button.setAttribute("aria-label", "Copy code");
            pre.appendChild(button);
        }
        bindCopyButtons({
            root: article,
            hostSelector: "pre[data-copy]",
            buttonSelector: ".code-copy",
            track: { event: "docs_snippet_copied", key: "snippet" },
        });
    }
</script>

