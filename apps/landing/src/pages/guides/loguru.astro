const enqueueCode = String.raw`import multiprocessing

from loguru import logger


def set_logger(parent_logger):
    global logger
    logger = parent_logger


def work(n):
    logger.info("Worker processed item {}", n)


if __name__ == "__main__":
    logger.remove()
    logger.add("logs/workers.log", enqueue=True)

    context = multiprocessing.get_context("spawn")
    with context.Pool(4, initializer=set_logger, initargs=(logger,)) as pool:
        pool.map(work, range(8))

    logger.complete()`;

