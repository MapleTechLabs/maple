---
/**
 * BillComparison: spec-sheet-style table.
 * Dense, numerical, deliberately not pretty. No icons, no checkmarks, no
 * card grid. The Maple column is amber-tinted to register as the answer.
 *
 * Numbers/positions are approximations meant for editorial comparison;
 * exact pricing is in /pricing and /compare/* pages.
 */
import * as m from "../paraglide/messages.js";
import { BILL_ROW_KEYS, billRowLabels, billVendors } from "../lib/bill-comparison";

interface Props {
	/** The homepage passes nothing and gets its own chapter heading; /compare
	 *  overrides the three lines and drops the link row it already is. */
	eyebrow?: string;
	title?: string;
	lede?: string;
	links?: boolean;
	class?: string;
}

const {
	eyebrow = m.bill_eyebrow(),
	title = m.bill_title(),
	lede = m.bill_lede(),
	links = true,
	class: className = "",
} = Astro.props;

const vendors = billVendors();
const labels = billRowLabels();
---

<section class={`relative bg-bg-deep ${className}`}>
	<div class="shell py-16 md:py-32">
		<div class="text-[10px] uppercase tracking-[0.18em] text-fg-muted mb-4">{eyebrow}</div>
		<h2 class="max-w-[20ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] md:text-[40px] lg:text-[54px]">
			{title}
		</h2>
		<p class="mt-4 text-sm md:text-base text-fg-muted max-w-xl leading-relaxed">{lede}</p>

		<div class="mt-12 overflow-hidden rounded-xl border border-border bg-bg-elevated">
			<div class="overflow-x-auto">
				<!-- border-separate: a sticky cell keeps its rule while the row scrolls under it. -->
				<table class="w-full border-separate border-spacing-0 text-[12.5px] tabular-nums">
					<thead>
						<tr class="text-[10px] uppercase tracking-wider text-fg-muted">
							<th class="sticky left-0 z-10 bg-bg-elevated text-left font-medium px-4 py-3 border-b border-border">{m.bill_col_metric()}</th>
							{vendors.map((vendor) => (
								<th class:list={["text-left font-medium px-4 py-3 border-b border-border", vendor.id === "maple" && "bg-primary/12 text-primary"]}>{vendor.name}</th>
							))}
						</tr>
					</thead>
					<tbody>
						{BILL_ROW_KEYS.map((key, rowIndex) => {
							const rule = rowIndex === BILL_ROW_KEYS.length - 1 ? "" : "border-b border-border";
							return (
								<tr>
									<td class:list={["sticky left-0 z-10 bg-bg-elevated px-4 py-3 text-fg-muted", rule]}>{labels[key]}</td>
									{vendors.map((vendor) => (
										<td class:list={["px-4 py-3", rule, vendor.id === "maple" ? "bg-primary/8 text-primary font-medium" : "text-foreground"]}>{vendor.cells[key]}</td>
									))}
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>
		</div>

		<p class="mt-4 text-[11px] text-fg-muted/80 max-w-[80ch]">
			{m.bill_footnote()}
		</p>

		{links && <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
			<a href="/pricing" class="text-primary border-b border-primary/40 hover:border-primary pb-px transition-colors">
				{m.bill_link_calculator()}
			</a>
			<a href="/compare/datadog" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_dd()}
			</a>
			<a href="/compare/grafana" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_gf()}
			</a>
			<a href="/compare/new-relic" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_nr()}
			</a>
			<a href="/compare/dash0" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_dash0()}
			</a>
			<a href="/compare/signoz" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_signoz()}
			</a>
			<a href="/compare/axiom" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_axiom()}
			</a>
			<a href="/compare/better-stack" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_better_stack()}
			</a>
			<a href="/compare/honeycomb" class="text-fg-muted hover:text-fg border-b border-border hover:border-foreground pb-px transition-colors">
				{m.bill_link_vs_honeycomb()}
			</a>
		</div>}
	</div>
</section>
