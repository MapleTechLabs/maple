const bridgeCode = String.raw`# telemetry.py, below the logger_provider setup from the Python guide
import logging

from loguru import logger
from opentelemetry.instrumentation.logging.handler import LoggingHandler

otel_logger = logging.getLogger("loguru.otel")
otel_logger.setLevel(logging.DEBUG)
otel_logger.propagate = False
otel_logger.addHandler(LoggingHandler(logger_provider=logger_provider, log_code_attributes=True))


def otel_sink(message):
    record = message.record
    log_record = otel_logger.makeRecord(
        record["name"],
        record["level"].no,
        record["file"].path,
        record["line"],
        record["message"],
        (),
        record["exception"],
        func=record["function"],
        extra=record["extra"],
    )
    log_record.levelname = record["level"].name
    otel_logger.handle(log_record)


logger.add(
    otel_sink,
    level="INFO",
    filter=lambda record: not record["name"].startswith("opentelemetry"),
)`;

