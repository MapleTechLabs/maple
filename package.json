{
	"name": "maple",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*",
		"lib/*",
		"examples/*"
	],
	"scripts": {
		"build": "turbo build",
		"dev": "bun run ./scripts/dev.ts",
		"dev:signin": "bun run ./scripts/dev-signin.ts",
		"preview:signin": "bun run ./scripts/preview-signin.ts",
		"errors:tick": "bun run ./scripts/errors-tick.ts",
		"errors:replay": "bun run ./scripts/errors-replay.ts",
		"seed:demo": "bun run ./scripts/seed-demo.ts",
		"seed:demo:env": "bun run ./scripts/seed-demo/make-env.ts",
		"seed:demo:code-review": "bun run ./scripts/seed-demo/code-review.ts",
		"prepare": "effect-tsgo unpatch --no-typescript --oxlint && effect-tsgo patch --no-typescript --oxlint",
		"docker:build": "COMPOSE_PARALLEL_LIMIT=1 docker compose build",
		"docker:up": "COMPOSE_PARALLEL_LIMIT=1 docker compose up --build",
		"db:up": "docker compose up -d postgres electric",
		"ch:up": "docker compose -f docker-compose.development.yml up -d clickhouse",
		"ch:down": "docker compose -f docker-compose.development.yml stop clickhouse",
		"bench:queries": "bun apps/api/scripts/bench-queries.ts",
		"ch:test": "CLICKHOUSE_E2E=1 CLICKHOUSE_E2E_URL=http://127.0.0.1:8123 bun run --cwd apps/api test scripts/query-bench/catalog.clickhouse.e2e.test.ts && CLICKHOUSE_E2E=1 CLICKHOUSE_E2E_URL=http://127.0.0.1:8123 bun run --cwd packages/backend test src/services/warehouse/WarehouseQueryService.clickhouse.e2e.test.ts src/services/warehouse/web-analytics-parity.clickhouse.e2e.test.ts",
		"db:migrate:local": "DATABASE_URL=postgres://maple:maple@localhost:5499/maple bun run --cwd packages/db db:migrate",
		"backup:restore-test": "bun run --cwd packages/db db:restore-test",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "bun run lint:core && bun run lint:foldkit",
		"lint:core": "oxlint -c .oxlintrc.effect.json --quiet --ignore-pattern 'apps/web/**' --ignore-pattern 'apps/local-ui/**' alchemy.run.ts scripts test apps packages lib examples",
		"lint:foldkit": "oxlint -c .oxlintrc.effect.json --quiet apps/web && oxlint -c .oxlintrc.effect.json --quiet apps/local-ui",
		"lint:audit": "oxlint -c .oxlintrc.effect.json alchemy.run.ts scripts test apps packages lib examples",
		"lint:fix": "oxlint -c .oxlintrc.effect.json --fix alchemy.run.ts scripts test apps packages lib examples",
		"alchemy:build-deps": "turbo build --filter=@maple-dev/effect-sdk --filter=@maple-dev/alchemy --filter=@maple-dev/browser && bun run --cwd apps/scraper bundle",
		"alchemy:deploy:prd": "bun run alchemy:build-deps && alchemy deploy --yes --adopt --stage ${MAPLE_STAGE:-prd}",
		"alchemy:deploy:pr": "bun run alchemy:build-deps && alchemy deploy --yes --adopt --stage pr-${PR_NUMBER}",
		"alchemy:destroy:pr": "bun run alchemy:build-deps && alchemy destroy --yes --stage pr-${PR_NUMBER}",
		"test": "turbo test",
		"test:alchemy": "turbo build --filter=@maple-dev/effect-sdk --filter=@maple-dev/alchemy && vitest run --config test/alchemy/vitest.config.mts",
		"changeset": "changeset",
		"changeset:version": "changeset version && bun run ./scripts/sync-sdk-versions.ts && bun install --lockfile-only",
		"changeset:publish": "bun run ./scripts/publish-packages.ts",
		"tinybird:manifest": "bun run ./scripts/generate-tinybird-project-manifest.ts",
		"tinybird:manifest:check": "bun run ./scripts/generate-tinybird-project-manifest.ts --check",
		"tinybird:deploy": "bun run ./scripts/tinybird-deploy.ts",
		"tinybird:datafiles": "bun run ./scripts/write-tinybird-datafiles.ts",
		"clickhouse:schema": "bun run ./scripts/generate-clickhouse-schema.ts && bun run ./scripts/generate-clickhouse-schema-sql.ts && bun run ./scripts/generate-clickhouse-insert-mappings.ts && bun run ./scripts/lint-clickhouse-schema.ts",
		"clickhouse:schema:check": "bun run ./scripts/generate-clickhouse-schema.ts --check && bun run ./scripts/generate-clickhouse-schema-sql.ts --check && bun run ./scripts/generate-clickhouse-insert-mappings.ts --check && bun run ./scripts/lint-clickhouse-schema.ts && bun run ./scripts/check-local-schema-manifest.ts",
		"local-schema:bump": "bun run ./scripts/bump-local-schema.ts",
		"clickhouse:schema:lint": "bun run ./scripts/lint-clickhouse-schema.ts",
		"check:tokens": "bun run ./scripts/check-token-drift.ts",
		"ios:openapi": "bun run ./scripts/generate-ios-openapi.ts",
		"ios:openapi:check": "bun run ./scripts/generate-ios-openapi.ts --check",
		"knip": "bun run --cwd apps/landing sync:i18n && knip",
		"knip:fix": "bun run --cwd apps/landing sync:i18n && knip --fix --allow-remove-files",
		"typecheck": "turbo typecheck && tsrs -p tsconfig.alchemy.json"
	},
	"dependencies": {
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@alchemy.run/aws": "catalog:alchemy",
		"@alchemy.run/cloudflare": "catalog:alchemy",
		"@alchemy.run/cloudflare-runtime": "catalog:alchemy",
		"@alchemy.run/domain": "catalog:alchemy",
		"@alchemy.run/neon": "catalog:alchemy",
		"@alchemy.run/planetscale": "catalog:alchemy",
		"@changesets/cli": "3.0.3",
		"@cloudflare/workers-types": "catalog:alchemy",
		"@effect/platform-node": "catalog:effect",
		"@effect/sql-pg": "4.1.0",
		"@effect/tsgo": "0.57.0",
		"@effect/vitest": "catalog:effect",
		"@maple-dev/effect-orm": "0.8.0",
		"@maple/alchemy-portless": "workspace:*",
		"@maple/db": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/infra": "workspace:*",
		"@oxlint/plugins": "1.89.0",
		"@types/node": "catalog:tooling",
		"alchemy": "catalog:alchemy",
		"effect": "catalog:effect",
		"knip": "^6.43.0",
		"oxfmt": "^0.72.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005",
		"portless": "^0.15.12",
		"tsrs": "0.15.0-ts7.1.0-dev.20260929",
		"turbo": "^2.11.10",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	},
	"overrides": {
		"@effect/platform-browser": "4.1.0",
		"@effect/sql-d1": "4.1.0",
		"@effect/sql-sqlite-do": "4.1.0",
		"workerd": "1.20261002.1"
	},
	"packageManager": "bun@1.4.0",
	"catalog": {
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"playwright": "^1.64.1"
	},
	"catalogs": {
		"alchemy": {
			"@cloudflare/workers-types": "5.20261005.1",
			"alchemy": "2.0.0-beta.84",
			"@alchemy.run/aws": "2.0.0-beta.84",
			"@alchemy.run/cloudflare": "2.0.0-beta.84",
			"@alchemy.run/neon": "2.0.0-beta.84",
			"@alchemy.run/planetscale": "2.0.0-beta.84",
			"@alchemy.run/domain": "2.0.0-beta.84",
			"@alchemy.run/cloudflare-runtime": "2.0.0-beta.84"
		},
		"charts": {
			"@tanstack/charts": "1.0.0",
			"@tanstack/charts-scales": "1.0.0"
		},
		"effect": {
			"@effect/ai-openai-compat": "4.1.0",
			"@effect/ai-openrouter": "4.1.0",
			"@effect/platform-bun": "4.1.0",
			"@effect/platform-node": "4.1.0",
			"@effect/vitest": "4.1.0",
			"effect": "4.1.0"
		},
		"react": {
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"react": "^19.3.1",
			"react-dom": "^19.3.1"
		},
		"tailwind": {
			"@tailwindcss/vite": "^4.3.3",
			"tailwind-merge": "^3.7.0",
			"tailwindcss": "^4.3.3",
			"tw-animate-css": "^1.4.0"
		},
		"tooling": {
			"@types/node": "^24.19.2",
			"typescript": "^7.0.2"
		},
		"ui": {
			"@base-ui/react": "^1.9.0",
			"@xyflow/react": "^12.12.0",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1"
		}
	},
	"patchedDependencies": {
		"@effect/ai-openrouter@4.1.0": "patches/@effect%2Fai-openrouter@4.1.0.patch",
		"@effect/vitest@4.1.0": "patches/@effect%2Fvitest@4.1.0.patch",
		"effect@4.1.0": "patches/effect@4.1.0.patch",
		"@cloudflare/workers-types@5.20261005.1": "patches/@cloudflare%2Fworkers-types@5.20261005.1.patch",
		"@alchemy.run/aws@2.0.0-beta.84": "patches/@alchemy.run%2Faws@2.0.0-beta.84.patch",
		"alchemy@2.0.0-beta.84": "patches/alchemy@2.0.0-beta.84.patch",
		"@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
	}
}
