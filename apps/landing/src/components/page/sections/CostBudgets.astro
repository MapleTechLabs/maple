---
// Cost · budgets: the Budgets list (server-rendered) beside three points about them. Media-left
// so it alternates with the copy-left ledger below, like UptimeCheckTrace.
import * as m from "../../../paraglide/messages.js";
import { LiveCostBudgets } from "../../live/LiveCostBudgets";

const rules = [
	{ title: m.cost_budgets_rule_1_title(), body: m.cost_budgets_rule_1_body() },
	{ title: m.cost_budgets_rule_2_title(), body: m.cost_budgets_rule_2_body() },
	{ title: m.cost_budgets_rule_3_title(), body: m.cost_budgets_rule_3_body() },
];
---

<section class="border-t border-border bg-bg">
	<div class="shell py-14 md:py-20">
		<div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
			<!-- Below `lg` the copy comes first, so the table never shows before its heading. -->
			<div class="order-2 min-w-0 self-start lg:order-1">
				<LiveCostBudgets />
			</div>

			<div class="order-1 flex min-w-0 flex-col lg:order-2">
				<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.cost_budgets_eyebrow()}</p>
				<h2
					class="mt-4 max-w-[16ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px]"
				>
					{m.cost_budgets_title()}
				</h2>
				<p class="mt-5 max-w-[52ch] text-sm leading-relaxed text-fg-muted">{m.cost_budgets_lede()}</p>
				<dl class="mt-auto pt-8">
					{
						rules.map((rule) => (
							<div class="border-t border-border py-4">
								<dt class="text-[13px] font-medium text-fg">{rule.title}</dt>
								<dd class="mt-1.5 max-w-[52ch] text-[13px] leading-relaxed text-fg-muted">{rule.body}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
</section>
