---
/**
 * Compliance: what a buyer can have today and what is still being audited.
 *
 * A held item is a filled dot in fg; an audit in progress is a hollow dot with
 * a muted status, so the two can't be skimmed as the same claim. The DPA links
 * to the request address, since there is no self-serve copy to download.
 */
import * as m from "../paraglide/messages.js";
import { complianceItems, complianceStatusLabel } from "../lib/compliance";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class={className}>
	<p class="text-sm font-medium text-fg">{m.compliance_title()}</p>
	<ul class="mt-3 space-y-2" role="list">
		{
			complianceItems.map((item) => {
				const held = item.status === "available";
				return (
					<li class="flex items-center justify-between gap-4 text-[13px]">
						<span class="flex items-center gap-2.5">
							<span
								aria-hidden="true"
								class:list={[
									"size-1.5 shrink-0 rounded-full",
									held ? "bg-fg" : "border border-fg-muted",
								]}
							/>
							{item.href ? (
								<a
									href={item.href}
									class="text-fg underline decoration-border underline-offset-4 transition-colors hover:text-primary"
								>
									{item.name}
								</a>
							) : (
								<span class="text-fg">{item.name}</span>
							)}
						</span>
						<span class:list={["font-mono text-[12px]", held ? "text-fg" : "text-fg-muted"]}>
							{complianceStatusLabel(item.status)}
						</span>
					</li>
				);
			})
		}
	</ul>
</div>
