---
/**
 * Signals: the dashboard's own trace waterfall across the shell, with its logs stream and a
 * session replay capture at half the shell. Metrics has a tab in the surface explorer instead.
 */
import * as m from "../../paraglide/messages.js";
import { featurePath } from "../../lib/page-registry";
import LiveLogs from "../live/LiveLogs.astro";
import LiveTraceFrame from "../live/LiveTraceFrame.astro";
import MediaFrame from "./MediaFrame.astro";

const locale = Astro.currentLocale ?? "en";

const trace = {
	title: m.signals_trace_title(),
	sub: m.signals_trace_sub(),
	href: featurePath(locale, "distributed-tracing"),
	link: m.nav_distributed_tracing(),
};
const logs = {
	title: m.signals_logs_title(),
	sub: m.signals_logs_sub(),
	href: featurePath(locale, "log-management"),
	link: m.nav_log_management(),
};
const session = {
	title: m.signals_session_title(),
	sub: m.signals_session_sub(),
	href: featurePath(locale, "browser-sessions"),
	link: m.nav_browser_sessions(),
};
---

<section class="bg-bg-deep">
	<div class="shell py-16 md:py-24">
		<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.signals_eyebrow()}</p>

		<div class="mt-8 md:mt-10">
			<div class="grid grid-cols-[minmax(0,1fr)_max-content] items-baseline gap-x-8 gap-y-2 lg:grid-cols-[max-content_minmax(0,1fr)_max-content]">
				<h2 class="font-display text-2xl leading-tight tracking-[-0.01em] text-fg md:text-[28px]">{trace.title}</h2>
				<p class="col-span-2 row-start-2 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted lg:col-span-1 lg:col-start-2 lg:row-start-1">{trace.sub}</p>
				<a href={trace.href} class="col-start-2 row-start-1 whitespace-nowrap text-sm text-fg transition-colors hover:text-primary lg:col-start-3">{trace.link}<span aria-hidden="true"> →</span></a>
			</div>
			<LiveTraceFrame class="mt-6" height="19rem" />
		</div>

		<div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-2 lg:gap-8">
			<div class="flex min-w-0 flex-col">
				<div class="grid flex-1 grid-cols-[minmax(0,1fr)_max-content] content-start items-baseline gap-x-8 gap-y-2">
					<h2 class="font-display text-2xl leading-tight tracking-[-0.01em] text-fg md:text-[28px]">{logs.title}</h2>
					<p class="col-span-2 row-start-2 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">{logs.sub}</p>
					<a href={logs.href} class="col-start-2 row-start-1 whitespace-nowrap text-sm text-fg transition-colors hover:text-primary">{logs.link}<span aria-hidden="true"> →</span></a>
				</div>
				{/* Taller on phones, where 16:10 leaves no room for an expanded row. */}
				<div class="mt-6 aspect-[4/5] min-h-0 overflow-hidden sm:aspect-[16/10]">
					<LiveLogs volume={false} streamHeight="fill" />
				</div>
			</div>
			<div class="flex min-w-0 flex-col">
				<div class="grid flex-1 grid-cols-[minmax(0,1fr)_max-content] content-start items-baseline gap-x-8 gap-y-2">
					<h2 class="font-display text-2xl leading-tight tracking-[-0.01em] text-fg md:text-[28px]">{session.title}</h2>
					<p class="col-span-2 row-start-2 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">{session.sub}</p>
					<a href={session.href} class="col-start-2 row-start-1 whitespace-nowrap text-sm text-fg transition-colors hover:text-primary">{session.link}<span aria-hidden="true"> →</span></a>
				</div>
				{/* Declared 16:10 like the logs plate beside it; the crop window still ends inside the capture. */}
				<div class="mt-6">
					<MediaFrame
						label="A browser session replay showing the recorded page and captured network requests"
						src="/screenshots/strip-session.webp"
						width={1440}
						height={900}
						crop={{ x: 0.185, y: 0.075, zoom: 1.25 }}
					/>
				</div>
			</div>
		</div>
	</div>
</section>
