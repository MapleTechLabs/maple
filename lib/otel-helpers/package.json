{
	"name": "@maple-dev/otel-helpers",
	"version": "0.1.0",
	"description": "Tiny OpenTelemetry helpers: withSpan() for bounded business spans without try/catch/finally bloat.",
	"keywords": [
		"maple",
		"observability",
		"opentelemetry",
		"otel",
		"tracing"
	],
	"homepage": "https://github.com/MapleTechLabs/maple/tree/main/lib/otel-helpers#readme",
	"bugs": {
		"url": "https://github.com/MapleTechLabs/maple/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MapleTechLabs/maple.git",
		"directory": "lib/otel-helpers"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"prepublishOnly": "tsdown"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@types/bun": "^1.3.11",
		"@types/node": "catalog:tooling",
		"tsdown": "^0.22.14",
		"typescript": "catalog:tooling"
	},
	"peerDependencies": {
		"@opentelemetry/api": ">=1.9.0"
	}
}
