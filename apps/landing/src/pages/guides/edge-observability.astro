---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { highlight } from "../../lib/guide-highlight";
import LanguageTabs from "../../components/docs/LanguageTabs.astro";
import LanguageTab from "../../components/docs/LanguageTab.astro";

const pageTitle = "Edge observability: what it is and how to set it up | Maple";
const pageDescription =
    "What edge observability means for edge functions and edge sites, and an OpenTelemetry Collector setup that buffers telemetry while a site is offline.";
const published = "2026-10-19";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "definition", text: "Edge observability, defined" },
    { depth: 3, slug: "two-edges", text: "Serverless edge and edge sites" },
    { depth: 3, slug: "constraints", text: "Constraints at the edge" },
    { depth: 2, slug: "collector", text: "A Collector at every edge site" },
    { depth: 3, slug: "pipeline", text: "The pipeline, stage by stage" },
    { depth: 3, slug: "gateways", text: "Regional gateways" },
    { depth: 3, slug: "tools", text: "Edge observability tools" },
    { depth: 2, slug: "config", text: "The edge Collector config" },
    { depth: 3, slug: "buffering", text: "Buffer while offline" },
    { depth: 3, slug: "volume", text: "Cut volume before the uplink" },
    { depth: 3, slug: "site-identity", text: "Tag every signal with its site" },
    { depth: 3, slug: "run", text: "Run and test it" },
    { depth: 2, slug: "edge-kubernetes", text: "Edge Kubernetes and containers" },
    { depth: 2, slug: "cloudflare-workers", text: "Cloudflare Workers and edge functions" },
    { depth: 2, slug: "in-maple", text: "Edge observability in Maple" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per job the edge Collector does, reused by the badges, the diagram,
// the pipeline steps and the stripes on the config.
const concepts = {
    identify: { name: "Identify", color: "var(--chart-2)" },
    reduce: { name: "Reduce", color: "var(--chart-5)" },
    buffer: { name: "Buffer", color: "var(--chart-3)" },
} as const;
type Concept = keyof typeof concepts;
const neutral = "var(--muted-foreground)";

const constraints: { title: string; body: string; answer: string; concept?: Concept }[] = [
    { title: "The uplink drops", body: "Links go down for minutes or days. By default a Collector exporter retries a failed batch for five minutes and then drops it.", answer: "Buffer", concept: "buffer" },
    { title: "Bandwidth is metered", body: "Cellular and satellite uplinks are slow and often billed per gigabyte, so volume has to be cut at the site, before the data crosses the link.", answer: "Reduce", concept: "reduce" },
    { title: "Hundreds of sites", body: "Near-identical sites can't be told apart unless each one reports its ID. Ship one config everywhere and inject only the identity.", answer: "Identify", concept: "identify" },
    { title: "Little memory", body: "The Collector shares a small box with the workload it watches. Without a ceiling, a burst of telemetry can get either of them killed by the kernel's out-of-memory killer.", answer: "memory_limiter" },
    { title: "Runtimes that vanish", body: "An edge function lives for one request. Telemetry still in memory when its isolate is evicted is lost, unless the platform exports it.", answer: "Platform export" },
    { title: "Clocks drift", body: "Spans keep the device's timestamps, buffered ones too. A clock that is seconds off puts site spans out of order against the cloud services they call.", answer: "NTP or chrony" },
];

const pipeline: { component: string; body: string; concept?: Concept }[] = [
    { component: "memory_limiter", body: "First in every pipeline. Close to its limit it refuses new data with an error that tells senders to retry later, so the Collector stays under a fixed memory ceiling." },
    { component: "resourcedetection, resource/site", body: "Add the host name and the site's ID to everything that passes through, so applications never need to know which site they run at.", concept: "identify" },
    { component: "filter/noise", body: "Drop health-check spans and debug logs before they cost anything to send or store.", concept: "reduce" },
    { component: "probabilistic_sampler", body: "Keep a fixed share of traces, chosen by trace ID, so all spans of a kept trace are kept together.", concept: "reduce" },
    { component: "batch", body: "Group data into fewer, larger requests, which saves per-request overhead on a slow link.", concept: "reduce" },
    { component: "otlphttp/maple with sending_queue", body: "Write each batch to a queue on local disk and send from there. While the uplink is down, batches wait in the queue, across Collector restarts.", concept: "buffer" },
];

// The tested config, split where its job changes so each part can carry its color.
const configParts: [Concept | null, string][] = [
    [null, `extensions:
    health_check:
        endpoint: 127.0.0.1:13133`],
    ["buffer", `    file_storage/queue:
        directory: /var/lib/otelcol/queue
        create_directory: true
        timeout: 10s
        compaction:
            directory: /var/lib/otelcol/queue
            on_start: true
            on_rebound: true`],
    [null, `
receivers:
    otlp:
        protocols:
            grpc:
                endpoint: 0.0.0.0:4317
            http:
                endpoint: 0.0.0.0:4318
    hostmetrics:
        collection_interval: 60s
        scrapers:
            cpu:
                metrics:
                    system.cpu.utilization:
                        enabled: true
            memory:
                metrics:
                    system.memory.utilization:
                        enabled: true
            filesystem:
                metrics:
                    system.filesystem.utilization:
                        enabled: true
            load: {}
            network: {}

processors:
    memory_limiter:
        check_interval: 1s
        limit_mib: 200
        spike_limit_mib: 40`],
    ["identify", `    resourcedetection:
        detectors: [env, system]
    resource/site:
        attributes:
            - key: acme.site.id
              value: \${env:SITE_ID}
              action: upsert
            - key: acme.site.region
              value: \${env:SITE_REGION}
              action: upsert
            - key: deployment.environment.name
              value: production
              action: insert`],
    ["reduce", `    filter/noise:
        trace_conditions:
            - span.attributes["http.route"] == "/healthz"
            - span.attributes["url.path"] == "/healthz"
        log_conditions:
            - log.severity_number > SEVERITY_NUMBER_UNSPECIFIED and log.severity_number < SEVERITY_NUMBER_INFO
    probabilistic_sampler:
        mode: proportional
        sampling_percentage: 25
    batch:
        send_batch_size: 2048
        send_batch_max_size: 4096
        timeout: 10s`],
    [null, `
exporters:
    otlphttp/maple:
        # EU organizations: https://ingest.eu.maple.dev
        endpoint: https://ingest.maple.dev`],
    ["reduce", `        compression: gzip`],
    [null, `        timeout: 30s
        headers:
            authorization: Bearer \${env:MAPLE_INGEST_KEY}`],
    ["buffer", `        sending_queue:
            enabled: true
            storage: file_storage/queue
            queue_size: 5000
            num_consumers: 2
        retry_on_failure:
            enabled: true
            initial_interval: 10s
            max_interval: 5m
            max_elapsed_time: 0`],
    [null, `
service:
    extensions: [health_check, file_storage/queue]
    pipelines:
        traces:
            receivers: [otlp]
            processors: [memory_limiter, resourcedetection, resource/site, filter/noise, probabilistic_sampler, batch]
            exporters: [otlphttp/maple]
        metrics:
            receivers: [otlp, hostmetrics]
            processors: [memory_limiter, resourcedetection, resource/site, batch]
            exporters: [otlphttp/maple]
        logs:
            receivers: [otlp]
            processors: [memory_limiter, resourcedetection, resource/site, filter/noise, batch]
            exporters: [otlphttp/maple]`],
];
const configHtml = configParts
    .map(([concept, code]) => (concept ? `<span class="cfg-part" style="--c: ${concepts[concept].color}">${highlight(code, "yaml")}</span>` : highlight(code, "yaml")))
    .join("\n");

const runCommand = `otelcol-contrib validate --config edge-site.yaml

SITE_ID=store-0142 SITE_REGION=eu-west \\
MAPLE_INGEST_KEY=YOUR_INGEST_KEY \\
otelcol-contrib --config edge-site.yaml`;

const tailSamplingConfig = `processors:
    tail_sampling:
        decision_wait: 10s
        num_traces: 5000
        policies:
            - name: errors
              type: status_code
              status_code:
                  status_codes: [ERROR]
            - name: slow
              type: latency
              latency:
                  threshold_ms: 1000
            - name: baseline
              type: probabilistic
              probabilistic:
                  sampling_percentage: 5`;

const helmCommand = `kubectl create namespace maple
kubectl -n maple create secret generic maple-ingest-key \\
  --from-literal=ingest-key=YOUR_INGEST_KEY

helm upgrade --install maple-k8s-infra \\
  oci://ghcr.io/mapletechlabs/charts/maple-k8s-infra \\
  --namespace maple \\
  --set maple.ingestKey.existingSecret.name=maple-ingest-key \\
  --set maple.ingestKey.existingSecret.key=ingest-key \\
  --set-string global.clusterName=store-0142
# EU organizations add:
#   --set-string maple.ingest.endpoint=https://ingest.eu.maple.dev`;

const wranglerConfig = `// wrangler.jsonc
{
    "observability": {
        "traces": {
            "enabled": true,
            "destinations": ["maple-traces"],
            "head_sampling_rate": 0.1,
            "persist": false
        },
        "logs": {
            "enabled": true,
            "destinations": ["maple-logs"]
        }
    }
}`;

const queueSettings = [
    ["sending_queue.storage", "file_storage/queue", "The queue lives on disk instead of in memory, so it survives a restart or a power cut."],
    ["queue_size", "5000", "Maximum batches held. With batches of up to 4,096 items, that is up to about 20 million spans, points or log records. A full queue drops new data."],
    ["retry_on_failure.max_elapsed_time", "0", "Never give up on a batch. The default of 300s drops it after five minutes of failures."],
    ["max_interval", "5m", "Caps the wait between retries, so a site starts sending within five minutes of its link returning."],
    ["num_consumers", "2", "Parallel senders. The default is 10; fewer is gentler on a thin uplink."],
    ["compaction.on_rebound", "true", "Shrinks the queue file on disk after a backlog drains."],
];

const siteAttributes = [
    ["acme.site.id", "store-0142", "SITE_ID at the Collector (custom)"],
    ["acme.site.region", "eu-west", "SITE_REGION at the Collector (custom)"],
    ["host.name", "gw-0142", "resourcedetection, system detector"],
    ["deployment.environment.name", "production", "resource/site, unless the app sets it"],
    ["service.name", "pos-api", "The application's SDK"],
];

const runNotes = [
    ["The queue directory must be writable", "by the user the Collector runs as. On a fresh Docker volume the first start failed with <code>permission denied</code> until the volume was owned by that user."],
    ["Set limit_mib to what the box can spare", "200 MiB with a 40 MiB spike allowance suits a gateway with 1 GB of RAM or more. <code>limit_percentage</code> works instead where memory sizes vary."],
    ["Bind the OTLP receivers to the LAN", "They accept unauthenticated data on 4317 and 4318 and forward it under the site's key. Use the site LAN's interface address instead of <code>0.0.0.0</code>, and firewall both ports from other networks."],
    ["The ingest key is regional", "An EU organization's key sent to <code>ingest.maple.dev</code> gets a <code>401</code>, which the exporter does not retry. Set the EU endpoint before rollout."],
    ["Host metrics from a container", "need the host's root filesystem mounted and <code>root_path</code> set on <code>hostmetrics</code>, or they describe the container."],
    ["Older releases use other names", "The filter syntax here is the current one; older releases use <code>traces: span:</code> and <code>logs: log_record:</code>. 0.163.1 warns that <code>otlphttp</code>, <code>resourcedetection</code> and <code>hostmetrics</code> are now <code>otlp_http</code>, <code>resource_detection</code> and <code>host_metrics</code>; the old names still run."],
];

const faqs = [
    {
        question: "What is edge computing observability?",
        answer:
            "Edge computing observability, or edge observability, is collecting traces, metrics and logs from code that runs outside a central cloud region and getting them to the backend that holds the rest of your telemetry. The edge can be a CDN function such as a Cloudflare Worker, or a site you run yourself: a store, a factory, a vessel or a small Kubernetes cluster.",
    },
    {
        question: "Why is observability harder at the edge?",
        answer:
            "Edge sites lose their uplink, pay for bandwidth and run on small machines, and there are often hundreds of them. Edge functions live for one request and have no host to run an agent on. Telemetry has to be buffered locally, cut down before it leaves the site, and tagged with the site it came from.",
    },
    {
        question: "How do I buffer telemetry when an edge site goes offline?",
        answer:
            "Run an OpenTelemetry Collector at the site and give its exporter a sending queue stored on disk by the file_storage extension. Set retry_on_failure.max_elapsed_time to 0 so batches are retried until the link returns, and size queue_size and the disk for the longest outage you want to survive. The queue survives Collector restarts and drains when the uplink comes back.",
    },
    {
        question: "How do I observe Cloudflare Workers?",
        answer:
            "Turn on Workers tracing and logs in the Worker's Wrangler config and point them at OTLP destinations created under Workers & Pages, Observability, Destinations in the Cloudflare dashboard. Cloudflare records handler, fetch and binding spans without an SDK. Request counts, errors and CPU time are not part of that export; they come from Cloudflare's analytics API.",
    },
    {
        question: "Which observability tools work for edge apps?",
        answer:
            "For edge sites, the OpenTelemetry Collector (the contrib distribution) does the collection, buffering, sampling and filtering, and any backend that accepts OTLP can receive the data. For edge functions, use the platform's own exporter where one exists, such as Cloudflare Workers Observability, or an OpenTelemetry SDK that flushes before the function's runtime ends.",
    },
    {
        question: "What are the four pillars of observability?",
        answer:
            "Lists vary. Most start with metrics, logs and traces and add either events or continuous profiles as the fourth. OpenTelemetry is adding profiles as a signal next to the other three. For edge workloads, traces, metrics and logs cover most questions.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Edge observability, explained",
    description: pageDescription,
    datePublished: published,
    dateModified: "2026-10-20",
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo192.png` },
    },
    mainEntityOfPage: `${siteUrl}/guides/edge-observability`,
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <Nav />
    <Breadcrumb
        items={[
            { label: "Home", href: "/" },
            { label: "Guides", href: "/guides" },
            { label: "Edge observability" },
        ]}
    />

    <main>
        <header class="relative overflow-hidden border-b border-border pt-[19px]">
            <div
                class="pointer-events-none absolute inset-0"
                aria-hidden="true"
                style="background-image: linear-gradient(to right, oklch(1 0 0 / 4%) 1px, transparent 1px), linear-gradient(to bottom, oklch(1 0 0 / 4%) 1px, transparent 1px); background-size: 60px 60px; mask-image: radial-gradient(ellipse 78% 68% at 22% 26%, black, transparent);"
            >
            </div>
            <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-20 md:pb-20 md:pt-28">
                <div class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
                    <span class="border border-primary/40 px-2 py-1 text-primary">Edge</span>
                    <span>10 min read</span>
                </div>
                <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(40px,6.3vw,72px)] font-medium leading-[0.98] tracking-[-0.045em] text-fg">
                    Edge observability, explained
                </h1>
                <p class="mt-7 max-w-[56ch] font-display text-[17px] leading-[1.6] text-fg-muted md:text-lg">
                    What changes when code runs at the edge, and a tested OpenTelemetry Collector setup that keeps telemetry through an outage.
                </p>
                <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] text-fg-muted">
                    <a href={authorUrl} rel="noopener" class="flex items-center gap-2 transition-colors hover:text-fg">
                        <img src={author.avatar} alt="" width="20" height="20" class="h-5 w-5 rounded-full ring-1 ring-border" />
                        <span>By {author.name}</span>
                    </a>
                    <time datetime="2026-10-20">Updated {updatedLabel}</time>
                </div>
            </div>
        </header>

        <nav aria-label="Guide sections" class="border-b border-border bg-bg-deep">
            <div class="mx-auto flex max-w-6xl gap-6 overflow-x-auto px-6 py-4 font-mono text-[10px] whitespace-nowrap text-fg-muted">
                {sectionNav.map((h) => (
                    <a href={`#${h.slug}`} class="transition-colors hover:text-primary">{h.text}</a>
                ))}
            </div>
        </nav>

        <div class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:py-24 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
            <aside class="hidden lg:block">
                <TableOfContents headings={toc} class="sticky top-28" />
            </aside>

            <article class="edge-guide min-w-0">
                <section id="definition" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>01</span> · Definition</p>
                    <h2>Edge observability, defined</h2>

                    <p>
                        A retailer runs 400 shops, each with a till, a few sensors and a 4G router that drops out when the weather turns. A website runs a small function in a data center near each visitor, and the function is gone milliseconds after it answers. <strong>Edge observability</strong> is collecting traces, metrics and logs from code like this, which runs outside your main cloud region, and getting them to the same backend as the rest of your telemetry. In the cloud that data crosses a fast network that rarely fails; at the edge the link can be down for hours and every gigabyte sent costs money, so a default setup loses the data from the very outage you need to debug. By the end of this guide you'll have a Collector config for each site that survives a dead uplink, plus setups for edge Kubernetes and Cloudflare Workers.
                    </p>

                    <div class="guide-callout guide-takeaways">
                        <p class="guide-kicker">Key takeaways</p>
                        <ul>
                            <li>Run one OpenTelemetry Collector at each edge site. Edge functions have no host for one, so the platform exports for them.</li>
                            <li>A Collector exporter retries a failed batch for five minutes and then drops it. Put its sending queue on disk to keep data through longer outages.</li>
                            <li>Filter and sample at the site, before data crosses a metered uplink.</li>
                            <li>Add a site ID to every signal, or hundreds of identical sites can't be told apart.</li>
                            <li>Cloudflare Workers export traces and logs over OTLP, but no metrics, and don't pass trace context to services outside Cloudflare.</li>
                        </ul>
                    </div>

                    <h3 id="two-edges" class="scroll-mt-24">Serverless edge and edge sites</h3>
                    <p>
                        "The edge" names two different places, and they need different setups. At the serverless edge the platform collects for you. At an edge site you run the collection yourself, on hardware at the site.
                    </p>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th></th><th>Serverless edge</th><th>Edge sites</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Examples</td><td>Cloudflare Workers and other CDN functions</td><td>Stores, factories, vessels, cell sites, small Kubernetes clusters</td></tr>
                                <tr><td>Collection runs</td><td>In the platform</td><td>In an OpenTelemetry Collector on site</td></tr>
                                <tr><td>Connectivity</td><td>Always online to the provider</td><td>Drops, metered, or both</td></tr>
                                <tr><td>Buffering</td><td>The platform's job</td><td><span class="type-badge" style={`--type: ${concepts.buffer.color}`}>Buffer</span> A queue on local disk</td></tr>
                                <tr><td>Volume control</td><td>A head sampling rate in config</td><td><span class="type-badge" style={`--type: ${concepts.reduce.color}`}>Reduce</span> Filtering and sampling in the Collector</td></tr>
                                <tr><td>Location identity</td><td>The data center on each span (<code>cloudflare.colo</code> on Workers)</td><td><span class="type-badge" style={`--type: ${concepts.identify.color}`}>Identify</span> A site ID added to every signal</td></tr>
                                <tr><td>Infrastructure metrics</td><td>The provider's analytics API</td><td>Host, kubelet and cluster receivers in the Collector</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <h3 id="constraints" class="scroll-mt-24">Constraints at the edge</h3>
                    <div class="guide-table">
                        <table>
                            <thead>
                                <tr><th></th><th>Cloud</th><th>Edge site</th></tr>
                            </thead>
                            <tbody>
                                <tr><td>Network</td><td>Data center links to the backend</td><td>Shop broadband, cellular or satellite</td></tr>
                                <tr><td>Connectivity</td><td>Always on</td><td>Down for minutes or days</td></tr>
                                <tr><td>Data volume</td><td>Sent in full, paid for at the backend</td><td>Every gigabyte over the uplink costs money</td></tr>
                                <tr><td>Processing</td><td>In a central Collector or the backend</td><td>In a Collector at the site, before the uplink</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <p>
                        Each constraint below carries the part of the setup that handles it. The colored ones are jobs of the edge site Collector, and the rest of this guide uses the same colors for them.
                    </p>
                    <div class="guide-checklist">
                        {constraints.map((c) => (
                            <div>
                                <h4>{c.title}</h4>
                                <p>{c.body}</p>
                                <span class="type-badge" style={`--type: ${c.concept ? concepts[c.concept].color : neutral}`}>{c.answer}</span>
                            </div>
                        ))}
                    </div>
                </section>

                <section id="collector" class="scroll-mt-24">
                    <p class="guide-eyebrow"><span>02</span> · Architecture</p>
                    <h2>A Collector at every edge site</h2>
                    <p>
                        At an edge site you own the hardware, so run one <a href="/opentelemetry">OpenTelemetry</a> Collector there. The Collector is a single program that receives telemetry, processes it and sends it on. Applications at the site send to it over the local network using OTLP, the OpenTelemetry protocol, on port 4317 (gRPC) or 4318 (HTTP). It reads the host's CPU, memory and disk itself, and it is the only process at the site that talks to the outside world.
                    </p>

                    <figure class="edge-flow" aria-label="An edge site, store-0142, runs apps that send OTLP to a Collector. The Collector tags each signal with the site ID, filters, samples and batches it, and writes batches to a queue on disk. The uplink from the queue to an optional regional gateway and on to Maple is down. A chart below shows the queue size: flat while online, rising steadily while the uplink is down, unaffected by a Collector restart, and draining back to zero once the link returns.">
                        <svg viewBox="0 0 760 384" aria-hidden="true">
                            <defs>
                                <marker id="edge-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                                    <path d="M0,0 L8,4 L0,8 z" class="edge-flow__head" />
                                </marker>
                            </defs>

                            <rect x="1" y="1" width="440" height="178" rx="10" class="edge-flow__site" />
                            <text x="18" y="27" class="edge-flow__title">Edge site</text>
                            <text x="96" y="27" class="edge-flow__mono">store-0142</text>

                            <rect x="16" y="62" width="96" height="84" rx="8" class="edge-flow__box" />
                            <text x="64" y="98" text-anchor="middle" class="edge-flow__title">Apps</text>
                            <text x="64" y="118" text-anchor="middle" class="edge-flow__mono">POS, sensors</text>
                            <line x1="112" y1="104" x2="146" y2="104" marker-end="url(#edge-arrow)" class="edge-flow__line" />
                            <text x="129" y="94" text-anchor="middle" class="edge-flow__mono edge-flow__mono--small">OTLP</text>

                            <rect x="152" y="52" width="170" height="104" rx="8" class="edge-flow__box" />
                            <text x="237" y="76" text-anchor="middle" class="edge-flow__title">Collector</text>
                            <rect x="164" y="88" width="146" height="22" rx="4" class="edge-flow__chip" style={`--c: ${concepts.identify.color}`} />
