import (
	"net/http"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/propagation"
)

func main() {
	// Go's global propagator does nothing until you set one.
	otel.SetTextMapPropagator(propagation.TraceContext{})

	// The transport writes traceparent on outgoing requests.
	client := &http.Client{Transport: otelhttp.NewTransport(http.DefaultTransport)}

	checkout := func(w http.ResponseWriter, r *http.Request) {
		// r.Context() carries the caller's trace. context.Background() would start a new one.
		req, _ := http.NewRequestWithContext(r.Context(), http.MethodPost,
			"http://payments:8080/charge", nil)
		if resp, err := client.Do(req); err == nil {
			resp.Body.Close()
		}
		w.Write([]byte("ok"))
	}

	// The handler reads traceparent on incoming requests.
	handler := otelhttp.NewHandler(http.HandlerFunc(checkout), "checkout")
	http.ListenAndServe(":8000", handler)
}` },
    { id: "rust", label: "Rust", lang: "rust", install: "cargo add opentelemetry-http@0.31 reqwest-middleware reqwest-tracing -F reqwest-tracing/opentelemetry_0_31", code: `// The setup from the Rust guide, which sets the TraceContext propagator.
mod telemetry;

use axum::{extract::State, http::HeaderMap, routing::post, Router};
use opentelemetry::global;
use opentelemetry_http::HeaderExtractor;
use reqwest_middleware::{ClientBuilder, ClientWithMiddleware};
use reqwest_tracing::TracingMiddleware;
use tracing::Instrument;
use tracing_opentelemetry::OpenTelemetrySpanExt;

async fn checkout(
    State(client): State<ClientWithMiddleware>,
    headers: HeaderMap,
) -> &'static str {
    // Read traceparent from the incoming request and continue that trace.
    let parent =
        global::get_text_map_propagator(|p| p.extract(&HeaderExtractor(&headers)));
    let span = tracing::info_span!("POST /checkout", otel.kind = "server");
    let _ = span.set_parent(parent);

    async {
        let _ = client.post("http://payments:8080/charge").send().await;
        "ok"
    }
    .instrument(span)
    .await
}

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let _telemetry = telemetry::init()?;
    // TracingMiddleware writes traceparent on outgoing requests.
    let client = ClientBuilder::new(reqwest::Client::new())
        .with(TracingMiddleware::default())
        .build();
    let app = Router::new().route("/checkout", post(checkout)).with_state(client);
    axum::serve(tokio::net::TcpListener::bind("0.0.0.0:8000").await?, app).await?;
    Ok(())
}` },
