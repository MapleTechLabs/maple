---
/** Shared, localized homepage. The Orange Dither Monumentalism skin is
 * homepage-only; product screenshots and all interactive sections stay intact. */
import Layout from "../../layouts/Layout.astro";
import "../../styles/home-monument.css";
import Nav from "../Nav.astro";
import SeoHead from "../SeoHead.astro";
import HomeHero from "./HomeHero.astro";
import HomeObjections from "./HomeObjections.astro";
import SignalsStrip from "./SignalsStrip.astro";
import IncidentStory from "./IncidentStory.astro";
import PlatformSheet from "./PlatformSheet.astro";
import Sovereignty from "../Sovereignty.astro";
import LocalSection from "./LocalSection.astro";
import KubernetesSection from "./KubernetesSection.astro";
import WebAnalyticsSection from "./WebAnalyticsSection.astro";
import AgentSection from "./AgentSection.astro";
import BillComparison from "../BillComparison.astro";
import PricingTable from "../PricingTable.astro";
import SdkBand from "./SdkBand.astro";
import FAQ from "../FAQ.astro";
import FinalCta from "./FinalCta.astro";
import Footer from "../Footer.astro";
import * as m from "../../paraglide/messages.js";

const pageTitle = m.page_home_title();
const pageDescription = m.page_home_desc();

// Quotable, AI-extractable facts about Maple. Homepages are among the most-cited
// sources by AI chatbots, so we state the core entity facts plainly (and emit
// FAQPage schema via FAQ.astro).
const homeFaqs = [
    { question: m.faq_home_what_q(), answer: m.faq_home_what_a() },
    { question: m.faq_home_oss_q(), answer: m.faq_home_oss_a() },
    { question: m.faq_home_otel_q(), answer: m.faq_home_otel_a() },
    { question: m.faq_home_price_q(), answer: m.faq_home_price_a() },
    { question: m.faq_home_agents_q(), answer: m.faq_home_agents_a() },
    { question: m.faq_selfhost_q(), answer: m.faq_selfhost_a() },
];
---

<Layout title={pageTitle} description={pageDescription} mdHref="/index.md" bodyClass="monumental-home" themeColor="#1a1714">
    <SeoHead title={pageTitle} description={pageDescription} type="SoftwareApplication" includeOrganization={true} />

    <Nav />

    <main id="main-content">
        <HomeHero />

        <!-- 00 — self-hosting, OpenTelemetry and the trial terms, stated before
             the page asks for anything. These are the three rows visitors open
             once they reach /pricing, and 83% of them never get that far. -->
        <HomeObjections />

        <!-- 01 — the three surfaces you actually look at. -->
        <SignalsStrip />

        <!-- 02 — the signature section: one incident, four surfaces, one trace id. -->
        <IncidentStory />

        <!-- 03 — Maple Local. Promoted out of the second half: it holds readers
             longer than anything else on the site (the deepest read time of any
             entry point, the lowest bounce), so it earns a slot people reach. -->
        <LocalSection />

        <!-- 04 — everything that didn't get a narrative, and the link hub. -->
        <PlatformSheet />

        <!-- Orange identity section. -->
        <span id="sovereignty"></span>
        <Sovereignty />

        <!-- 06 — the infrastructure proof point. -->
        <KubernetesSection />

        <!-- 07 — the audience above the trace: web analytics read from the
             sessions the browser SDK already records. A real capture, media-left
             so 06 → 07 → 08 alternate instead of stacking three copy-left sections. -->
        <WebAnalyticsSection />

        <!-- 08 — the same investigation as 02, run by an agent instead of a human. -->
        <AgentSection />

        <!-- 09 + 10 — the money chapter: one deep floor, two beats, one internal
             hairline. The bill runs first because Maple's pricing only reads as
             remarkable next to Datadog's. -->
        <BillComparison />
        <PricingTable
            variant="home"
            class="border-t border-border bg-bg-deep"
            eyebrow={m.pricing_home_eyebrow()}
            title={m.pricing_home_title()}
            lede={m.pricing_home_lede()}
        />

        <!-- The runtimes band — this slot's honest answer to a testimonial wall. -->
        <SdkBand />

        <FAQ items={homeFaqs} />

        <!-- Generated portal closes the page. -->
        <FinalCta />
    </main>

    <Footer />
</Layout>
