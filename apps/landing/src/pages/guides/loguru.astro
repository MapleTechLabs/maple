const tocHeadings = toc.map(([slug, text]) => ({ depth: 2, slug, text }));

const faqs = [
    {
        question: "What is Loguru?",
        answer:
            "Loguru is an MIT-licensed logging library for Python. You import one ready-made logger with from loguru import logger, and it writes colored output to stderr with no setup. One method, logger.add(), configures every destination, including rotating files, JSON output and custom functions.",
    },
    {
        question: "Should I use Loguru or the standard logging module?",
        answer:
            "Loguru is quicker to set up for an application you own: rotation, retention, JSON output and readable tracebacks are single arguments. The standard logging module is what libraries should use, and it is what most tools hook into, including the OpenTelemetry Python SDK. Many applications use both: libraries log through logging, an InterceptHandler forwards those records into Loguru, and Loguru writes the output.",
    },
    {
        question: "How do I log to a file with rotation in Loguru?",
        answer:
            "Pass a file path to logger.add() with a rotation condition, for example logger.add(\"logs/app.log\", rotation=\"100 MB\", retention=\"14 days\", compression=\"gz\"). Rotation also accepts a time of day such as \"00:00\" or an interval such as \"1 week\". Retention deletes old files by age or keeps a fixed number of them, and compression archives each rotated file.",
    },
    {
        question: "How do I output JSON logs with Loguru?",
        answer:
            "Add a sink with serialize=True, for example logger.add(sys.stdout, serialize=True). Each line is a JSON object holding the formatted text and the full record, including the values attached with bind(). For a smaller document with only the fields you choose, pass a function as the sink and write json.dumps() of the parts of message.record you want.",
    },
    {
        question: "How do I send Loguru logs to OpenTelemetry?",
        answer:
            "The OpenTelemetry Python SDK reads logs from the standard logging module, and Loguru does not pass through it. Add a Loguru sink that turns each Loguru record into a logging.LogRecord and hands it to a dedicated stdlib logger with the OpenTelemetry LoggingHandler attached. Keep that sink synchronous (no enqueue=True) so the handler can read the active span and attach the trace and span IDs.",
    },
    {
        question: "How do I set the log level in Loguru?",
        answer:
            "The default handler logs everything from DEBUG up. Call logger.remove() to drop it, then logger.add(sys.stderr, level=\"INFO\"). You can also set the LOGURU_LEVEL environment variable before the process starts, which changes the level of the default handler without code changes.",
    },
    {
        question: "Why do I get ModuleNotFoundError: No module named 'loguru'?",
        answer:
            "Loguru is installed for a different Python interpreter than the one running your code, usually a different virtual environment. Install it with the interpreter you run, python -m pip install loguru, and check that your editor or process manager uses the same environment.",
    },
];

