---
/**
 * 01 · Signals — the three-up strip directly under the hero.
 *
 * Three parallel imperatives over three plates. Not the three OTel signals:
 * metrics is the least differentiated surface Maple has and the least legible
 * at plate size, while session replay joined to a trace id is a real
 * differentiator. Metrics gets a named slot in §03 instead.
 *
 * Columns are separated by the grid gap, not by rules — vertical rules here
 * would turn a strip into a table.
 *
 * The trace and logs plates are the dashboard's own waterfall and logs stream
 * on example data. The session plate is still a capture, cropped to the part
 * of the screen the heading is about. All three share the capture's 16:9 box.
 */
import * as m from "../../paraglide/messages.js";
import LiveLogs from "../live/LiveLogs.astro";
import LiveTraceFrame from "../live/LiveTraceFrame.astro";
import MediaFrame from "./MediaFrame.astro";

const columns = [
	{ title: m.signals_trace_title(), sub: m.signals_trace_sub(), plate: "trace" },
	{ title: m.signals_logs_title(), sub: m.signals_logs_sub(), plate: "logs" },
	{
		plate: "session",
		title: m.signals_session_title(),
		sub: m.signals_session_sub(),
		shot: "A browser session replay showing the recorded page and captured network requests",
		src: "/screenshots/strip-session.webp",
		width: 1440,
		height: 810,
		crop: { x: 0.185, y: 0.075, zoom: 1.6 },
	},
] as const;
---

<section class="bg-bg-deep">
	<div class="shell py-16 md:py-32">
		<p class="mb-10 text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted md:mb-14">
			{m.signals_eyebrow()}
		</p>

		<div class="grid gap-12 lg:grid-cols-3 lg:gap-8">
			{
				columns.map((col) => (
					<div class="flex flex-col gap-5">
						{/* flex-1 so the three plates share a top edge whatever the copy wraps to. */}
						<div class="flex-1">
							<h2 class="font-display text-[22px] leading-tight tracking-[-0.01em] text-fg md:text-2xl lg:text-[26px]">
								{col.title}
							</h2>
							<p class="mt-3 max-w-[38ch] text-[15px] leading-relaxed text-fg-muted">{col.sub}</p>
						</div>
						{col.plate === "trace" ? (
							<div class="aspect-[16/9] min-h-0 overflow-hidden">
								<LiveTraceFrame height="fill" />
							</div>
						) : col.plate === "logs" ? (
							<div class="aspect-[16/9] min-h-0 overflow-hidden">
								<LiveLogs volume={false} streamHeight="fill" />
							</div>
						) : (
							<MediaFrame
								label={col.shot}
								src={col.src}
								width={col.width}
								height={col.height}
								crop={col.crop}
							/>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>
