---
// One section of the docs tree at a time: only the groups of the section
// picked in the header strip render, so a reader on a Python guide scans
// languages, not alerting.
// Language rows carry their logo; nested rows (Effect's platforms, the hosting
// platforms under Deploy) come from getNavTree.
import DocsCategoryIcon from "./DocsCategoryIcon.astro";
import BrandMarkIcon from "../BrandMarkIcon.astro";
import LanguageLogo from "./LanguageLogo.astro";
import { isDocGroup, sectionForGroup } from "../../lib/docs-nav";
import type { BrandMarkId } from "../../lib/brand-marks";
import { getDocSections, getNavTree, type Doc } from "../../lib/docs-order";

interface Props {
    currentSlug: string;
    /** Prefix for section heading ids — distinct per instance on a page. */
    idPrefix?: string;
}

const { currentSlug, idPrefix = "docs-nav" } = Astro.props;

const sections = await getDocSections(currentSlug);
const section = sections.find((s) => s.active) ?? sections[0];
const ordered = (await getNavTree()).filter(({ group }) => sectionForGroup(group).id === section.id);

// Brand marks for rows whose frontmatter has no `icon`, so a top-level row never
// sits indented like a nested child.
const ICON_FALLBACK: Record<string, BrandMarkId> = { "guides/instrumentation-cloudflare-workers": "cloudflare" };
const markOf = (doc: Doc): BrandMarkId | undefined => doc.data.icon ?? ICON_FALLBACK[doc.id];
const hasIcon = (doc: Doc) => Boolean(doc.data.sdk ?? markOf(doc));
const label = (doc: Doc) => doc.data.navLabel ?? doc.data.title;
const headingId = (group: string) => `${idPrefix}-${group.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

const rowClass = (active: boolean) =>
    active
        ? "text-primary bg-primary/5 border-l-2 border-primary"
        : "text-fg-muted hover:text-fg border-l-2 border-transparent";
---

<nav aria-label="Documentation">
    {ordered.map(({ group: groupName, rows }) => {
        // Icon-less rows in a group with icons get a spacer so the labels line up.
        const iconColumn = rows.some(({ doc }) => hasIcon(doc));
        return (
        <section class="mb-7" aria-labelledby={headingId(groupName)}>
            <h3
                id={headingId(groupName)}
                class="mb-2 flex items-center gap-2 pl-3 pr-2.5 text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted"
            >
                {isDocGroup(groupName) && (
                    <DocsCategoryIcon name={groupName} class="h-3.5 w-3.5 shrink-0 text-primary/80" />
                )}
                {groupName}
            </h3>
            <ul class="space-y-px">
                {rows.map(({ doc, children, open }) => {
                    const active = doc.id === currentSlug;
                    const childActive = children.some((c) => c.id === currentSlug);
                    const mark = markOf(doc);
                    return (
                        <li>
                            <a
                                href={`/docs/${doc.id}`}
                                aria-current={active ? "page" : undefined}
                                class:list={["flex items-center gap-2 px-2.5 py-1.5 text-[13px] leading-5 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-primary", rowClass(active)]}
                            >
                                {doc.data.sdk ? (
                                    <LanguageLogo id={doc.data.sdk} class="h-3.5 w-3.5 shrink-0" />
                                ) : mark ? (
                                    <BrandMarkIcon id={mark} class="h-3.5 w-3.5 shrink-0" />
                                ) : (
                                    iconColumn && <span class="h-3.5 w-3.5 shrink-0" aria-hidden="true"></span>
                                )}
                                <span class="truncate">{label(doc)}</span>
                            </a>
                            {children.length > 0 && (
                                <ul
                                    class:list={[
                                        "ml-[1.35rem] border-l border-border/70 mt-px mb-1",
                                        !(open || active || childActive) && "hidden",
                                    ]}
                                >
                                    {children.map((child) => {
                                        const on = child.id === currentSlug;
                                        return (
                                            <li>
                                                <a
                                                    href={`/docs/${child.id}`}
                                                    aria-current={on ? "page" : undefined}
                                                    class:list={[
                                                        "-ml-px flex items-center gap-2 py-1 pl-3 pr-2 text-[13px] leading-5 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-primary",
                                                        on
                                                            ? "text-primary border-l border-primary"
                                                            : "text-fg-muted hover:text-fg border-l border-transparent",
                                                    ]}
                                                >
                                                    {child.data.icon && <BrandMarkIcon id={child.data.icon} class="h-3.5 w-3.5 shrink-0" />}
                                                    <span class="truncate">{label(child)}</span>
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            )}
                        </li>
                    );
                })}
            </ul>
        </section>
        );
    })}
</nav>
