---
/**
 * The runtimes row, the last row of the ownership chapter (`LocalSection`): which runtimes are
 * covered, each mark with its name. Logos are runtimes, not customers; the customers are in the
 * hero and the proof chapter.
 *
 * Marks come from `lib/brand-marks.ts` (simple-icons paths), drawn in one colour so the row
 * reads as one ruled object.
 */
import * as m from "../../paraglide/messages.js";
import { BRAND_MARKS } from "../../lib/brand-marks";

const MARKS = (["nodejs", "nextjs", "python", "go", "effect", "opentelemetry", "kubernetes", "cloudflare", "prometheus"] as const).map(
	(id) => BRAND_MARKS[id],
);
---

<p class="ledger-runtimes__label">{m.trustbar_text()}</p>
<ul class="ledger-runtimes">
	{
		MARKS.map((mark) => (
			<li>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
					<path d={mark.path} />
				</svg>
				{mark.name}
			</li>
		))
	}
</ul>
