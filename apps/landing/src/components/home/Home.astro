---
/** Shared, localized homepage. The Orange Dither Monumentalism skin is
 * homepage-only; product screenshots and all interactive sections stay intact. */
import Layout from "../../layouts/Layout.astro";
import "../../styles/home-monument.css";
import "../../styles/home-ledger.css";
import Nav from "../Nav.astro";
import SeoHead from "../SeoHead.astro";
import HomeHero from "./HomeHero.astro";
import HomeObjections from "./HomeObjections.astro";
import HomeProductPlate from "./HomeProductPlate.astro";
import SignalsStrip from "./SignalsStrip.astro";
import IncidentStory from "./IncidentStory.astro";
import HomeProof from "./HomeProof.astro";
import SurfaceWall from "./SurfaceWall.astro";
import LocalSection from "./LocalSection.astro";
import AgentSection from "./AgentSection.astro";
import HomeBill from "./HomeBill.astro";
import HomeMotion from "./HomeMotion.astro";
import PricingTable from "../PricingTable.astro";
import FAQ from "../FAQ.astro";
import FinalCta from "./FinalCta.astro";
import Footer from "../Footer.astro";
import * as m from "../../paraglide/messages.js";

const pageTitle = m.page_home_title();
const pageDescription = m.page_home_desc();

// Quotable, AI-extractable facts about Maple. Homepages are among the most-cited
// sources by AI chatbots, so we state the core entity facts plainly (and emit
// FAQPage schema via FAQ.astro).
const homeFaqs = [
    { question: m.faq_home_what_q(), answer: m.faq_home_what_a() },
    { question: m.faq_home_oss_q(), answer: m.faq_home_oss_a() },
    { question: m.faq_home_otel_q(), answer: m.faq_home_otel_a() },
    { question: m.faq_home_price_q(), answer: m.faq_home_price_a() },
    { question: m.faq_home_agents_q(), answer: m.faq_home_agents_a() },
    { question: m.faq_selfhost_q(), answer: m.faq_selfhost_a() },
    { question: m.faq_region_q(), answer: m.faq_region_a() },
];
---

<Layout title={pageTitle} description={pageDescription} mdHref="/index.md" bodyClass="monumental-home" themeColor="#1a1714">
    <SeoHead title={pageTitle} description={pageDescription} type="SoftwareApplication" includeOrganization={true} />

    <Nav />

    <main id="main-content">
        <HomeHero />

        <!-- 00 — self-hosting, OpenTelemetry and the trial terms, stated before
             the page asks for anything. These are the three rows visitors open
             once they reach /pricing, and 83% of them never get that far.

             It sits between the headline and the product plate deliberately.
             Below the plate it lands two screens down, and the median homepage
             visit is fourteen seconds — far enough that the visitors this is
             aimed at would never reach it. Here it is the first thing after the
             fold, one scroll from the hero CTA. -->
        <HomeObjections />

        <!-- The hero's product screenshots, as their own section. -->
        <HomeProductPlate />

        <!-- From here down the page is one ruled sheet (home-ledger.css): the same head on every
             section, frames that share hairlines, and no art until the proof chapter. -->

        <!-- The three surfaces you actually look at. -->
        <SignalsStrip />

        <!-- One incident, four surfaces, one trace id. -->
        <IncidentStory />

        <!-- The amber chapter: a named customer, the story's own figures, the logo list. -->
        <HomeProof />

        <!-- Every other surface, visible without a click, and the link hub. -->
        <SurfaceWall />

        <!-- Your data, your instrumentation, your bill: the whole product on a laptop, and the
             runtimes it takes telemetry from. -->
        <LocalSection />

        <!-- The same investigation as the incident story, run by an agent instead of a human. -->
        <AgentSection />

        <!-- The money chapter: the one plan first, then everyone else's list price under it. -->
        <PricingTable variant="home" title={m.pricing_home_title()} lede={m.pricing_home_lede()} />
        <HomeBill />

        <FAQ items={homeFaqs} split />

        <!-- Generated portal closes the page. -->
        <FinalCta />
        <HomeMotion />
    </main>

    <Footer />
</Layout>
