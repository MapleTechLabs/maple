---
/**
 * The product plate and the proof rail under it.
 *
 * The plate overlaps the hero's lower edge, so the top of the app is inside the
 * first viewport and the monument's base runs behind it.
 */
import HeroCarousel from "./HeroCarousel.astro";
import HomeProof from "./HomeProof.astro";
---

<section class="monument-product">
	<div class="shell">
		<HeroCarousel />
		<HomeProof />
	</div>
</section>
