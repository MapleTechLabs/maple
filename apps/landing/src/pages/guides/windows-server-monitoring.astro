const pageTitle = "Windows server monitoring tools, counters and setup | Maple";
const pageDescription =
    "The Windows server monitoring tools to know, the counters and thresholds worth watching, and an OpenTelemetry Collector setup for metrics and event logs.";
const published = "2026-10-19";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "what-to-watch", text: "Counters to watch" },
    { depth: 3, slug: "commit-charge", text: "Commit charge" },
    { depth: 3, slug: "disk-latency", text: "Disk latency" },
    { depth: 3, slug: "event-ids", text: "Event IDs" },
    { depth: 2, slug: "built-in", text: "Built-in tools" },
    { depth: 2, slug: "tool-types", text: "Types of tools" },
    { depth: 3, slug: "open-source", text: "Open source" },
    { depth: 3, slug: "choosing", text: "Choosing one" },
    { depth: 2, slug: "collector", text: "OpenTelemetry setup" },
    { depth: 3, slug: "install", text: "Install" },
    { depth: 3, slug: "config", text: "Config" },
    { depth: 3, slug: "ingest-key", text: "Ingest key" },
    { depth: 3, slug: "event-log-collection", text: "Event logs" },
    { depth: 2, slug: "maple", text: "In Maple" },
    { depth: 3, slug: "per-server-alerts", text: "One alert per server" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per resource, reused by the cards, the event table, the Collector
// diagram and the counter paths and receiver names in the code blocks.
const resources = [
    {
        id: "cpu",
        name: "CPU",
        color: "var(--chart-2)",
        signals: [
            { path: "\\Processor(_Total)\\% Processor Time", watch: "Above 85% for 10 minutes", metric: "system.cpu.utilization" },
            { path: "\\System\\Processor Queue Length", watch: "More than 2 threads per core, sustained", metric: "windows.system.processor_queue_length" },
        ],
    },
    {
        id: "memory",
        name: "Memory",
        color: "var(--chart-5)",
        signals: [
            { path: "\\Memory\\Available MBytes", watch: "Below 10% of physical RAM", metric: "system.memory.utilization" },
            { path: "\\Memory\\% Committed Bytes In Use", watch: "Above 90%", metric: "windows.memory.committed_percent" },
            { path: "\\Memory\\Pages/sec", watch: "High while available memory is low", metric: "windows.memory.pages_per_sec" },
        ],
    },
    {
        id: "disk",
        name: "Disk",
        color: "var(--chart-3)",
        signals: [
            { path: "\\PhysicalDisk(*)\\Avg. Disk sec/Read, sec/Write", watch: "Above 20 ms, sustained", metric: "windows.disk.latency" },
            { path: "\\PhysicalDisk(*)\\Current Disk Queue Length", watch: "A queue that never drains", metric: "windows.disk.queue_length" },
            { path: "\\LogicalDisk(*)\\% Free Space", watch: "Below 10% on any volume", metric: "system.filesystem.utilization" },
        ],
    },
    {
        id: "network",
        name: "Network",
        color: "var(--chart-4)",
        signals: [
            { path: "\\Network Interface(*)\\Bytes Total/sec", watch: "Above 70% of Current Bandwidth, which counts bits: multiply bytes by 8 first", metric: "system.network.io" },
            { path: "\\Network Interface(*)\\Packets Received Errors", watch: "Any count that keeps rising", metric: "system.network.errors" },
        ],
    },
    {
        id: "services",
        name: "Services",
        color: "oklch(0.8 0.14 95)",
        signals: [
            { path: "Service state", watch: "An Automatic service that is not Running", metric: "windows.service.status" },
            { path: "System log, event 7031 or 7034", watch: "A service that crashed", metric: "log record" },
        ],
    },
    {
        id: "events",
        name: "Event logs",
        color: "var(--chart-error)",
        signals: [
            { path: "System and Application logs", watch: "Critical and Error events", metric: "log record" },
            { path: "Security log, event 4625", watch: "A burst of failed logons", metric: "log record" },
        ],
    },
] as const;
type ResourceId = (typeof resources)[number]["id"];
const color = Object.fromEntries(resources.map((r) => [r.id, r.color])) as Record<ResourceId, string>;
const resourceName = Object.fromEntries(resources.map((r) => [r.id, r.name])) as Record<ResourceId, string>;

// Counter paths (PowerShell strings) and Collector keys take their resource's color.
const counterObjects: [string, ResourceId][] = [
    ["Processor", "cpu"],
    ["System", "cpu"],
    ["Memory", "memory"],
    ["PhysicalDisk", "disk"],
    ["LogicalDisk", "disk"],
    ["Network Interface", "network"],
];
const yamlKeys: [RegExp, ResourceId][] = [
    [/^cpu$/, "cpu"],
    [/^memory$/, "memory"],
    [/^(disk|filesystem)$/, "disk"],
    [/^network$/, "network"],
    [/^windows_service$/, "services"],
    [/^windows_event_log\//, "events"],
];
const tint = (html: string) =>
    html
        .replace(/<span class="tok-labels">(["'])\\([^\\(<]+)/g, (match, quote: string, object: string) => {
            const id = counterObjects.find(([name]) => name === object)?.[1];
            return id ? `<span class="tok-labels" style="--type: ${color[id]}">${quote}\\${object}` : match;
        })
        .replace(/<span class="tok-name">([\w/]+)<\/span>:/g, (match, key: string) => {
            const id = yamlKeys.find(([re]) => re.test(key))?.[1];
            return id ? `<span class="tok-name" style="--type: ${color[id]}">${key}</span>:` : match;
        });
const code = (source: string, lang: GuideLang) => tint(highlight(source, lang));

const eventIds: { log: string; id: string; meaning: string; resource: ResourceId }[] = [
    { log: "System", id: "41, 6008", meaning: "The server restarted without a clean shutdown", resource: "events" },
    { log: "System", id: "1074", meaning: "A user or process started a restart or shutdown", resource: "events" },
    { log: "System", id: "7031, 7034", meaning: "A service terminated unexpectedly", resource: "services" },
    { log: "System", id: "2004", meaning: "Resource Exhaustion Detector: low on virtual memory", resource: "memory" },
    { log: "Application", id: "1000", meaning: "An application crashed", resource: "events" },
    { log: "Security", id: "4625", meaning: "A logon attempt failed", resource: "events" },
    { log: "Security", id: "4740", meaning: "An account was locked out", resource: "events" },
    { log: "Security", id: "1102", meaning: "The audit log was cleared", resource: "events" },
];

const getCounterExample = `# CPU, sampled every 5 seconds for a minute
Get-Counter '\\Processor(_Total)\\% Processor Time' -SampleInterval 5 -MaxSamples 12

# Commit charge and disk latency, one sample
Get-Counter '\\Memory\\% Committed Bytes In Use', '\\PhysicalDisk(*)\\Avg. Disk sec/Read'

# The same counters from another server
Get-Counter '\\Memory\\Available MBytes' -ComputerName web-01

# Automatic services that are not running
Get-Service | Where-Object { $_.StartType -eq 'Automatic' -and $_.Status -ne 'Running' }

# Critical and Error events in the System log, last 24 hours
Get-WinEvent -FilterHashtable @{ LogName = 'System'; Level = 1, 2; StartTime = (Get-Date).AddDays(-1) }`;

const logmanExample = `logman create counter Baseline -f bin -si 00:00:15 -o C:\\PerfLogs\\Baseline \`
  -c '\\Processor(_Total)\\% Processor Time' '\\Memory\\Available MBytes' \`
     '\\Memory\\% Committed Bytes In Use' '\\PhysicalDisk(*)\\Avg. Disk sec/Transfer'
logman start Baseline`;

const builtInTools = [
    {
        id: "task-manager",
        label: "Task Manager",
        open: "Ctrl+Shift+Esc",
        body: "The <strong>Performance</strong> tab charts CPU, memory, each disk and each adapter for the last 60 seconds. Under Memory, <strong>Committed</strong> shows the commit charge against the commit limit. <strong>Details</strong> sorts processes by CPU or memory, and <strong>Services</strong> shows which services are stopped.",
        limit: "Live only. Nothing is kept once you close it.",
    },
    {
        id: "resource-monitor",
        label: "Resource Monitor",
        open: "resmon.exe",
        body: "Per-process detail Task Manager lacks: the <strong>Disk</strong> tab lists the files each process is reading and writing with their response time in milliseconds, <strong>Memory</strong> shows hard faults per second per process, and <strong>Network</strong> lists TCP connections per process. <strong>Associated Handles</strong> on the CPU tab finds the process holding a file open.",
        limit: "Live only, on the machine you are logged in to.",
    },
    {
        id: "perfmon",
        label: "Performance Monitor",
        open: "perfmon.exe",
        body: "Charts any counter, local or remote: click the green plus and pick an object such as <strong>Memory</strong> and a counter. A <strong>data collector set</strong> logs counters to a <code>.blg</code> file at a fixed interval, which gives you a baseline of normal to compare against during an incident. Create one under <strong>Data Collector Sets → User Defined</strong>, or with <code>logman</code>:",
        limit: "History only for the sets you create. No alert notifications.",
    },
    {
        id: "powershell",
        label: "PowerShell",
        open: "Get-Counter, Get-Service, Get-WinEvent",
        body: "The same counters, services and events as objects you can script, schedule and run against other servers. Works in Windows PowerShell 5.1 and PowerShell 7 on Windows.",
        limit: "History and alerting are whatever your script builds.",
    },
];

const toolTypes: { type: string; examples: string; fits: string; tradeoffs: string }[] = [
    {
        type: "Built into Windows",
        examples: "Task Manager, Resource Monitor, Performance Monitor, Event Viewer, Windows Admin Center",
        fits: "Investigating one server while you are on it",
        tradeoffs: "No alerts across servers; history only from data collector sets",
