{
	"name": "@maple/changesets",
	"private": true,
	"description": "A dependency-free, Effect-based drop-in for the @changesets/cli add, version and status commands.",
	"bin": {
		"changeset": "./src/bin.ts"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsrs --noEmit",
		"record-reference": "bun scripts/record-reference.ts"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effect",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
