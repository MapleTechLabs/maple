import logging

from fastapi import FastAPI

import intercept  # noqa: F401  (installs the InterceptHandler)

# uvicorn gives its loggers their own handlers and stops propagation,
# so their records never reach the root logger. Undo that.
for name in ("uvicorn", "uvicorn.error", "uvicorn.access"):
    logging.getLogger(name).handlers = []
    logging.getLogger(name).propagate = True

app = FastAPI()


@app.get("/")
def index():
    return {"ok": True}`,
