{
	"name": "@maple/cli",
	"version": "0.3.1",
	"private": true,
	"bin": {
		"maple": "./src/bin.ts"
	},
	"type": "module",
	"scripts": {
		"start": "bun run src/bin.ts",
		"bench:ingest": "bun bench/ingest-http.ts",
		"bench:ingest:chdb": "bun bench/ingest-chdb.ts",
		"test": "bun test --max-concurrency=1 test/*.test.ts src/core/*.test.ts",
		"typecheck": "tsrs --noEmit"
	},
	"dependencies": {
		"@effect/platform-bun": "catalog:effect",
		"@maple-dev/effect-sdk": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/eventing-core": "workspace:*",
		"@maple/local-server": "workspace:*",
		"@maple/query-engine": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@types/bun": "^1.4.4",
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
