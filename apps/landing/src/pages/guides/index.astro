---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SeoHead from "../../components/SeoHead.astro";
import type { BlogPost } from "../../lib/blog";
import { allGuides, guideCategories } from "../../lib/guides";

const pageTitle = "Guides to APM, Observability & OpenTelemetry | Maple";
const pageDescription =
    "Practical guides to application performance monitoring, observability, OpenTelemetry, latency, and choosing an open-source observability stack.";

const fieldNotes = (await getCollection("blog") as BlogPost[])
    .filter((post) => (!post.data.draft || import.meta.env.DEV) && post.data.category === "guides")
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const itemListJsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Maple observability guides",
    itemListElement: allGuides.map((guide, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: guide.title,
        url: `${siteUrl}${guide.href}`,
    })),
};
---

<Layout title={pageTitle} description={pageDescription} alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <Nav />
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Guides" }]} />

    <main class="mx-auto max-w-6xl px-6 pb-20 pt-16 md:pb-28 md:pt-20">
        <h1 class="font-display text-4xl font-medium tracking-[-0.03em] text-fg md:text-5xl">Guides</h1>
        <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-fg-muted">
            Practical guides to APM, observability, OpenTelemetry, and running production software.
        </p>

        <div class="mt-12 border-b border-border">
            {guideCategories.map(({ icon: CategoryIcon, ...category }) => (
                <section id={category.id} class="grid scroll-mt-24 gap-6 border-t border-border py-10 lg:grid-cols-[15rem_1fr] lg:gap-12" aria-labelledby={`${category.id}-title`}>
                    <div>
                        <h2 id={`${category.id}-title`} class="flex items-center gap-2.5 font-display text-xl font-medium tracking-[-0.015em] text-fg">
                            <CategoryIcon className="size-5 text-primary" />
                            {category.title}
                        </h2>
                        <p class="mt-2 text-[13px] leading-relaxed text-fg-muted">{category.description}</p>
                    </div>
                    <ul class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
                        {category.guides.map(({ icon: GuideIcon, ...item }) => (
                            <li>
                                <a href={item.href} class="group flex gap-4">
                                    <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-deep text-primary transition-colors group-hover:border-primary/45 group-hover:text-primary">
                                        <GuideIcon className="size-[18px]" />
                                    </span>
                                    <span class="min-w-0">
                                    <span class="font-display text-[16px] font-medium leading-snug text-fg transition-colors group-hover:text-primary">{item.title}</span>
                                    <span class="mt-1.5 block text-[13px] leading-relaxed text-fg-muted">{item.description}</span>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))}

            {fieldNotes.length > 0 && (
                <section class="grid gap-6 border-t border-border py-10 lg:grid-cols-[15rem_1fr] lg:gap-12" aria-labelledby="field-notes">
                    <div>
                        <h2 id="field-notes" class="font-display text-xl font-medium tracking-[-0.015em] text-fg">From the blog</h2>
                    </div>
                    <ul class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
                        {fieldNotes.map((item) => (
                            <li>
                                <a href={`/blog/${item.id}`} class="group block">
                                    <span class="font-display text-[16px] font-medium leading-snug text-fg transition-colors group-hover:text-primary">{item.data.title}</span>
                                    <span class="mt-1.5 block text-[13px] leading-relaxed text-fg-muted">{item.data.description}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )}
        </div>
    </main>

    <BottomCTA />
    <Footer />
</Layout>
