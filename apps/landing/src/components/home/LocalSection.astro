---
/**
 * Ownership: the claim that the data, the instrumentation and the bill stay yours, and the piece
 * of the product that proves it hardest, the whole thing running on a laptop.
 *
 * Commands are the real ones from the repo. The left cell is the copyable install and nothing
 * else; `maple start` and what it prints belong to the terminal on the right, so neither says the
 * same thing twice.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import * as m from "../../paraglide/messages.js";
import LiveLocalTerminal from "../live/LiveLocalTerminal.astro";
import { getGitHubStars, formatStars } from "../../lib/github-stars";
import LedgerHead from "./LedgerHead.astro";
import SdkBand from "./SdkBand.astro";

const locale = Astro.currentLocale ?? "en";
const l = (path: string) => getRelativeLocaleUrl(locale, path);
const stars = await getGitHubStars();
---

<section id="sovereignty" class="ledger">
	<div class="shell">
		<LedgerHead title={m.sov_title()} lede={m.sov_lede()}>
			<a href="https://github.com/MapleTechLabs/maple" target="_blank" rel="noopener noreferrer" class="ledger-link">
				{m.sov_link_source()}
				{stars !== null && <span class="tabular-nums text-fg-muted"> {formatStars(stars)}</span>}
			</a>
			<a href={l("/opentelemetry")} class="ledger-link">{m.sov_link_otel()}<span aria-hidden="true"> →</span></a>
			<a href={l("/pricing")} class="ledger-link">{m.sov_link_pricing()}<span aria-hidden="true"> →</span></a>
		</LedgerHead>

		<div class="ledger-grid">
			{/* min-w-0 (on the cell) so the install <pre> scrolls inside itself. */}
			<div class="ledger-cell ledger-cell--pad">
				<h3 class="ledger-local__title">{m.local_title()}</h3>
				<p class="mt-4 max-w-[52ch] text-[15px] text-fg-muted">{m.local_body()}</p>

				<div class="ledger-install mt-8">
					<pre><code><span class="select-none text-fg-muted">$ </span>brew install Makisuo/tap/maple</code></pre>
					<p>
						{m.local_install_alt()}
						<code class="ml-1">curl -fsSL https://maple.dev/cli/install | sh</code>
					</p>
				</div>

				<p class="mt-auto pt-8 text-sm">
					<a href={l("/local")} class="text-fg transition-colors hover:text-primary">{m.local_link_docs()}</a>
				</p>
			</div>
			<div class="ledger-cell">
				<LiveLocalTerminal class="h-full" />
			</div>
		</div>

		<SdkBand />
	</div>
</section>
