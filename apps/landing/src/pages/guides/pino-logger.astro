})`;

// pino-pretty's terminal output, colored the way it prints.
const prettyOutput = `<span class="tok-comment">[18:24:50]</span> <span class="tok-level">INFO</span>: <span class="tok-labels">listening</span>
    <span class="tok-name">port</span>: <span class="tok-value">3000</span>`;

const prettyFlags = `-c -t "SYS:HH:MM:ss" -i pid,hostname`;
const prettyCli = [
    { id: "npm", value: `node app.ts | npx pino-pretty ${prettyFlags}` },
    { id: "pnpm", value: `node app.ts | pnpm exec pino-pretty ${prettyFlags}` },
    { id: "bun", value: `node app.ts | bunx pino-pretty ${prettyFlags}` },
];

const transportSnippet = `const transport = pino.transport({
  targets: [
    { target: "pino-pretty", level: "info", options: { colorize: true } },
    { target: "pino/file", level: "debug", options: { destination: "./logs/app.log", mkdir: true } },
  ],
})

const logger = pino({ level: "debug" }, transport)

logger.debug("only in the file")
logger.info({ orderId: "ord_77" }, "in the terminal and in the file")`;

const destinationSnippet = `// Collect 4 KiB before each write: more throughput, and a crash can lose the last buffer.
const logger = pino(pino.destination({ dest: "./logs/app.log", minLength: 4096, mkdir: true }))

// Block on every write: nothing is pending when the function returns.
const lambdaLogger = pino(pino.destination({ sync: true }))`;

const writeModes = [
    { setting: "Default destination", runs: stages.main, behaviour: "Hands each line to stdout without blocking or buffering", when: "Most services" },
    { setting: "minLength: 4096", runs: stages.main, behaviour: "Collects 4 KiB, then writes", when: "Very high volume, where losing the last buffer on a crash is acceptable" },
    { setting: "sync: true", runs: stages.main, behaviour: "Blocks until each write completes", when: "AWS Lambda and other runtimes that freeze the process after a response" },
    { setting: "pino.transport()", runs: stages.worker, behaviour: "Formatting and I/O move to a worker", when: "Pretty printing, several files, sending over the network" },
];

const httpTabs = [
    {
        id: "express",
        label: "Express",
        install: "npm install express pino pino-http",
        code: `// server.mjs
import express from "express"
import pino from "pino"
import { pinoHttp } from "pino-http"

const logger = pino({
  level: process.env.LOG_LEVEL ?? "info",
  redact: ["req.headers.authorization", "req.headers.cookie"],
})
const app = express()

app.use(
  pinoHttp({
    logger,
    quietReqLogger: true,
    customLogLevel: (req, res, err) =>
      err || res.statusCode >= 500 ? "error" : res.statusCode >= 400 ? "warn" : "info",
  }),
)

app.get("/orders/:id", (req, res) => {
  req.log.info({ orderId: req.params.id }, "loading order")
  res.json({ id: req.params.id })
})

app.listen(3000, () => logger.info({ port: 3000 }, "listening"))`,
        note: "<code>pino-http</code> writes one <code>request completed</code> line per request with the request, the status code and <code>responseTime</code> in milliseconds. Its default request serializer includes every header, which is why the logger redacts <code>authorization</code> and <code>cookie</code>. <code>quietReqLogger</code> keeps the lines your handlers write down to a <code>reqId</code> instead of the whole request, and <code>customLogLevel</code> logs 4xx as <code>warn</code> and 5xx as <code>error</code>. The older <code>express-pino-logger</code> package is deprecated in favour of <code>pino-http</code>.",
    },
    {
        id: "fastify",
        label: "Fastify",
        install: "npm install fastify",
        code: `// server.mjs
import Fastify from "fastify"

const app = Fastify({
  logger: { level: process.env.LOG_LEVEL ?? "info" },
})

app.get("/orders/:id", async (request) => {
  request.log.info({ orderId: request.params.id }, "loading order")
  return { id: request.params.id }
})

await app.listen({ port: 3000 })`,
        note: "Fastify depends on Pino and builds the logger from its <code>logger</code> option, which takes <code>true</code> or any Pino options, including <code>redact</code> and <code>transport</code>. It writes <code>incoming request</code> and <code>request completed</code> lines with a <code>reqId</code>, and its default request serializer logs no headers. To pass a Pino instance you created yourself, Fastify 5 has a separate <code>loggerInstance</code> option.",
    },
];

const otelInstall = `npm install @opentelemetry/api \\
  @opentelemetry/sdk-node \\
  @opentelemetry/auto-instrumentations-node \\
  @opentelemetry/instrumentation \\
  @opentelemetry/resources \\
  @opentelemetry/sdk-logs \\
  @opentelemetry/sdk-metrics \\
  @opentelemetry/exporter-trace-otlp-proto \\
  @opentelemetry/exporter-logs-otlp-proto \\
  @opentelemetry/exporter-metrics-otlp-proto`;

const tracingSnippet = `// tracing.mjs
import { register } from "node:module"
import { NodeSDK } from "@opentelemetry/sdk-node"
import { getNodeAutoInstrumentations } from "@opentelemetry/auto-instrumentations-node"
import { resourceFromAttributes } from "@opentelemetry/resources"
import { BatchLogRecordProcessor } from "@opentelemetry/sdk-logs"
import { PeriodicExportingMetricReader } from "@opentelemetry/sdk-metrics"
import { OTLPTraceExporter } from "@opentelemetry/exporter-trace-otlp-proto"
import { OTLPLogExporter } from "@opentelemetry/exporter-logs-otlp-proto"
import { OTLPMetricExporter } from "@opentelemetry/exporter-metrics-otlp-proto"

// Lets the instrumentations patch ES modules. CommonJS apps can drop this line.
register("@opentelemetry/instrumentation/hook.mjs", import.meta.url)

const MAPLE_ENDPOINT = "https://ingest.maple.dev" // EU: https://ingest.eu.maple.dev
const MAPLE_KEY = "YOUR_INGEST_KEY"
const headers = { authorization: \`Bearer \${MAPLE_KEY}\` }

const sdk = new NodeSDK({
  resource: resourceFromAttributes({ "service.name": "orders-api" }),
  traceExporter: new OTLPTraceExporter({ url: \`\${MAPLE_ENDPOINT}/v1/traces\`, headers }),
  logRecordProcessors: [
    new BatchLogRecordProcessor({
      exporter: new OTLPLogExporter({ url: \`\${MAPLE_ENDPOINT}/v1/logs\`, headers }),
    }),
  ],
  metricReaders: [
    new PeriodicExportingMetricReader({
      exporter: new OTLPMetricExporter({ url: \`\${MAPLE_ENDPOINT}/v1/metrics\`, headers }),
    }),
  ],
  instrumentations: [getNodeAutoInstrumentations()],
})

sdk.start()

process.on("SIGTERM", () => {
  sdk.shutdown().finally(() => process.exit(0))
})`;

const disableSendingSnippet = `instrumentations: [
  getNodeAutoInstrumentations({
    "@opentelemetry/instrumentation-pino": { disableLogSending: true },
  }),
],`;

const correlatedOutput = `{"level":30,"time":1792513527238,"pid":4812,"hostname":"api-1","reqId":1,"trace_id":"0c8fecc47de79cc6181bbc93a912d762","span_id":"22497105575e6deb","trace_flags":"01","orderId":"42","msg":"loading order"}`;

const winston = [
    ["Default output", "One JSON object per line", "Whatever <code>format</code> builds; JSON is one option"],
    ["Levels", "trace 10 up to fatal 60", "npm levels: error 0 down to silly 6"],
    ["Formatting", "Outside the process: pino-pretty or your log tooling", "In the process with <code>format.combine()</code>"],
    ["Transports", "Worker threads via <code>pino.transport()</code>", "Streams on the main thread (Console, File, Http)"],
    ["Redaction", "Built-in <code>redact</code> option", "A custom format"],
    ["OpenTelemetry", "Instrumentation adds trace IDs and sends records", "Instrumentation adds trace IDs; sending needs <code>@opentelemetry/winston-transport</code>"],
];

const faqs = [
    {
        question: "What is Pino in Node.js?",
        answer:
            "Pino is an open-source (MIT) logger for Node.js that writes each log entry as one line of JSON. It keeps the work on the main thread small, and moves pretty printing and shipping to transports that run in worker threads. Fastify uses Pino as its built-in logger.",
    },
    {
        question: "Pino vs Winston: which should I use?",
        answer:
            "Pick Pino when your logs are JSON that something outside the process collects, which is the usual setup in containers, and per-call cost matters. Pick Winston when the process itself must write several formats to several destinations, or your codebase already relies on its format pipeline. Both have OpenTelemetry instrumentations that add trace IDs.",
    },
    {
        question: "How do I pretty print Pino logs?",
        answer:
            "Install pino-pretty as a dev dependency. Either pipe the output through it (node app.ts | npx pino-pretty) or set transport: { target: \"pino-pretty\" } in the logger options only when NODE_ENV is development. Keep production output as JSON so log tooling can read the fields.",
    },
    {
        question: "How do I set the Pino log level?",
        answer:
            "Pass level in the options, for example pino({ level: process.env.LOG_LEVEL ?? \"info\" }). The default is info. You can change it at runtime with logger.level = \"debug\", and give a child logger its own level with logger.child(bindings, { level: \"warn\" }).",
    },
    {
        question: "Does Pino work with TypeScript?",
        answer:
            "Yes. Pino ships its own type definitions, so import pino, { type Logger } from \"pino\" works without an @types package. The Logger type is what you use for function parameters that take a logger or a child logger.",
    },
    {
        question: "How do I add trace IDs to Pino logs?",
        answer:
            "Run your app with the OpenTelemetry Node.js SDK and its auto-instrumentations. The pino instrumentation adds trace_id, span_id and trace_flags to every line written inside an active span, and sends each record to the OpenTelemetry log SDK, which exports it over OTLP. Your logging calls stay the same.",
    },
    {
        question: "Is Pino synchronous or asynchronous?",
        answer:
            "The default destination writes to stdout without blocking and without buffering, and Pino flushes what is pending when the process exits normally. pino.destination({ minLength: 4096 }) adds a buffer for more throughput. sync: true blocks on every write, which Pino recommends for AWS Lambda.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
