---
/**
 * CrossLinks — the internal link hub at the foot of every feature and use-case
 * page, and the page's SEO load-bearing section.
 *
 * The construction is PlatformSheet's: one ruled plate, cells sharing hairline
 * edges via `gap-px` on a `bg-border` fill, no per-cell radius, no per-cell
 * background lift, no icons and no index numbers. The old RelatedFeatures was a
 * `max-w-6xl` grid with a `text-primary` "Learn more →" in every cell: three
 * amber links in one section, against a two-per-page budget.
 *
 * Links are hand-picked per page in the registry, not `filter().slice(0, 3)`
 * over a fixed array. The mechanical version sent every page to the same first
 * three slugs, which left four features with no inbound links at all.
 *
 * A link may carry a brand mark (the compare pages): it sits before the name.
 */
import BrandMarkIcon from "../BrandMarkIcon.astro";
import type { BrandMarkId } from "../../lib/brand-marks";

interface Props {
	eyebrow: string;
	title: string;
	links: { href: string; name: string; desc: string; mark?: BrandMarkId }[];
	class?: string;
}

const { eyebrow, title, links, class: className = "" } = Astro.props;

// Three per row for the feature and use-case pages, four when the count
// divides by four, so a 1px-gap grid never shows an empty cell. Counts that
// divide by neither (five, with six vendors in the compare registry) lay out
// on six columns instead: full rows of three take two columns each and the
// remainder stretches to fill the last row, the way CompareHub does it.
const ragged = links.length % 4 !== 0 && links.length % 3 !== 0;
const columns = ragged ? "lg:grid-cols-6" : links.length % 4 === 0 ? "lg:grid-cols-4" : "lg:grid-cols-3";
const lastRowCount = links.length % 3 || 3;
const spanOf = (i: number) => {
	if (!ragged) return undefined;
	if (i < links.length - lastRowCount) return "lg:col-span-2";
	return lastRowCount === 1 ? "lg:col-span-6" : lastRowCount === 2 ? "lg:col-span-3" : "lg:col-span-2";
};
---

<section class={`bg-bg-deep ${className}`}>
	<div class="shell py-12 md:py-16">
		<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{eyebrow}</p>
		<h2 class="mt-3 max-w-[24ch] font-display text-xl font-medium leading-[1.15] tracking-[-0.02em] text-fg md:text-2xl">
			{title}
		</h2>

		<div
			class:list={["mt-6 grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-2", columns]}
		>
			{
				links.map((link, i) => (
					<a
						href={link.href}
						class:list={["group flex flex-col gap-1.5 bg-bg p-5 transition-colors hover:bg-bg-elevated md:p-6", spanOf(i)]}
					>
						<h3 class="flex items-center justify-between gap-3 font-display text-base leading-snug tracking-[-0.01em] text-fg md:text-lg">
							<span class="flex min-w-0 items-center gap-2.5">
								{link.mark && <BrandMarkIcon id={link.mark} class="h-[18px] w-[18px] shrink-0" />}
								{link.name}
							</span>
							<span class="text-sm text-fg-muted transition-colors group-hover:text-fg" aria-hidden="true">→</span>
						</h3>
						<p class:list={["max-w-[46ch] text-[13px] leading-relaxed text-fg-muted", link.mark && "pl-7"]}>{link.desc}</p>
					</a>
				))
			}
		</div>
	</div>
</section>
