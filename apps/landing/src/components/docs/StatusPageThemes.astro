---
/**
 * The five theme presets on the same page. One image is swapped rather than five toggled, because
 * the lightbox makes every image in the article a slide and closes onto it, hidden or not.
 */
const THEMES = [
    { id: "maple", label: "Maple", mode: "dark" },
    { id: "default", label: "Default", mode: "light" },
    { id: "paper", label: "Vintage Paper", mode: "light" },
    { id: "midnight", label: "Cosmic Night", mode: "dark" },
    { id: "mono", label: "Mono", mode: "dark" },
].map((theme) => ({
    ...theme,
    src: `/screenshots/docs/status-pages-theme-${theme.id}.webp`,
    alt: `The same status page in the ${theme.label} preset, ${theme.mode} mode.`,
    caption: `${theme.label}, shown in ${theme.mode} mode. Every preset has both modes.`,
}));
const first = THEMES[0]!;
---

<div class="themes" data-status-page-themes>
    <div class="themes__tabs" role="radiogroup" aria-label="Theme preset" hidden>
        {
            THEMES.map((theme) => (
                <label>
                    <input
                        type="radio"
                        name="status-page-theme"
                        value={theme.id}
                        checked={theme.id === first.id}
                        data-src={theme.src}
                        data-alt={theme.alt}
                        data-caption={theme.caption}
                    />
                    <span>{theme.label}</span>
                </label>
            ))
        }
    </div>
    <figure class="shot">
        <img src={first.src} alt={first.alt} width="1520" height="1120" loading="lazy" decoding="async" data-zoomable />
        <figcaption>{first.caption}</figcaption>
    </figure>
</div>

<script>
    for (const root of document.querySelectorAll<HTMLElement>("[data-status-page-themes]")) {
        const tabs = root.querySelector<HTMLElement>(".themes__tabs");
        const image = root.querySelector("img");
        const caption = root.querySelector("figcaption");
        if (tabs === null || image === null || caption === null) continue;
        tabs.hidden = false;
        tabs.addEventListener("change", (event) => {
            if (!(event.target instanceof HTMLInputElement)) return;
            const { src, alt, caption: text } = event.target.dataset;
            if (src === undefined || alt === undefined || text === undefined) return;
            image.src = src;
            image.alt = alt;
            caption.textContent = text;
        });
    }
</script>

<style>
    .themes {
        margin-block: 24px;
    }
    .themes__tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 10px;
    }
    .themes__tabs[hidden] {
        display: none;
    }
    .themes__tabs label {
        position: relative;
        cursor: pointer;
    }
    .themes__tabs input {
        position: absolute;
        inset: 0;
        margin: 0;
        opacity: 0;
        cursor: pointer;
    }
    .themes__tabs span {
        display: block;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 5px 11px;
        color: var(--muted-foreground);
        font-size: 13px;
        font-weight: 500;
    }
    .themes__tabs input:checked + span {
        border-color: var(--primary);
        color: var(--foreground);
    }
    .themes__tabs input:focus-visible + span {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
    .themes .shot {
        margin-block: 0;
    }
</style>
