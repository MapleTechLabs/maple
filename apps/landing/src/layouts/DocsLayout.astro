---
import "../styles/global.css";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsTableOfContents from "../components/docs/DocsTableOfContents.astro";
import DocsPrevNext from "../components/docs/DocsPrevNext.astro";
import DocsMobileNav from "../components/docs/DocsMobileNav.astro";
import DocsSectionNav from "../components/docs/DocsSectionNav.astro";
import DocsSearch from "../components/docs/DocsSearch.tsx";
import { getGitHubStars } from "../lib/github-stars";
import { GithubStarButton } from "../components/GithubStarButton";
import { MapleMark } from "@maple/ui/components/icons/maple-mark";

interface Props {
    title: string;
    description: string;
    headings: Array<{ depth: number; slug: string; text: string }>;
    currentSlug: string;
    image?: string;
    /** Path of this page's markdown twin — see the same prop on Layout.astro. */
    mdHref?: string;
    /** Widen the column and drop the table-of-contents rail (index pages). */
    wide?: boolean;
}

const { title, description, headings, currentSlug, image = "/og-docs.png", mdHref, wide = false } = Astro.props;
const stars = await getGitHubStars();

const pageTitle = currentSlug ? `${title} — Maple Docs` : "Maple Docs";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImage = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
const hasToc = !wide && headings.some((h) => h.depth >= 2 && h.depth <= 3);
---

<!doctype html>
<html lang="en" class="dark docs">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#171410" />
        <meta name="robots" content="index,follow" />
        <link rel="canonical" href={canonicalUrl} />
        {mdHref && (
            <link rel="alternate" type="text/markdown" href={new URL(mdHref, Astro.site).toString()} />
        )}
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="Maple" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@Mapledotdev" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <!-- Docs pages don't go through Layout.astro, so telemetry is wired here too. -->
        <script>
            import { startLandingTelemetry } from "../lib/telemetry";
            startLandingTelemetry();
        </script>
    </head>
    <!-- Docs are a reading surface: proportional Geist for everything, the way
         the blog sets its prose. Mono is opted back in per element for code,
         eyebrows and labels. -->
    <body class="min-h-screen antialiased bg-bg text-fg font-display">
        <header class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/95 backdrop-blur-md">
            <div class="flex h-14 items-center gap-5 px-4 sm:px-6">
                <a href="/" class="flex items-center gap-2 text-fg transition-colors hover:text-primary">
                    <MapleMark size={20} className="text-primary shrink-0" />
                    <span class="text-[15px] font-semibold tracking-[-0.01em]">Maple</span>
                </a>
                <span class="h-4 w-px bg-border" aria-hidden="true"></span>
                <a href="/docs" class="text-[14px] text-fg-muted transition-colors hover:text-fg">Docs</a>
                <div class="ml-auto flex items-center gap-2.5">
                    <DocsSearch client:idle />
                    <GithubStarButton stars={stars} className="hidden sm:inline-flex" />
                    <a
                        href="https://app.maple.dev"
                        class="inline-flex h-7 items-center rounded-lg border border-border px-2.5 text-xs font-medium text-fg-muted transition-colors hover:border-fg-muted/40 hover:text-fg"
                    >
                        Open app
                    </a>
                </div>
            </div>
            <DocsSectionNav currentSlug={currentSlug} />
        </header>

        <div class="flex min-h-screen pt-24">
            <aside class="fixed top-24 bottom-0 left-0 hidden w-64 shrink-0 overflow-y-auto border-r border-border px-4 py-7 lg:block">
                <DocsSidebar currentSlug={currentSlug} />
            </aside>

            <main class:list={["min-w-0 flex-1 lg:ml-64", hasToc && "xl:mr-60"]}>
                <div class:list={["mx-auto px-5 py-10 sm:px-8 md:py-12", wide ? "max-w-5xl" : "max-w-3xl"]}>
                    <DocsMobileNav currentSlug={currentSlug} />
                    {hasToc && (
                        <details class="mb-8 rounded-lg border border-border xl:hidden">
                            <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[13px] text-fg-muted transition-colors hover:text-fg [&::-webkit-details-marker]:hidden">
                                <span>On this page</span>
                                <svg class="h-3 w-3 shrink-0 transition-transform details-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M3 5l3 3 3-3" />
                                </svg>
                            </summary>
                            <div class="max-h-[60vh] overflow-y-auto border-t border-border px-4 pt-4 pb-4">
                                <DocsTableOfContents headings={headings} spy={false} />
                            </div>
                        </details>
                    )}
                    <slot />
                    {currentSlug && <DocsPrevNext currentSlug={currentSlug} />}
                </div>
            </main>

            {hasToc && (
                <aside class="fixed top-24 right-0 bottom-0 hidden w-60 shrink-0 overflow-y-auto py-7 pr-6 pl-4 xl:block">
                    <DocsTableOfContents headings={headings} />
                </aside>
            )}
        </div>

        <script>
            import { bindCopyButtons } from "../lib/copy-to-clipboard";

            // Progressive enhancement over the rendered article: copy buttons on
            // code blocks, section permalinks, and the navigation scrolled so the
            // current page is in view. Everything here is optional — the page
            // reads fine without it.
            const article = document.querySelector(".docs-content");

            if (article) {
                for (const pre of article.querySelectorAll<HTMLPreElement>("pre")) {
                    const code = pre.querySelector("code");
                    if (!code) continue;
                    pre.dataset.copy = code.textContent ?? "";
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "code-copy";
                    button.textContent = "copy";
                    button.setAttribute("aria-label", "Copy code");
                    pre.appendChild(button);
                }
                bindCopyButtons({
                    root: article,
                    hostSelector: "pre[data-copy]",
                    buttonSelector: ".code-copy",
                    track: { event: "docs_snippet_copied", key: "snippet" },
                });

                for (const heading of article.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]")) {
                    const anchor = document.createElement("a");
                    anchor.className = "heading-anchor";
                    anchor.href = `#${heading.id}`;
                    anchor.textContent = "#";
                    anchor.setAttribute("aria-label", `Link to “${heading.textContent?.trim() ?? ""}”`);
                    heading.appendChild(anchor);
                }
            }

            // Sidebar: the active row is often below the fold on long trees. Scroll
            // just far enough to show it.
            const sidebar = document.querySelector<HTMLElement>("aside nav[aria-label='Documentation']");
            const active = sidebar?.querySelector<HTMLElement>("a[aria-current='page']");
            const rail = sidebar?.closest<HTMLElement>("aside");
            if (active && rail) {
                const bottom = active.offsetTop + active.offsetHeight + 32;
                if (bottom > rail.clientHeight) rail.scrollTop = bottom - rail.clientHeight;
            }

            // Section strip scrolls horizontally on phones; keep the active one visible.
            const strip = document.querySelector<HTMLElement>(".docs-section-nav");
            const section = strip?.querySelector<HTMLElement>("a[aria-current='page']");
            if (strip && section) {
                const overflow = section.offsetLeft + section.offsetWidth - strip.clientWidth;
                if (overflow > 0) strip.scrollLeft = overflow + 16;
            }
        </script>
    </body>
</html>
