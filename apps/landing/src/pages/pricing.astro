---
import "../styles/pricing-monument.css";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PricingHero from "../components/PricingHero.astro";
import PricingTable from "../components/PricingTable.astro";
import PricingCalculatorSection from "../components/PricingCalculatorSection.astro";
import SupportedStack from "../components/SupportedStack.astro";
import PricingPaths from "../components/PricingPaths.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import * as m from "../paraglide/messages.js";
import { pricingFaq } from "../lib/pricing-faq";

const pageTitle = m.page_pricing_title();
const pageDescription = m.page_pricing_desc();

const faqItems = await pricingFaq();
---

<Layout title={pageTitle} description={pageDescription} mdHref="/pricing.md" bodyClass="monumental-pricing">
    <SeoHead title={pageTitle} description={pageDescription} />
    <Nav />
    <main class="pricing-page">
    <PricingHero />
    {/* The estimator runs before the offer card. The median pricing visit is
        about six seconds — not enough to reach a calculator sitting two
        sections down, which is why only 15% of pricing visitors ever touched
        it. The ones who did averaged six slider moves each, so it is the thing
        they came for; the offer card still closes the decision below it. */}
    <PricingCalculatorSection eager />
    <PricingTable class="pricing-offer" />
    <SupportedStack />
    <PricingPaths />
    <FAQ items={faqItems} />
    </main>
    <Footer />
</Layout>
