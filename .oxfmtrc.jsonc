{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": false,
	"printWidth": 110,
	"useTabs": true,
	"tabWidth": 4,
	// packages/db/drizzle is generated (drizzle-kit, then effect-orm) — formatting
	// it is churn that only obscures the migration-snapshot diff.
	// The iOS OpenAPI spec is generated by scripts/generate-ios-openapi.ts, and
	// `ios:openapi:check` re-runs that generator and compares byte for byte — so
	// formatting it does not merely churn, it fails CI for anyone who has run
	// `bun run format` since the last regeneration.
	// CLAUDE.md (AGENTS.md links to it) has a bare `yield*` snippet that oxfmt parses
	// outside a generator and rewrites to `yield *`, a multiplication.
	"ignorePatterns": [
		".agents/**",
		".codex/**",
		".context/**",
		".factory/**",
		".impeccable/**",
		".superset/**",
		"deploy",
		"skills",
		"packages/db/drizzle",
		// Vendored upstream, kept byte-identical, and the module generated from it.
		"packages/security-audit/skill",
		"packages/security-audit/src/skill-files.generated.ts",
		// Generated by `bun run --cwd apps/ai mcp:tools`, whose `--check` compares it byte for byte.
		"apps/ai/src/mcp/tool-descriptors.generated.ts",
		"packages/eventing-core/schemas",
		"apps/ios/Packages/MapleAPI/Sources/MapleAPI/openapi.json",
		"lib/oxlint-config/plugins/anti-slop/**",
		"lib/oxlint-config/plugins/anti-slop.mjs",
		"CLAUDE.md",
	],
}
