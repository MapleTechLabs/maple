---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import BottomCTA from "../../components/BottomCTA.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FAQ from "../../components/FAQ.astro";
import SeoHead from "../../components/SeoHead.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { CONTRIBUTORS } from "../../lib/changelog-meta";
import { highlight, type GuideLang } from "../../lib/guide-highlight";
import LanguageTabs from "../../components/docs/LanguageTabs.astro";
import LanguageTab from "../../components/docs/LanguageTab.astro";

const pageTitle = "Python logging levels: how to set the log level | Maple";
const pageDescription =
    "The Python logging levels and their values, why debug logs don't print, and how to set the log level with basicConfig, a flag, LOG_LEVEL or dictConfig.";
const published = "2026-10-19";
const updatedLabel = "October 20, 2026";
const author = CONTRIBUTORS.jeremyfunk;
const authorUrl = `https://github.com/${author.github}`;

const toc = [
    { depth: 2, slug: "levels", text: "The logging levels" },
    { depth: 3, slug: "choosing", text: "Choosing a level" },
    { depth: 3, slug: "default", text: "The default is WARNING" },
    { depth: 2, slug: "logger-vs-handler", text: "Logger vs handler level" },
    { depth: 3, slug: "effective-level", text: "Effective level" },
    { depth: 3, slug: "propagation", text: "Propagation" },
    { depth: 3, slug: "debug-not-printing", text: "Why debug logs don't print" },
    { depth: 2, slug: "set-level", text: "Set the logging level" },
    { depth: 3, slug: "basicconfig", text: "basicConfig and setLevel" },
    { depth: 3, slug: "flag-env-config", text: "Flag, variable or dictConfig" },
    { depth: 3, slug: "per-module", text: "Per-module levels" },
    { depth: 3, slug: "runtime", text: "Change it at runtime" },
    { depth: 2, slug: "opentelemetry", text: "OpenTelemetry and Maple" },
    { depth: 3, slug: "handler-level", text: "A level for the exporter" },
    { depth: 3, slug: "severity", text: "Levels as severities" },
    { depth: 3, slug: "maple", text: "Filter by severity in Maple" },
    { depth: 2, slug: "mistakes", text: "Common mistakes" },
];
const sectionNav = toc.filter((h) => h.depth === 2);

// One color per level, the same severity colors Maple's Logs page uses. Code
// blocks, badges and the diagram all read them.
const levels = [
    { name: "CRITICAL", value: 50, color: "var(--severity-fatal)", use: "The program may not be able to continue: the database is unreachable at startup.", shown: true, otel: "FATAL", severity: 21 },
    { name: "ERROR", value: 40, color: "var(--severity-error)", use: "One operation failed: a request returned 500, a payment call raised.", shown: true, otel: "ERROR", severity: 17 },
    { name: "WARNING", value: 30, color: "var(--severity-warn)", use: "Something unexpected that the program handled: a retry, a deprecated option.", shown: true, otel: "WARN", severity: 13 },
    { name: "INFO", value: 20, color: "var(--severity-info)", use: "Normal milestones: service started, job finished, order placed.", shown: false, otel: "INFO", severity: 9 },
    { name: "DEBUG", value: 10, color: "var(--severity-debug)", use: "Detail for chasing a bug: payloads, cache hits, branch decisions.", shown: false, otel: "DEBUG", severity: 5 },
] as const;
const levelColor = Object.fromEntries(levels.map((l) => [l.name, l.color]));

// Shared highlighter, plus the level names in their level color.
const code = (src: string, lang: GuideLang = "python") =>
    highlight(src, lang).replace(/\b(DEBUG|INFO|WARNING|ERROR|CRITICAL)\b/g, (name) => `<span class="lvl" style="--lvl: ${levelColor[name]}">${name}</span>`);

const gatesCode = String.raw`import logging

root = logging.getLogger()
root.setLevel(logging.WARNING)

console = logging.StreamHandler()
console.setLevel(logging.WARNING)    # terminal: WARNING and above
logfile = logging.FileHandler("app.log")
logfile.setLevel(logging.DEBUG)      # file: everything it receives
root.addHandler(console)
root.addHandler(logfile)

logging.getLogger("app").setLevel(logging.ERROR)
db = logging.getLogger("app.db")
db.setLevel(logging.DEBUG)
api = logging.getLogger("app.api")   # no level of its own

db.debug("pool size 5")
api.debug("GET /orders")
db.warning("pool exhausted")`;

const gatesRun = String.raw`$ python levels.py
pool exhausted
$ cat app.log
pool size 5
pool exhausted`;

const noHandlerCode = String.raw`import logging

log = logging.getLogger("app")
log.setLevel(logging.DEBUG)

log.debug("cache miss for user 42")  # not printed
log.warning("disk 91% full")         # printed`;

const basicCode = String.raw`import logging

logging.basicConfig(
    level=logging.DEBUG,
    format="%(levelname)-8s %(name)s: %(message)s",
)

log = logging.getLogger("app")
log.debug("cache miss for user 42")`;

const basicRun = String.raw`$ python app.py
DEBUG    app: cache miss for user 42`;

const flagCode = String.raw`import argparse
import logging

parser = argparse.ArgumentParser()
parser.add_argument(
    "--log-level",
    default="WARNING",
    type=str.upper,
    choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
)
args = parser.parse_args()

logging.basicConfig(level=args.log_level, format="%(levelname)-8s %(name)s: %(message)s")
log = logging.getLogger("app")
log.debug("parsed %s", args)
log.info("starting")`;

const flagRun = String.raw`$ python app.py --log-level debug
DEBUG    app: parsed Namespace(log_level='DEBUG')
INFO     app: starting
$ python app.py --log-level loud
usage: app.py [-h] [--log-level {DEBUG,INFO,WARNING,ERROR,CRITICAL}]
app.py: error: argument --log-level: invalid choice: 'LOUD' (choose from DEBUG, INFO, WARNING, ERROR, CRITICAL)`;

const verboseCode = String.raw`parser.add_argument("-v", "--verbose", action="count", default=0)
args = parser.parse_args()

# no flag: WARNING, -v: INFO, -vv: DEBUG
logging.basicConfig(level=max(logging.DEBUG, logging.WARNING - 10 * args.verbose))`;

const envCode = String.raw`import logging
import os

logging.basicConfig(
    level=os.environ.get("LOG_LEVEL", "INFO").upper(),
    format="%(levelname)-8s %(name)s: %(message)s",
)
log = logging.getLogger("worker")
log.debug("polling queue")
log.info("job 7 done")`;

const envRun = String.raw`$ LOG_LEVEL=debug python worker.py
DEBUG    worker: polling queue
INFO     worker: job 7 done
$ python worker.py
INFO     worker: job 7 done
$ LOG_LEVEL=loud python worker.py
Traceback (most recent call last):
  ...
ValueError: Unknown level: 'LOUD'`;

const dictCode = String.raw`import logging
import logging.config
import os

logging.config.dictConfig({
    "version": 1,
    "disable_existing_loggers": False,
    "formatters": {
        "plain": {"format": "%(levelname)-8s %(name)s: %(message)s"},
    },
    "handlers": {
        "console": {"class": "logging.StreamHandler", "formatter": "plain"},
    },
    "root": {"level": os.environ.get("LOG_LEVEL", "INFO").upper(), "handlers": ["console"]},
    "loggers": {
        "app.payments": {"level": "DEBUG"},
        "urllib3": {"level": "WARNING"},
    },
})

logging.getLogger("app.payments").debug("charging card")
logging.getLogger("app.api").debug("GET /orders")
logging.getLogger("urllib3.connectionpool").info("new connection")`;

const dictRun = String.raw`$ python app.py
DEBUG    app.payments: charging card
$ LOG_LEVEL=debug python app.py
DEBUG    app.payments: charging card
DEBUG    app.api: GET /orders`;

const noisyCode = String.raw`for name in ("urllib3", "botocore", "httpx", "httpcore"):
    logging.getLogger(name).setLevel(logging.WARNING)`;

const runtimeCode = String.raw`import logging
import signal

logging.basicConfig(level=logging.INFO)
root = logging.getLogger()


def toggle_debug(signum, frame):
    root.setLevel(logging.INFO if root.level == logging.DEBUG else logging.DEBUG)
    root.warning("log level now %s", logging.getLevelName(root.level))


signal.signal(signal.SIGUSR1, toggle_debug)`;

const otelInstall = "pip install opentelemetry-instrumentation-logging";

const otelCode = String.raw`from opentelemetry.instrumentation.logging.handler import LoggingHandler

root = logging.getLogger()
root.setLevel(logging.DEBUG)

console = logging.StreamHandler()
console.setFormatter(logging.Formatter("%(levelname)-8s %(name)s: %(message)s"))
root.addHandler(console)

otel = LoggingHandler(logger_provider=logger_provider)
otel.setLevel(logging.INFO)
root.addHandler(otel)

logging.getLogger("urllib3").setLevel(logging.WARNING)`;

const setTabs = [
    { id: "log-level-flag", label: "--log-level flag", file: "app.py", src: flagCode, run: flagRun,
      note: `<code>type=str.upper</code> makes <code>--log-level debug</code> work, and <code>choices</code> rejects a typo before logging is set up. To let <code>LOG_LEVEL</code> provide the default, write <code>default=os.environ.get("LOG_LEVEL", "WARNING")</code>.` },
    { id: "log-level-env", label: "LOG_LEVEL variable", file: "worker.py", src: envCode, run: envRun,
      note: `<code>LOG_LEVEL</code> is a naming convention, not a variable Python reads. An unknown name raises at startup instead of running at the wrong level; to fall back to a default, look the name up in <code>logging.getLevelNamesMapping()</code> (Python 3.11+) first.` },
    { id: "log-level-dictconfig", label: "dictConfig", file: "app.py", src: dictCode, run: dictRun,
      note: `The console handler has no level, so the logger levels alone decide what prints. <code>"disable_existing_loggers": False</code> keeps loggers created before the call working. Django's <code>LOGGING</code> setting takes the same dictionary.` },
];

const mistakes = [
    ["Lower-case level names", "<code>setLevel(\"debug\")</code> and <code>basicConfig(level=\"debug\")</code> raise <code>ValueError: Unknown level: 'debug'</code>. Call <code>.upper()</code> on any name that comes from a user or a variable."],
    ["Configuring logging in a library", "A library that calls <code>basicConfig</code> or sets the root level overrides the application's choice. Libraries only call <code>logging.getLogger(__name__)</code>, and the application sets levels and handlers."],
    ["dictConfig's disable_existing_loggers", "It defaults to <code>True</code>, which disables every existing logger the config doesn't name, including <code>getLogger(__name__)</code> loggers in modules already imported. Their records disappear without an error. Set it to <code>False</code>."],
    ["Every line printed twice", "A logger with its own handler still propagates to the root's handlers, so both write the record. Set <code>propagate = False</code> on that logger, or attach handlers to the root only."],
    ["Formatting the message yourself", "<code>log.debug(f\"payload {data}\")</code> builds the string even when DEBUG is off. Write <code>log.debug(\"payload %s\", data)</code> so only records that pass are formatted, and wrap expensive work in <code>if log.isEnabledFor(logging.DEBUG):</code>."],
    ["Custom levels", "<code>logging.addLevelName(5, \"TRACE\")</code> works, but there is no <code>log.trace()</code> method, two libraries can give the same number different names, and OpenTelemetry exports levels below 10 with an unspecified severity. DEBUG on a dedicated logger such as <code>app.parser.trace</code> can be switched on alone."],
];

const faqs = [
    {
        question: "What are the Python logging levels?",
        answer:
            "Python's logging module has five levels: DEBUG (10), INFO (20), WARNING (30), ERROR (40) and CRITICAL (50). WARN and FATAL are aliases for WARNING and CRITICAL. NOTSET (0) is not a severity: it tells a logger to use its parent's level. A logger handles a record only when the record's level is at or above the logger's effective level.",
    },
    {
        question: "What is the default logging level in Python?",
        answer:
            "WARNING. The root logger starts at WARNING, and loggers created with logging.getLogger(name) start at NOTSET, so they inherit WARNING from the root until you set a level on them or on a parent. That is why info() and debug() print nothing in a fresh script.",
    },
    {
        question: "How do I set the logging level in Python?",
        answer:
            "Call logging.basicConfig(level=logging.DEBUG) once at startup, which sets the root logger's level and adds a console handler. To change the level later, or for a single logger, call setLevel on it: logging.getLogger(\"app.db\").setLevel(logging.DEBUG). Both accept the constant or its upper-case name.",
    },
    {
        question: "How do I set the Python log level from an environment variable?",
        answer:
            "Read the variable yourself and pass it on: logging.basicConfig(level=os.environ.get(\"LOG_LEVEL\", \"INFO\").upper()). Python does not read any log level variable on its own; LOG_LEVEL is a naming convention. An unknown name raises ValueError at startup.",
    },
    {
        question: "How do I set the Python logging level from the command line?",
        answer:
            "Add a --log-level option with argparse, using type=str.upper so lower-case input works and choices to reject typos, then pass args.log_level to logging.basicConfig(level=...). Command-line tools often use a repeatable -v flag instead, lowering the level by 10 for each -v.",
    },
    {
        question: "Why doesn't my Python debug log print?",
        answer:
            "Usually the root logger is still at its default WARNING; call logging.basicConfig(level=logging.DEBUG). If the logger is at DEBUG and still prints nothing, there is no handler, so Python falls back to logging.lastResort, whose level is WARNING. If basicConfig has no effect, the root logger already had a handler; use logging.getLogger().setLevel(logging.DEBUG) or basicConfig(force=True).",
    },
    {
        question: "What is the difference between logger level and handler level?",
        answer:
            "The logger level decides whether a record is created at all. Each handler's level then decides whether that handler writes it, so one logger can send DEBUG to a file and only WARNING to the terminal. When a record propagates to parent loggers, only their handlers' levels are checked, not the parents' own levels.",
    },
];

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Python logging levels",
    description: pageDescription,
    datePublished: published,
    dateModified: "2026-10-20",
    author: { "@type": "Person", name: author.name, url: authorUrl },
    publisher: {
        "@type": "Organization",
        name: "Maple",
