---
/**
 * GitHub · CI runs as traces. The tab carries the argument (a red streak with its
 * first failing commit); the failed run's trace below shows where it leads. The pull
 * request's review sheet is the page's hero, so it is not repeated here.
 */
import * as m from "../../../paraglide/messages.js";
import { APP_MAIN, GALLERY_SHOT_SIZE } from "../../../lib/page-registry";
import Shot from "../Shot.astro";
---

<section class="border-t border-border bg-bg">
	<div class="shell py-14 md:py-20">
		<div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-20">
			<div>
				<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{m.gh_ci_eyebrow()}</p>
				<h2
					class="mt-4 max-w-[16ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px]"
				>
					{m.gh_ci_title()}
				</h2>
			</div>
			<p class="max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-[15px]">{m.gh_ci_lede()}</p>
		</div>

		<div class="mt-10 grid gap-6 md:mt-12" data-lightbox-group>
			<Shot
				src="/screenshots/surface-ci.webp"
				alt="The Code Review CI tab: runs, success rate, run time and runner wait against the previous week, with the failing workflow and its last green commit"
				width={GALLERY_SHOT_SIZE.width}
				height={GALLERY_SHOT_SIZE.height}
				crop={APP_MAIN}
				route="/code-review/ci"
			/>
			<!-- The run's header and waterfall at full width: a wide window, not the whole screen. -->
			<Shot
				src="/screenshots/gallery-ci-trace.webp"
				alt="A failed CI run as a trace: runner waits, jobs and steps, with the failing test shard marked"
				width={GALLERY_SHOT_SIZE.width}
				height={GALLERY_SHOT_SIZE.height}
				crop={{ ...APP_MAIN, y: 0.092, aspect: 2.35 }}
				route="/traces/:id"
				title={m.gh_ci_trace_title()}
			/>
		</div>
	</div>
</section>
