---
/**
 * Agents: the MCP transcript, and the three things it proves.
 *
 * `IncidentStory`'s last step shows the MCP setup screen, not an agent working, which is the only
 * thing that makes the claim land. This section is that proof.
 *
 * The points deliberately are NOT a tool list. Every observability MCP server ships a long list
 * of tools, so a count proves nothing; what a competitor's list doesn't imply is that this one
 * reads your source, writes back, and needs no plugin. They are the one column of points beside
 * a frame on the page, because the transcript beside them is what demonstrates each one.
 *
 * The endpoint rides the transcript's status bar instead of sitting in a box of its own.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import * as m from "../../paraglide/messages.js";
import LiveMcpTranscript from "../live/LiveMcpTranscript.astro";
import LedgerHead from "./LedgerHead.astro";

const locale = Astro.currentLocale ?? "en";
const featurePath = getRelativeLocaleUrl(locale, "/features/ai-mcp-integration");

/** The live server. Clients differ on how you register it; they all take a URL. */
const MCP_ENDPOINT = "https://api.maple.dev/mcp";

const points = [
	{ title: m.mcp_point_1_title(), body: m.mcp_point_1_body() },
	{ title: m.mcp_point_2_title(), body: m.mcp_point_2_body() },
	{ title: m.mcp_point_3_title(), body: m.mcp_point_3_body() },
];
---

<section id="agents" class="ledger">
	<div class="shell">
		<LedgerHead title={m.mcp_title()} lede={m.mcp_lede()} href={featurePath} link={m.nav_ai_mcp()} />

		<div class="ledger-grid ledger-grid--agent">
			<dl class="ledger-cell ledger-points">
				{
					points.map((point) => (
						<div>
							<dt>{point.title}</dt>
							<dd>{point.body}</dd>
						</div>
					))
				}
			</dl>
			<div class="ledger-cell">
				<LiveMcpTranscript class="h-full" endpoint={MCP_ENDPOINT} />
			</div>
		</div>
	</div>
</section>
