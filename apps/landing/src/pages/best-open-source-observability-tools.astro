---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHero from "../components/page/PageHero.astro";
import ProductBand from "../components/marketing/ProductBand.astro";
import ProductFrame from "../components/marketing/ProductFrame.astro";
import FAQ from "../components/FAQ.astro";
import BottomCTA from "../components/BottomCTA.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import {
    bestObservabilityTools,
    listicleFaqs,
    methodology,
    lastUpdated,
} from "../lib/best-observability-tools";

const pageTitle = "Best Open-Source Observability Tools in 2026";
const pageDescription =
    "Seven observability tools you can self-host, compared by the Maple team: Maple, Grafana LGTM, SigNoz, HyperDX, OpenObserve, Uptrace and Jaeger. Licenses, pros and cons.";

// The entries sit two to a row from lg, which halves the longest run of text on the page. Maple's
// carries product frames and takes a full row; so does the last entry when it would sit alone.
const others = bestObservabilityTools.filter((tool) => tool.slug !== "maple");
const fullRow = new Set(["maple", ...(others.length % 2 === 1 ? others.slice(-1).map((tool) => tool.slug) : [])]);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://maple.dev";
const pageUrl = `${siteUrl}/best-open-source-observability-tools`;

// Format-native schema only (ItemList for the listicle, FAQPage via FAQ.astro).
// We deliberately don't pile on speculative markup: Ahrefs found schema had
// near-zero impact on AI citations.
const itemListJsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: pageTitle,
    description: pageDescription,
    url: pageUrl,
    numberOfItems: bestObservabilityTools.length,
    itemListElement: bestObservabilityTools.map((tool) => ({
        "@type": "ListItem",
        position: tool.rank,
        name: tool.name,
        url: tool.url,
    })),
};
---

<Layout title={pageTitle} description={pageDescription} ogType="article" alternates={["en"]}>
    <SeoHead title={pageTitle} description={pageDescription} type="WebPage" />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

    <Nav />
    <PageHero
        title="Best open-source observability tools in 2026"
        lede="OpenTelemetry-native traces, logs, and metrics you can self-host, ranked, with pros, cons, licenses, and what each tool is best for."
        breadcrumb={[{ label: "Home", href: "/" }, { label: "Best open-source observability tools" }]}
    >
        <ProductFrame slot="aside" surface="trace" caption="Maple, the first entry below: a trace on its waterfall view." />
    </PageHero>

    <!-- Intro + methodology + last updated -->
    <section class="py-12 md:py-16">
        <div class="shell">
            <p class="max-w-3xl text-sm md:text-base text-fg-muted leading-relaxed">{methodology}</p>
            <p class="mt-6 text-[11px] text-fg-muted uppercase tracking-wider">Last updated: {lastUpdated}</p>
        </div>
    </section>

    <!-- Quick picks summary -->
    <section class="pb-8">
        <div class="shell">
            <div class="border border-border">
                <div class="border-b border-border px-5 py-3 text-[11px] uppercase tracking-wider text-primary">
                    At a glance
                </div>
                <ul class="divide-y divide-border">
                    {bestObservabilityTools.map((tool) => (
                        <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 px-5 py-3">
                            <a
                                href={`#${tool.slug}`}
                                class="shrink-0 sm:w-64 text-sm font-medium text-fg hover:text-primary transition-colors"
                            >
                                {tool.rank}. {tool.name}
                            </a>
                            <span class="text-sm text-fg-muted">{tool.bestFor}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <!-- Ranked entries -->
    <section class="pb-16 md:pb-24">
        <div class="shell">
            <div class="grid grid-cols-1 gap-px bg-border border border-border lg:grid-cols-2">
                {bestObservabilityTools.map((tool) => (
                    <article id={tool.slug} class:list={["bg-bg p-6 md:p-8 scroll-mt-24", fullRow.has(tool.slug) && "lg:col-span-2"]}>
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="flex items-center gap-3">
                                    <span class="inline-flex h-7 w-7 items-center justify-center border border-border text-xs font-bold text-primary">
                                        {tool.rank}
                                    </span>
                                    <h2 class="text-xl md:text-2xl font-bold text-fg">{tool.name}</h2>
                                </div>
                                <p class="mt-2 text-sm text-primary">Best for: {tool.bestFor}</p>
                            </div>
                            <span class="shrink-0 text-[11px] text-fg-muted border border-border px-2 py-1">{tool.license}</span>
                        </div>

                        <p class="mt-4 max-w-3xl text-sm md:text-base text-fg-muted leading-relaxed">{tool.summary}</p>

                        <div class="mt-6 grid gap-6 sm:grid-cols-2">
                            <div>
                                <h3 class="text-[11px] uppercase tracking-wider text-fg-muted mb-2">Strengths</h3>
                                <ul class="space-y-1.5">
                                    {tool.pros.map((p) => (
                                        <li class="flex gap-2 text-sm text-fg-muted">
                                            <span class="text-primary">+</span><span>{p}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-[11px] uppercase tracking-wider text-fg-muted mb-2">Trade-offs</h3>
                                <ul class="space-y-1.5">
                                    {tool.cons.map((c) => (
                                        <li class="flex gap-2 text-sm text-fg-muted">
                                            <span class="text-fg-muted">–</span><span>{c}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>

                        {tool.slug === "maple" && (
                            <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2">
                                <ProductFrame surface="logs" height="min(31rem, 100vw)" caption="The log stream in Maple." />
                                <ProductFrame surface="agent" caption="An agent session over Maple's MCP server." />
                            </div>
                        )}

                        <div class="mt-6 flex flex-wrap items-center gap-4 text-xs">
                            <a
                                href={tool.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-fg hover:text-primary transition-colors"
                            >
                                Visit {tool.name} ↗
                            </a>
                            {tool.comparePath && (
                                <a href={tool.comparePath} class="text-fg-muted hover:text-primary transition-colors">
                                    Maple vs {tool.name.split(" ")[0]}
                                </a>
                            )}
                            {tool.alternativesPath && (
                                <a href={tool.alternativesPath} class="text-fg-muted hover:text-primary transition-colors">
                                    {tool.name.split(" ")[0]} alternatives
                                </a>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <ProductBand
        class="border-t border-border"
        eyebrow="Maple"
        title="A service map drawn from the spans"
        lede="Every service, queue and database, with throughput, error rate and latency on each edge. There is no topology file to maintain."
        surface="service-map"
        link={{ href: "/features/service-catalog", label: "See the service catalog" }}
    />

    <!-- How to choose / cross-links -->
    <section class="py-16 md:py-24">
        <div class="shell">
            <div class="border border-border p-6 md:p-8 max-w-3xl">
                <h2 class="text-xl md:text-2xl font-bold text-fg">How to choose</h2>
                <p class="mt-3 text-sm md:text-base text-fg-muted leading-relaxed">
                    Start with how your team already works. If you've standardized on OpenTelemetry, an OTel-native
                    platform avoids re-instrumentation later. New to the category? Read
                    <a href="/observability" class="text-primary hover:underline">what observability is</a> and
                    <a href="/opentelemetry" class="text-primary hover:underline">why OpenTelemetry matters</a> first,
                    then come back to this list.
                </p>
            </div>
        </div>
    </section>

    <FAQ items={listicleFaqs} shell />
    <BottomCTA />
    <Footer />
</Layout>
