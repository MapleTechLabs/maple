---
/**
 * /integrations/<runtime> in every locale: Next.js, Node.js and Python. The nine route files only
 * claim their path, so the three locales cannot drift apart again.
 *
 * The hero carries the real waterfall. It replaces a hand-drawn "trace preview" lower on the
 * page, whose bars and durations were made up.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { integrations } from "../../lib/integrations";
import Layout from "../../layouts/Layout.astro";
import * as m from "../../paraglide/messages.js";
import BottomCTA from "../BottomCTA.astro";
import FeatureDetailGrid from "../FeatureDetailGrid.astro";
import Footer from "../Footer.astro";
import Nav from "../Nav.astro";
import QuickStartCode from "../QuickStartCode.astro";
import SeoHead from "../SeoHead.astro";
import CrossLinks from "../page/CrossLinks.astro";
import PageHero from "../page/PageHero.astro";
import ProductFrame from "./ProductFrame.astro";

type Runtime = "nextjs" | "nodejs" | "python";

interface Props {
	runtime: Runtime;
}

const { runtime } = Astro.props;
const integration = integrations[runtime];
if (!integration) throw new Error(`IntegrationPage: unknown runtime "${runtime}"`);

// Only Next.js has message keys. Node.js and Python are English in every locale, as before.
const COPY = {
	nextjs: {
		title: m.page_nextjs_title,
		description: m.page_nextjs_desc,
		heading: m.page_nextjs_heading,
		lede: m.page_nextjs_subtitle,
		eyebrow: m.page_nextjs_what_you_get,
		gridTitle: m.page_nextjs_auto_heading,
		traceHeading: m.page_nextjs_trace_heading,
	},
	nodejs: {
		title: () => "Node.js Observability with OpenTelemetry | Maple",
		description: () =>
			"Add distributed tracing to any Node.js application with the OpenTelemetry SDK. Auto-instrumentation captures Express, Fastify, database queries, and HTTP calls with no code changes.",
		heading: () => "Node.js observability with OpenTelemetry",
		lede: () =>
			"Add distributed tracing to any Node.js application with the OpenTelemetry SDK. Auto-instrumentation captures Express, Fastify, database queries, and HTTP calls with no code changes.",
		eyebrow: () => "What you get",
		gridTitle: () => "Automatic instrumentation for Node.js",
		traceHeading: () => "See your Node.js traces",
	},
	python: {
		title: () => "Python Observability with OpenTelemetry | Maple",
		description: () =>
			"Instrument a Python application with OpenTelemetry auto-instrumentation and send traces to Maple. Flask, FastAPI, Django, SQLAlchemy, requests and dozens of other libraries are covered without code changes.",
		heading: () => "Python observability with OpenTelemetry",
		lede: () =>
			"Install the OpenTelemetry distro, bootstrap the instrumentations for the libraries you already use, and run your app under opentelemetry-instrument. Flask, FastAPI, Django, SQLAlchemy, requests and dozens of other libraries are traced without code changes.",
		eyebrow: () => "What you get",
		gridTitle: () => "Automatic instrumentation for Python",
		traceHeading: () => "See your Python traces",
	},
} satisfies Record<Runtime, Record<string, () => string>>;

const OTHERS = [
	{ runtime: "nextjs", name: "Next.js", desc: m.intg_other_nextjs_desc() },
	{ runtime: "python", name: "Python", desc: m.intg_other_python_desc() },
	{ runtime: "nodejs", name: "Node.js", desc: m.intg_other_nodejs_desc() },
];

const copy = COPY[runtime];
const pageTitle = copy.title();
const pageDescription = copy.description();

const howToJsonLd = {
	"@context": "https://schema.org",
	"@type": "HowTo",
	name: `How to add OpenTelemetry observability to ${integration.name}`,
	description: pageDescription,
	step: integration.steps.map((step, index) => ({
		"@type": "HowToStep",
		position: index + 1,
		name: step.title,
		text: step.code,
	})),
};

const locale = Astro.currentLocale ?? "en";
const crossLinks = [
	...OTHERS.filter((other) => other.runtime !== runtime).map((other) => ({
		href: getRelativeLocaleUrl(locale, `integrations/${other.runtime}`),
		name: other.name,
		desc: other.desc,
	})),
	{ href: getRelativeLocaleUrl(locale, "integrations"), name: m.breadcrumb_integrations(), desc: m.intg_title() },
];
---

<Layout title={pageTitle} description={pageDescription} ogType="article">
	<SeoHead title={pageTitle} description={pageDescription} />
	<Nav />

	<PageHero
		title={copy.heading()}
		lede={copy.lede()}
		breadcrumb={[
			{ label: m.breadcrumb_home(), href: "/" },
			{ label: m.breadcrumb_integrations(), href: "/integrations" },
			{ label: integration.name },
		]}
	>
		{/* The heading names the runtime; the frame is the trace view every runtime's spans land in. */}
		<div slot="aside" class="min-w-0">
			<ProductFrame surface="trace" />
			<h2 class="mt-3 text-sm font-medium text-fg">{copy.traceHeading()}</h2>
		</div>
	</PageHero>

	<div class="border-t border-border">
		<QuickStartCode steps={integration.steps} />
	</div>

	<section class="border-t border-border bg-bg">
		<div class="shell py-16 md:py-24">
			<p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{copy.eyebrow()}</p>
			<h2 class="mt-4 max-w-[24ch] font-display text-2xl font-medium leading-[1.08] tracking-[-0.02em] text-fg md:text-3xl">
				{copy.gridTitle()}
			</h2>
			<div class="mt-10">
				<FeatureDetailGrid items={integration.signals.map((s) => ({ title: s.title, description: s.description }))} />
			</div>
		</div>
	</section>

	<CrossLinks eyebrow={m.breadcrumb_integrations()} title={m.intg_others_title()} links={crossLinks} />

	<BottomCTA />
	<Footer />
	<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
</Layout>
