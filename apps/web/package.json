{
	"name": "@maple/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port ${PORT:-3471} --host ${HOST:-127.0.0.1}",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run --passWithNoTests",
		"test:perf": "playwright test",
		"test:perf:bundle": "bun run build && bun run check:bundle",
		"check:bundle": "bun perf/check-bundle-budget.ts",
		"test:perf:logs": "playwright test perf/logs.perf.spec.ts --project=chromium-performance",
		"test:perf:cross-browser": "playwright test perf/cross-browser.perf.spec.ts",
		"test:perf:service-detail": "playwright test perf/service-detail.perf.spec.ts",
		"test:perf:infra": "playwright test perf/infra.perf.spec.ts --project=chromium-performance",
		"test:perf:tanstack": "playwright test perf/tanstack.perf.spec.ts --project=chromium-performance",
		"test:perf:charts": "playwright test perf/charts-lab.perf.spec.ts --project=chromium-performance",
		"test:perf:renders": "playwright test --grep \"React render work\"",
		"test:perf:compare-renders": "bun perf/compare-react-render-reports.ts",
		"typecheck": "tsc --noEmit",
		"og:fonts": "bun scripts/build-og-fonts.ts"
	},
