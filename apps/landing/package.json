{
	"name": "@maple/landing",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate:og": "node scripts/generate-og.mjs",
		"screenshots": "bun scripts/screenshots/capture.ts",
		"screenshots:thread": "bun scripts/screenshots/capture.ts --set thread",
		"dev": "bun run --silent sync:cli && exec env -u CLAUDECODE astro dev --port ${PORT:-3391} --host ${HOST:-127.0.0.1}",
		"sync:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && astro sync",
		"sync:cli": "mkdir -p public/cli && cp ../../scripts/install.sh public/cli/install && cp ../../scripts/uninstall.sh public/cli/uninstall",
		"test": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale && vitest run",
		"build": "bun run sync:cli && astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:alchemy",
		"@astrojs/markdown-remark": "^7.3.5",
		"@astrojs/markdown-satteri": "^0.4.6",
		"@astrojs/mdx": "^8.1.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@maple-dev/browser": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/infra": "workspace:*",
		"@maple/ui": "workspace:*",
		"@maple/views": "workspace:*",
		"@shikijs/themes": "^4.6.0",
		"@shikijs/transformers": "^4.6.0",
		"@tailwindcss/vite": "catalog:tailwind",
		"@takumi-rs/helpers": "2.19.0",
		"@takumi-rs/wasm": "2.19.0",
		"astro": "^7.4.5",
		"autumn-js": "^1.5.41",
		"effect": "catalog:effect",
		"foldkit": "0.170.0",
		"fuse.js": "^7.5.0",
		"tailwindcss": "catalog:tailwind",
		"tw-animate-css": "catalog:tailwind"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@foldkit/vite-plugin": "0.29.0",
		"@inlang/paraglide-js": "^2.29.3",
		"happy-dom": "^21.0.4",
		"playwright": "catalog:",
		"typescript": "catalog:tooling",
		"vitest": "catalog:",
		"woff2-encoder": "^2.0.0"
	}
}
