---
/**
 * The offer.
 *
 * Not a plan grid. `apps/api/autumn.config.ts` sells exactly one self-serve
 * plan, so a card-per-tier layout manufactured a choice that doesn't exist and
 * spent two 881px columns restating the same feature list. This is one priced
 * offer: an amber claim plate on the left, the meter that backs it on the right.
 *
 * On /pricing it steps in to max-w-5xl; on the home page it runs the width of
 * the sheet under the shared head, with the vendor bill as the beat after it.
 * It spends one accent: the button is the only solid amber on the surface.
 *
 * Enterprise is a one-line rail below the card, not a peer: a "call us" card
 * given equal weight costs self-serve conversion.
 */
import * as m from "../paraglide/messages.js";
import { APP_SIGN_UP_URL } from "../lib/app-urls";
import PixelIcon from "./icons/PixelIcon.astro";
import { DPA_REQUEST_URL } from "../lib/compliance";
import RegionChip from "./RegionChip.astro";
import LedgerHead from "./home/LedgerHead.astro";
import {
    getOffer,
    isUsageCredit,
    money,
    platformFeatures,
    rateBlock,
    rateLabel,
    volume,
    type Allotment,
} from "../lib/pricing-offer";

// The offer, the meter and the formatters live in `lib/pricing-offer.ts` so
// `/pricing.md`: the agent-readable twin of this page: renders the same
// numbers from the same Autumn call. Everything below is layout.
const offer = await getOffer()
const PLATFORM_FEATURES = platformFeatures()

// The meter is a table: one head row names the columns, so each cell carries a value only
// ("$0.15 / GB", "30 days") instead of a sentence ("then $0.15 / GB"). Amounts are bright and
// start flush under their head; units are muted.
/** A charge as an amount and its unit, or a note for a row billed some other way. */
type Charge = { amount: string; unit: string } | { note: string }

const unitOf = (a: Allotment) =>
    a.unit === "gb" ? "GB" : a.unit === "sessions" ? "session" : `${rateBlock(a)} events`

const thenCharge = (a: Allotment): Charge | undefined =>
    a.unlimited
        ? { note: m.pricing_free_beta() }
        : isUsageCredit(a)
          ? { note: m.pricing_ai_billed() }
          : a.rate === undefined
            ? undefined
            : { amount: rateLabel(a.rate), unit: unitOf(a) }

/** Everything a meter row renders, resolved once. */
const meterRows = offer.allotments.map((a) => {
    const then = thenCharge(a)
    const storage: Charge | undefined =
        a.retention?.rate === undefined ? undefined : { amount: rateLabel(a.retention.rate), unit: "GB-month" }
    return {
        featureId: a.featureId,
        label: a.label,
        included: volume(a, a.included),
        kept: a.retention === undefined ? undefined : m.pricing_days({ days: String(a.retention.days) }),
        then,
        storage,
        // Below md the columns fold into a label/value list under the row, as on the rates strip.
        folded: [
            ...(a.retention === undefined
                ? []
                : [{ label: m.pricing_col_kept(), value: m.pricing_days({ days: String(a.retention.days) }) }]),
            ...(then === undefined
                ? []
                : [{ label: m.pricing_col_then(), value: "note" in then ? then.note : `${then.amount} / ${then.unit}` }]),
            ...(storage === undefined || "note" in storage
                ? []
                : [{ label: m.pricing_col_storage(), value: `${storage.amount} / ${storage.unit}` }]),
        ],
    }
})

// One template for every row and the head: fixed value columns, so separate rows line up.
const METER_COLUMNS = "md:grid-cols-[minmax(0,1fr)_4.5rem_4.5rem_10rem_9.5rem]"

// ── Layout ───────────────────────────────────────────────────────────────────
// `variant` is explicit rather than inferred from whether copy props are set:
// /pricing renders this with no props at all, and inferring the container from
// copy presence silently handed that page a different width.
interface Props {
    variant?: "page" | "home"
    title?: string
    eyebrow?: string
    lede?: string
    class?: string
}

const { variant = "page", title, eyebrow, lede, class: className = "" } = Astro.props
const containerClass = variant === "home" ? "shell" : "mx-auto max-w-5xl px-6"
---

<section class={variant === "home" ? `ledger ${className}` : `py-16 md:py-32 ${className}`}>
    <div class={containerClass}>
        {variant === "home" && title ? (
            <LedgerHead title={title} lede={lede} />
        ) : (
            (eyebrow || title || lede) && (
                <div class="mb-10 md:mb-14">
                    {eyebrow && (
                        <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">{eyebrow}</p>
                    )}
                    {title && (
                        <h2 class="mt-4 max-w-[20ch] font-display text-3xl font-medium leading-[1.05] tracking-[-0.02em] text-fg md:text-[40px]">
                            {title}
                        </h2>
                    )}
                    {lede && <p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-[15px]">{lede}</p>}
                </div>
            )
        )}

        {/* The home page runs the offer the width of the sheet, like every frame on it. */}
        <div class={variant === "home" ? "" : "mx-auto max-w-5xl"}>
            {/* gap-px over bg-border draws the rule between rails: the table-rule
                vocabulary of the section above, without building a table. */}
            <div class="offer-grid grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-[minmax(0,340px)_1fr]">
                {/* The claim. */}
                <div class="bg-primary/[0.06] p-6 md:p-8">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-[11px] uppercase tracking-widest text-fg-muted">{offer.name}</span>
                        {offer.hasTrial && offer.trialDuration && (
                            <span class="inline-flex items-center rounded-full bg-primary/15 px-2 py-0.5 text-[10px] font-medium text-primary">
                                {m.pricing_trial_badge({ duration: String(offer.trialDuration) })}
                            </span>
                        )}
                    </div>

                    <div class="mt-5 flex items-baseline gap-1.5">
                        <span class="font-mono text-[44px] font-medium leading-none tracking-[-0.03em] tabular-nums text-fg md:text-[56px]">
                            {money(offer.price)}
                        </span>
                        {offer.interval && (
                            <span class="font-mono text-base font-normal text-fg-muted">{offer.interval}</span>
                        )}
                    </div>
                    <p class="mt-3 text-[13px] leading-relaxed text-fg-muted">{m.pricing_everything_included()}</p>

                    {/* The three numbers the table above just spent eight rows earning. */}
                    <div class="mt-6 grid grid-cols-3 gap-3">
                        {[m.pricing_zero_host(), m.pricing_zero_seat(), m.pricing_zero_query()].map((label) => (
                            <div>
                                <div class="font-mono text-xl tabular-nums text-fg">$0</div>
                                <div class="mt-1 text-[10px] uppercase tracking-widest text-fg-muted">{label}</div>
                            </div>
                        ))}
                    </div>

                    <a
                        href={APP_SIGN_UP_URL}
                        data-track="pricing_plan_selected"
                        data-track-plan={offer.name}
                        data-track-label={offer.ctaLabel}
                        data-track-destination={APP_SIGN_UP_URL}
                        data-track-location="pricing_offer_card"
                        class="mt-8 flex h-11 w-full items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
                    >
                        {offer.ctaLabel}
                    </a>
                    {offer.hasTrial && offer.trialDuration && (
                        <p class="mt-3 text-pretty text-[11px] leading-relaxed text-fg-muted">
                            {m.pricing_trial_reassure({ duration: String(offer.trialDuration) })}
                        </p>
                    )}
                    {/* The home page gets one line; /pricing gets the region band below. */}
                    {variant === "home" && (
                        <p class="mt-2 text-pretty text-[11px] leading-relaxed text-fg-muted">
                            {m.pricing_regions_note()}{" "}
                            <a href="/eu" class="text-fg underline underline-offset-2 transition-colors hover:text-primary">{m.pricing_regions_link()}</a>
                        </p>
                    )}
                </div>

                {/* The meter that backs it. */}
                <div class="bg-bg-elevated p-6 md:p-8">
                    <span class="text-[10px] uppercase tracking-[0.18em] text-fg-muted">
                        {m.pricing_included_monthly()}
                    </span>

                    {/* Head row, md and up: it names the columns, so the cells below hold values only. */}
                    <div class={`mt-5 hidden border-b border-border/60 pb-2.5 text-[10px] uppercase tracking-[0.16em] text-fg-muted md:grid ${METER_COLUMNS}`}>
                        <span></span>
                        <span class="text-right">{m.pricing_col_included()}</span>
                        <span class="text-right">{m.pricing_col_kept()}</span>
                        <span class="pl-8">{m.pricing_col_then()}</span>
                        <span class="pl-4">{m.pricing_col_storage()}</span>
                    </div>
                    <div class="mt-4 md:mt-0">
                        {meterRows.map((a) => (
                            <div class={`grid grid-cols-[minmax(0,1fr)_auto] items-center gap-y-1 border-b border-border/60 py-3 last:border-b-0 ${METER_COLUMNS}`}>
                                <div class="flex min-w-0 items-center gap-2.5">
                                    {a.featureId === "logs" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M8 18H16"/><path d="M8 14L11 14"/><path d="M12 4V10H8"/><path d="M4 20L4 10"/><path d="M20 20L20 4"/><path d="M12 2L18 2"/><path d="M6 22L18 22"/><path d="M6 8H6.01"/><path d="M8 6H8.01"/><path d="M10 4H10.01"/></svg>
                                    )}
                                    {a.featureId === "traces" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M6 18.01L6 18"/><path d="M18 7.01001L18 7.00001"/><path d="M8 20.01L8 20"/><path d="M2 16L4 16"/><path d="M14 9L16 9"/><path d="M20 5L22 5"/><path d="M10 16L10 18"/><path d="M12 11L12 14"/></svg>
                                    )}
                                    {a.featureId === "metrics" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M2 15.01V15"/><path d="M4 13.01V13"/><path d="M6 11.01V11"/><path d="M8 9.01V9"/><path d="M10 11.01V11"/><path d="M12 13.01V13"/><path d="M14 15.01V15"/><path d="M16 13.01V13"/><path d="M18 11.01V11"/><path d="M20 9.01V9"/><path d="M22 7.01V7"/></svg>
                                    )}
                                    {a.featureId === "browser_sessions" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 6L4 6.01"/><path d="M6 4L6 4.01"/><path d="M20.01 6L20 6"/><path d="M18.01 4L18 4"/><path d="M20.01 18L20 18"/><path d="M18.01 20L18 20"/><path d="M6.01001 20L6.00001 20"/><path d="M4.01001 18L4.00001 18"/><path d="M2 8L2 16"/><path d="M22 14L22 16"/><path d="M8 2L16 2"/><path d="M8 22L16 22"/><path d="M22 8V4"/><path d="M17 12.01V12"/><path d="M14 10H15"/><path d="M14 14H15"/><path d="M12 8H9L9 16L12 16"/></svg>
                                    )}
                                    {a.featureId === "product_events" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M21 11H3"/><path d="M15 19L15 15L19 15"/><path d="M21.01 21H21"/><path d="M23.01 23H23"/><path d="M21 17H23V19"/><path d="M17 21V23H19"/><path d="M9 2L15 2"/><path d="M9 20L11 20"/><path d="M3 14V8"/><path d="M21 11V8"/><path d="M7.01 4L7 4"/><path d="M7.01 18L7 18"/><path d="M17.01 4L17 4"/><path d="M19.01 6L19 6"/><path d="M5.01 6L5 6"/><path d="M10.01 6L10 6"/><path d="M14.01 6L14 6"/><path d="M10.01 16L10 16"/><path d="M12.01 4L12 4"/><path d="M5.01 16L5 16"/><path d="M8 8V14"/><path d="M16 8V10"/></svg>
                                    )}
                                    {a.featureId === "ai_credits" && (
                                        <svg class="h-4 w-4 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M17 7V7.01"/><path d="M13 7V7.01"/><path d="M13 11V11.01"/><path d="M17 11V11.01"/><path d="M15 13V17"/><path d="M15 1V5"/><path d="M11.005 8.995L9.005 8.995"/><path d="M21.005 8.995L19.005 8.995"/><path d="M9.01001 17L9.00001 17"/><path d="M3.01001 6L3.00001 6"/><path d="M5.01001 17L5.00001 17"/><path d="M7 13L7 15"/><path d="M7 19L7 21"/></svg>
                                    )}
                                    <span class="text-[12.5px] text-fg">{a.label}</span>
                                </div>
                                <div class="whitespace-nowrap text-right font-mono text-[12.5px] tabular-nums text-fg">{a.included}</div>
                                <div class="hidden whitespace-nowrap text-right font-mono text-[12px] tabular-nums text-fg-muted md:block">{a.kept}</div>
                                {a.then !== undefined && "note" in a.then ? (
                                    <div class="hidden pl-8 text-[12px] leading-snug text-fg-muted md:col-span-2 md:block">{a.then.note}</div>
                                ) : (
                                    <>
                                        <div class="hidden whitespace-nowrap pl-8 font-mono text-[12px] tabular-nums md:block">
                                            {a.then !== undefined && (
                                                <>
                                                    <span class="text-fg">{a.then.amount}</span>
                                                    <span class="text-fg-muted"> / {a.then.unit}</span>
                                                </>
                                            )}
                                        </div>
                                        <div class="hidden whitespace-nowrap pl-4 font-mono text-[12px] tabular-nums md:block">
                                            {a.storage !== undefined && !("note" in a.storage) && (
                                                <>
                                                    <span class="text-fg">{a.storage.amount}</span>
                                                    <span class="text-fg-muted"> / {a.storage.unit}</span>
                                                </>
                                            )}
                                        </div>
                                    </>
                                )}
                                <dl class="col-span-2 mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5 text-[11.5px] md:hidden">
                                    {a.folded.map((d) => (
                                        <>
                                            <dt class="text-fg-muted">{d.label}</dt>
                                            <dd class="font-mono tabular-nums text-fg">{d.value}</dd>
                                        </>
                                    ))}
                                </dl>
                            </div>
                        ))}
                    </div>

                    {/* Everything the plan carries, as one run rather than a checklist , 
                        a checklist implies some rows might have been withheld. It sits
                        with the allotments because both answer "what do I get". */}
                    <p class="mt-6 border-t border-border/60 pt-5 text-[12px] leading-relaxed text-fg-muted">
                        {PLATFORM_FEATURES.join(" · ")}
                    </p>

                    {/* The one honest answer to "what will I actually pay?": the real
                        calculator, not a canned example. */}
                    <a
                        href="/pricing#calculator"
                        class="mt-5 inline-block text-[12.5px] text-primary transition-colors hover:text-fg"
                    >
                        {m.pricing_estimate_link()}
                    </a>
                </div>
            </div>

            {/* Where the data lives, stated at the point of purchase. /eu is
                English-only, like /about: bare href, not a localized path. */}
            {/* Wrapped so the page stylesheet's offer-card rule
                (`.pricing-offer > div > div > .grid`) does not reach this grid. */}
            {variant === "page" && (
                <div class="mt-4"><div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border md:grid-cols-2 lg:grid-cols-4">
                    <div class="bg-bg-elevated px-6 py-5">
                        <span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-fg-muted"><PixelIcon name="location" class="size-3.5" />{m.pricing_region_eyebrow()}</span>
                        <p class="mt-3 flex items-center gap-2 text-sm font-medium text-fg">
                            <RegionChip region="us" />{m.pricing_region_us_name()}
                        </p>
                        <p class="mt-1 text-[12.5px] leading-relaxed text-fg-muted">{m.pricing_region_us_detail()}</p>
                    </div>
                    <div class="bg-bg-elevated px-6 py-5">
                        <span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-fg-muted"><PixelIcon name="location" class="size-3.5" />{m.pricing_region_eyebrow()}</span>
                        <p class="mt-3 flex items-center gap-2 text-sm font-medium text-fg">
                            <RegionChip region="eu" />{m.pricing_region_eu_name()}
                        </p>
                        <p class="mt-1 text-[12.5px] leading-relaxed text-fg-muted">{m.pricing_region_eu_detail()}</p>
                    </div>
                    <div class="flex flex-col bg-bg-elevated px-6 py-5">
                        <p class="flex items-center gap-2 text-sm font-medium text-fg">
                            <PixelIcon name="tag" class="size-4 text-primary" />{m.pricing_region_same()}
                        </p>
                        <p class="mt-1 text-[12.5px] leading-relaxed text-fg-muted">{m.pricing_region_same_body()}</p>
                        <a href="/eu" class="mt-3 text-[12.5px] text-primary transition-colors hover:text-fg">
                            {m.pricing_region_link()} →
                        </a>
                    </div>
                    {/* Sits with the region: both answer "can my company buy this".
                        The DPA and audit log are stated as held; the audits stay in the body. */}
                    <div class="flex flex-col bg-bg-elevated px-6 py-5">
                        <span class="flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-fg-muted"><PixelIcon name="lock" class="size-3.5" />{m.compliance_title()}</span>
                        <p class="mt-3 text-sm font-medium text-fg">{m.compliance_dpa_held()}</p>
                        <p class="text-sm font-medium text-fg">{m.compliance_audit_log_held()}</p>
                        <p class="mt-1 text-[12.5px] leading-relaxed text-fg-muted">{m.compliance_audits()}</p>
                        <a href={DPA_REQUEST_URL} class="mt-3 text-[12.5px] text-primary transition-colors hover:text-fg">
                            {m.compliance_dpa_link()} →
                        </a>
                    </div>
                </div></div>
            )}

            {/* Enterprise carries the amber accent too, so it can't be skimmed past , 
                but as border and text, never a filled button. The offer above owns the
                only solid amber block on the surface, which is what keeps the trial the
                primary action while this still reads as a real second door. */}
            <div class="mt-4 flex flex-col gap-5 rounded-xl border border-primary/25 bg-primary/[0.04] px-6 py-5 sm:flex-row sm:items-center sm:justify-between md:px-8">
                <div>
                    <span class="text-[11px] uppercase tracking-widest text-primary">
                        {m.pricing_enterprise()}
                    </span>
                    <p class="mt-2 max-w-[48ch] text-[13px] leading-relaxed text-fg">
                        {m.pricing_enterprise_rail()}
                    </p>
                </div>
                <div class="flex shrink-0 items-center justify-between gap-5 sm:justify-end">
                    <a
                        href="https://cal.com/david-granzin/30min?overlayCalendar=true"
                        class="inline-flex h-10 shrink-0 items-center justify-center rounded-lg border border-primary/40 bg-primary/10 px-4 text-[13px] font-medium text-primary transition-colors hover:bg-primary/20"
                    >
                        {m.pricing_talk_to_founder()} →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
