---
// Docs / group, plus the parent row for nested pages (Effect / Server, Deploy /
// Render). The H1 right below names the page, so the trail stops above it.
// The group links to its overview page when it opens with one.
import { getNavTree, locate } from "../../lib/docs-order";

interface Props {
    slug: string;
    group: string;
}

const { slug, group: ownGroup } = Astro.props;
const tree = await getNavTree();
const here = locate(tree, slug);
const group = here?.group ?? ownGroup;
const first = tree.find((g) => g.group === group)?.rows[0]?.doc;
const groupHref = first && first.id !== slug && first.data.navLabel === "Overview" ? `/docs/${first.id}` : null;
const parent = here?.parent ?? null;

const linkClass = "whitespace-nowrap transition-colors hover:text-fg";
---

<nav aria-label="Breadcrumb" class="mb-5 flex min-w-0 flex-wrap items-center gap-x-1.5 gap-y-1 text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">
    <a href="/docs" class={linkClass}>Docs</a>
    <span class="text-border" aria-hidden="true">/</span>
    {groupHref ? <a href={groupHref} class={linkClass}>{group}</a> : <span class="whitespace-nowrap">{group}</span>}
    {parent && (
        <>
            <span class="text-border" aria-hidden="true">/</span>
            <a href={`/docs/${parent.id}`} class={linkClass}>{parent.data.navLabel ?? parent.data.title}</a>
        </>
    )}
</nav>
