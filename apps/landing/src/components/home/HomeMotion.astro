---
/**
 * The sheet's two entrances, each played once: section headlines rise a line at a time, and the
 * captures resolve out of coarse blocks. Both skip anything already on screen at load and all of
 * it under reduced motion, and without this script the page is simply drawn. Styles are in
 * home-ledger.css.
 */
---

<script>
	const HEADLINES = ".ledger-head h2, [data-scrollstory] > .shell:first-child h2";
	const CAPTURES = ".ledger .shot-crop, .ledger .media-crop";
	const CELL = 14;
	const RESOLVE_MS = 620;

	const belowFold = (el: Element) => el.getBoundingClientRect().top >= innerHeight;

	/** The headline's text as the browser wrapped it, one string per line. */
	const wrappedLines = (node: Text): Array<string> => {
		const segmenter = new Intl.Segmenter(document.documentElement.lang || "en", { granularity: "word" });
		const range = document.createRange();
		const lines: Array<string> = [];
		let lineTop: number | undefined;
		for (const { segment, index } of segmenter.segment(node.data)) {
			range.setStart(node, index);
			range.setEnd(node, index + segment.length);
			const rect = range.getClientRects()[0];
			const startsLine = rect !== undefined && (lineTop === undefined || rect.top - lineTop > 2);
			if (startsLine) {
				lineTop = rect.top;
				lines.push(segment);
			} else if (lines.length > 0) {
				lines[lines.length - 1] += segment;
			}
		}
		return lines.map((line) => line.trim()).filter((line) => line !== "");
	};

	const rise = (headline: HTMLElement) => {
		const node = headline.firstChild;
		headline.dataset.rise = "play";
		if (!(node instanceof Text) || headline.childNodes.length !== 1) return;
		const text = node.data;
		const lines = wrappedLines(node).map((line, i) => {
			const mask = document.createElement("span");
			const inner = document.createElement("span");
			mask.className = "rise-line";
			inner.style.setProperty("--i", String(i));
			inner.textContent = line;
			mask.append(inner);
			return mask;
		});
		if (lines.length === 0) return;
		headline.replaceChildren(...lines);
		// Back to plain text once drawn, so the headline wraps for itself on resize.
		lines.at(-1)?.firstElementChild?.addEventListener(
			"animationend",
			() => {
				headline.textContent = text;
				delete headline.dataset.rise;
			},
			{ once: true },
		);
	};

	/** The page colour behind a frame: what the blocks are drawn in. */
	const groundOf = (el: Element): string => {
		for (let node: Element | null = el; node; node = node.parentElement) {
			const colour = getComputedStyle(node).backgroundColor;
			if (colour !== "rgba(0, 0, 0, 0)" && colour !== "transparent") return colour;
		}
		return "#000";
	};

	/** One canvas pixel per block, scaled up unsmoothed. */
	const cover = (frame: HTMLElement) => {
		const canvas = document.createElement("canvas");
		canvas.className = "resolve-cover";
		canvas.width = Math.max(1, Math.ceil(frame.clientWidth / CELL));
		canvas.height = Math.max(1, Math.ceil(frame.clientHeight / CELL));
		canvas.setAttribute("aria-hidden", "true");
		const context = canvas.getContext("2d");
		if (!context) return undefined;
		context.fillStyle = groundOf(frame);
		context.fillRect(0, 0, canvas.width, canvas.height);
		frame.append(canvas);
		return { canvas, context };
	};

	const resolve = (canvas: HTMLCanvasElement, context: CanvasRenderingContext2D) => {
		const { width, height } = canvas;
		// Each block clears at its own moment: a sweep from the left, roughened.
		const due = Float32Array.from({ length: width * height }, (_, i) => ((i % width) / width) * 0.5 + Math.random() * 0.5);
		const started = performance.now();
		const frame = (now: number) => {
			const progress = (now - started) / RESOLVE_MS;
			due.forEach((at, i) => {
				if (at <= progress) context.clearRect(i % width, Math.floor(i / width), 1, 1);
			});
			if (progress < 1) requestAnimationFrame(frame);
			else canvas.remove();
		};
		requestAnimationFrame(frame);
	};

	if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "Segmenter" in Intl) {
		const headlines = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) continue;
					observer.unobserve(entry.target);
					rise(entry.target);
				}
			},
			{ rootMargin: "0px 0px -12% 0px" },
		);
		for (const headline of document.querySelectorAll<HTMLElement>(HEADLINES)) {
			if (!belowFold(headline)) continue;
			headline.dataset.rise = "armed";
			headlines.observe(headline);
		}

		const covers = new Map<Element, { canvas: HTMLCanvasElement; context: CanvasRenderingContext2D }>();
		const captures = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					const covered = covers.get(entry.target);
					if (!entry.isIntersecting || !covered) continue;
					observer.unobserve(entry.target);
					covers.delete(entry.target);
					resolve(covered.canvas, covered.context);
				}
			},
			{ threshold: 0.35 },
		);
		for (const frame of document.querySelectorAll<HTMLElement>(CAPTURES)) {
			// A frame waiting off to the side in a phone's swipe strip stays drawn: its edge is the cue to swipe.
			if (!belowFold(frame) || frame.getBoundingClientRect().left > innerWidth / 2) continue;
			const covered = cover(frame);
			if (!covered) continue;
			covers.set(frame, covered);
			captures.observe(frame);
		}
	}
</script>
