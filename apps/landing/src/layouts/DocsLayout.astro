---
import "../styles/global.css";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import DocsPrevNext from "../components/docs/DocsPrevNext.astro";
import DocsMobileNav from "../components/docs/DocsMobileNav.astro";
import DocsSectionNav from "../components/docs/DocsSectionNav.astro";
import DocsSearch from "../components/docs/DocsSearch.tsx";
import { getGitHubStars } from "../lib/github-stars";
import { GithubStarButton } from "../components/GithubStarButton";
import { MapleMark } from "@maple/ui/components/icons/maple-mark";

interface Props {
    title: string;
    description: string;
    headings: Array<{ depth: number; slug: string; text: string }>;
    currentSlug: string;
    image?: string;
    /** Path of this page's markdown twin — see the same prop on Layout.astro. */
    mdHref?: string;
    /** GitHub edit URL of the page's source; renders the "Edit this page" link. */
    editHref?: string;
    /** Widen the column and drop the table-of-contents rail (index pages). */
    wide?: boolean;
    /** Keep the page out of search indexes (the docs 404). */
    noindex?: boolean;
}

const { title, description, headings, currentSlug, image = "/og-docs.png", mdHref, editHref, wide = false, noindex = false } = Astro.props;
const stars = await getGitHubStars();

const pageTitle = currentSlug || noindex ? `${title} · Maple Docs` : "Maple Docs";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImage = image.startsWith("http") ? image : new URL(image, Astro.site).toString();
const hasToc = !wide && headings.some((h) => h.depth >= 2 && h.depth <= 3);
// A reference page with dozens of subsections (the CLI) outlines its H2s only.
const tocDepth = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 28 ? 2 : 3;
// Backticks are markup in the lede; meta tags get the plain text.
const metaDescription = description.replaceAll("`", "");
---

<!doctype html>
<html lang="en" class="dark docs">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={metaDescription} />
        <meta name="theme-color" content="#171410" />
        <meta name="robots" content={noindex ? "noindex" : "index,follow"} />
        <link rel="canonical" href={canonicalUrl} />
        {mdHref && (
            <link rel="alternate" type="text/markdown" href={new URL(mdHref, Astro.site).toString()} />
        )}
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content="Maple" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@Mapledotdev" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={absoluteImage} />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <!-- Docs pages don't go through Layout.astro, so telemetry is wired here too. -->
        <script>
            import { startLandingTelemetry } from "../lib/telemetry";
            startLandingTelemetry();
        </script>
    </head>
    <!-- Docs are a reading surface: proportional Geist for everything, the way
         the blog sets its prose. Mono is opted back in per element for code,
         eyebrows and labels. -->
    <body class="min-h-screen antialiased bg-bg text-fg font-display">
        <a
            href="#docs-main"
            class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:border focus:border-primary focus:bg-bg-elevated focus:px-3 focus:py-2 focus:text-[13px] focus:text-fg"
        >
            Skip to content
        </a>
        <header class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/95 backdrop-blur-md">
            <div class="flex h-14 items-center gap-5 px-4 sm:px-6">
                <a href="/" class="flex items-center gap-2 text-fg transition-colors hover:text-primary">
                    <MapleMark size={20} className="text-primary shrink-0" />
                    <span class="text-[15px] font-semibold tracking-[-0.01em]">Maple</span>
                </a>
                <span class="h-4 w-px bg-border" aria-hidden="true"></span>
                <a href="/docs" class="text-[14px] text-fg-muted transition-colors hover:text-fg">Docs</a>
                <div class="ml-auto flex items-center gap-2.5">
                    <DocsSearch client:idle />
                    <GithubStarButton stars={stars} className="hidden sm:inline-flex" />
                    <a
                        href="https://app.maple.dev"
                        class="inline-flex h-7 items-center rounded-lg border border-border px-2.5 text-xs font-medium text-fg-muted transition-colors hover:border-fg-muted/40 hover:text-fg"
                    >
                        Open app
                    </a>
                </div>
            </div>
            <DocsSectionNav currentSlug={currentSlug} />
        </header>

        <div class="flex min-h-screen pt-24">
            <aside class="fixed top-24 bottom-0 left-0 hidden w-64 shrink-0 overflow-y-auto border-r border-border px-4 py-7 lg:block">
                <DocsSidebar currentSlug={currentSlug} />
            </aside>

            <main id="docs-main" class:list={["min-w-0 flex-1 lg:ml-64", hasToc && "xl:mr-60"]} tabindex="-1">
                <div class:list={["mx-auto px-5 py-10 sm:px-8 md:py-12", wide ? "max-w-5xl" : "max-w-3xl"]}>
                    <DocsMobileNav currentSlug={currentSlug} headings={headings} hasToc={hasToc} tocDepth={tocDepth} />
                    <slot />
                    {currentSlug && (
                        <footer class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-border pt-5 text-[12.5px] text-fg-muted">
                            {editHref && (
                                <a href={editHref} class="inline-flex items-center gap-1.5 transition-colors hover:text-fg" rel="noopener">
                                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                                        <path d="M5 15H5.01" /><path d="M7 13H7.01" /><path d="M9 11H9.01" /><path d="M11 9H11.01" /><path d="M13 7H13.01" /><path d="M15 5H15.01" /><path d="M17 3H17.01" /><path d="M19 5H19.01" /><path d="M9 19H9.01" /><path d="M11 17H11.01" /><path d="M13 21H21" /><path d="M13 15H13.01" /><path d="M15 13H15.01" /><path d="M17 11H17.01" /><path d="M19 9H19.01" /><path d="M21 7H21.01" /><path d="M3 17V21H7" /><path d="M15 9H15.01" />
                                    </svg>
                                    Edit this page on GitHub
                                </a>
                            )}
                            {mdHref && (
                                <a href={mdHref} class="inline-flex items-center gap-1.5 transition-colors hover:text-fg">
                                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
                                        <path d="M10 17H10.01" /><path d="M14 7L13.99 7" /><path d="M12 19H12.01" /><path d="M12 5L11.99 5" /><path d="M19 19H19.01" /><path d="M5 5L4.99 5" /><path d="M10 10H10.01" /><path d="M14 14L13.99 14" /><path d="M14 21H17" /><path d="M10 3L7 3" /><path d="M21 14L21 17" /><path d="M3 10L3 7" /><path d="M8 12L8 15" /><path d="M16 12L16 9" />
                                    </svg>
                                    View as Markdown
                                </a>
                            )}
                            <a href="https://github.com/MapleTechLabs/maple/issues/new?labels=docs" class="ml-auto transition-colors hover:text-fg" rel="noopener">
                                Report an issue
                            </a>
                        </footer>
                    )}
                    {currentSlug && <DocsPrevNext currentSlug={currentSlug} />}
                </div>
            </main>

            {hasToc && (
                <aside data-toc-rail class="fixed top-24 right-0 bottom-0 hidden w-60 shrink-0 overflow-y-auto overscroll-contain py-7 pr-6 pl-4 xl:block">
                    <TableOfContents headings={headings} collapse={tocDepth === 2} />
                </aside>
            )}
        </div>

        <script>
            import { bindCopyButtons } from "../lib/copy-to-clipboard";
            import "../lib/docs-tabs";

            // Progressive enhancement over the rendered article: copy buttons on
            // code blocks, section permalinks, and the navigation scrolled so the
            // current page is in view. Everything here is optional — the page
            // reads fine without it.
            const article = document.querySelector(".docs-content");

            if (article) {
                for (const pre of article.querySelectorAll<HTMLPreElement>("pre")) {
                    const code = pre.querySelector("code");
                    if (!code) continue;
                    pre.dataset.copy = code.textContent ?? "";
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "code-copy";
                    button.textContent = "copy";
                    button.setAttribute("aria-label", "Copy code");
                    pre.appendChild(button);
                }
                bindCopyButtons({
                    root: article,
                    hostSelector: "pre[data-copy]",
                    buttonSelector: ".code-copy",
                    track: { event: "docs_snippet_copied", key: "snippet" },
                });

                for (const heading of article.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]")) {
                    const anchor = document.createElement("a");
                    anchor.className = "heading-anchor";
                    anchor.href = `#${heading.id}`;
                    anchor.textContent = "#";
                    anchor.setAttribute("aria-label", `Link to “${heading.textContent?.trim() ?? ""}”`);
                    heading.appendChild(anchor);
                }
            }

            // Sidebar: the active row is often below the fold on long trees. When it
            // is not comfortably in view, bring it to the middle, snapped to the top
            // of a group so the first visible row is never cut in half.
            const sidebar = document.querySelector<HTMLElement>("aside nav[aria-label='Documentation']");
            const active = sidebar?.querySelector<HTMLElement>("a[aria-current='page']");
            const rail = sidebar?.closest<HTMLElement>("aside");
            if (sidebar && active && rail) {
                const at = (el: HTMLElement) => el.getBoundingClientRect().top - rail.getBoundingClientRect().top + rail.scrollTop;
                const top = at(active);
                const view = top - rail.scrollTop;
                if (view < 48 || view + active.offsetHeight > rail.clientHeight - 48) {
                    const centred = top - (rail.clientHeight - active.offsetHeight) / 2;
                    const groupTops = [...sidebar.querySelectorAll<HTMLElement>(":scope > section")].map((s) => at(s) - 20);
                    const snapped = groupTops.filter((g) => g <= centred && top + active.offsetHeight - g < rail.clientHeight - 24).pop();
                    rail.scrollTop = snapped ?? centred;
                }
            }

            // Outline rail: on long pages it scrolls on its own; keep the entry the
            // scroll spy marks inside it.
            const tocRail = document.querySelector<HTMLElement>("aside[data-toc-rail]");
            if (tocRail) {
                const follow = () => {
                    const current = tocRail.querySelector<HTMLElement>("a[aria-current='true']");
                    if (!current) return;
                    const top = current.getBoundingClientRect().top - tocRail.getBoundingClientRect().top;
                    if (top < 24 || top + current.offsetHeight > tocRail.clientHeight - 24) {
                        tocRail.scrollTop += top - (tocRail.clientHeight - current.offsetHeight) / 2;
                    }
                };
                new MutationObserver(follow).observe(tocRail, { subtree: true, attributeFilter: ["aria-current"] });
            }

            // Section strip scrolls sideways on phones: centre the active tab, and
            // fade whichever edge still has tabs beyond it.
            const strip = document.querySelector<HTMLElement>(".docs-section-nav");
            const section = strip?.querySelector<HTMLElement>("a[aria-current='page']");
            if (strip) {
                if (section) {
                    strip.scrollLeft = section.offsetLeft - (strip.clientWidth - section.offsetWidth) / 2;
                }
                const edges = () => {
                    const max = strip.scrollWidth - strip.clientWidth;
                    strip.toggleAttribute("data-more-start", strip.scrollLeft > 2);
                    strip.toggleAttribute("data-more-end", strip.scrollLeft < max - 2);
                };
                edges();
                strip.addEventListener("scroll", edges, { passive: true });
                window.addEventListener("resize", edges, { passive: true });
            }
        </script>
    </body>
</html>
