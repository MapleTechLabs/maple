---
/**
 * PageHero: the hero for the feature, compare and other marketing pages. Feature pages fill the
 * `product` slot (the real product beside the copy from `lg`, under it on phones, in front of the
 * engraving). Other pages use the narrower `aside` column over the dot-grid veil.
 * No eyebrow: the breadcrumb above the title already names the page.
 */
import { buttonVariants } from "@maple/views/ui/button.styles";
import * as m from "../../paraglide/messages.js";
import Breadcrumb from "../Breadcrumb.astro";
import HeroCta from "../HeroCta.astro";

interface Props {
	title: string;
	lede: string;
	illustration?: string;
	/** What the illustration shows. With none, the image stays hidden from assistive tech. */
	illustrationAlt?: string;
	breadcrumb: { label: string; href?: string }[];
}

const { title, lede, breadcrumb, illustration, illustrationAlt } = Astro.props;

// An optional right-hand column (the /compare logo pairing). Without it the
// hero keeps its single-column measure; with it, the copy and the aside sit
// on one row from lg up, centred on each other.
const hasAside = Astro.slots.has("aside");
// The wide column for real product. Top-aligned with the copy: a tall frame
// must not push the headline down the screen.
const hasProduct = Astro.slots.has("product");
---

<section class:list={["relative overflow-hidden bg-bg", illustration && "page-hero--illustrated"]}>
	{illustration ? (
		<div class:list={["page-hero__art", hasProduct && "page-hero__art--behind"]} aria-hidden={illustrationAlt ? undefined : "true"}>
			<img src={illustration} width="1536" height="1024" alt={illustrationAlt ?? ""} loading="eager" decoding="async" />
		</div>
	) : <div class="dot-grid-veil" aria-hidden="true"></div>}

	<div class="relative">
		<Breadcrumb items={breadcrumb} class="shell pt-24 md:pt-28" />

		<div
			class:list={[
				"shell pt-8",
				hasProduct ? "pb-12 md:pb-16 lg:pt-14" : "pb-16 md:pb-24 md:pt-10",
				hasProduct && "grid gap-10 lg:grid-cols-[minmax(0,0.74fr)_minmax(0,1fr)] lg:items-start lg:gap-14",
				!hasProduct &&
					hasAside &&
					"grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-center lg:gap-16",
			]}
		>
		<div class:list={["min-w-0", illustration && !hasProduct && "page-hero__copy"]}>
			<h1
				class:list={[
					"max-w-[20ch] font-display text-[2.375rem] font-semibold leading-[1.03] tracking-[-0.025em] text-fg sm:text-5xl",
					hasProduct ? "page-hero__title xl:text-[3.25rem]" : "lg:text-6xl",
				]}
			>
				{title}
			</h1>

			<p class="mt-6 max-w-[62ch] text-sm leading-relaxed text-fg-muted md:text-base">{lede}</p>

			<div class:list={["flex flex-wrap items-center gap-3", hasProduct ? "mt-8" : "mt-10"]}>
				<HeroCta class={buttonVariants({ size: "xl" })} />
				<a
					href="https://github.com/MapleTechLabs/maple"
					target="_blank"
					rel="noopener noreferrer"
					class={buttonVariants({ variant: "outline", size: "xl" })}
				>
					{m.cta_github()}
				</a>
			</div>
		</div>
		{hasProduct && <div class="min-w-0"><slot name="product" /></div>}
		{!hasProduct && hasAside && <div class="min-w-0"><slot name="aside" /></div>}
		</div>
	</div>
</section>

<style>
	.page-hero__art {
		position: absolute;
		inset: 0;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, transparent, black 18%, black 85%, transparent);
	}

	.page-hero__art img {
		position: absolute;
		right: 0;
		bottom: 0;
		width: 72%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.75;
		mask-image: linear-gradient(to right, transparent, black 55%);
	}

	/* Behind a product frame the engraving is a backdrop: the frame covers its middle,
	   so the top band stays at full strength for the monument's crown to show. */
	.page-hero__art--behind {
		/* Gone before the frame's caption, which sits in the last 10rem. */
		mask-image: linear-gradient(to bottom, black calc(100% - 17rem), transparent calc(100% - 9.5rem));
	}
	/* Half the hero, anchored on the monument, which every engraving draws right of centre. */
	.page-hero__art--behind img {
		width: 50%;
		object-position: right top;
		mask-image: linear-gradient(to right, transparent, black 36%);
	}

	/* Product heroes only. Korean breaks between words, not inside one, and the narrower copy track made mid-word breaks common. */
	.page-hero__title:lang(ko) {
		word-break: keep-all;
	}

	@media (min-width: 1024px) {
		.page-hero__copy {
			max-width: 58%;
		}
	}

	@media (max-width: 1023px) {
		.page-hero__art img {
			width: 100%;
			opacity: 0.2;
			object-position: 65% center;
		}
	}
</style>
