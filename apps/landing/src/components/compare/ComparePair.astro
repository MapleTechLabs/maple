---
/**
 * ComparePair: the two marks, side by side, in the hero's right-hand column.
 *
 * The hero copy takes half the row and left the other half to the dot grid.
 * This fills it with the one thing a comparison page can show at a glance:
 * who is being compared. Two hairline cells, each mark in its own brand
 * color (a vs-pairing is the one place two brand colors belong together),
 * the name, and the vendor's domain as a literal: no claim, no tagline.
 * Each cell is washed in its side's color: a flat tint and a halftone dither
 * from `.pair-cell`.
 */
import Icon from "../Icon.astro";
import BrandMarkIcon from "../BrandMarkIcon.astro";
import { brandMark, markTint } from "../../lib/brand-marks";
import type { Competitor } from "../../lib/competitors";

interface Props {
	competitor: Competitor;
	/** A single short row, for the hero where a product frame sits under the pairing. */
	compact?: boolean;
}

const { competitor, compact = false } = Astro.props;
// Compact puts the mark beside the name; the full cell stacks them.
const cell = compact
	? "pair-cell flex items-center justify-center gap-3 px-4 py-4 text-left"
	: "pair-cell flex flex-col items-center gap-4 px-6 py-10 text-center md:py-12";
const tile = compact
	? "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-border bg-bg-elevated"
	: "flex h-16 w-16 items-center justify-center rounded-xl border border-border bg-bg-elevated";
const name = compact
	? "font-display text-[15px] font-medium tracking-[-0.01em] text-fg"
	: "font-display text-lg font-medium tracking-[-0.01em] text-fg md:text-xl";
const site = compact ? "font-mono text-[10.5px] text-fg-muted" : "mt-1 font-mono text-[11px] text-fg-muted";
// The vendor's brand color drives its cell's dither; near-black marks tint
// with the muted foreground so the field stays visible on the dark ground.
const vendorColor = markTint(brandMark(competitor.mark));
---

<div class="relative grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border">
	<div class={cell} style="--pair: var(--primary)">
		<span class={tile}>
			<Icon name="MapleMark" size={compact ? 22 : 34} class="text-primary" />
		</span>
		<div class="min-w-0">
			<div class={name}>Maple</div>
			<div class={site}>maple.dev</div>
		</div>
	</div>
	<div class={cell} style={`--pair: ${vendorColor}`}>
		<span class={tile}>
			<BrandMarkIcon id={competitor.mark} class={compact ? "h-5 w-5" : "h-8 w-8"} />
		</span>
		<div class="min-w-0">
			<div class:list={[name, "truncate"]}>{competitor.name}</div>
			<div class:list={[site, "truncate"]}>{competitor.site}</div>
		</div>
	</div>
	<span
		class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border bg-bg px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted"
		aria-hidden="true"
	>
		vs
	</span>
</div>
