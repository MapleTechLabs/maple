{
	"name": "@maple/db",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./config": "./src/config.ts",
		"./migrate": "./src/migrate.ts",
		"./pglite": "./src/pglite.ts",
		"./roles": "./src/roles.ts",
		"./tables": "./src/tables/index.ts"
	},
	"scripts": {
		"typecheck": "tsrs --noEmit",
		"test": "vitest run --passWithNoTests",
		"db:generate": "bun --bun effect-orm generate",
		"db:check": "bun --bun effect-orm check",
		"db:migrate": "bun scripts/migrate.ts",
		"db:status": "bun --bun effect-orm status",
		"db:verify": "bun --bun effect-orm verify",
		"db:audit-raw-sql": "bun scripts/audit-raw-sql.ts",
		"db:restore-test": "bun scripts/restore-test.ts"
	},
	"dependencies": {
		"@effect/sql-pg": "4.0.6",
		"@effect/sql-pglite": "4.0.6",
		"@electric-sql/pglite": "^0.5.12",
		"@maple-dev/effect-orm": "0.8.0",
		"@maple/domain": "workspace:*",
		"@maple/security-audit": "workspace:*",
		"effect": "catalog:effect",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@maple/widgets": "workspace:*",
		"@types/bun": "^1.4.4",
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
