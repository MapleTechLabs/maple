{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "unicorn", "typescript", "oxc", "react", "jsx-a11y"],
	"jsPlugins": [
		"./scripts/oxlint-plugins/maple.mjs",
		"./scripts/oxlint-plugins/anti-slop/index.ts",
		"./scripts/oxlint-plugins/test-slop.mjs"
	],
	"options": {
		"reportUnusedDisableDirectives": "deny",
		"respectEslintDisableDirectives": false
	},
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": ["error", { "allowWithTestSeamComment": true }],
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": [
			"error",
			{
				"allowInTypeGuards": true,
				"allowInBoundaryFunctions": true,
				"checkUnknownOnly": true
			}
		],
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": [
			"error",
			{ "allowInBoundaryFunctions": true, "allowWithBoundaryComment": true }
		],
		"anti-slop/no-unknown-returns": ["error", { "allowWithBoundaryComment": true }],
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": [
			"error",
			{ "check": "unsafe", "allowFileSafetyComment": true }
		],
		"maple/dialog-body-padding": "error",
		"maple/no-effect-die": "error",
		"maple/no-ordie-compiled-query": "error",
		"maple/no-raw-tool-layer": "error",
		"maple/no-react-use-effect": "warn",
		"maple/no-record-string-any": "error",
		"maple/no-try-catch": "error",
		"maple/no-date-parse": "error",
		"typescript/no-explicit-any": "warn",
		"typescript/no-non-null-assertion": "error",
		"no-alert": "error",
		"oxc/approx-constant": "warn",
		"no-plusplus": "off",
		"require-yield": "off"
	},
	"overrides": [
		// The dashboard's design rules (docs/design-rules.md), on the app and its kit.
		{
			"files": ["apps/web/src/**", "packages/ui/src/**"],
			"rules": {
				"maple/couldnt-copy": "error",
				"maple/hover-needs-active": "error",
				"maple/instant-state": "error",
				"maple/no-arbitrary-radius": "error",
				"maple/no-dimmed-icon": "error",
				"maple/no-raw-shadow": "error",
				"maple/no-transition-all": "error",
				"maple/single-tooltip-delay": "error",
				"maple/tone-alpha-steps": "error"
			}
		},
		// Lab fixtures hold sample telemetry (log bodies, error messages), not UI copy.
		{
			"files": ["apps/web/src/lab/**"],
			"rules": { "maple/couldnt-copy": "off" }
		},
		// Existing API burndown entries, relocated with their implementation.
		{
			"files": [
				"packages/backend/src/platform/Apns.ts",
				"packages/backend/src/platform/CacheBackendLive.ts",
				"packages/backend/src/platform/describe-cause.ts",
				"packages/backend/src/services/alerts/AlertDeliveryDispatch.ts",
				"packages/backend/src/services/alerts/AlertsService.ts",
				"packages/backend/src/services/billing/autumn-tracker.ts",
				"packages/backend/src/services/integrations/PlanetScaleDiscoveryService.ts",
				"packages/backend/src/services/integrations/vcs/vendor/github/GithubProvider.ts",
				"packages/backend/src/services/org/OrgClickHouseSettingsService.ts",
				"packages/backend/src/services/product-events/svix.ts"
			],
			"rules": { "maple/no-try-catch": "off" }
		},
		// Existing API burndown entries, relocated with their implementation.
		{
			"files": [
				"packages/backend/src/http/schema-error-detail.ts",
				"packages/backend/src/services/alerts/AlertDestinationsService.ts",
				"packages/backend/src/services/alerts/AlertsService.ts",
				"packages/backend/src/services/alerts/AnomalyDetectionService.ts",
				"packages/backend/src/services/alerts/anomaly/detection.ts",
				"packages/backend/src/services/alerts/delivery/transports/email.ts",
				"packages/backend/src/services/auth/CliDeviceAuthService.ts",
				"packages/backend/src/services/auth/McpOAuthService.ts",
				"packages/backend/src/services/auth/PlanetScaleOAuthService.ts",
				"packages/backend/src/services/dashboards/ServiceMapRollupService.ts",
				"packages/backend/src/services/dashboards/dashboard-changes.ts",
				"packages/backend/src/services/digest/DigestService.ts",
				"packages/backend/src/services/errors/ErrorIssueReadModelsService.ts",
				"packages/backend/src/services/errors/ErrorIssueWorkflowService.ts",
				"packages/backend/src/services/errors/ErrorsService.ts",
				"packages/backend/src/services/errors/InvestigationService.ts",
				"packages/backend/src/services/integrations/PlanetScaleConnectionService.ts",
				"packages/backend/src/services/integrations/PlanetScaleService.ts",
				"packages/backend/src/services/integrations/ScrapeTargetsService.ts",
				"packages/backend/src/services/integrations/vcs/vendor/github/GithubProvider.ts",
				"packages/backend/src/services/org/demo/fixtures.ts",
				"packages/backend/src/services/push/LiveActivitiesService.ts",
				"packages/backend/src/services/push/MobileDevicesService.ts"
			],
			"rules": { "typescript/no-non-null-assertion": "off" }
		},
		// The executor is the seam that decides a compile failure is a defect — the
		// one place `Effect.orDie` around a compile is the intended behaviour rather
		// than a call site restating it.
		{
			"files": ["packages/query-engine/src/execution/**"],
			"rules": {
				"maple/no-ordie-compiled-query": "off"
			}
		},
		// A test asserts on a fixture it just built, so `!` there documents the fixture
		// rather than hiding an unchecked value; and a test that drives a throwing
		// boundary on purpose needs `try`/`catch` to observe it.
		{
			"files": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/test/**",
				"**/tests/**",
				"**/__tests__/**",
				"**/*test-support*"
			],
			"rules": {
				"maple/no-date-parse": "off",
				"maple/no-effect-die": "off",
				"maple/no-try-catch": "off",
				"typescript/no-non-null-assertion": "off"
			}
		},
		// `Date.parse` burndown: the server side is clean and held to the rule. These still parse
		// with it and move to `parseWarehouseDateTime` / `DateTime` in their own audit; the
		// implementation of `parseWarehouseDateTime` itself is the one permanent entry.
		{
			"files": [
				"apps/web/src/components/infra/gcp/list-model.ts",
				"apps/web/src/components/integrations/gcp-connector-state.ts",
				"apps/web/src/components/integrations/gcp-usage.ts",
				"apps/web/src/components/integrations/planetscale-setup-steps.ts",
				"apps/web/src/components/releases/release-model.ts",
				"apps/web/src/components/replays/replay-timeline.ts",
				"apps/web/src/components/settings/audit-log-filters.ts",
				"apps/web/src/components/settings/keys-table.ts",
				"apps/web/src/lab/alerts-fixture.ts",
				"apps/web/src/lab/cloudflare-fixture.ts",
				"apps/web/src/lab/gcp-infra-fixture.ts",
				"apps/web/src/lab/gcp-workload-fixture.ts",
				"apps/web/src/lib/billing/spend.ts",
				"apps/web/src/lib/models/error-signal.ts",
				"packages/web-data/**",
				"apps/cli/**",
				"packages/ui/**",
				"packages/domain/**",
				"packages/primitives/**",
				"packages/query-engine-integrations/**",
				"packages/chat-platform/**",
				"packages/alchemy-maple/**",
				"packages/db/scripts/**",
				"packages/query-engine/src/datetime.ts",
				"scripts/**",
				"examples/**"
			],
			"rules": { "maple/no-date-parse": "off" }
		},
		// The rule points at an Effect primitive, so it only applies where Effect is on
		// the dependency list. These ship to customers with no runtime deps at all
		// (`@maple/browser`, and `@maple/browser-session` and `@maple/sdk-core` bundled into
		// it, are under a bundle-size budget), so `try`/`catch` is the only error handling they have.
		{
			"files": [
				"packages/browser/**",
				"packages/browser-session/**",
				"packages/sdk-core/**",
				"packages/clickhouse-cli/**"
			],
			"rules": {
				"maple/no-try-catch": "off"
			}
		},
		// Burndown list, not a policy. `packages/*` and `lib/*` source is clean and
		// gated for both rules; the apps and the one-shot ops scripts still hold
		// ~460 `try`/`catch` blocks and ~500 non-null assertions between them.
		// Drop entries from this list as each is converted rather than widening it.
		{
			"files": [
				"apps/**",
				"packages/web-data/**",
				"scripts/**",
				"**/scripts/**",
				"examples/**",
				"alchemy.run.ts"
			],
			"rules": {
				"maple/no-try-catch": "off",
				"typescript/no-non-null-assertion": "off"
			}
		},
		// Test cases that cannot catch a bug: assertion-free, existence-only, constant pins,
		// Tailwind class pins, source greps, exact command lists and SQL projection pins.
		// Rationale per rule in scripts/oxlint-plugins/test-slop.mjs.
		{
			"files": ["**/*.test.ts", "**/*.test.tsx"],
			"plugins": ["vitest"],
			"rules": {
				"test-slop/no-classname-assertions": "error",
				"test-slop/no-constant-pin": "error",
				"test-slop/no-exact-name-list": "error",
				"test-slop/no-source-text-assertions": "error",
				"test-slop/no-sql-text-pin": "error",
				"test-slop/no-weak-only-assertions": "error",
				"vitest/expect-expect": [
					"error",
					{
						"assertFunctionNames": [
							"expect",
							"expect*",
							"assert",
							"assert*",
							"assert.*",
							"expect.*",
							"*.assert*",
							"strictEqual",
							"deepStrictEqual",
							"notStrictEqual",
							"notDeepStrictEqual",
							"equal",
							"deepEqual",
							"ok",
							"rejects",
							"doesNotReject",
							"throws",
							"doesNotThrow",
							"match",
							"doesNotMatch",
							"fail",
							"expectTypeOf",
							"Lazy.expectAllReused"
						]
					}
				],
				"vitest/no-identical-title": "error",
				// Plugin defaults that misread `it.effect` / `expect(value, message)` or are style-only.
				"vitest/no-conditional-expect": "off",
				"vitest/no-conditional-tests": "off",
				"vitest/no-standalone-expect": "off",
				"vitest/require-mock-type-parameters": "off",
				"vitest/require-to-throw-message": "off",
				"vitest/valid-expect": "off",
				"vitest/valid-title": "off"
			}
		},
		// The raw-SQL preparer is a text rewriter: its output SQL text is the behavior under test.
		{
			"files": ["packages/query-engine/src/runtime/raw-sql*.test.ts"],
			"rules": {
				"test-slop/no-sql-text-pin": "off"
			}
		},
		// "shape" is Electric's own protocol noun — `/v1/shape` is the endpoint this
		// app proxies and `maple.electric.shape` is the span attribute naming which
		// one. The rule is about `shape` as a stand-in for a domain role it could not
		// name; here it IS the domain role.
		{
			"files": ["apps/electric-sync/**"],
			"rules": {
				"anti-slop/no-shape-in-symbol-names": "off"
			}
		},
		// Standalone generic DSLs use `any` as a variance placeholder; Maple product code may not.
		{
			"files": ["lib/**"],
			"rules": {
				"anti-slop/no-unsafe-dictionary-type": "off",
				"maple/no-record-string-any": "off",
				"typescript/no-explicit-any": "off"
			}
		},
		// Provider code is private outside its implementation, tests, and composition roots.
		{
			"files": ["apps/api/src/**/*.ts", "apps/api/src/**/*.tsx", "packages/backend/src/**/*.ts"],
			"excludeFiles": [
				"apps/api/src/vcs-sync-runtime.ts",
				"apps/api/src/runtime/service-graph.ts",
				"packages/backend/src/services/integrations/vcs/VcsProviderRegistry.ts",
				"apps/api/src/routes/internal/integrations.http.ts",
				"apps/api/src/routes/oauth-complete.ts",
				"packages/backend/src/services/integrations/vcs/vendor/**",
				"packages/backend/src/services/integrations/vcs/__tests__/**"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations are private. Import through the provider-agnostic VCS services; only composition roots, provider tests, and the provider implementation may import vendor code."
							}
						]
					}
				]
			}
		},
		// Replaces a source-grepping test: MCP-capable tracers must list the anticipated MCP errors.
		{
			"files": ["apps/ai/src/**/*.ts"],
			"excludeFiles": ["**/*.test.ts"],
			"rules": { "maple/mcp-tracer-anticipated-errors": "error" }
		},
		// Customer SDK bundle boundaries (were source-grepping architecture tests). Later overrides
		// replace earlier rule options, so the narrower tiers repeat the broader patterns.
		{
			"files": ["packages/sdk-core/src/**/*.ts"],
			"excludeFiles": ["**/*.test.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^effect($|/)",
								"message": "sdk-core is bundled into the browser SDK eager chunk; it stays Effect-free."
							},
							{
								"regex": "^@opentelemetry/",
								"message": "sdk-core is bundled into the Effect SDK, which never ships OpenTelemetry."
							},
							{
								"regex": "^(rrweb|rrweb-|@rrweb/)",
								"message": "Only the SDKs' lazy replay chunk may reach rrweb."
							},
							{
								"regex": "^@maple/browser-session/replay$",
								"message": "The replay entry pulls rrweb in; only an SDK's lazy chunk may import it."
							}
						]
					}
				]
			}
		},
		// The sdk-core root tier is bundled server-side: no DOM tier, no browser globals.
		{
			"files": ["packages/sdk-core/src/**/*.ts"],
			"excludeFiles": ["**/*.test.ts", "packages/sdk-core/src/browser/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^effect($|/)",
								"message": "sdk-core is bundled into the browser SDK eager chunk; it stays Effect-free."
							},
							{
								"regex": "^@opentelemetry/",
								"message": "sdk-core is bundled into the Effect SDK, which never ships OpenTelemetry."
							},
							{
								"regex": "^(rrweb|rrweb-|@rrweb/)",
								"message": "Only the SDKs' lazy replay chunk may reach rrweb."
							},
							{
								"regex": "^@maple/browser-session/replay$",
								"message": "The replay entry pulls rrweb in; only an SDK's lazy chunk may import it."
							},
							{
								"regex": "^\\./browser",
								"message": "The sdk-core root tier is bundled server-side; it must not import the DOM tier."
							},
							{
								"regex": "^@maple/browser-session",
								"message": "The sdk-core root tier is bundled server-side; it must not import the DOM tier."
							},
							{
								"name": "web-vitals",
								"message": "The sdk-core root tier is bundled server-side; it must not import the DOM tier."
							}
						]
					}
				],
				"no-restricted-globals": [
					"error",
					"window",
					"document",
					"navigator",
					"location",
					"localStorage",
					"indexedDB"
				]
			}
		},
		// Code views highlight through lib/highlight, whose output falls back to plain text past the
		// display cap; a span per token of a megabyte log body froze the log sheet.
		{
			"files": ["apps/web/src/**/*.ts", "apps/local-ui/src/**/*.ts"],
			"excludeFiles": ["apps/web/src/lib/highlight.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@pierre/highlights",
								"message": "Use highlightCode from lib/highlight (or cappedCode from ui/logs/log-message): they bound what a view renders."
							}
						]
					}
				]
			}
		},
		// browser-session: the always-loaded tier never reaches the lazy replay tier.
		{
			"files": ["packages/browser-session/src/**/*.ts"],
			"excludeFiles": [
				"**/*.test.ts",
				"**/*.bench.ts",
				"packages/browser-session/src/replay/**",
				"packages/browser-session/src/session/replay-session.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^(\\.\\.?/)+replay/",
								"message": "replay/ is the lazily loaded tier; importing it from the always-loaded tier hoists rrweb into the base chunk."
							},
							{
								"regex": "^(rrweb|rrweb-|@rrweb/)",
								"message": "rrweb stays behind the lazy replay boundary."
							}
						]
					}
				]
			}
		},
		// browser-session platform/ is the leaf layer.
		{
			"files": ["packages/browser-session/src/platform/**/*.ts"],
			"excludeFiles": ["**/*.test.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^(\\.\\.?/)+replay/",
								"message": "replay/ is the lazily loaded tier; importing it from the always-loaded tier hoists rrweb into the base chunk."
							},
							{
								"regex": "^(rrweb|rrweb-|@rrweb/)",
								"message": "rrweb stays behind the lazy replay boundary."
							},
							{
								"regex": "^\\.\\./",
								"message": "platform/ is the leaf layer: it must not import the domain layers back."
							}
						]
					}
				]
			}
		},
		// Service-graph boundaries. These replace source-grepping tests; overrides replace (not merge)
		// rule options, so files under the VCS vendor rule above repeat its pattern.
		{
			"files": [
				"apps/ai/src/mcp/tools/list-alert-incidents.ts",
				"apps/ai/src/mcp/tools/get-incident-timeline.ts",
				"apps/ai/src/mcp/tools/list-alert-checks.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@maple/backend/services/alerts/AlertsService",
								"message": "Read handlers go through AlertReadModelsService / AlertDestinationsService. AlertsService pulls in the whole evaluation and dispatch graph."
							}
						]
					}
				]
			}
		},
		// Runtime entry points compose their own graph instead of the compatibility facade.
		{
			"files": ["apps/ai/src/chat/turn-runner.ts", "apps/ai/src/mcp/__evals__/eval-runtime.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "(^|/)app$",
								"message": "Entry points compose their own service graph; the `app` compatibility facade (`MainLive`) drags every route and service in."
							}
						]
					}
				]
			}
		},
		// A cold `/mcp` request (initialize, resources, prompts, 401s) never loads the tool graph;
		// McpToolExecutorLoader, the one importer, loads it on the first `tools/*` request. Types stay importable.
		{
			"files": [
				"apps/ai/src/worker/http.ts",
				"apps/ai/src/runtime/http-graph.ts",
				"apps/ai/src/mcp/app.ts",
				"apps/ai/src/mcp/server.ts",
				"apps/ai/src/mcp/tool-catalog.ts",
				"apps/ai/src/mcp/transport/*.ts"
			],
			"excludeFiles": ["**/*.test.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "(^|/)(dispatcher|mcp-service-graph)$",
								"allowTypeImports": true,
								"message": "The tool graph loads lazily through McpToolExecutorLoader; import its types only."
							}
						]
					}
				]
			}
		},
		// The headless MCP root carries only what registered tools need.
		{
			"files": ["apps/ai/src/mcp/dispatcher.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "./service-graph",
								"message": "The MCP root uses mcp-service-graph, not the full route graph."
							}
						],
						"patterns": [
							{
								"regex": "/(DailySpendService|CloudflareAnalyticsService|AnomalyDetectionService|AiTriageService|DigestService|DemoService)$",
								"message": "Route-only service; MCP tools never require it."
							}
						]
					}
				]
			}
		},
		// The API service composition root stays free of HTTP routes and schemas.
		{
			"files": ["apps/api/src/runtime/service-graph.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "/routes/",
								"message": "The service graph must not depend on HTTP routes."
							},
							{
								"regex": "^@maple/domain/http",
								"message": "The service graph must not depend on HTTP schemas."
							},
							{
								"regex": "^effect/http",
								"message": "The service graph must not depend on the HTTP layer."
							}
						]
					}
				]
			}
		},
		// The HTTP entry point composes HttpServicesLive, not the compatibility facade.
		{
			"files": ["apps/api/src/worker/http.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "(^|/)app$",
								"message": "Entry points compose their own service graph; the `app` compatibility facade (`MainLive`) drags every route and service in."
							},
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations are private. Import through the provider-agnostic VCS services."
							}
						]
					}
				]
			}
		},
		// Alert read and destination handlers use the narrow capability services.
		{
			"files": [
				"apps/api/src/routes/v2/alert-destinations.http.ts",
				"apps/api/src/routes/v2/alert-incidents.http.ts",
				"apps/api/src/routes/v2/alert-deliveries.http.ts"
			],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "@maple/backend/services/alerts/AlertsService",
								"message": "Read handlers go through AlertReadModelsService / AlertDestinationsService. AlertsService pulls in the whole evaluation and dispatch graph."
							}
						],
						"patterns": [
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations are private. Import through the provider-agnostic VCS services."
							}
						]
					}
				]
			}
		},
		// AlertDestinationsService stays independent of evaluation and the warehouse.
		{
			"files": ["packages/backend/src/services/alerts/AlertDestinationsService.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "^@maple/query-engine",
								"message": "Destinations do not query the warehouse."
							},
							{
								"regex": "/(QueryEngineService|WarehouseQueryService|OrgClickHouseSettingsService|AnomalyDetectionService|ErrorsService)$",
								"message": "Destinations stay independent of alert evaluation and warehouse services."
							},
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations are private. Import through the provider-agnostic VCS services."
							}
						]
					}
				]
			}
		},
		// AlertReadModelsService reads persistence and the warehouse, never scheduling or delivery.
		{
			"files": ["packages/backend/src/services/alerts/AlertReadModelsService.ts"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"regex": "/(AlertDestinationsService|AlertRuntime|EmailService|Env|OrgClickHouseSettingsService|QueryEngineService)$",
								"message": "Read models must not depend on scheduler or delivery capabilities."
							},
							{
								"group": ["**/vendor/*", "**/vendor/*/**"],
								"message": "VCS provider implementations are private. Import through the provider-agnostic VCS services."
							}
						]
					}
				]
			}
		}
	],
	// Vendored third-party source is read as a unit and re-pulled wholesale from its upstream,
	// so house rules that would be rewrites are not applied to it.
	"ignorePatterns": [
		"packages/security-audit/skill/**",
		".agents/**",
		".codex/**",
		".context/**",
		".factory/**",
		".impeccable/**",
		".superset/**",
		"scripts/oxlint-plugins/anti-slop/**"
	]
}
