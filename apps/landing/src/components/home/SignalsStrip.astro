---
/**
 * Signals: the dashboard's own trace waterfall across the sheet, with its logs stream and a
 * session replay capture sharing the row under it. The request plays once as it scrolls in.
 */
import * as m from "../../paraglide/messages.js";
import { featurePath } from "../../lib/page-registry";
import LiveLogs from "../live/LiveLogs.astro";
import LiveTraceFrame from "../live/LiveTraceFrame.astro";
import LedgerHead from "./LedgerHead.astro";
import MediaFrame from "./MediaFrame.astro";

const locale = Astro.currentLocale ?? "en";

const logs = {
	title: m.signals_logs_title(),
	sub: m.signals_logs_sub(),
	href: featurePath(locale, "log-management"),
	link: m.nav_log_management(),
};
const session = {
	title: m.signals_session_title(),
	sub: m.signals_session_sub(),
	href: featurePath(locale, "browser-sessions"),
	link: m.nav_browser_sessions(),
};
---

<section class="ledger">
	<div class="shell">
		<LedgerHead
			title={m.signals_trace_title()}
			lede={m.signals_trace_sub()}
			href={featurePath(locale, "distributed-tracing")}
			link={m.nav_distributed_tracing()}
		/>

		<div class="ledger-grid">
			<div class="ledger-cell ledger-cell--wide ledger-trace" data-trace-play>
				<LiveTraceFrame height="19rem" />
			</div>
			<div class="ledger-cell">
				<div class="ledger-cap ledger-cap--top">
					<h2>{logs.title}</h2>
					<a href={logs.href}>{logs.link}<span aria-hidden="true"> →</span></a>
					<p>{logs.sub}</p>
				</div>
				{/* Taller on phones, where 16:10 leaves no room for an expanded row. */}
				<div class="aspect-[4/5] min-h-0 overflow-hidden sm:aspect-[16/10]">
					<LiveLogs volume={false} streamHeight="fill" />
				</div>
			</div>
			<div class="ledger-cell">
				<div class="ledger-cap ledger-cap--top">
					<h2>{session.title}</h2>
					<a href={session.href}>{session.link}<span aria-hidden="true"> →</span></a>
					<p>{session.sub}</p>
				</div>
				<MediaFrame
					label="A browser session replay showing the recorded page and captured network requests"
					src="/screenshots/strip-session.webp"
					width={1440}
					height={900}
					crop={{ x: 0.185, y: 0.075, zoom: 1.25 }}
				/>
			</div>
		</div>
	</div>
</section>

<script>
	// The timeline cells light in start order, once. The cells are the waterfall's own markup,
	// so the order is a column index set here and the rest is CSS (home-ledger.css).
	const root = document.querySelector<HTMLElement>("[data-trace-play]");
	// Already on screen at load (a restored scroll position): leave it drawn, with no dim-then-play.
	const onScreen = root ? root.getBoundingClientRect().top < innerHeight : true;
	if (root && !onScreen && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		root.toggleAttribute("data-armed", true);
		const play = () => {
			// `.w-48` is the waterfall's timeline column. If the kit renames it nothing matches and the
			// cells simply stay lit: the dimmed state is keyed on the same selector.
			for (const row of root.querySelectorAll<HTMLElement>(".w-48")) {
				[...row.children].forEach((cell, i) => (cell as HTMLElement).style.setProperty("--i", String(i)));
			}
			root.toggleAttribute("data-played", true);
		};
		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					observer.disconnect();
					// The island hydrates on visibility too: give it a beat to draw its rows.
					setTimeout(play, 350);
				}
			},
			{ threshold: 0.5 },
		);
		observer.observe(root);
	}
</script>
