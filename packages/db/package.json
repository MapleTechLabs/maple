{
	"name": "@maple/db",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./config": "./src/config.ts",
		"./migrate": "./src/migrate.ts",
		"./pglite": "./src/pglite.ts",
		"./tables": "./src/tables/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"db:generate": "effect-orm generate",
		"db:check": "effect-orm check",
		"db:migrate": "bun scripts/migrate.ts",
		"db:status": "effect-orm status",
		"db:verify": "effect-orm verify",
		"db:audit-raw-sql": "bun scripts/audit-raw-sql.ts",
		"db:restore-test": "bun scripts/restore-test.ts",
		"db:backfill:dashboards-v3": "bun scripts/backfill-dashboard-datasource-v3.ts"
	},
	"dependencies": {
		"@effect/sql-pg": "4.0.1",
		"@effect/sql-pglite": "4.0.1",
		"@electric-sql/pglite": "^0.5.8",
		"@maple/domain": "workspace:*",
		"@maple-dev/effect-orm": "0.4.0",
		"effect": "catalog:effect",
		"pg": "^8.23.1",
		"postgres": "^3.4.9"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:alchemy",
		"@effect/language-service": "catalog:effect",
		"@maple/widgets": "workspace:*",
		"@types/node": "catalog:tooling",
		"@types/pg": "^8.23.1",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
