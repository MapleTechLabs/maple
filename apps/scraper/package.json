{
	"name": "@maple/scraper",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "bun run src/main.ts",
		"dev": "bun --env-file=../../.env.local --watch src/main.ts",
		"test": "vitest run",
		"typecheck": "tsrs --noEmit",
		"bundle": "bun build src/main.ts --target=bun --outfile dist/scraper.js"
	},
	"dependencies": {
		"@effect/platform-bun": "catalog:effect",
		"@maple-dev/effect-sdk": "workspace:*",
		"@maple/domain": "workspace:*",
		"@maple/prometheus-otlp": "workspace:*",
		"@maple/safe-fetch": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@types/bun": "^1.4.2",
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
