{
	"name": "@maple/web-data",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./collections": "./src/collections/index.ts",
		"./collections/*": "./src/collections/*.ts",
		"./alerts/*": "./src/alerts/*.ts",
		"./anomalies/*": "./src/anomalies/*.ts",
		"./investigations/*": "./src/investigations/*.ts",
		"./dashboards/*": "./src/dashboards/*.ts",
		"./lib/*": "./src/lib/*.ts",
		"./warehouse/*": "./src/warehouse/*.ts"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsrs --noEmit"
	},
	"dependencies": {
		"@maple/domain": "workspace:*",
		"@maple/query-engine": "workspace:*",
		"@maple/query-model": "workspace:*",
		"@maple/ui": "workspace:*",
		"@maple/widgets": "workspace:*",
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@types/node": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:"
	}
}
