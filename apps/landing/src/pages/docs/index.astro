---
// /docs, the front door. Three questions, in order: where do I start, how do
// I get my language in, and how do I do a common task. The sidebar is the full
// list of pages, so this page doesn't repeat it.
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import DocsCategoryIcon from "../../components/docs/DocsCategoryIcon.astro";
import LanguageLogo from "../../components/docs/LanguageLogo.astro";
import BrandMarkIcon from "../../components/BrandMarkIcon.astro";
import { LANGUAGES } from "../../lib/docs-languages";
import { INSTRUMENTATION_SLUG } from "../../lib/docs-nav";

const allDocs = await getCollection("docs", ({ data }) => !data.draft);
const bySlug = (slug: string) => allDocs.find((d) => d.id === slug);

// Each card carries the glyph of the surface it opens, matching the sidebar
// and section strip (DocsCategoryIcon ids). Blurbs are written to fit three
// lines; page descriptions are longer and get cut off mid-word.
const START_HERE = [
    { slug: "getting-started/quickstart", icon: "Getting Started", blurb: "Send your first trace in about five minutes." },
    { slug: INSTRUMENTATION_SLUG, icon: "Instrumentation", blurb: "Setup guides for every language, framework and runtime." },
    { slug: "local-mode", icon: "Local Mode", blurb: "Run all of Maple as one binary on your machine. No account needed." },
    { slug: "reference/mcp", icon: "MCP", blurb: "Connect Claude, Cursor and other agents to your telemetry." },
].flatMap(({ slug, icon, blurb }) => {
    const doc = bySlug(slug);
    return doc ? [{ doc, icon, blurb }] : [];
});

// Task entry points instead of a copy of the sidebar. A link whose page is
// missing is dropped at build, so a rename can't ship a dead row.
const TASKS: { title: string; icon: string; links: { label: string; href: string }[] }[] = [
    {
        title: "Get data in",
        icon: "Instrumentation",
        links: [
            { label: "Send your first trace", href: "getting-started/quickstart" },
            { label: "Instrument a service", href: INSTRUMENTATION_SLUG },
            { label: "Collect host and container metrics", href: "infrastructure/hosts" },
            { label: "Record browser sessions", href: "session-replay/browser-sdk" },
            { label: "Track product events", href: "product-events/overview" },
        ],
    },
    {
        title: "Find a problem",
        icon: "Explore",
        links: [
            { label: "Search traces", href: "explore/traces" },
            { label: "Search logs", href: "explore/logs" },
            { label: "Triage errors", href: "errors/overview" },
            { label: "Read the service map", href: "explore/service-map" },
            { label: "Trace AI agents", href: "agent-sessions/overview" },
        ],
    },
    {
        title: "Get alerted",
        icon: "Alerting",
        links: [
            { label: "Create an alert rule", href: "alerting/alert-rules" },
            { label: "Work an incident", href: "alerting/incidents" },
            { label: "Send alerts to Slack, email or a webhook", href: "alerting/notification-destinations" },
            { label: "Build a dashboard", href: "dashboards/build-dashboards" },
            { label: "Connect GitHub, Cloudflare or PlanetScale", href: "integrations/github" },
        ],
    },
    {
        title: "Automate",
        icon: "Reference",
        links: [
            { label: "Call the REST API", href: "reference/api" },
            { label: "Query with SQL", href: "reference/sql" },
            { label: "Use the CLI", href: "reference/cli" },
            { label: "Receive alert webhooks", href: "reference/webhooks" },
            { label: "Check limits and retention", href: "reference/limits" },
        ],
    },
].map((task) => ({
    ...task,
    links: task.links.flatMap((link) => {
        const [slug, hash] = link.href.split("#");
        return bySlug(slug) ? [{ label: link.label, href: `/docs/${slug}${hash ? `#${hash}` : ""}` }] : [];
    }),
}));

const introduction = bySlug("getting-started/introduction");
---

<DocsLayout
    title="Documentation"
    description="Technical documentation for the Maple observability platform: instrumentation guides, concepts, integrations, alerting, local mode and the API."
    headings={[]}
    currentSlug=""
    mdHref="/docs.md"
    wide
>
    <div class="docs-index">
        <header>
            <h1 class="text-[34px] font-semibold leading-[1.1] tracking-[-0.03em] text-fg md:text-[40px]">Documentation</h1>
            <p class="mt-4 max-w-[58ch] text-[16px] leading-[1.6] text-pretty text-fg-muted">
                Maple is an OpenTelemetry-native observability platform for traces, logs, metrics, errors and sessions. Point any OTel SDK at it and start exploring.
                {introduction && (
                    <>
                        New here? Read the <a href={`/docs/${introduction.id}`} class="text-fg underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary">introduction</a>.
                    </>
                )}
            </p>
        </header>

        {/* ── Start here ─────────────────────────────────────── */}
        <section class="mt-10" aria-labelledby="start-here">
            <h2 id="start-here" class="font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Start here</h2>
            <div class="hairline-grid mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                {START_HERE.map(({ doc, icon, blurb }) => (
                    <a href={`/docs/${doc.id}`} class="cell group flex flex-col p-5 transition-colors hover:bg-bg-elevated">
                        <span class="flex items-center justify-between">
                            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated text-primary transition-colors group-hover:border-primary/40" aria-hidden="true">
                                <DocsCategoryIcon name={icon} class="h-4 w-4" />
                            </span>
                            <svg
                                class="h-3.5 w-3.5 -translate-x-1 text-fg-muted opacity-0 transition-[opacity,transform] duration-200 group-hover:translate-x-0 group-hover:opacity-100 motion-reduce:transition-none"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="square"
                                aria-hidden="true"
                            >
                                <path d="M16.99 12H17" /><path d="M14.99 10H15" /><path d="M14.99 14H15" /><path d="M12.99 16H13" /><path d="M12.99 8H13" /><path d="M10.99 6H11" /><path d="M10.99 18H11" /><path d="M8.99 20H9" /><path d="M8.99 4H9" />
                            </svg>
                        </span>
                        <span class="mt-4 block text-[14px] font-medium text-fg">{doc.data.title}</span>
                        <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">{blurb}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* ── Instrumentation ─────────────────────────────────── */}
        <section class="mt-12" aria-labelledby="instrument">
            <div class="flex items-baseline justify-between gap-4">
                <h2 id="instrument" class="font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Instrument your application</h2>
                <a href={`/docs/${INSTRUMENTATION_SLUG}`} class="text-[13px] text-primary transition-colors hover:text-fg">All guides</a>
            </div>
            <div class="hairline-grid mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
                {LANGUAGES.map((lang) => (
                    <a href={`/docs/${lang.slug}`} class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                            <LanguageLogo id={lang.id} class="h-4 w-4" />
                        </span>
                        <span class="truncate text-[14px] font-medium text-fg">{lang.name}</span>
                    </a>
                ))}
                <a href="/docs/session-replay/browser-sdk" class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                        <BrandMarkIcon id="javascript" class="h-4 w-4" />
                    </span>
                    <span class="truncate text-[14px] font-medium text-fg">Browser</span>
                </a>
                <a href={`/docs/${INSTRUMENTATION_SLUG}#anything-that-speaks-otlp`} class="cell flex items-center gap-3 p-4 transition-colors hover:bg-bg-elevated">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border bg-bg-elevated" aria-hidden="true">
                        <BrandMarkIcon id="opentelemetry" class="h-4 w-4" />
                    </span>
                    <span class="truncate text-[14px] font-medium text-fg">Any OTLP exporter</span>
                </a>
            </div>
        </section>

        {/* ── Common tasks ────────────────────────────────────── */}
        <section class="mt-12" aria-labelledby="tasks">
            <h2 id="tasks" class="font-mono text-[10px] font-medium uppercase tracking-[0.18em] text-fg-muted">Common tasks</h2>
            <div class="hairline-grid mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
                {TASKS.map(({ title, icon, links }) => (
                    <div class="cell p-5">
                        <h3 class="flex items-center gap-2 text-[14px] font-medium text-fg">
                            <DocsCategoryIcon name={icon} class="h-3.5 w-3.5 shrink-0 text-primary/80" />
                            {title}
                        </h3>
                        {/* Full-width rows with a chevron: these must read as links at
                            rest, not as a bullet list that happens to be clickable. */}
                        <ul class="-mx-2 mt-3 space-y-px">
                            {links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="group/link flex items-center justify-between gap-3 rounded-md px-2 py-1.5 text-[13.5px] text-fg/85 transition-colors hover:bg-bg-elevated hover:text-fg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
                                    >
                                        <span>{link.label}</span>
                                        <svg
                                            class="h-3.5 w-3.5 shrink-0 text-fg-muted/60 transition-[color,transform] duration-200 group-hover/link:translate-x-0.5 group-hover/link:text-primary motion-reduce:transition-none"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="square"
                                            aria-hidden="true"
                                        >
                                            <path d="M16.99 12H17" /><path d="M14.99 10H15" /><path d="M14.99 14H15" /><path d="M12.99 16H13" /><path d="M12.99 8H13" /><path d="M10.99 6H11" /><path d="M10.99 18H11" /><path d="M8.99 20H9" /><path d="M8.99 4H9" />
                                        </svg>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </section>

        {/* ── Footer ──────────────────────────────────────────── */}
        <footer class="mt-14 flex flex-col gap-2 border-t border-border pt-6 text-[13px] text-fg-muted sm:flex-row sm:items-center sm:justify-between">
            <p>
                Every page is also plain markdown: append <code class="rounded bg-bg-elevated px-1.5 py-0.5 text-fg">.md</code> to its URL, or start from
                <a href="/llms.txt" class="text-fg transition-colors hover:text-primary">/llms.txt</a>.
            </p>
            <p class="flex flex-wrap items-center gap-3">
                <a href="/changelog" class="text-fg transition-colors hover:text-primary">Changelog</a>
                <a href="/pricing" class="text-fg transition-colors hover:text-primary">Pricing</a>
                <a href="https://github.com/MapleTechLabs/maple" class="text-fg transition-colors hover:text-primary">GitHub</a>
                <a href="https://github.com/MapleTechLabs/maple/issues" class="text-fg transition-colors hover:text-primary">Report a docs issue</a>
            </p>
        </footer>
    </div>
</DocsLayout>

<style>
    /* Hairline grid that tolerates a short last row: each cell draws its own
       1px frame, so an empty slot reads as an empty cell rather than a block
       of border colour. */
    .hairline-grid {
        gap: 1px;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--background);
    }
    .hairline-grid > .cell {
        background: var(--background);
        box-shadow: 0 0 0 1px var(--border);
    }
    .hairline-grid > a.cell:hover {
        background: var(--bg-elevated);
    }
</style>
